    function gridSalesOrderDetailPartial_onSubmitChanges(e) {

        var flag = InputValidation();

        if (flag == false)
            e.preventDefault();
        else {
            var materialClassifiedId = $('#MaterialClassifiedName').data('tDropDownList').value();
            var materialTypeId = $('#MaterialTypeName').data('tDropDownList').value();

            var revisionNumber = $("#RevisionNumber").val();
            var orderDate = $("#OrderDate").data("tDatePicker").value();
            var shipDate = $("#ShipDate").data("tDatePicker").value();

            var vendorCodeName = $('#VendorCodeName').data('tDropDownList').value();
            var shipMethodName = $('#ShipMethodName').data('tDropDownList').value();
            var employeeName = $('#EmployeeName').data('tDropDownList').value();

            e.values = $.extend(e.values,
            {
                materialClassifiedId: materialClassifiedId,
                materialTypeId: materialTypeId,

                revisionNumber: revisionNumber,
                orderDate: orderDate,
                shipDate: shipDate,

                vendorId: vendorCodeName,
                shipMethodId: shipMethodName,
                employeeId: employeeName
            }
            //            ,
            //            function (data) {
            //                alert("d: " +data);
            //            }
            );
            productIds = {};
        }
    }

    function gridSalesOrderDetailPartial_onError(args) {
        if (args.textStatus == "modelstateerror" && args.modelState) {
            var message = "Errors:\n";
            $.each(args.modelState, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            args.preventDefault();
            alert(message);
        }
    }
</script>
