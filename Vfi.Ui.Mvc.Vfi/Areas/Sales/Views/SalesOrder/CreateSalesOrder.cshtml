@section Scripts{
<script type="text/javascript">
    $(function () {
        $('#lookupSalesOrderNumberExisted').attr('class', 'imgUnAvailable');
        $('#txtSalesOrderNumberHidden').val(0);

        $("#SalesOrderNumber").change(function () {
            CheckSalesOrderNumber($(this).val());
        });
    });
</script>

<script type="text/javascript">
    function CheckSalesOrderNumber(value) {
        if (value.length === 0) {
            $('#lookupSalesOrderNumberExisted').attr('class', 'imgUnAvailable');
            $('#txtSalesOrderNumberHidden').val(0);
            return false;
        }
        $('#lookupSalesOrderNumberExisted').attr('class', 't-loading');

        $.ajax({
            type: 'post',
            data: { salesOrderNumber: value },
            dataType: 'json',
            url: '@Url.Action("CheckSalesOrderNumber", "SalesOrder")',
            timeout: 20000,
            success: function (data) {
                if (data == 1) {
                    $('#lookupSalesOrderNumberExisted').attr('class', 'imgUnAvailable');
                    $('#txtSalesOrderNumberHidden').val(0);
                }
                else if (data == 0) {
                    $('#lookupSalesOrderNumberExisted').attr('class', 'imgAvailable');
                    $('#txtSalesOrderNumberHidden').val(1);
                }
                else if (data == 2) {
                    $('#lookupSalesOrderNumberExisted').attr('class', 'imgUnAvailable');
                    $('#txtSalesOrderNumberHidden').val(0);
                }
            }
        });

        return false;
    }
</script>

