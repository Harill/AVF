@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@{
    ViewBag.Title = "Product Quotation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
  
    <script type="text/javascript">
        function customer_onChange(e) {
            //$("#Customer").data('tComboBox').value(e.text());
            RefreshGrid("gridProductQuotationDetail");
        }

        function grid_OnDataBinding(args) {
            var type = $('#Type').data('tDropDownList').value();
            var exchangeRate = $("#ExchangeRate").val();
            if (type == 1) {

                var customerId = $("#FilterProduct").data('tComboBox').value();
                if (customerId == 0) {
                    customerId = 0;
                }
                args.data = $.extend(args.data, {
                    customerId: customerId,
                    quoteId: 0,
                    exchangeRate: exchangeRate
                });
            } else {
                var quoteId = $("#QuoteNumber").data('tComboBox').value();
                if (quoteId == 0) {
                    quoteId = 0;
                }
                args.data = $.extend(args.data, {
                    customerId: 0,
                    quoteId: quoteId,
                    exchangeRate: exchangeRate
                });
            }
           

        }

        function grid_OnSubmitChanges(e) {

            var flag = InputValidation();

            if (flag == false)
                e.preventDefault();
            else {
                var customerId = $("#Customer").data('tComboBox').value();
                if (customerId == 0) {
                    customerId = 0;
                }
                var quoteId = $("#QuoteNumber").data('tComboBox').value();
                if (quoteId == 0) {
                    quoteId = 0;
                }
                var quoteDate = $("#QuoteDate").data("tDatePicker").value();
                if (quoteDate === null)
                    quoteDate = "";
                else
                    quoteDate = $.telerik.formatString('{0:dd/MM/yyyy}', quoteDate);
                var endDate = $("#EndDate").data("tDatePicker").value();
                if (endDate === null)
                    endDate = "";
                else
                    endDate = $.telerik.formatString('{0:dd/MM/yyyy}', endDate);

                var deliveryTerm = $('#DeliveryTerm').data('tDropDownList').value();
                var employee = $('#EmployeeName').data('tDropDownList').value();
                var paymentMethod = $('#PaymentMethod').data('tDropDownList').value();
                var deliveryPeriod = $('#DeliveryPeriod').data('tDropDownList').value();
                var paymentCondition = $('#PaymentCondition').data('tDropDownList').value();
                var currencyCode = $('#CurrencyCode').data('tDropDownList').value();
                var note = $('#Note').val();
                var portName = $('#PortName').data('tAutoComplete').value();
                var exchangeRate = $("#ExchangeRate").val();
                var $checkedRecords = $(':checked');
                //var $checkedRecords = $("input[name='chkMaterialIds']:checked");

                if ($checkedRecords.length < 1) {
                    alert("Vui lọn chọn ít nhất 1 sản phẩm");
                    return;
                }

                //$.ajaxSettings.traditional = false;
                var a = {};
                var ids = "";
                //var $b = (a);

                for (var i = 0; i < $checkedRecords.length; i++) {
                    a[i] = $checkedRecords[i].value;

                    ids += $checkedRecords[i].value;
                    if (i < ($checkedRecords.length - 1))
                        ids += ":";
                }

                e.values = $.extend(e.values,
                    {
                        customerId: customerId,
                        quoteId: quoteId,
                        productIds: ids,
                        salesPersonId: employee,
                        quoteDate: quoteDate,
                        endDate: endDate,
                        deliveryTerm: deliveryTerm,
                        portName: portName,
                        paymentMethod: paymentMethod,
                        deliveryPeriod: deliveryPeriod,
                        paymentCondition: paymentCondition,
                        currencyCode: currencyCode,
                        exchangeRate: exchangeRate,
                        note: note
                    }
                );
            }
        }

        function InputValidation() {
            var strMsgAlert = "";

            var customerId = $("#Customer").data('tComboBox').value();
            if (customerId == 0) {
                strMsgAlert += "Vui lòng chọn khách hàng.\t\r\n";
            }
            var employeeName = $('#EmployeeName').data('tDropDownList').value();
            if (employeeName === "") {
                strMsgAlert += "Vui lòng chọn nhân viên bán.\t\r\n";
            }
            var deliveryTerm = $('#DeliveryTerm').data('tDropDownList').value();
            if (deliveryTerm === "") {
                strMsgAlert += "Vui lòng chọn phương thức vận chuyển.\t\r\n";
            }
            var portName = $('#PortName').data('tAutoComplete').value();
            if (portName === "") {
                strMsgAlert += "Vui lòng chọn cảng vận chuyển.\t\r\n";
            }
            var paymentMethod = $('#PaymentMethod').data('tDropDownList').value();
            if (paymentMethod === "") {
                strMsgAlert += "Vui lòng chọn phương thức thanh toán.\t\r\n";
            }
            var deliveryPeriod = $('#DeliveryPeriod').data('tDropDownList').value();
            if (deliveryPeriod === "") {
                strMsgAlert += "Vui lòng chọn thời hạn giao hàng.\t\r\n";
            }
            var paymentCondition = $('#PaymentCondition').data('tDropDownList').value();
            if (paymentCondition === "") {
                strMsgAlert += "Vui lòng chọn điều kiện thanh toán.\t\r\n";
            }
            var currencyCode = $('#CurrencyCode').data('tDropDownList').value();
            if (currencyCode === "USD") {
                if ($("#ExchangeRate").val() == 1)
                    strMsgAlert += "Tiền tệ USD phải ghi rõ tỉ giá\t\r\n";
            }
            if (strMsgAlert === "")
                return true;
            alert(strMsgAlert);
            return false;
        }

