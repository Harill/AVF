<div class="clear"></div>
<div class="cover-div">
@{
    Html.Telerik().Grid<ProductQuotationModel>()
        .Name("gridProductQuotationDetail")
        .ToolBar(bar => bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Tạo mẫu báo giá với SP đã chọn").CancelText("Làm mới"))
        .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
        .DataBinding(dataBindings => dataBindings.Ajax()
                                                 .Select("SelectQuotationProducts", "SalesOrder",
                                                         new {customerId = 0})
                                                 .Update("UpdateQuotationProductDetail", "SalesOrder")
        )
        .Columns(columns =>
            {
                columns.Bound(f => f.ProductId).Title("Chọn").Width(50).ReadOnly(true)
                       .ClientTemplate("<input type='checkbox' name='chkProductIds' value='<#= ProductId #>' />")
                       .HtmlAttributes(new {style = "text-align:center"});
                //columns.Bound(f => f.CustomerCodeName).Width(100).Title("Khách hàng");
                columns.Bound(f => f.ProductName).Width(100).Title("Tên SP").ReadOnly(true);
                columns.Bound(f => f.ProductCustomerCode).Width(100).Title("Mã SP KH");
                columns.Bound(f => f.Dimension).Width(75).Title("Quy cách").ReadOnly(true);
                columns.Bound(f => f.ProductWeight).Width(100).Title("Trọng lượng").ReadOnly(true)
                       .ClientTemplate("<#= ProductWeight == null ? 0 : $.telerik.formatString('{0:n3}', ProductWeight) #>")
                       .HtmlAttributes(new {style = "text-align: right;"});
                columns.Bound(f => f.Quantity).Width(75).Title("SL đặt")
                       .ClientTemplate("<#= Quantity == null ? 0 : $.telerik.formatString('{0:n0}', Quantity) #>");
                columns.Bound(f => f.MaterialDesign).Width(100).Title("Nguyên liệu").ReadOnly(true);
                columns.Bound(f => f.ProcessingPrice).Width(75).Title("Giá gia công").ReadOnly(true)
                       .ClientTemplate("<#= ProcessingPrice == null ? 0 : $.telerik.formatString('{0:n4}', ProcessingPrice) #>")
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.MaterialPrice).Width(75).Title("Giá NL(kg)")
                       .ClientTemplate("<#= MaterialPrice == null ? 0 : $.telerik.formatString('{0:n4}', MaterialPrice) #>")
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.MaterialUnitPrice).Width(75).Title("Giá NL(pc)")
                       .ClientTemplate("<#= MaterialUnitPrice == null ? 0 : $.telerik.formatString('{0:n4}', MaterialUnitPrice) #>")
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.LastDiff).Width(75).Title("Điều chỉnh(+/-)")
                       .HtmlAttributes(new { style = "text-align: right;" });
                    
                columns.Bound(f => f.QuotationCost).Width(75).Title("Giá báo(pc)")
                       .ClientTemplate("<span name='QuotationCost' class='QuotationCost'><#= QuotationCost == null ? 0 : $.telerik.formatString('{0:n4}', QuotationCost) #></span>")
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.Note).Width(75).Title("Ghi chú");  
            })
        .Editable(editing => editing.Mode(GridEditMode.InCell))
        .Scrollable(f => f.Height("auto"))
        .Scrollable(f => f.Height(300))
        .Resizable(f => f.Columns(true))
        //.Pageable(f => f.Style(GridPagerStyles.Status))
        .ClientEvents(events => events.OnDataBinding("grid_OnDataBinding")
                                      .OnEdit("grid_OnEdit")
                                      .OnSubmitChanges("grid_OnSubmitChanges")
                                      .OnError("grid_OnError")
        )
        .Render();
}
