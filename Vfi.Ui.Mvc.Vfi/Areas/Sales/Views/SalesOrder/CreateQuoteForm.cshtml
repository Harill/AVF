@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@using Vfi.Ui.Mvc.Vfi.Models.Production
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Create Quotation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
  
    <script type="text/javascript">

        function grid_OnSubmitChanges(e) {

            var flag = InputValidation();

            if (flag == false)
                e.preventDefault();
            else {
                var customerId = $("#QuoteCustomer").data('tComboBox').value();
                if (customerId == 0) {
                    customerId = 0;
                }
                var quoteId = $("#QuoteNumber").data('tComboBox').value();
                if (quoteId == 0) {
                    quoteId = 0;
                }
                var quoteDate = $("#QuoteDate").data("tDatePicker").value();
                if (quoteDate === null)
                    quoteDate = "";
                else
                    quoteDate = $.telerik.formatString('{0:dd/MM/yyyy}', quoteDate);
                var endDate = $("#EndDate").data("tDatePicker").value();
                if (endDate === null)
                    endDate = "";
                else
                    endDate = $.telerik.formatString('{0:dd/MM/yyyy}', endDate);

                var deliveryTerm = $('#DeliveryTerm').data('tDropDownList').value();
                var employee = $('#EmployeeName').data('tDropDownList').value();
                var paymentMethod = $('#PaymentMethod').data('tDropDownList').value();
                var deliveryPeriod = $('#DeliveryPeriod').data('tDropDownList').value();
                var paymentCondition = $('#PaymentCondition').data('tDropDownList').value();
                var currencyCode = $('#CurrencyCode').data('tDropDownList').value();
                var note = $('#Note').val();
                var portName = $('#PortName').data('tAutoComplete').value();
                var exchangeRate = $("#ExchangeRate").val();

                var $checkedRecords = $("input[name='chkProductIds']:checked")
                //var $checkedRecords = $("input[name='chkMaterialIds']:checked");

                if ($checkedRecords.length < 1) {
                    alert("Vui lọn chọn ít nhất 1 sản phẩm");
                    return;
                }

                //$.ajaxSettings.traditional = false;
                var a = {};
                ids = "";
                //var $b = (a);

                for (var i = 0; i < $checkedRecords.length; i++) {
                    if ($checkedRecords[i] === "0") continue;
                    a[i] = $checkedRecords[i].value;

                    ids += $checkedRecords[i].value;
                    if (i < ($checkedRecords.length - 1))
                        ids += ":";
                }

                e.values = $.extend(e.values,
                    {
                        customerId: customerId,
                        quoteId: quoteId,
                        productIds: ids,
                        salesPersonId: employee,
                        quoteDate: quoteDate,
                        endDate: endDate,
                        deliveryTerm: deliveryTerm,
                        portName: portName,
                        paymentMethod: paymentMethod,
                        deliveryPeriod: deliveryPeriod,
                        paymentCondition: paymentCondition,
                        currencyCode: currencyCode,
                        exchangeRate: exchangeRate,
                        note: note
                    }
                );
            }
        }

        function InputValidation() {
            var strMsgAlert = "";

            var customerId = $("#QuoteCustomer").data('tComboBox').value();
            if (customerId == 0) {
                strMsgAlert += "Vui lòng chọn khách hàng.\t\r\n";
            }
            var employeeName = $('#EmployeeName').data('tDropDownList').value();
            if (employeeName === "") {
                strMsgAlert += "Vui lòng chọn nhân viên bán.\t\r\n";
            }
            var deliveryTerm = $('#DeliveryTerm').data('tDropDownList').value();
            if (deliveryTerm === "") {
                strMsgAlert += "Vui lòng chọn phương thức vận chuyển.\t\r\n";
            }
            var portName = $('#PortName').data('tAutoComplete').value();
            if (portName === "") {
                strMsgAlert += "Vui lòng chọn cảng vận chuyển.\t\r\n";
            }
            var paymentMethod = $('#PaymentMethod').data('tDropDownList').value();
            if (paymentMethod === "") {
                strMsgAlert += "Vui lòng chọn phương thức thanh toán.\t\r\n";
            }
            var deliveryPeriod = $('#DeliveryPeriod').data('tDropDownList').value();
            if (deliveryPeriod === "") {
                strMsgAlert += "Vui lòng chọn thời hạn giao hàng.\t\r\n";
            }
            var paymentCondition = $('#PaymentCondition').data('tDropDownList').value();
            if (paymentCondition === "") {
                strMsgAlert += "Vui lòng chọn điều kiện thanh toán.\t\r\n";
            }
            var currencyCode = $('#CurrencyCode').data('tDropDownList').value();
            if (currencyCode === "USD") {
                if ($("#ExchangeRate").val() == 1)
                    strMsgAlert += "Tiền tệ USD phải ghi rõ tỉ giá\t\r\n";
            }
            if (strMsgAlert === "")
                return true;
            alert(strMsgAlert);
            return false;
        }

        function Type_OnLoad() {
            var combobox = $('#Type').data('tDropDownList');
            var dataSource =
            [
                { Text: "New Quotation", Value: "1" },
                { Text: "Quotation Again", Value: "2" }
            ];
            //Báo giá lại
            combobox.dataBind(dataSource);
        }

        function Type_OnChange() {
            var type = $('#Type').data('tDropDownList').value();
            var quote = $('#QuoteNumber').data('tComboBox');
            if (type == 1) {
                quote.dataBind(null);
                document.getElementById('cboQuoteNumber').hidden = true;
                $("#QuoteCustomer").data("tComboBox").$text[0].disabled = false;
                $("#FilterCustomer").data("tComboBox").$text[0].disabled = false;
            } else { //var monthlyDate = combobox.text();
                $.ajax({
                    type: 'post',
                    data: {},
                    dataType: 'json',
                    url: '@Url.Action("SelectReQuotation", "SalesOrder", new {area = "Sales"})',
                    timeout: 20000,
                    success: function (data) {
                        //$('#Invoice').data('tConbobox').dataBind(data);
                        quote.dataBind(data);
                    }
                });
                document.getElementById('cboQuoteNumber').hidden = false;
                $("#QuoteCustomer").data("tComboBox").$text[0].disabled = true;
                $("#FilterCustomer").data("tComboBox").$text[0].disabled = true;
            }
        }

        function Quote_OnChange(e) {
            $.ajax({
                type: 'post',
                data: { quoteId: e.value },
                dataType: 'json',
                url: '@Url.Action("SelectReQuotationInfo", "SalesOrder", new {area = "Sales"})',
                timeout: 20000,
                success: function (data) {
                    var quotation = data;
                    $('#Note').val(quotation.Note);
                    $('#PortName').data('tAutoComplete').value(quotation.PortName);
                    $("#ExchangeRate").val(quotation.ExchangeRate);
                    $("#ExchangeRate").data("tTextBox").$text[0].innerHTML = quotation.ExchangeRate;

                    $("#CurrencyCode").val(quotation.CurrencyCode);
                    $("#CurrencyCode").data("tDropDownList").$text[0].innerHTML = quotation.CurrencyCode;
                    $("#DeliveryTerm").val(quotation.DeliveryTermId);
                    $("#DeliveryTerm").data("tDropDownList").$text[0].innerHTML = quotation.DeliveryTermName;
                    $("#PaymentMethod").val(quotation.PaymentMethodId);
                    $("#PaymentMethod").data("tDropDownList").$text[0].innerHTML = quotation.PaymentMethodName;
                    $("#DeliveryPeriod").val(quotation.DeliveryPeriod);
                    $("#DeliveryPeriod").data("tDropDownList").$text[0].innerHTML = quotation.DeliveryPeriodName;
                    $("#PaymentCondition").val(quotation.PaymentCondition);
                    $("#PaymentCondition").data("tDropDownList").$text[0].innerHTML = quotation.PaymentConditionName;
                    $("#Customer").val(quotation.CustomerId);
                    $("#Customer").data("tComboBox").$text[0].innerHTML = quotation.CustomerCodeName;
                    $("#Customer").data("tComboBox").$text[0].value = quotation.CustomerCodeName;
                    //$("#FilterCustomer").val(quotation.FilterProduct);
                    //$("#FilterCustomer").data("tComboBox").$text[0].innerHTML = quotation.FilterProductCode;
                    //$("#FilterCustomer").data("tComboBox").$text[0].value = quotation.CustomerCodeName;
                    RefreshGrid("gridProductQuotationDetail");
                }
            });
        }

        function grid_OnDataBinding(args) {
            var customer = $("#FilterCustomer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            args.data = $.extend(args.data, {
                customerId: customer
            });
        }

        function customer_onChange() {
            RefreshGrid("grid");
        }
    </script>

}

<div class="title">Create Quotation</div>

<div class="t-info-sha" style="padding-left: 15px;padding-right: 15px;">

