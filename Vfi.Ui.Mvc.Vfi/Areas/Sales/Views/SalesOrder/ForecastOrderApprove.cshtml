@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "Approve Forecast ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script>
        function grid_OnDataBinding(e) {
            //if (startGrid) {
            var customerId = $('#CustomerForMonthly').data('tComboBox').value();
            if (customerId === "")
                customerId = 0;
            e.data = $.extend(e.data, {
                customerId: customerId,
            });
            //}
            index = 0;
        }

        function grid_OnSave(e) {
            index = 0;
            var customerId = $('#CustomerForMonthly').data('tComboBox').value();
            if (customerId === "")
                customerId = 0;
            e.values = $.extend(e.values, {
                customerId: customerId,
            });
        }

        var startGrid = false;
        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("gridForecast");
        }
        var index = 0;
    </script>
}

<div class="title">Approve Sale-Forecast 
   @* Duyệt dự báo bán hàng*@</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1065px;">
    <fieldset>
        <legend>Filters</legend>
        <div class="grid_2_5">
            @Html.Label("Customer Code")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("CustomerForMonthly")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 275px" })
                    //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
        <div class="grid_2_5">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2(); ">
                <span class='t-icon t-insert'></span>
                Find
            </button>
        </div>
    </fieldset>
</div>
<br />

