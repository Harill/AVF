                                            .Select("SelectProductionProcessById", "Product", new { area = "", productId = "<#= ProductId #>" })
                                    )
                                    .Columns(columns =>
                                    {
                                        columns.Bound(f => f.WarehouseName).Width(100).Title("Warehouse</br>Name");
                                        columns.Bound(f => f.ProcessIndex).Width(50).Title("Phase")
                                               .ClientTemplate("<#= ProcessIndex == null ? 0 : $.telerik.formatString('{0:n0}', ProcessIndex) #>");
                                        columns.Bound(f => f.IsAlert).Width(75).Title("Alert?")
                                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='Alert' <#=IsAlert? checked='checked' : '' #> />")
                                               .HtmlAttributes(new { style = "text-align:center" });
                                        columns.Bound(f => f.IsNecessary).Width(75).Title("Necessary?")
                                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='Necessary' <#=IsNecessary? checked='checked' : '' #> />")
                                               .HtmlAttributes(new { style = "text-align:center" });
                                        columns.Bound(f => f.ModifiedDate).Width(100).Title("M-Date").ReadOnly(true)
                                               .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ModifiedDate) #>");
                                        columns.Bound(f => f.ModifiedUser).Width(100).Title("M-User").ReadOnly(true);
                                    })
                                    .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
                                    .ClientEvents(e => e.OnError("grid_OnError"))
                                    .ToHtmlString()
                                );
                            items.Add().Text("Track-Up Infomation").Content(
                                Html.Telerik().Grid<Vfi.Ui.Mvc.Vfi.Areas.Factory.Models.TrackUpMachineModel>()
                                    .Name("gridRealProduction_<#= ProductId #>")
                                    .DataKeys(key => key.Add(f => f.TrackId).RouteKey("trackId"))
                                    .DataBinding(dataDindings => dataDindings.Ajax()
                                        .Select("SelectRealProductionById", "Product", new { area = "", productId = "<#= ProductId #>" })
                                    )
                                    .Columns(columns =>
                                    {
                                        columns.Bound(f => f.DeliveryDate).Width(75).Title("Delivery</br>Date")
                                               .ClientTemplate("<#= DeliveryDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', DeliveryDate) #>");
                                        columns.Bound(f => f.MachineName).Width(60).Title("Machine")
                                               .ClientTemplate("<strong><#= MachineName #></strong>");
                                        columns.Bound(f => f.MaterialCode).Width(170).Title("Material")
                                               .ClientTemplate("<strong><#= MaterialCode #></strong>");
                                        columns.Bound(f => f.Quantity).Width(170).Title("Quantity")
                                               .Format("{0:n0}");
                                        columns.Bound(f => f.Phase).Width(75).Title("Section");
                                        columns.Bound(f => f.RoundPerMinute).Width(50).Title("RPM")
                                               .ClientTemplate("<#= RoundPerMinute == null ? 0 : $.telerik.formatString('{0:n0}', RoundPerMinute) #>");
                                        columns.Bound(f => f.RealProductivity).Width(50).Title("Productivity")
                                               .ClientTemplate("<#= RealProductivity == null ? 0 : $.telerik.formatString('{0:n2}', RealProductivity) #>");
                                        columns.Bound(f => f.RealRate).Width(50).Title("Quota")
                                               .ClientTemplate("<#= RealRate == null ? 0 : $.telerik.formatString('{0:n2}', RealRate) #>");
                                        columns.Bound(f => f.WorkPiece).Width(50).Title("Excess</br>Workpiece")
                                               .ClientTemplate("<#= WorkPiece == null ? 0 : $.telerik.formatString('{0:n2}', WorkPiece) #>");
                                        columns.Bound(f => f.KnifeCut).Width(50).Title("Knife Cut")
                                               .ClientTemplate("<#= KnifeCut == null ? 0 : $.telerik.formatString('{0:n2}', KnifeCut) #>");
                                        columns.Bound(f => f.DeliveryEmployee).Width(75).Title("Delivery</br>Employee");
                                        columns.Bound(f => f.ReceiveEmployee).Width(75).Title("Receive</br>Employee");
                                        columns.Bound(f => f.Note).Title("Note");
                                    })
                                    .ClientEvents(events => events.OnError("grid_OnError"))
                                    .ToHtmlString()
                                );
                        }).ToHtmlString()))
            .Selectable()
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
            .ClientEvents(e => e.OnError("grid_OnError")
                                .OnRowSelect("grid_OnRowSelect")
                                .OnDataBinding("grid_OnDataBinding")
                                .OnRowDataBound("grid_OnRowDataBound")
                                //.OnSave("grid_OnSave")
            )
            .Scrollable(f => f.Height(500))
            .Sortable()
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
            .Scrollable()
            .Render();
    }
</div>
