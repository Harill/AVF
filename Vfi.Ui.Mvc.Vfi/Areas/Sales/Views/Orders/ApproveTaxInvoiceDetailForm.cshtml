@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@{
    ViewBag.Title = "Duyệt phiếu thu tiền";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Scripts{
    <!-- approve stockorder -->
    <script type="text/javascript">
        function Approve() {
            $("#btnApprove").attr('disabled', 'disabled');

            var $checkedRecords = $("input[name='chkIds']:checked");

            if ($checkedRecords.length < 1) {
                alert("Vui lòng chọn ít nhất 1 chứng từ");
                $("#btnApprove").removeAttr('disabled');
                return;
            }
            $.post('@Url.Action("ApproveTaxInvoice", "Orders")',
            {
                //checkedRecords: $checkedRecords.map(function () { return value; })
                checkedRecords: $checkedRecords.eq(0).val()
            },
            function (data) {

                if (data === "okie") {
                    RefreshGrid("gridTransaction");
                }
                else
                    alert(data);
            });
            $("#btnApprove").removeAttr('disabled');
    }
    </script>

}

<div class="title">Duyệt phiếu nhập tiền chứng từ</div>

<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">Sổ lệnh</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TaxInvoiceDetailModel>()
            .Name("gridTransaction")
            .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
            .ToolBar(bar => bar.Template(
                @<text>
                     <div class="grid_7">
                         <button class="t-button" id="btnApprove" name="btnApprove" onclick=" Approve() ">
                             <span class='t-icon t-insert'></span>
                             Duyệt các sổ lệnh
                         </button>
                     </div>
                     <div class="clear"></div>
                 </text>
                                ))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectTaxInvoideDetailNeedApprove", "Orders")
                                                     .Delete("CancelTaxInvoideDetailNeedApprove", "Orders")
            )
            .Columns(columns =>
                {
                    columns.Bound(f => f.DetailId).Title("Chọn").Width(50)
                           .ClientTemplate("<input type='radio' name='chkIds' value='<#= DetailId #>' />")
                           .HtmlAttributes(new { style = "text-align:center" });
                    columns.Bound(f => f.TaxInvoiceList).Width(100).Title("Chứng từ");
                    columns.Bound(f => f.CurrencyCode).Width(30).Title("Tiền tệ");
                    columns.Bound(f => f.Times).Width(30).Title("Lần");
                    columns.Bound(f => f.ImportDate).Title("Ngày nhập").Width(100)
                           .Format("{0:dd/MM/yyyy}")
                           .HtmlAttributes(new {style = "text-align:right"});
                    columns.Bound(f => f.RequiredAmountFormat).Title("Nợ còn lại").Width(80)
                           .HtmlAttributes(new {style = "text-align:right"});
                    columns.Bound(f => f.MoneyFormat).Title("Số tiền").Width(80)
                           .HtmlAttributes(new { style = "text-align:right" });
                    columns.Bound(f => f.Note).Title("Ghi chú");
                    columns.Bound(f => f.ModifiedUser).Title("Người tạo").Width(80);
                    columns.Bound(f => f.ModifiedDate).Title("Ngày tạo").Width(100)
                           .Format("{0:dd/MM/yyyy HH:mm}");

                    columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(50).Title("");
                })

            //.Selectable()
            .Resizable(c=> c.Columns(true))
            .Reorderable(c=> c.Columns(true))
            .ClientEvents(events => events.OnError("grid_OnError"))
            //.Pageable(f=>f.PageSize(5))
            .Render();
    }
</div>
