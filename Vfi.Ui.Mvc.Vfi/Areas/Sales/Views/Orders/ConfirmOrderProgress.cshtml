@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@{
    ViewBag.Title = "Xác nhận tiến độ đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function gridOrderProgress_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (!dataItem.IsProductionManager) {
                e.row.childNodes[1].innerHTML = "";
            }
            if (dataItem.StartDate !=null && dataItem.StartDate <= Date.now()) {
                e.row.childNodes[10].bgColor = "red";
            }
            if (dataItem.StartDate != null && dataItem.EndDate <= Date.now()) {
                e.row.childNodes[11].bgColor = "red";
            }
        }
    </script>
}

