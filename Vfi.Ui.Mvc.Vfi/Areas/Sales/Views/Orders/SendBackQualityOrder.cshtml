@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Models
@model ExportFormTP_KD
@{
    ViewBag.Title = "Returned Goods";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{

    <script type="text/javascript">


        function Type_OnLoad() {
            var combobox = $('#Type').data('tDropDownList');
            var dataSource =
            [
                { Text: "Returned", Value: "1" },
                //{ Text: "Đổi hàng", Value: "2" }
            ];

            combobox.dataBind(dataSource);
        }
        function Type_OnChange() {
            var type = $('#Type').data('tDropDownList').value();
            var invoice = $('#Invoice').data('tComboBox');
            //var monthlyDate = combobox.text();
            $.ajax({
                type: 'post',
                data: { type: type },
                dataType: 'json',
                url: '@Url.Action("SelectInvoiceByType", "Orders")',
            timeout: 20000,
            success: function (data) {
                //$('#Invoice').data('tConbobox').dataBind(data);
                invoice.dataBind(data);
            }
        });
        }
        function Invoice_OnChange() {
            RefreshGrid("gridProductInventory");
        }

        function gridProductInInvoice_onDataBinding(args) {

            var invoiceId = $("#Invoice").data('tComboBox').value();
            if (invoiceId == "")
                invoiceId = 0;
            args.data = $.extend(args.data, {
                invoiceId: invoiceId
            });
        }


        function autoComplete_onChange() {
            RefreshGrid("gridProductInventory");
        }
    </script>

    <script type="text/javascript">
        function PickupProductId() {

            var $checkedRecords = $(':checked');
            //var $checkedRecords = $("input[name='chkMaterialIds']:checked");

            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 nguyên liệu");
                return;
            }
            var type = $('#Type').data('tDropDownList').value();

            //$.ajaxSettings.traditional = false;
            var a = {};
            var ids = "";

            for (var i = 0; i < $checkedRecords.length; i++) {
                a[i] = $checkedRecords[i].value;

                ids += $checkedRecords[i].value;
                if (i < ($checkedRecords.length - 1))
                    ids += ":";
            }

            var invoiceId = $("#Invoice").data('tComboBox').value();
            if (invoiceId !== 0) {
                $("#gridProductInventoryDetail").data("tGrid").rebind({
                    //checkedRecords: $checkedRecords.map(function () { return value; }) 
                    //checkedRecords: a
                    productIds: ids,
                    invoiceId: invoiceId,
                    type: type
                });
            }

        }
    </script>

    <!-- client event grid material inventory -->
    <script type="text/javascript">
        function gridProductInventoryDetail_onDataBound() {
            // GenCode();
        }

        function gridProductInventoryDetail_onSave(e) {
            var quanlity = $(e.cell).find('#Quality').val();
            if (!isNaN(parseInt(quanlity))) {
                var sumQuality = 0;
                var spanRequests = $("span[name='Quality']");
                for (var i = 0; i < spanRequests.length; i++) {
                    var innerText = spanRequests[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumQuality = sumQuality + parseInt(innerText);
                }
                sumQuality = sumQuality + parseInt(quanlity);
                $("#TotalSendQuantity").text(sumQuality);
            }
            var weight = $(e.cell).find('#Weight').val();
            if (!isNaN(parseInt(weight))) {
                var sumWeight = 0.0;
                var spanWeights = $("span[name='Weight']");
                for (i = 0; i < spanWeights.length; i++) {
                    innerText = spanWeights[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumWeight = sumWeight + parseFloat(innerText);
                }
                sumWeight = sumWeight + parseFloat(weight);
                $("#TotalSendWeight").text(sumWeight);
            }
        }

        function gridProductInventoryDetail_onSubmitChanges(e) {

            var createdDate = $("#CreatedDate").data("tDatePicker").value();
            if (createdDate === null)
                createdDate = "";
            else
                createdDate = $.telerik.formatString('{0:dd/MM/yyyy}', createdDate);

            var invoiceId = $("#Invoice").data('tComboBox').value();
            var type = $("#Type").data('tDropDownList').value();
            e.values = $.extend(e.values,
                {
                    invoiceId: invoiceId,
                    type: type,
                    createdDate: createdDate
                }
            );
        }

    </script>

}

<div class="title">Returned Goods</div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
    <fieldset>
        <div class="grid_1">Type</div> 
        <div class="grid_3">
            @{
                Html.Telerik().DropDownList()
                    .Name("Type")
                    //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxPaymentTerm", "Orders"))
                    .HtmlAttributes(new { style = "width: 100px" })
                    .DropDownHtmlAttributes(new { style = "width: 100px;" })
                    .ClientEvents(events => events.OnLoad("Type_OnLoad").OnChange("Type_OnChange"))
                    .Render();                                              
            }
        </div>
        <div class="grid_1_5">Invoice</div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("Invoice")
                    //.DataBinding(binding => binding.Ajax().Select("SelectInvoiceByType", "Orders", new { area = "Sales", type = 2 }))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 200px" })
                    .ClientEvents(events => events.OnChange("Invoice_OnChange"))
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
        <div class="grid_2">Created Date</div>
            <div class="grid_4">
                @{
                    Html.Telerik().DatePicker()
                        .Name("CreatedDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
    </fieldset>

</div>

<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ExportFormTP_KDDetailsModel>()
            .Name("gridProductInventory")
            .ToolBar(bar => bar.Template(
        @<text>
        <div class="grid_7">
            <button class="t-button" id="btnPickupProductId" name="btnPickupProductId" onclick="PickupProductId()">
                <span class='t-icon t-insert'></span>
                Select Products
            </button>
        </div>
        <div class="clear"></div>
        </text>
))
            .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                // .Select("SelectProductInventoryRotateByCustomer", "Inv",
                .Select("SelectProductInInvoice", "Inv",
                new { area = "Inv", invoiceId = 0 }))
            .Columns(columns =>
                         {
                             columns.Bound(f => f.ProductId).Title("Select").Width(75)
                                    .ClientTemplate("<input type='checkbox' name='chkProductIds' value='<#= ProductId #>' />")
                                    .HtmlAttributes(new { style = "text-align:center" });
                             columns.Bound(f => f.ProductCode)
                                    .HeaderTemplate("Product Code").Width(250);
                             columns.Bound(f => f.SentNumber)
                                    .HeaderTemplate("Delivered Quantity").Width(100)
                                    .ClientTemplate("<span name='cot3'><#= SentNumber == null ? 0 : $.telerik.formatString('{0:n0}', SentNumber) #></span>")
                                    .HtmlAttributes(new { style = "text-align: right;" });
                             columns.Bound(f => f.SentWeight)
                                    .HeaderTemplate("Weight Quantity").Width(100)
                                    .ClientTemplate("<span name='cot3'><#= SentWeight == null ? 0 : $.telerik.formatString('{0:n0}', SentWeight) #></span>")
                                    .HtmlAttributes(new { style = "text-align: right;" });
                             columns.Bound(f => f.StatusInvoice)
                                    .HeaderTemplate("Issue Invoices").Width(100)
                                    .HtmlAttributes(new { style = "text-align: center;" });
                             //columns.Bound(f => f.CustomerCode)
                             //       .HeaderTemplate("Mã Khách Hàng").Width(250);
                             //columns.Bound(f => f.TotalQtyExport)
                             //       .HeaderTemplate("Tồn kho thành phẩm");
                         })
            .Scrollable(f => f.Height("auto"))
            .Scrollable(f => f.Height(200))
            .Resizable(f => f.Columns(true))
            //.Pageable(f => f.Style(GridPagerStyles.Status))
            .ClientEvents(events => events.OnDataBinding("gridProductInInvoice_onDataBinding")
                                        .OnDataBound("gridProductInventoryDetail_onDataBound")
                                        .OnError("grid_OnError"))
            .Render();
    }
</div>
<div class="clear"></div>
<br />

<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">Returned Detail</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ExportFormTP_KDDetailsModel>()
            .Name("gridProductInventoryDetail")
            .ToolBar(bar => bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).SaveText("Save").CancelText("Cancel"))
            .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("InputProductInInvoice", "Inv",
                                                             new { area="Inv", materialIds = "", warehouseIssue = 10, warehouseReceipt = 11 })
                                                     .Update("SendBackQuantityProduct", "Orders"))
            .Columns(columns =>
                {
                    columns.Bound(f => f.ProductCode)
                           .HeaderTemplate("Product").Width(100).ReadOnly(true);
                    columns.Bound(f => f.LotNumber)
                           .HeaderTemplate("Lot").Width(100).ReadOnly(true);
                    columns.Bound(f => f.TotalQuantity).ReadOnly(true)
                           .HeaderTemplate("Inventory").Width(100)
                           .Format("{0:n0}")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    columns.Bound(f => f.SentNumber).ReadOnly(true)
                           .HeaderTemplate("Delivered Quantity").Width(100)
                           .Format("{0:n0}")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    columns.Bound(f => f.Quality)
                           .HeaderTemplate("Returned Quantity(*)").Width(100)
                           .ClientTemplate("<span name='Quality'><#= Quality == null ? 0 : $.telerik.formatString('{0:n0}', Quality) #></span>")
                           .FooterTemplate("<span id='TotalSendQuantity'></span>")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    //columns.Bound(f => f.SentWeight)
                    //       .HeaderTemplate("TL đã giao").Width(100)
                    //       .ClientTemplate("<span name='cot1'><#= SentWeight == null ? 0 : $.telerik.formatString('{0:n0}', SentWeight) #></span>")
                    //       .HtmlAttributes(new { style = "text-align: right;" }).ReadOnly(true);
                    //columns.Bound(f => f.Weight)
                    //       .HeaderTemplate("Trọng lượng trả").Width(100)
                    //       .ClientTemplate("<span name='Weight'><#= Weight == null ? 0 : $.telerik.formatString('{0:n0}', Weight) #></span>")
                    //       .FooterTemplate("<span id='TotalSendWeight'></span>")
                    //       .HtmlAttributes(new { style = "text-align: right;" });
                    columns.Bound(f => f.Note)
                           .HeaderTemplate("Reason(*)")
                           .HtmlAttributes(new { style = "text-align: left;" });
                    columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Title("").Width(30);
                })
            .ClientEvents(events => events
                                        .OnSave("gridProductInventoryDetail_onSave")
                                        .OnSubmitChanges("gridProductInventoryDetail_onSubmitChanges")
                                        .OnError("grid_OnError")
            )
            .Editable(f => f.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            // .Footer(false)
            .Resizable(f => f.Columns(true))
             .Render()
            ;
    }
</div>
