@{
    ViewBag.Title = "Duyệt Đơn Hàng ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var strSplitOrderDetails = Url.RouteUrl(new { controller = "SalesOrder", action = "SplitOrderDetails" });    
}

@section Scripts{
    <script type="text/javascript">

        var index = 0;
        var count = 0;
        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            if (dataItem.DetailStatus == 1) {
                document.getElementsByClassName("t-button t-grid-edit t-button-icon")[index - count].parentNode.innerHTML = "";
                count++;
            }
            index++;
            if (dataItem.StatusColor == 2) {
                e.row.style.backgroundColor = "#FA5858";
            }
        }

        function Grid_OnSave(e) {
            var value = e.values;
            var dueDate = value.DueDate;
            dueDate = $.telerik.formatString('{0:dd/MM/yyyy}', dueDate);
            var orderId = value.OrderId;
            e.data = $.extend(e.data, {
                orderId: orderId,
                dueDate: dueDate
            });
            index = 0;
            count = 0;
        }

        function Grid_OnDataBinding(e) {

           index = 0;
            count = 0;
        }
        function Grid_OnDelete() {

            index = 0;
            count = 0;
        }
        
        function GridDetail_OnSave(e) {
            var value = e.values;
            var vfiDueDate = value.VFIDueDate;
            vfiDueDate = $.telerik.formatString('{0:dd/MM/yyyy}', vfiDueDate);
            var orderDetailId = value.OrderDetailId;
            var orderId = value.OrderId;
            e.data = $.extend(e.data, {
                orderId: orderId,
                orderDetailId: orderDetailId,
                vfiDueDate: vfiDueDate
            });
        }
        function SplitOrderDetails(orderId) {
            var $detailIds = $("input[name='chkOrderDetailIds']:checked");
            if ($detailIds.length == 0) {
                alert("Vui lòng chọn SP nhân bản");
                return false;
            }
            var ids = {};
            for (var i = 0; i < $detailIds.length; i++) {
                ids[i] = $detailIds[i].value;
            }
            try {
                $.ajax({
                    type: 'post',
                    data: {
                        orderId: orderId,
                        orderDetailIds: ids,
                    },
                    dataType: 'json',
                    url: '@Url.Action("SplitOrderDetails", "SalesOrder")',
                    timeout: 20000,
                    success: function (data) {
                        //alert(data);
                        if (data == 1) {
                            alert("Tách thành công!");
                            $('#gridProduct').data('tGrid').ajaxRequest();
                        } else if (data == 0) {
                            alert("Không tách được đơn hàng");
                        } else if (data == 2) {
                            alert("Không được chọn tách tất cả chi tiết");
                        }
                        //else if (data == 2) {
                        //    $('#lookupTransactionCodeExisted').attr('class', 'imgUnAvailable');
                        //    $('#txtTransactionCodeHidden').val(0);
                        //}
                    }
                });
            } catch (err) { alert("Co Loi !"); }
            return false;
        }
        function GridDetail_OnDataBinding() {
            indexDetail = 0;
            countDetail = 0;
            indexApprove = 0;
            countApprove = 0;
        }
        var indexDetail = 0;
        var countDetail = 0;
        var indexApprove = 0;
        var countApprove = 0;
        function GridDetail_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            //if (dataItem.IsProductionManager != 1 ) {
            //    e.currentTarget.getElementsByClassName("t-button t-grid-edit t-button-icon")[indexDetail - countDetail].parentNode.innerHTML = "";
            //    countDetail++;
            //}
            //indexDetail++;
            if (dataItem.StatusColor == 2) {
                e.row.style.backgroundColor = "#FA5858";
            }
            if (dataItem.ApproveType== false) {
                e.currentTarget.getElementsByClassName("t-button t-grid-edit t-button-icon")[indexApprove - countApprove].parentNode.innerHTML = "";
                countApprove++;
            }
            indexApprove++;
        }
    </script>
}

