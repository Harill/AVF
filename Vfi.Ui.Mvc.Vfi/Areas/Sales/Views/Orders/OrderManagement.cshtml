                Print Delivery-Schedule
               @* In Lịch Giao Hàng*@
            </button>
        </div>
        <div class="clear"></div>
        <br />

        <fieldset>
            <legend>Filters</legend>
            <div class="grid_2_5">
                Customer Code
                <br />
                (Have Orders)
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCode")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div style="float: left">
