@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@*@model Vfi.Ui.Mvc.Vfi.Areas.Sales.Models.OrderModel*@
@{
    ViewBag.Title = "Orders Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        function grid_onDataBinding(args) {

            var activeValue = $("#Active").data("tComboBox").value();
            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;
            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }

            var productCode = $("#ProductCode").data("tAutoComplete").value();
            var chkAll = $("input[name='chkAll']").attr('checked');
            //    if (customerId == 0)
            //        customerId = 0;

            args.data = $.extend(args.data,
            {
                productCode: productCode,
                employeeId: 0,
                fromDate: fromDate,
                toDate: toDate,
                active: activeValue,
                status: statusValue,
                chkAll: chkAll
            });
            index = 0;
        }

        function active_onChange() {
            var activeValue = $("#Active").data("tComboBox").value();
            if (activeValue === "2") {
                $("#Status").data("tComboBox").value("");
                $("#Status").data("tComboBox").enable();
            } else {
                $("#Status").data("tComboBox").value("");
                $("#Status").data("tComboBox").disable();
            }
            RefreshGrid("gridOrder");
        }

        function status_onChange() {
            RefreshGrid("gridOrder");
        }

        function active_onload() {
            var combobox = $('#Active').data('tComboBox');
            var dataSource =
            [
                { Text: "Not Approve", Value: "1" },
                { Text: "Approved", Value: "2" },
                { Text: "Cancel", Value: "3" }
            ];

            combobox.dataBind(dataSource);
        }

        function status_onload() {
            var combobox = $('#Status').data('tComboBox');
            var dataSource =
            [
                { Text: "Not Delivery", Value: "1" },
                { Text: "Delivered", Value: "2" },
                { Text: "Cancel", Value: "3" }
            ];

            combobox.dataBind(dataSource);
        }

        function month_onLoad() {
            var combobox = $('#Month').data('tComboBox');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            if (new Date().getMonth() === "12")
                combobox.value = "1";
            else combobox.value(new Date().getMonth() + 1);
        }

        function PrintOrderPlan() {

            var month = $('#Month').data('tComboBox').value();
            var year = $('#Year').data('tAutoComplete').text();

            $('#result').load('@Url.Action("PrintOrderPlan", "Inv", new {area = "Inv"})',
                {
                    month: month,
                    year: year
                },
                function() {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function Grid_OnRowDataBound(e) {
            //var dataItem = e.dataItem;
            if (e.dataItem.StatusName === "Đang giao") {
                e.row.childNodes[6].bgColor = "#F4FA58";
                //e.row.style.backgroundColor = "#F4FA58";
            }

            var today = new Date();
            var check = e.dataItem.DueDate < today;
            if (check) {
                e.row.childNodes[3].bgColor = "#FA5858";
                //e.row.style.backgroundColor = "#FA5858";
            }
            if (!e.dataItem.CanCreateWorkOrder) {
                e.row.getElementsByClassName("t-button workorder_" + e.dataItem.OrderId)[0].parentNode.innerHTML = "";
            }
        }

        function gridDetail_OnRowDataBound(e) {
            if (e.dataItem.IsSaleManager !== 1 || e.dataItem.OrderQty !== e.dataItem.RequiredNumber) {
                e.row.childNodes[0].innerHTML = "";
            }
        }

        var index = 0;

        function CreateWorkOrder(id) {
            var message = "Create work order";
            message += "\nYes ??";
            if (confirm(message)) {
                $.ajax({
                    type: 'post',
                    data: { orderId: id },
                    dataType: 'json',
                    url: '@Url.Action("CreateWorkOrder", "Orders", new { area = "Sales" })',
                    timeout: 20000,
                    success: function (res) {
                        if (res.Code === 1) {
                            if (res.Message && res.Message != "") {
                                alert(res.Message);
                            }
                            RefreshGrid("gridOrder");
                        } else {
                            alert("Lỗi! " + res.Message);
                        }
                    }
                });
            } else {
            }
        }
    </script>
}

<div class="title">Orders-Information Management
    @*Quản lý thông tin đơn hàng*@</div>
