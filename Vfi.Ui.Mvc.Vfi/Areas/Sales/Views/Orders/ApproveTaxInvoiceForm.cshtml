@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@{
    ViewBag.Title = "Approve Tax-Invoice ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">

        function Grid_OnDataBinding(args) {

            var month = $('#Month').data('tComboBox').value();
            var year = $('#Year').data('tAutoComplete').text();

            args.data = $.extend(args.data, {
                month: month,
                year: year
            });
        }

        function grid_OnRowDataBound(e) {
            if (e.dataItem.Quantity > e.dataItem.Receive)
                e.row.childNodes[3].style.backgroundColor = "#F4FA58";
        }

        function Grid_OnDelete(e) {
            var month = $('#Month').data('tComboBox').value();
            var year = $('#Year').data('tAutoComplete').text();
            e.values = $.extend(e.values, {
                month: month,
                year: year,
            });
        }

        function month_onLoad() {
            var combobox = $('#Month').data('tComboBox');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            if (new Date().getMonth() === 12)
                combobox.value = "1";
            else combobox.value(new Date().getMonth() + 1);
        }
    </script> 
 
}

<div class="title">Approve Tax-Invoice </div>
<div>
    <div class="grid_1">
        @Html.Label("Month")
    </div>
    <div class="grid_2">
        @{
            Html.Telerik().ComboBox()
                .Name("Month")
                .HtmlAttributes(new { style = "width: 40px" })
                .DropDownHtmlAttributes(new { style = "width: 40px" })
                //.Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                // .HighlightFirstMatch(true)
                //.AutoFill(true)
                .ClientEvents(events => events.OnLoad("month_onLoad"))
                .Render();
        }
    </div>

    <div class="grid_1">
        @Html.Label("Year")
    </div>
    <div class="grid_2">

        @{
            Html.Telerik().AutoComplete()
                .Name("Year")
                .Value(DateTime.Now.Year + "")
                .HtmlAttributes(new { style = "width: 40px" })
                .Render();
        }
    </div>
    <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid('gridTaxInvoice'); ">
        <span class='t-icon t-insert'></span>
       Find
    </button>
</div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<TaxInvoiceModel>()
            .Name("gridTaxInvoice")
            .DataKeys(key => key.Add(f => f.TaxInvoiceId).RouteKey("taxInvoiceId"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectTaxInvoiceWaiting", "SalesOrder", new { area = "Sales", month = DateTime.Now.Month, year = DateTime.Now.Year })
                                   //.Update("UpdateTaxInvoice", "Orders", new {area = "Sales"})
                                          .Delete("CancelTaxInvoice", "SalesOrder", new { area = "Sales", month = DateTime.Now.Month, year = DateTime.Now.Year }))
            .Columns(columns =>
                {
                    //columns.Command(command =>
                    //                command.Edit().ButtonType(GridButtonType.ImageAndText).UpdateText("Duyệt").CancelText("Bỏ")
                    //    ).Width(98).Title("").HtmlAttributes(new {style = "text-align:center"});

                    columns.Bound(f => f.TaxInvoiceList).Title("Invoice").Width(125).ReadOnly(true);
                    columns.Bound(f => f.SetupDate).Title("Create Date").Width(100)
                           .ClientTemplate("<#= SetupDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', SetupDate) #>");
                    //columns.Bound(f => f.InvoiceNumber).Width(75).ReadOnly(true).Title("Số Invoice");
                    //columns.Bound(f => f.PoNumber).Width(125).ReadOnly(true);
                    columns.Bound(f => f.CustomerCode).Title("Customer Code").Width(75).ReadOnly(true);
                    columns.Bound(f => f.CurrencyCode).Title("Currency").Width(65).ReadOnly(true);
                    columns.Bound(f => f.Tax).Title("Tax(%)").Width(75).ReadOnly(true);
                    columns.Bound(f => f.ExchangeRate).Title("Rate").Width(65).ReadOnly(true);
                    columns.Bound(f => f.TotalQuantity).Width(90).ReadOnly(true).Title("Total Quantity")
                           .HtmlAttributes(new {style = "text-align: right;"})
                           .ClientTemplate("<#= TotalQuantity == null ? 0 : $.telerik.formatString('{0:n0}', TotalQuantity) #>");
                    columns.Bound(f => f.TotalAmount).Width(100).ReadOnly(true).Title("Total Amount+(%)")
                           .HtmlAttributes(new {style = "text-align: right;"})
                           .ClientTemplate("<#= TotalAmount == null ? 0 : $.telerik.formatString('{0:n2}', TotalAmount) #>");
                    columns.Bound(f => f.TotalAmountVND).Width(100).ReadOnly(true).Title("Total Amount VND+(%)")
                           .HtmlAttributes(new {style = "text-align: right;"})
                           .ClientTemplate("<#= TotalAmountVND == null ? 0 : $.telerik.formatString('{0:n2}', TotalAmountVND) #>");
                    columns.Bound(f => f.ModifiedDate).Width(100).ReadOnly(true).Title("M-Date")
                           .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm:ss}', ModifiedDate) #>");
                    //columns.Bound(f => f.ExportId).Title("In").Width(45).ReadOnly(true)
                    //       .ClientTemplate("<input type='button' id='id_<#= ExportId #>' value='In' class='t-button' min-width='20px' onclick=PrintInvoiceForm(<#= ExportId #>) />")
                    //       .HtmlAttributes(new {style = "text-align:center"});
                    columns.Command(command => command.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image))
                           .Width(50).Title("Cance;").HtmlAttributes(new {style = "text-align:center;color:red"});
                })
            .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("TabStrip_<#= TaxInvoiceId #>")
                    .SelectedIndex(0)
                    .Items(items =>
                           items.Add().Text("Detail").Content(

                               Html.Telerik().Grid<InvoiceDetailTempModel>()
                                   .Name("gridTaxInvoiceProduct_<#= TaxInvoiceId #>")
                                   .DataKeys(key => key.Add(f => f.DetailId).RouteKey("DetailId"))
                                   .DataBinding(dataDindings =>
                                                dataDindings.Ajax()
                                                            .Select("SelectTaxInvoiceProductById", "SalesOrder", new {area = "Sales", taxInvoiceId = "<#= TaxInvoiceId #>"})
                                                            .Delete("CancelTaxInvoiceProduct", "SalesOrder", new {area = "Sales"})
                                   )
                                   .Columns(columns =>
                                       {
                                           columns.Bound(f => f.ProductCode).Title("Product Code").Width(50).ReadOnly(true);
                                           //columns.Bound(f => f.OrderNumber).Title("Số ĐH").Width(50).ReadOnly(true);
                                           columns.Bound(f => f.Quantity).Width(70).ReadOnly(true).Title("Quantity")
                                                  .HtmlAttributes(new {style = "text-align: right;"})
                                                  .Format("{0:n0}");
                                           columns.Bound(f => f.Receive).Width(70).ReadOnly(true).Title("Entried")
                                                  .HtmlAttributes(new {style = "text-align: right;"})
                                                  .Format("{0:n0}");
                                           columns.Bound(f => f.UnitPriceFormat).ReadOnly(true).Width(50).Title("Unit Price")
                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                           columns.Bound(f => f.AmountFormat).Width(70).Title("Total Amount").ReadOnly(true)
                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                           columns.Command(command =>
                                                           command.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)
                                               ).Width(40).Title("").HtmlAttributes(new {style = "text-align:center"});
                                       })
                                   .DetailView(details2 => details2.ClientTemplate(
                                       //Html.Telerik().TabStrip()
                                       //    .Name("TabStrip_<#= TaxInvoiceId #>")
                                       //    .SelectedIndex(0)
                                       //    .Items(items2 =>
                                       //           items2.Add().Text("Thông tin chi tiết").Content(

                                       Html.Telerik().Grid<InvoiceDetailTempModel>()
                                           .Name("gridTaxInvoiceProductDetail_<#= DetailId #>")
                                           .DataKeys(key => key.Add(f => f.DetailId).RouteKey("DetailId"))
                                           .DataBinding(dataDindings =>
                                                        dataDindings.Ajax()
                                                                    .Select("SelectTaxInvoiceProductDetailById", "SalesOrder", new {area = "Sales", detailId = "<#= DetailId #>"})
                                                                    .Delete("CancelTaxInvoiceProductDetail", "SalesOrder", new {area = "Sales"})
                                           )
                                           .Columns(columns =>
                                               {
                                                   columns.Bound(f => f.ProductCode).Title("Product Code").Width(50).ReadOnly(true);
                                                   //columns.Bound(f => f.OrderNumber).Title("Số ĐH").Width(50).ReadOnly(true);
                                                   columns.Bound(f => f.InvoiceNumber).Title("Invoice ").Width(50).ReadOnly(true);
                                                   columns.Bound(f => f.ExportedDate).Title("Release Date").Width(50).ReadOnly(true)
                                                          .ClientTemplate("<#= ExportedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ExportedDate) #>");
                                                   columns.Bound(f => f.Quantity).Width(70).ReadOnly(true).Title("Quantity")
                                                          .HtmlAttributes(new {style = "text-align: right;"})
                                                          .Format("{0:n0}");
                                                   columns.Bound(f => f.UnitPriceFormat).ReadOnly(true).Width(50).Title("Unit Price")
                                                          .HtmlAttributes(new {style = "text-align: right;"});
                                                   columns.Bound(f => f.AmountFormat).Width(70).Title("Total Amount").ReadOnly(true)
                                                          .HtmlAttributes(new {style = "text-align: right;"});
                                                   columns.Command(command =>
                                                                   command.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)
                                                       ).Width(40).Title("").HtmlAttributes(new {style = "text-align:center"});
                                               })
                                           .ClientEvents(e => e.OnError("grid_OnError"))
                                           .ToHtmlString())
                                   //.ToHtmlString())
                                   )
                                   .Selectable()
                                   .ClientEvents(e => e.OnError("grid_OnError")
                                                       .OnRowSelect("grid_OnRowSelect")
                                                       .OnRowDataBound("grid_OnRowDataBound"))
                                   .ToHtmlString()
                               ))
                    .ToHtmlString()))
            .Selectable()
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
            .ClientEvents(events => events.OnRowSelect("grid_OnRowSelect")
                                          .OnDelete("Grid_OnDelete")
                                          .OnDataBinding("Grid_OnDataBinding")
                                          .OnError("grid_OnError"))
            .Scrollable(f => f.Height(500))
            //.HtmlAttributes(new {style = "width: 950px;"})
            .Sortable()
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
            .Scrollable()
            .Render();
    }
</div>

