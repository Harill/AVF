@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models

@{
    ViewBag.Title = "Employee Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
<script type="text/javascript">
    function gridEmploye_onEdit(e) {
        //var dataItem = e.dataItem;
        //var mode = e.mode;
        //var form = e.form;

        var employeeCode = $(form).find('#EmployeeCode');
        if (mode == 'insert') {
            employeeCode.attr("style", "color: blue;");
        }
        if (mode == 'edit') {
            //employeeCode.attr("readonly", "readonly");
            employeeCode.attr("style", "color: red;");
        }
    }

</script>
}
<div class="title">Employee Information</div>

<div class="cover-div">
@{
    Html.Telerik().Grid<EmployeeModel>()
        .Name("gridEmployee")
        .DataKeys(keys => keys.Add(f => f.EmployeeId).RouteKey("employeeId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert().Text("Add new Employee").ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).Text("Add New").ImageHtmlAttributes(new { style = "margin-left:0" }))
        .DataBinding(dataBindings=>dataBindings.Ajax()
            .Select("SelectEmployee","Employee")
            .Insert("InsertEmployee","Employee")
            .Update("UpdateEmployee","Employee")
        )
        .Columns(columns=>
        {
            columns.Command(command =>
                command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image).UpdateText("Update").CancelText("Cancel")
            ).Width(70).Title("Commands").HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.EmployeeCode).Width(110);
            columns.Bound(f => f.EmployeeName).Width(200);
            columns.Bound(f => f.Active).Width(100).Title("Business")                                                                // Kinh doanh
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.Production2).Width(100).Title("Production2")                                                                               //NV SX2
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Production2' <#=Production2? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.Production2B).Width(100).Title("Production2B")                                                //NV SX2B
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Production2B' <#=Production2B? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.Repair).Width(110).Title("Machine-Repair")                                                              //Sửa máy
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Repair' <#=Repair? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.QcLine).Width(100).Title("Qc Line") 
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Repair' <#=QcLine? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.GroupName).Title("Team");
            columns.Bound(f => f.UserName).Title("User Name");              //LK ACC
            columns.Bound(f => f.ModifiedDate).Width(125).Title("M-Date").Format("{0:dd/MM/yyyy HH:mm}").ReadOnly(true);
            columns.Bound(f => f.ModifiedUser).Width(100).Title("M-User").ReadOnly(true);
        })
        .ClientEvents(events => events.OnEdit("gridEmploye_onEdit").OnError("grid_OnError"))
        .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
        //.Pageable(page => page.PageSize(10))
                .Scrollable(f => f.Height(510))
        .Sortable()
        .Render();  
}
</div>