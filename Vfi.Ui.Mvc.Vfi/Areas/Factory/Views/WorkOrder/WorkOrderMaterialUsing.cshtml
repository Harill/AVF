@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "WO NL SD";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        function grid_OnDataBinding(args) {
            var date = $("#PrintDate").data("tDatePicker").value();
            if (date === null) date = "";
            else date = $.telerik.formatString('{0:dd/MM/yyyy}', date);
            
            var machine = $("#Machine").data("tComboBox").value();
            if (machine == "") machine = 0;

            args.data = $.extend(args.data, {
                date: date,
                machineId: machine
            });
        }

        function printWOMaterialUse() {
            if (!onLoading) {
                OnLoadingData();
                var printDate = $("#PrintDate").data("tDatePicker").value();
                if (printDate === null)
                    printDate = new Date();
                else
                    printDate = $.telerik.formatString('{0:dd/MM/yyyy}', printDate);
                $('#result').load('@Url.Action("PrintWOMaterialUse", "WorkOrder", new { area = "Factory" })',
                    {
                        date: printDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }
    </script>
    <script type="text/javascript">
        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }
    </script>
}

<div class="title">Phát nguyên liệu cho Work Order</div>

<div class="t-info-sha" style="padding-left: 15px;padding-right: 15px;">
    
        <button id="btnPrintUsing" class="t-button" onclick="printWOMaterialUse();">
            <span class='t-icon t-insert'></span>
            In sử dụng nguyên liệu
            <span class="twoToneButton"></span>
        </button>
        <div class="clear"></div><br />

    <fieldset>
        <legend>Thông tin lọc</legend> 
        <div class="grid_1">
            Máy
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().ComboBox()
                    .Name("Machine")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMachine", "Machine", new { area = "Factory" }))
                    .DropDownHtmlAttributes(new { style = "width: 100%; " })
                        .HtmlAttributes(new { style = "width: 100%; " })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>
        
        <div class="grid_1">Ngày</div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("PrintDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
        <div class="grid_3">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('grid'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
        </div>
    </fieldset>
</div>
<div class="clear"></div>
<br />
<div class="cover-div">
    @{
        Html.Telerik().Grid<MaterialInvOnMachineModel>()
            .Name("grid")
            .DataKeys(key => key.Add(f => f.Id).RouteKey("id"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectWorkOrderMaterialUse", "WorkOrder", new { area = "Factory", date = "", machineId = 0 })
           )
            .Columns(columns => {
                columns.Bound(f => f.MachineName).Title("Máy").Width(100).ReadOnly(true);
                columns.Bound(f => f.ProductCode).Title("Sản phẩm").Width(150).ReadOnly(true);
                columns.Bound(f => f.MaterialDesign).Title("Nguyên liệu").Width(270).ReadOnly(true);
                columns.Bound(f => f.Note).Title("Work Order").Width(100).ReadOnly(true);
                columns.Bound(f => f.EarlyQuantity).Title("Tồn đầu</br>(cây)").Width(70).ReadOnly(true)
                    .Aggregate(agg => agg.Sum())
                    .Format("{0:n1}")
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n1}', Sum) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n1}', Sum) #>")
                    .HtmlAttributes(new { style = "text-align: right;border-right:1px black solid" })
                    .FooterHtmlAttributes(new { style = "text-align: right;border-right:1px black solid" });
                columns.Bound(f => f.QuantityUse1).Title("Sử dụng</br>ca 1(cây)").Width(70).ReadOnly(true)
                    .Aggregate(agg => agg.Sum())
                    .Format("{0:n1}")
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n1}', Sum) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n1}', Sum) #>")
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .FooterHtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.QuantityUse2).Title("Sử dụng</br>ca 2(cây)").Width(70).ReadOnly(true)
                    .Aggregate(agg => agg.Sum())
                    .Format("{0:n1}")
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n1}', Sum) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n1}', Sum) #>")
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .FooterHtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.LastQuantity).Title("Tồn cuối</br>(cây)").Width(70).ReadOnly(true)
                    .Aggregate(agg => agg.Sum())
                    .Format("{0:n1}")
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n1}', Sum) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n1}', Sum) #>")
                    .HtmlAttributes(new { style = "text-align: right;border-left:1px black solid" })
                    .FooterHtmlAttributes(new { style = "text-align: right;border-left:1px black solid" });

            })
            .Selectable()
            .Editable(editing => editing.Mode(GridEditMode.InLine))
            .ClientEvents(e => e.OnError("grid_OnError")
                                .OnDataBinding("grid_OnDataBinding"))
            .Scrollable(f => f.Height("auto"))
            .Sortable()
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
            .Scrollable()
            .Render();
    }
</div>

<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
        )
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

<style type="text/css">
    #windowReport {
        /*
            float: right;
            Position: relative;
            */
        min-height: 580px;
        top: 15%;
    }

    #result {
        height: 520px;
        overflow: hidden;
    }

    #ReportBody {
        padding-bottom: 25px;
        margin-bottom: 25px;
    }

    .tb-witdh td {
        width: 55px;
    }
</style>
