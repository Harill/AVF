@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Xuất gia công ngoài";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .fieldheader {
        /*height: 150px;*/
        padding-left: 15px;
        padding-right: 15px;
        float: left;
    }

    .fieldheader1 {
        width: 35%;
        min-width: 420px;
        margin-right: 10px;
    }

    .fieldheader2 {
        width: 20%;
        margin-right: 10px;
    }

    .fieldheader3 {
        width: 35%;
    }
</style>
@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnProcess.js")"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            loadEmployeeLogin();
        });

        function loadEmployeeLogin() {
            $.ajax({
                type: 'post',
                data: {},
                dataType: 'json',
                url: '@Url.Action("GetComboBoxEmployeeLogin", "Employee", new { area = "Sales" })',
                timeout: 20000,
                success: function (data) {
                    //a
                    var cbo = $('#Employee').data('tComboBox');
                    cbo.dataBind(data);
                    if (cbo.selectedIndex > -1) {

                        var selected = cbo.data[cbo.selectedIndex];

                        if (selected != undefined) {
                            cbo.value(selected.Value);
                            cbo.text(selected.Text);
                            cbo.selectedIndex = cbo.selectedIndex;
                            cbo.previousValue = selected.Value;
                        } else {
                            cbo.value(-1);
                            cbo.text("");
                        }
                    } else {
                        cbo.value(-1);
                        cbo.text("");
                    }
                }
            });
        }

        function grid_OnSave(e) {

            var $platingCode = $(e.cell).find('#PlatingCode');
            if ($platingCode.length > 0) {
                var platingCode = $platingCode.data("tComboBox"),
                    platingCodeSelectItem = platingCode.selectedIndex > -1 ? platingCode.data[platingCode.selectedIndex] : null;

                if (platingCodeSelectItem) {
                    e.values["PlatingCode"] = platingCodeSelectItem.Text;
                    e.values["PlatingId"] = platingCodeSelectItem.Value;
                }
            }
        }

        function grid_OnSubmitChanges(e) {
            if (!onProcessing) {
                OnProcessingData();
                var vendor = $("#Vendor").data('tComboBox').value();
                if (vendor === "") vendor = 0;
                var employee = $("#Employee").data('tComboBox').value();
                if (employee === "") employee = 0;
                var currencyCode = $('#CurrencyCode').data('tDropDownList').value();
                var platingType = $('#PlatingType').data('tDropDownList').value();
                if (platingType === "") platingType = 0;
                var exchangeRate = $("#ExchangeRate").val();
                var processDate = $("#ExportDate").data("tDateTimePicker").value();
                if (processDate === null)
                    processDate = "";
                else
                    processDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', processDate);
                var note = $('#Note').val();
                if (employee === 0 || vendor === 0 || platingType === 0 || currencyCode === '') {
                    alert("Vui lòng điền đủ thông tin: NCC, loại gia công, nhân viên, tiền tệ ");
                    OnProcessedData();
                    e.preventDefault();
                }
                else if (currencyCode !== 'VND' && exchangeRate <= 1) {
                    alert("Vui lòng điền đủ thông tin: tiền tệ, tỉ giá");
                    OnProcessedData();
                    e.preventDefault();

                }
                else {
                    e.values = $.extend(e.values, {
                        employeeId: employee,
                        vendorId: vendor,
                        platingType: platingType,
                        currencyCode: currencyCode,
                        exchangeRate: exchangeRate,
                        processDate: processDate,
                        note: note
                    });
                }
            } else {
                e.preventDefault();
            }
        }

        function grid_OnDataBound() {
            OnProcessedData();
        }

        function grid_OnEdit(e) {
            productId = e.dataItem.ProductId;
        }

        var productId = 0;
        function plating_OnDataBinding(e) {
            //alert(e);
            //var productId = e.currentTarget.value;
            e.data = $.extend(e.data, {
                productId: productId
            });
        }

    </script>

}

<div class="title">Xuất gia công ngoài</div>
<div class="clear"></div>
<br />

<div class="t-info-sha fieldheader fieldheader1">
    <fieldset>
        <legend>Thông tin Work Order</legend>
        <div class="grid_3">Chọn NCC</div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("Vendor")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxPlatingVendor", "Vendor", new { area = "Purchasing" })
                    .Delay(350))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .Render();
            }
        </div>
        <div class="grid_3_5">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshCombobox('Vendor'); ">
                <span class='t-icon t-refresh'></span>
                <span class="loadButton"></span>
            </button>
        </div>
        <div class="clear"></div>
            
        <div class="grid_3">Loại gia công</div>
           <div class="grid_4">
            @{
                Html.Telerik().DropDownList()
                    .Name("PlatingType")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxPlatingType", "PurchaseOrder", new { area = "Purchasing" }))
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Render();
            }
        </div> 
        <div class="clear"></div>
        <div class="grid_3">Ngày xuất kho</div>
        <div class="grid_4">
            @{
                Html.Telerik().DateTimePicker()
                    .Name("ExportDate")
                    .Format("dd/MM/yyyy HH:mm")
                    .Value(DateTime.Now)
                    .Render();
            }
        </div>
    </fieldset>
</div>

<div class="t-info-sha fieldheader fieldheader2">
    <fieldset>
        <legend>Ghi chú</legend>
        <div>@Html.TextArea("Note", new  { style="min-width: 265px; min-height: 56px;" })</div>
    </fieldset>
</div>

<div class="t-info-sha fieldheader fieldheader3">
    <fieldset>
        <legend>Thông tin</legend>
        <div class="grid_2">Nhân viên</div>
        <div class="grid_4">
            @{
                    Html.Telerik().ComboBox()
                        .Name("Employee")
                        //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxEmployee", "Employee", new { area = "Sales" }).Delay(350))
                        .HtmlAttributes(new { style = "width: 100%" })
                        //.DropDownHtmlAttributes(new { style = "width: 150px" })
                        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .Render();
                }
        </div>
        <div class="clear"></div>
        
        <div class="grid_2">Tiền tệ</div>
        <div class="grid_4">
            @{
                Html.Telerik().DropDownList()
                    .Name("CurrencyCode")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCurrency", "Currency", new { area = "" }))
                    .DropDownHtmlAttributes(new { style = "width: 150px" })
                    .SelectedIndex(3)
                    .Render();
            }
        </div> 
        <div class="clear"></div>
        <div class="grid_2">Tỉ giá</div>
        <div class="grid_2">
             @{
                    Html.Telerik().NumericTextBox()
                        .Name("ExchangeRate")
                        .Value(1)
                        .MinValue(1)
                        .DecimalDigits(0)
                        .HtmlAttributes(new { style = "width: 100%" })
                        .InputHtmlAttributes(new { style = "width: 100%" })
                        .Render();
                }
            </div>
    </fieldset>
</div>

<div class="clear"></div>
<br />

<div class="cover-div">
    @{
        Html.Telerik().Grid<WorkOrderRoutingModel>()
            .Name("grid")
            .ToolBar(bar => bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu lại").CancelText("Huỷ bỏ"))
            .DataKeys(keys => keys.Add(f => f.RoutingId).RouteKey("routingId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectWorkOrderPlatingProcess", "WorkOrder", new { area = "Factory" })
                .Update("CreateWorkOrderPlatingExport", "WorkOrder", new { area = "Factory" })
                )
            .Columns(columns => {

                columns.Bound(f => f.CanAdd).Width(50).Title("Chọn")
                    .HeaderHtmlAttributes(new { @class = "edit-column" })
                    .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsRotateAll_<#= RoutingId #>' class='IsRotateAll_<#= RoutingId #>' <#=CanAdd? checked='checked' : '' #> />")
                    .HtmlAttributes(new { style = "text-align: center;" });

                columns.Bound(f => f.SerialNumber).Width(80).HeaderTemplate("Số</br>WO").ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .HtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.ProductCode).Width(100).HeaderTemplate("Mã</br>SP").ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .HtmlAttributes(new { style = "text-align: center;border-right: 1px solid black;" });

                columns.Bound(f => f.PlatingCode).Width(90).HeaderTemplate("Mã</br>gia công")
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.Thickness).Width(75).HeaderTemplate("Độ dày</br>(µm)")
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.SaltSprayTime).Width(75).HeaderTemplate("Phun muối</br>(h)")
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.SpecialRequest).Width(75).Title("Yêu cầu")
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.Sample).Width(75).Title("Mẫu SP")
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.TestingEquipment).Width(75).Title("Thiết bị KT")
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .HtmlAttributes(new { style = "border-right: 1px solid black;" });
                
                columns.Bound(f => f.ProductWeight).Width(70).HeaderTemplate("TL</br>SP</br>(g/pc)").ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n4}")
                    .HtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.PlannedCost).Width(70).HeaderTemplate("SL</br>tồn</br>(pcs)").ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.PlannedWeight).Width(70).HeaderTemplate("TL</br>tồn</br>(g)").ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;border-right: 1px solid black;" });
                columns.Bound(f => f.GoodQuantity).Width(80).HeaderTemplate("Số lượng</br>xuất</br>(pcs)")
                    .HeaderHtmlAttributes(new { @class = "good-column", style = "text-align: center;" })
                    .Format("{0:n0}")
                    .ClientTemplate("<span class='GoodQuantity'><#=  $.telerik.formatString('{0:n0}', GoodQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.GoodWeight).Width(80).HeaderTemplate("Trọng lượng</br>xuất</br>(g)")
                    .HeaderHtmlAttributes(new { @class = "good-column", style = "text-align: center;" })
                    .Format("{0:n0}")
                    .ClientTemplate("<span class='GoodWeight'><#=  $.telerik.formatString('{0:n0}', GoodWeight) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.NGQuantity).Width(80).HeaderTemplate("Hàng</br>CPL</br>(pcs)")
                    .HeaderHtmlAttributes(new { @class = "ng-column", style = "text-align: center;" })
                    .Format("{0:n0}")
                    .ClientTemplate("<span class='NGQuantity'><#=  $.telerik.formatString('{0:n0}', NGQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.DefectQuantity).Width(80).HeaderTemplate("Phế phẩm</br>(pcs)")
                    .HeaderHtmlAttributes(new { @class = "defect-column", style = "text-align: center;" })
                    .Format("{0:n0}")
                    .ClientTemplate("<span class='DefectQuantity'><#=  $.telerik.formatString('{0:n0}', DefectQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.Unit).Width(50).Title("ĐVT")
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.UnitPrice).Width(80).Title("Đơn</br>giá")
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.Note).Title("Ghi</br>chú")
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.ProductInvId).Hidden(true);
                
            })
            .Editable(editing => editing.Mode(GridEditMode.InCell))
            .ClientEvents(events => events
                .OnSave("grid_OnSave")
                .OnEdit("grid_OnEdit")
                .OnDataBound("grid_OnDataBound")
                .OnSubmitChanges("grid_OnSubmitChanges")
                .OnError("grid_OnError")
            )
            .Groupable(group => group.Groups(g => g.Add(model => model.ProductCode)))
            .KeyboardNavigation()
            .Render();   
    }
</div>

<div class="clear"></div><br />