@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Confirm Outsourcing Command ";
    //Nhận gia công ngoài
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnProcess.js")"></script>
    <script type="text/javascript">

        function grid_OnSave(args) {
            if (!onProcessing) {
                var processDate = $("#ProcessDate").data("tDateTimePicker").value();
                if (processDate === null)
                    processDate = "";
                else
                    processDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', processDate);

                args.values = $.extend(args.values,
                    {
                        processDate: processDate
                    }
                );
                OnProcessingData();
            }
        }
        function grid_OnDataBound() {
            OnProcessedData();
        }
        function grid_OnDelete(e) {
            var message = "Hủy tiếp nhận: " + e.dataItem.RoutingFullName;
            message += "\nĐồng ý ??";
            if (confirm(message)) {
                // Save it!
            } else {
                e.preventDefault();
            }
        }
        function grid_OnRowDataBound(e) {
            if (!e.dataItem.CanCancel) {
                e.row.getElementsByClassName("t-button t-grid-delete t-button-icon")[0].parentNode.innerHTML = "";
            }
        }
    </script>
}
<div class="title">Confirm Outsourcing Command</div>

<div class="t-info-sha" style="padding-left: 15px; width: 550px; color: Maroon;">WO Sheet<span class="processButton"></span>
<div class="grid_5">
    @{
            Html.Telerik().DateTimePicker()
                .Name("ProcessDate")
                .Format("dd/MM/yyyy HH:mm")
                .Value(DateTime.Now)
                .Render();
        }
</div>
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<WorkOrderRoutingModel>()
            .Name("grid")
            .DataKeys(keys => keys.Add(f => f.RoutingId).RouteKey("routingId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectWorkOrderPlatingConfirmation", "WorkOrder", new { area = "Factory" })
                .Update("ConfirmWorkOrderPlating", "WorkOrder", new { area = "Factory" })
                .Delete("RejectWorkOrder", "WorkOrder", new {
                    area = "Factory",
                    config = new RoutingConfiguration { IsPlating = true }
                })
            )
            .Columns(columns => {
                columns.Command(command => command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(50).Title("Confirm")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.SerialNumber).Title("Work Order").Width(100).ReadOnly(true)
                       .HtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.LastRouteFinishDate).Width(85).Title("End-Date</br>Previous Section").ReadOnly(true)
                       .ClientTemplate("<#= LastRouteFinishDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', LastRouteFinishDate) #>")
                       .HtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.ProductCode).Title("Product").Width(150).ReadOnly(true)
                       .HtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.RoutingName).Title("Section").Width(200).ReadOnly(true);
                columns.Bound(f => f.PlannedCost).Title("Quantity</br>(pcs)").Width(70).ReadOnly(true)
                       .HeaderHtmlAttributes(new { @class = "good-column" })
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.PlannedWeight).Title("Weight</br>(g)").Width(70).ReadOnly(true)
                       .HeaderHtmlAttributes(new { @class = "good-column" })
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.MaterialInvCode).Title("Material").Width(170).ReadOnly(true)
                       .HtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.MoreInfo).Title("Note").ReadOnly(true);
                columns.Command(c => c.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Title("Return</br>WO").Width(35);
            })
            .Selectable()
            .ClientEvents(events => events
                .OnRowSelect("grid_OnRowSelect")
                .OnSave("grid_OnSave")
                .OnDataBound("grid_OnDataBound")
                .OnRowDataBound("grid_OnRowDataBound")
                .OnDelete("grid_OnDelete")
                .OnError("grid_OnError"))
            .Render();
    }
</div>
