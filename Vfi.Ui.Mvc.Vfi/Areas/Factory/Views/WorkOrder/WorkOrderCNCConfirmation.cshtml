@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Nhận phay CNC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnProcess.js")"></script>
    <script type="text/javascript">

        function grid_OnSave(args) {
            if (!onProcessing) {
                OnProcessingData();
            }
        }
        function grid_OnDataBound() {
            OnProcessedData();
        }
    </script>
}
<div class="title">Nhận phay CNC</div>

<div class="t-info-sha" style="padding-left: 15px; width: 550px; color: Maroon;">Danh sách lệnh<span class="processButton"></span></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<WorkOrderRoutingModel>()
            .Name("grid")
            .DataKeys(keys => keys.Add(f => f.RoutingId).RouteKey("routingId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectWorkOrderCNCConfirmation", "WorkOrder", new { area = "Factory" })
                .Update("ConfirmWorkOrderCNC", "WorkOrder", new { area = "Factory" })
            )
            .Columns(columns => {
                columns.Command(command => command.Edit().ButtonType(GridButtonType.Image)).Width(50).Title("Duyệt")
                    .HtmlAttributes(new { style = "text-align:center" });

                columns.Bound(f => f.SerialNumber).Title("Work Order").Width(100).ReadOnly(true)
                    .HtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.LastRouteFinishDate).Width(85).Title("Ngày HT</br>CĐ trước").ReadOnly(true)
                    .ClientTemplate("<#= LastRouteFinishDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', LastRouteFinishDate) #>")
                    .HtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.ProductCode).Title("Sản phẩm").Width(150).ReadOnly(true)
                    .HtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.RoutingName).Title("Công đoạn").Width(200).ReadOnly(true);
                columns.Bound(f => f.PlannedCost).Title("Số lượng</br>(pcs)").Width(70).ReadOnly(true)
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.PlannedWeight).Title("Trọng lượng</br>(g)").Width(70).ReadOnly(true)
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.MaterialInvCode).Title("Nguyên liệu").Width(170).ReadOnly(true)
                    .HtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.MoreInfo).Title("Ghi chú").ReadOnly(true);
            })
            .Selectable()
            .ClientEvents(events => events
                .OnRowSelect("grid_OnRowSelect")
                .OnSave("grid_OnSave")
                .OnDataBound("grid_OnDataBound")
                .OnError("grid_OnError"))
            .Render();
    }
</div>
