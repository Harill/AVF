        <div class="grid_4">
            @{
                    Html.Telerik().ComboBox()
                        .Name("Employee")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxEmployee", "Employee", new { area = "Sales" }).Delay(350))
                        .HtmlAttributes(new { style = "width: 100%" })
                        //.DropDownHtmlAttributes(new { style = "width: 150px" })
                        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .Render();
                }
        </div>
        <div class="clear"></div>
        <div class="clear"></div>
        <br />
        <div class="grid_2">
            Nguyên liệu
        </div>
        <div class="grid_8" style="font-size: large;">
            <span id="MaterialInvCode">~~</span>
        </div>
