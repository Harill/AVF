                        .Render();
                }
            </div>
            <div class="grid_1_5">(g/pc)</div>

            <div class="grid_2">
                TL BB
            </div>
            <div class="grid_1_5">
                @{
                    Html.Telerik().NumericTextBox()
                        .Name("PackageWeight")
                        .MinValue(0)
                        .MaxValue(1000000)
                        .DecimalDigits(0)
                        .Value(0)
                        .Spinners(false)
                        .InputHtmlAttributes(new { style = "text-align:right;width:100%;width:100%;" })
                        //.ClientEvents(events => { events.OnChange("crossWeight_OnChange"); })
                        .Render();
                }
            </div>
            <div class="grid_1">(g)</div>
            <div class="clear"></div>
            <br />
        </div>
    </fieldset>
</div>

<div class="t-info-sha fieldheader fieldheader2">
    <fieldset>
