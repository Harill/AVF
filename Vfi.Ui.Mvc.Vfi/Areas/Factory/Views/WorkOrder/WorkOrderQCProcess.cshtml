@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Đo kiểm WO";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .fieldheader {
        /*height: 150px;*/
        padding-left: 15px;
        padding-right: 15px;
        float: left;
    }

    .fieldheader1 {
        width: 35%;
        min-width: 420px;
        margin-right: 10px;
    }

    .fieldheader2 {
        width: 20%;
        margin-right: 10px;
    }

    .fieldheader3 {
        width: 35%;
    }
</style>
@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">        
        function workOrder_OnChange() {
            var workOrder = $("#WorkOrder").data('tComboBox').value();
            if (workOrder === "") workOrder = 0;
            $.ajax({
                type: 'post',
                data: { routingId: workOrder },
                dataType: 'json',
                url: '@Url.Action("CheckWorkOrderRoutingInfo", "WorkOrder", new { area = "Factory" })',
                timeout: 20000,
                success: function (res) {
                    //OnLoadedData();
                    if (res.Code === 1) {
                        $("#SerialNumber")[0].innerText = res.Data.SerialNumber;
                        $("#ProductCode")[0].innerText = res.Data.ProductCode;

                        $("#RoutingName")[0].innerText = res.Data.RoutingName;
                        $("#NextRouteName")[0].innerText = res.Data.NextRouteName;

                        $("#WorkOrderQuantity")[0].innerText = res.Data.PlannedCost.format(0);
                        $("#ProductionQuantity")[0].innerText = res.Data.UsingQuantity.format(0);

                        $("#ProductWeight").val(res.Data.ProductWeight);
                        $("#ProductWeight").data("tTextBox").$text[0].innerHTML = res.Data.ProductWeight.format(4);

                        $("#MaterialInvCode")[0].innerText = res.Data.MaterialInvCode;
                        RefreshGrid("grid");
                    } else {
                        alert("Lỗi! " + res.Message);
                    }
                }
            });
        }

        function grid_OnDataBinding(e) {

            var workOrder = $("#WorkOrder").data('tComboBox').value();
            if (workOrder === "") workOrder = 0;
            var productWeight = $("#ProductWeight").data("tTextBox").value();
            e.data = $.extend(e.data, {
                routingId: workOrder,
                productWeight: productWeight
            });
        }

        function grid_OnSave(e) {
            var goodQuantity = $(e.cell).find('#GoodQuantity').val();
            var goodWeight = $(e.cell).find('#GoodWeight').val();
            var ngQuantity = $(e.cell).find('#NGQuantity').val();
            var ngWeight = $(e.cell).find('#NGWeight').val();
            var defectQuantity = $(e.cell).find('#DefectQuantity').val();
            var defectWeight = $(e.cell).find('#DefectWeight').val();
            var usingQuantity = $(e.cell).find('#UsingQuantity').val();
            var productWeight = e.dataItem.ProductWeight;
            var total = 0;
            if (!isNaN(parseInt(goodQuantity))) {
                goodQuantity = parseInt(goodQuantity);
                goodWeight = parseInt(goodQuantity * e.dataItem.ProductWeight);
                var span = e.cell.parentElement.getElementsByClassName("GoodWeight")[0];
                span.textContent = goodWeight.format(0);
                total = goodQuantity + e.dataItem.NGQuantity + e.dataItem.DefectQuantity;
            }
            else if (!isNaN(parseInt(goodWeight))) {
                goodWeight = parseInt(goodWeight);
                goodQuantity = parseInt(goodWeight / productWeight);
                var span = e.cell.parentElement.getElementsByClassName("GoodQuantity")[0];
                span.textContent = goodQuantity.format(0);
                total = goodQuantity + e.dataItem.NGQuantity + e.dataItem.DefectQuantity;
            }
            else if (!isNaN(parseInt(ngQuantity))) {
                ngQuantity = parseInt(ngQuantity);
                ngWeight = parseInt(ngQuantity * e.dataItem.ProductWeight);
                var span = e.cell.parentElement.getElementsByClassName("NGWeight")[0];
                span.textContent = ngWeight.format(0);
                total = e.dataItem.GoodQuantity + ngQuantity + e.dataItem.DefectQuantity;
            }
            else if (!isNaN(parseInt(ngWeight))) {
                ngWeight = parseInt(ngWeight);
                ngQuantity = parseInt(ngWeight / productWeight);
                var span = e.cell.parentElement.getElementsByClassName("NGQuantity")[0];
                span.textContent = ngQuantity.format(0);
                total = e.dataItem.GoodQuantity + ngQuantity + e.dataItem.DefectQuantity;
            }
            else if (!isNaN(parseInt(defectQuantity))) {
                defectQuantity = parseInt(defectQuantity);
                defectWeight = parseInt(defectQuantity * e.dataItem.ProductWeight);
                var span = e.cell.parentElement.getElementsByClassName("DefectWeight")[0];
                span.textContent = defectWeight.format(0);
                total = e.dataItem.GoodQuantity + e.dataItem.NGQuantity + defectQuantity;
            }
            else if (!isNaN(parseInt(defectWeight))) {
                defectWeight = parseInt(defectWeight);
                defectQuantity = parseInt(defectWeight / productWeight);
                var span = e.cell.parentElement.getElementsByClassName("DefectQuantity")[0];
                span.textContent = defectQuantity.format(0);
                total = e.dataItem.GoodQuantity + e.dataItem.NGQuantity + defectQuantity;
            }
            e.dataItem.UsingQuantity = total;
            var spanProduction = e.cell.parentElement.getElementsByClassName("ProductionQuantity")[0];
            if (e.dataItem.UsingQuantity > e.dataItem.PlannedCost) {
                // wrong: orange;
                spanProduction.parentNode.bgColor = "orange";
            }
            else if (e.dataItem.UsingQuantity < e.dataItem.PlannedCost) {
                // not done: yellow
                spanProduction.parentNode.bgColor = "yellow";
            } else {
                // right
                spanProduction.parentNode.bgColor = "";
            }
        }

        function grid_OnSubmitChanges(e) {
            var workOrder = $("#WorkOrder").data('tComboBox').value();
            if (workOrder === "") workOrder = 0;
            var employee = $("#Employee").data('tComboBox').value();
            if (employee === "") employee = 0;
            var productWeight = $("#ProductWeight").data("tTextBox").value();
            if (employee === 0 || productWeight ==0) {
                alert("Vui lòng điền đủ thông tin: nhân viên, trọng lượng SP");
                e.preventDefault();
            }
            else {
                e.values = $.extend(e.values,
                    {
                        routingId: workOrder,
                        employeeId: employee,
                        machineId: 0,
                        productWeight: productWeight,
                    });
            }
        }

    </script>
}

<div class="title">Nhập đo kiểm</div>
<div class="clear"></div>
<br />

<div class="t-info-sha fieldheader fieldheader1">
    <fieldset>
        <legend>Thông tin Work Order</legend>
        <div class="grid_1_5">
            Chọn
        </div>
        <div class="grid_6">
            @{
                Html.Telerik().ComboBox()
                    .Name("WorkOrder")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxWorkOrderQCRouting", "WorkOrder", new { area = "Factory" }).Delay(350))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .ClientEvents(events => events.OnChange("workOrder_OnChange"))
                    .Render();
            }
        </div>
        <div class="grid_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshCombobox('WorkOrder'); ">
                <span class='t-icon t-refresh'></span>
            </button>
        </div>
        <div class="clear"></div>
        <div class="grid_11">
            <div class="grid_2">
                Số Serial
            </div>
            <div class="grid_3" style="font-size: large;">
                <span id="SerialNumber">~~</span>
            </div>
            <div class="grid_2">
                Sản phẩm
            </div>
            <div class="grid_3" style="font-size: large;">
                <span id="ProductCode">~~</span>
            </div>
            <div class="clear"></div>
            <br />

            <div class="grid_2">
                Công đoạn
            </div>
            <div class="grid_3">
                <span id="RoutingName">~~</span>
            </div>
            <div class="grid_2">
                CĐ kế
            </div>
            <div class="grid_3">
                <span id="NextRouteName">~~</span>
            </div>
            <div class="clear"></div>
            <br />

            <div class="grid_2">
                Kế hoạch:
            </div>
            <div class="grid_3">
                <span id="WorkOrderQuantity">0</span> (pcs)
            </div>
            <div class="grid_2">
                Thực hiện:
            </div>
            <div class="grid_3">
                <span id="ProductionQuantity">0</span> (pcs)
            </div>
            <div class="clear"></div>
            <br />

            <div class="grid_2">
                TL SP
            </div>
            <div class="grid_1_5">
                @{
                    Html.Telerik().NumericTextBox()
                        .Name("ProductWeight")
                        .MinValue(0)
                        .MaxValue(1000)
                        .DecimalDigits(4)
                        .Value(0.000)
                        .Spinners(false)
                        .InputHtmlAttributes(new { style = "text-align:right; width:100%;" })
