<div class="clear"></div>
<br />
<div class="cover-div">
    @{
        Html.Telerik().Grid<WorkOrderRoutingModel>()
            .Name("grid")
            .ToolBar(bar => bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu lại").CancelText("Huỷ bỏ"))
            .DataKeys(keys => keys.Add(f => f.RoutingId).RouteKey("routingId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectWorkOrderProcess", "WorkOrder", new { area = "Factory", routingId = 0, productWeight = 0 })
                .Update("ImportWorkOrderProcess", "WorkOrder", new { area = "Factory", productWeight = 0 })
                )
            .Columns(columns => {
                columns.Bound(f => f.ProductWeight).Width(90).HeaderTemplate("Trọng lượng</br>Sản phẩm</br>(g/pc)").ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n4}")
                    .HtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.PlannedCost).Width(90).HeaderTemplate("Số lượng</br>nhận</br>xử lý").ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.PreviousRouteQuantity).Width(90).HeaderTemplate("Số lượng</br>cần</br>xử lý").ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    //.Format("{0:n0}")
                    .ClientTemplate("<span class='ProductionQuantity'><#=  $.telerik.formatString('{0:n0}', PreviousRouteQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;border-right:1px solid black;" });
                columns.Bound(f => f.GoodQuantity).Width(90).HeaderTemplate("Hàng</br>OK</br>(pcs)")
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .ClientTemplate("<span class='GoodQuantity'><#=  $.telerik.formatString('{0:n0}', GoodQuantity) #></span>")
                    //.Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.GoodWeight).Width(90).HeaderTemplate("Hàng</br>OK</br>(g)")
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    //.Format("{0:n0}")
                    .ClientTemplate("<span class='GoodWeight'><#=  $.telerik.formatString('{0:n0}', GoodWeight) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;border-right:1px solid black;" });
                
                columns.Bound(f => f.NGQuantity).Width(90).HeaderTemplate("Hàng</br>CPL</br>(pcs)")
                    .HeaderHtmlAttributes(new { @class = "ng-column" })
                    .ClientTemplate("<span class='NGQuantity'><#=  $.telerik.formatString('{0:n0}', NGQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.NGWeight).Width(90).HeaderTemplate("Hàng</br>CPL</br>(g)")
                    .HeaderHtmlAttributes(new { @class = "ng-column" })
                    .ClientTemplate("<span class='NGWeight'><#=  $.telerik.formatString('{0:n0}', NGWeight) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;border-right:1px solid black;" });

                columns.Bound(f => f.DefectQuantity).Width(90).HeaderTemplate("Phế phẩm</br>(pcs)")
                    .HeaderHtmlAttributes(new { @class = "defect-column" })
                    .ClientTemplate("<span class='DefectQuantity'><#=  $.telerik.formatString('{0:n0}', DefectQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.DefectWeight).Width(90).HeaderTemplate("Phế phẩm</br>(g)")
                    .HeaderHtmlAttributes(new { @class = "defect-column" })
                    .ClientTemplate("<span class='DefectWeight'><#=  $.telerik.formatString('{0:n0}', DefectWeight) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
            })
            .Editable(editing => editing.Mode(GridEditMode.InCell))
            .ClientEvents(events => events
                .OnDataBinding("grid_OnDataBinding")
                .OnSave("grid_OnSave")
                .OnSubmitChanges("grid_OnSubmitChanges")
                .OnError("grid_OnError")
            )
            .KeyboardNavigation()
            .Render();   
    }
</div>

