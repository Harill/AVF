@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Approve Outsourcing Command ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function PrintForm(val) {
            var $item = $('#id_' + val);
            var $formType = $item.attr('ftype');
            $('#result').load('@Url.Action("PrintImportExportForm", "Inv", new { area="Inv"})',
                {
                    transactionId: val,
                    formType: $formType,
                }, function (data) {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }
    </script>

}

<div class="title">Approve Outsourcing-Command </div>

<div class="t-info-sha" style="padding-left: 15px; width: 550px; color: Maroon;">WO Sheet<span class="processButton"></span></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<WorkOrderPlatingModel>()
            .Name("grid")
            .DataKeys(keys => keys.Add(f => f.TransactionId).RouteKey("transactionId"))
            .DataKeys(keys => keys.Add(f => f.FormType).RouteKey("formType"))
