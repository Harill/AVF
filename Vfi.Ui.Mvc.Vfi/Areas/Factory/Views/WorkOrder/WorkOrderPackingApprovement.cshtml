@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Nhận đóng gói";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- approve stockorder -->
    <script type="text/javascript">
        function ApproveTransaction() {
            var $checkedRecords = $("input[name='chkIds']:checked")
            //var $checkedRecords = $("input[name='chkMaterialIds']:checked");

            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 sản phẩm");
                return;
            }

            //$.ajaxSettings.traditional = false;
            var a = {};
            ids = "";
            //var $b = (a);

            for (var i = 0; i < $checkedRecords.length; i++) {
                if ($checkedRecords[i] === "0") continue;
                a[i] = $checkedRecords[i].value;

                ids += $checkedRecords[i].value;
                if (i < ($checkedRecords.length - 1))
                    ids += ":";
            }
            $.ajax({
                type: 'post',
                data: {
                    ids: ids
                },
                dataType: 'json',
                url: '@Url.Action("ApproveWorkOrderPackingProcess", "WorkOrder", new { area = "Factory" })',
                    timeout: 20000,
                    success: function (res) {
                        if (res.Code === 1) {
                            alert("Đã lưu " + res.Data);
                            RefreshGrid("grid");
                        } else {
                            alert(res.Message);
                        }
                    }
                });
        }

    </script>

}

<div class="title">Duyệt đóng gói</div>

<div class="t-info-sha" style="padding-left: 15px; width: 550px; color: Maroon;">Danh sách lệnh chuyển kho<span id="twoToneButton"></span></div>
