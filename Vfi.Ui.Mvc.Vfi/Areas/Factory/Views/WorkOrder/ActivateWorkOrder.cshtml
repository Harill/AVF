@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Active WO";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    function EditWorkOrders(id) {
        var $checkedRecords = $("input[name='chkIds" + id + "']:checked");

        if ($checkedRecords.length < 1) {
            alert("Vui lọn chọn ít nhất 1 Work Order");
            return;
        }

        var a = {};
        checkedRecords = "";
        for (var i = 0; i < $checkedRecords.length; i++) {
            if ($checkedRecords[i] === "0") continue;
            a[i] = $checkedRecords[i].value;

            checkedRecords += $checkedRecords[i].value;
            if (i < ($checkedRecords.length - 1))
                checkedRecords += ":";
        }
        if (checkedRecords.length > 0) {
            var link = '@Url.Action("EditWorkOrder", "WorkOrder", new { area = "Factory" })';
            window.location.href = link + "?ids=" + checkedRecords;
        }
        return false;
    }

    function AddWorkOrder(orderDetailId) {
        var link = '@Url.Action("AddWorkOrder", "WorkOrder", new { area = "Factory" })';
        window.location.href = link + "?orderDetailId=" + orderDetailId;
    }

    function gridDetail_OnRowDataBound(e) {
        if (!e.dataItem.CanChoose) {
            e.row.childNodes[1].innerHTML = "";
            e.row.childNodes[3].bgColor = "orange";
        }
        if (!e.dataItem.CanCancel) {
            e.row.getElementsByClassName("t-button t-grid-delete t-button-icon")[0].parentNode.innerHTML = "";
        }
        //if (e.dataItem.GoodQuantity < e.dataItem.OrderQty) {
        //    e.row.childNodes[9].bgColor = "orange";
        //}
    }
    function grid_OnDataBinding(args) {
        var status = $("#Status").data("tComboBox").value();
        if (status === "")
            status = 0;
        var customerId = $("#Customer").data('tComboBox').value();
        if (customerId === "") {
            customerId = 0;
        }
        var productCode = $("#ProductCodeName").data("tAutoComplete").value();
        args.data = $.extend(args.data, {
            customerId: customerId,
            productCode: productCode,
            status: status,
        });
    }
    function Print(id) {
        $('#result').load('@Url.Action("PrintWorkOrder", "WorkOrder")',
        {
            workOrderId: id
        }, function () {
            var window = $('#windowReport').data('tWindow');
            window.open();
        });
        return false;
    }
    function Print2(id) {
        $('#result').load('@Url.Action("PrintWorkOrder2", "WorkOrder")',
        {
            workOrderId: id
        }, function () {
            var window = $('#windowReport').data('tWindow');
            window.open();
        });
        return false;
    }
</script>
<script>
    function gridRouting_OnEdit(e) {

        var dataItem = e.dataItem;
        var mode = e.mode;
        var form = e.form;
        if (mode == 'insert') {
            workOrderId =  e.currentTarget.id.split("_")[1];
        }
        if (mode == 'edit') {
            var nodes = $(form).find('#RoutingName');
            nodes[0].parentNode.parentNode.innerHTML = dataItem.RoutingName;
        }
    }
    function gridRouting_OnRowDataBound(e) {
        if (!e.dataItem.CanCancel) {
            e.row.getElementsByClassName("t-button t-grid-delete t-button-icon")[0].parentNode.innerHTML = "";
            e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
        }
    }
    var workOrderId = 0;
    function woRoute_OnDataBinding(e) {
        e.data = $.extend({}, e.data, { workOrderId: workOrderId });

    }
</script>

