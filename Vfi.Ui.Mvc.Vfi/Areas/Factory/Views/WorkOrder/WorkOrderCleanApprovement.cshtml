@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Approve Cleanse ";
    //Duyệt làm sạch
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnProcess.js")"></script>
    <!-- approve stockorder -->
    <script type="text/javascript">
        function ApproveTransaction() {
            if (!onProcessing) {
                OnProcessingData();
                var $checkedRecords = $("input[name='chkIds']:checked")
                //var $checkedRecords = $("input[name='chkMaterialIds']:checked");

                if ($checkedRecords.length < 1) {
                    alert("Vui lọn chọn ít nhất 1 sản phẩm");
                    OnProcessedData();
                    return;
                }

                //$.ajaxSettings.traditional = false;
                var a = {};
                ids = "";
                //var $b = (a);

                for (var i = 0; i < $checkedRecords.length; i++) {
                    if ($checkedRecords[i] === "0") continue;
                    a[i] = $checkedRecords[i].value;

                    ids += $checkedRecords[i].value;
                    if (i < ($checkedRecords.length - 1))
                        ids += ":";
                }
                $.ajax({
                    type: 'post',
                    data: { ids: ids },
                    dataType: 'json',
                    url: '@Url.Action("ApproveWorkOrderCleanProcess", "WorkOrder", new { area = "Factory" })',
                    timeout: 20000,
                    success: function (res) {
                        if (res.Code === 1) {
                            alert("Đã lưu " + res.Data);
                            RefreshGrid("grid");
                        } else {
                            alert(res.Message);
                        }
                        OnProcessedData();
                    }
                });
            }
        }

    </script>

}

<div class="title">Approve Cleanse </div>

