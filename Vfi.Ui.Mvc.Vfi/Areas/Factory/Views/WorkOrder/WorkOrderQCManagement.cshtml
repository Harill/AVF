@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "List QC-Command ";
    //DS lệnh QC
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <script type="text/javascript">
        
        $(document).ready(function () {
            loadWO_Summary();
        });

        function loadWO_Summary() {
            $.ajax({
                type: 'post',
                data: { configStr: '{IsQc: true}' },
                dataType: 'json',
                url: '@Url.Action("GetWOSummary", "WorkOrder", new { area = "Factory" })',
                timeout: 20000,
                success: function (res) {
                    if (res.Code === 1) {
                        $("#wo_onProcess")[0].innerText = res.Data.DM.format(0);
                        $("#wo_inventory")[0].innerText = res.Data.NS.format(0);

                    } else {
                        alert("Lỗi! " + res.Message);
                    }
                }
            });
        }

        function grid_OnDataBinding(args) {
            if (startGrid && !onLoading) {
                OnLoadingData();
                var status = $("#Status").data("tComboBox").value();
                if (status === "")
                    status = 0;
                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                var productCode = $("#ProductCodeName").data("tAutoComplete").value();
                args.data = $.extend(args.data, {
                    status: status,
                    productCode: productCode,
                    fromDate: fromDate,
                    toDate: toDate
                });
            }
        }

        function grid_OnRowDataBound(e) {
            if(e.dataItem.Status != @Convert.ToInt32(MyUtilities.WorkOrder.Status.InProcess)){            
                e.row.childNodes[e.row.childNodes.length - 1].innerHTML = "";
            }
        }

        function ForceFinish(routingId) {
            $.ajax({
                type: 'post',
                data: { routingId: routingId },
                dataType: 'json',
                url: '@Url.Action("ForceFinishWorkOrderRouting", "WorkOrder", new { area = "Factory" })',
                timeout: 20000,
                success: function (res) {
                    if (res.Code === 1) {
                        alert(res.Message);
                        RefreshGrid("grid");
                    } else {
                        alert("Lỗi! " + res.Message);
                    }
                }
            });
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
    </script>
}
<div class="title">List QC-Command "</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        <fieldset>
            <legend>Filters</legend>
        <div class="grid_1_5">Product</div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ProductCodeName")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "min-width: 250px" })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>
        <div class="grid_1_5">
            Status
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("Status")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxWorkOrderStatus", "WorkOrder"))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .Render();
            }
        </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("FromDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                        .Render();
                }
            <div class="clear"></div>
                @{
                    Html.Telerik().DatePicker()
                        .Name("ToDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('grid'); ">
                    <span class='t-icon t-insert'></span>
                    Find
                <span class="loadButton"></span>
                </button>
            </div>
            <div class="grid_2">
                Total WO Are Processing
            </div>
            <div class="grid_3" style="font-size: large;">
                <span id="wo_onProcess">~~</span>
            </div>
            <div class="grid_2">
                Total WO Inventory
            </div>
            <div class="grid_3" style="font-size: large;">
                <span id="wo_inventory">~~</span>
            </div>
        </fieldset>
    </div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<WorkOrderRoutingModel>()
            .Name("grid")
            .DataKeys(keys => keys.Add(f => f.RoutingId).RouteKey("routingId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectWorkOrderQCManagement", "WorkOrder", 
                new { area = "Factory", productCode = "", fromDate = "", status = 0 })
            )
            .Columns(columns => {
                columns.Bound(f => f.SerialNumber).Title("Work Order</br>Code").Width(80).ReadOnly(true);
                columns.Bound(f => f.ActualStartDate).Title("Start<br/>Date").Width(80).ReadOnly(true)
                       .Format("{0:dd/MM/yyyy HH:mm}");
                columns.Bound(f => f.ActualEndDate).Title("End<br/>Date").Width(80).ReadOnly(true)
                       .ClientTemplate("<#= ActualEndDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', ActualEndDate) #>");
                columns.Bound(f => f.StatusName).Title("Status").Width(90).ReadOnly(true)
                       .HtmlAttributes(new { style = "border-right: 1px solid black;" });
                //columns.Bound(f => f.RoutingName).Title("Công đoạn").Width(200).ReadOnly(true);
                columns.Bound(f => f.ProductCode).Title("Product").Width(130).ReadOnly(true);
                //columns.Bound(f => f.MachineName).Title("Máy<br/>sản xuất").Width(70).ReadOnly(true);
                columns.Bound(f => f.PlannedCost).Title("Plan</br>(pcs)").Width(70).ReadOnly(true)
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right;border-right: 1px solid black;" });
                columns.Bound(f => f.GoodQuantity).Title("OK</br>(pcs)").Width(70).ReadOnly(true)
                       .HeaderHtmlAttributes(new { @class = "good-column" })
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.GoodWeight).Title("OK</br>(g)").Width(70).ReadOnly(true)
                       .HeaderHtmlAttributes(new { @class = "good-column" })
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.NGQuantity).Title("NG</br>(pcs)").Width(70).ReadOnly(true)
                       .HeaderHtmlAttributes(new { @class = "ng-column" })
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.NGWeight).Title("NG</br>(g)").Width(70).ReadOnly(true)
                       .HeaderHtmlAttributes(new { @class = "ng-column" })
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.DefectQuantity).Title("Scrap</br>(pcs)").Width(70).ReadOnly(true)
                       .HeaderHtmlAttributes(new { @class = "defect-column" })
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right;" });
                columns.Bound(f => f.DefectWeight).Title("Scrap</br>(g)").Width(70).ReadOnly(true)
                       .HeaderHtmlAttributes(new { @class = "defect-column" })
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right;border-right: 1px solid black;" });
                columns.Bound(f => f.MoreInfo).Title("Note").ReadOnly(true);
                columns.Bound(f => f.RoutingId).Title("Finished").Width(55).ReadOnly(true).Filterable(false)
                       .ClientTemplate("<input type='button' value='HT' class='t-button' onclick=ForceFinish(<#= RoutingId #>) />")
                       .HtmlAttributes(new { style = "text-align:center" });
            })
            .DetailView(details3 => details3.ClientTemplate(
                Html.Telerik().TabStrip()
                                .Name("TabStrip_<#= RoutingId #>")
                                .SelectedIndex(0)
                                .Items(items3 =>
                            items3.Add().Text("Input").Content(
                                Html.Telerik().Grid<WorkOrderProcessModel>()
                                            .Name("gridProcesses_<#= RoutingId #>")
                                            .DataKeys(key => key.Add(f => f.ProcessId).RouteKey("processId"))
                                            .DataBinding(
                                                dataBinding => dataBinding.Ajax()
                                                                        .Select("SelectWorkOrderProcesses", "WorkOrder", new {
                                                                            area = "Factory",
                                                                            routingId = "<#= RoutingId #>",
                                                                            status = 0
                                                                        })
                                            )
                                            .Columns(columns => {
                                                columns.Bound(f => f.Date).Title("Date").Width(150).ReadOnly(true)
                                                       .Format("{0:dd/MM/yyyy HH:mm}")
                                                       .HtmlAttributes(new { style = "text-align: center;" });
                                                columns.Bound(f => f.StatusName).Width(70).Title("Status");
                                                //columns.Bound(f => f.Shift).Title("Ca").Width(40).ReadOnly(true);
                                                columns.Bound(f => f.UsingQuantity).Title("Using</br>(pcs)").ReadOnly(true).Width(50)
                                                       .Format("{0:n0}")
                                                       .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" })
                                                       .Aggregate(agg => agg.Sum())
                                                       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                       .FooterHtmlAttributes(new { style = "text-align: center;" });
                                                columns.Bound(f => f.GoodQuantity).Title("OK Quantity</br>(pcs)").Width(70)
                                                       .HeaderHtmlAttributes(new { @class = "good-column" })
                                                       .Format("{0:n0}")
                                                       .HtmlAttributes(new { style = "text-align: center;" })
                                                       .Aggregate(agg => agg.Sum())
                                                       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                       .FooterHtmlAttributes(new { style = "text-align: center;" });
                                                columns.Bound(f => f.GoodWeight).Title("OK weight</br>(g)").ReadOnly(true).Width(70)
                                                       .HeaderHtmlAttributes(new { @class = "good-column" })
                                                       .Format("{0:n0}")
                                                       .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" })
                                                       .Aggregate(agg => agg.Sum())
                                                       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                       .FooterHtmlAttributes(new { style = "text-align: center;" });
                                                columns.Bound(f => f.NGQuantity).Title("NG QUantity</br>(pcs)").Width(70)
                                                       .HeaderHtmlAttributes(new { @class = "ng-column" })
                                                       .Format("{0:n0}")
                                                       .HtmlAttributes(new { style = "text-align: center;" })
                                                       .Aggregate(agg => agg.Sum())
                                                       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                       .FooterHtmlAttributes(new { style = "text-align: center;" });
                                                columns.Bound(f => f.NGWeight).Title("NG Weight</br>(g)").ReadOnly(true).Width(70)
                                                       .HeaderHtmlAttributes(new { @class = "ng-column" })
                                                       .Format("{0:n0}")
                                                       .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" })
                                                       .Aggregate(agg => agg.Sum())
                                                       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                       .FooterHtmlAttributes(new { style = "text-align: center;" });
                                                columns.Bound(f => f.DefectQuantity).Title("Scrap Quantity</br>(pcs)").Width(70)
                                                       .HeaderHtmlAttributes(new { @class = "defect-column" })
                                                       .Format("{0:n0}")
                                                       .HtmlAttributes(new { style = "text-align: center;" })
                                                       .Aggregate(agg => agg.Sum())
                                                       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                       .FooterHtmlAttributes(new { style = "text-align: center;" });
                                                columns.Bound(f => f.DefectWeight).Title("Scrap Weight</br>(g)").ReadOnly(true).Width(70)
                                                       .HeaderHtmlAttributes(new { @class = "defect-column" })
                                                       .Format("{0:n0}")
                                                       .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" })
                                                       .Aggregate(agg => agg.Sum())
                                                       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                       .FooterHtmlAttributes(new { style = "text-align: center;" });
                                                columns.Bound(f => f.EmployeeName).Title("Employee").Width(100).ReadOnly(true)
                                                       .HtmlAttributes(new { style = "text-align: center;" });
                                            })

                                            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
                                            .ClientEvents(e => e.OnError("grid_OnError"))
                                            //.Pageable(page => page.PageSize(10))
                                            .ToHtmlString())
                                        ).ToHtmlString()))

            .Selectable()
            .Sortable()
            .Groupable()
            .Filterable()
            .ClientEvents(events => events
                .OnRowSelect("grid_OnRowSelect")
                .OnDataBinding("grid_OnDataBinding")
                .OnDataBound("grid_OnDataBound")
                .OnRowDataBound("grid_OnRowDataBound")
                .OnError("grid_OnError"))
            .Render();
    }
</div>
