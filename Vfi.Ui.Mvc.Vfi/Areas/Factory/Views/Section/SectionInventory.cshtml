@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "Productinon2 Inventory Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {

            var getAll = $("input[name='chkGetAll']").attr('checked');
            var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);

            var toDate = $("#ToDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);


            args.data = $.extend(args.data, {
                productCode: productCodeNameForMonthly,
                fromDate: fromDate,
                toDate: toDate,
                getAll: getAll
            });

        }

        var index = 0;



    </script>
}

<div class="title">Báo cáo xuất nhập tồn kho Sản Xuất 2</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        <div class="clear"></div>  
        
        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
           
            <div class="grid_2">
                Sản phẩm
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeNameForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv",new {area="Inv"}))
                        .DropDownHtmlAttributes(new { style = "width: 110px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("FromDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("ToDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
        <div class="grid_3">
                <label>
                    <input type="checkbox" id="chkGetAll" name="chkGetAll"/>
                   Lấy tất cả
                </label> 
        </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridProductionMonthly'); ">
                    <span class='t-icon t-insert'></span>
                    Làm mới
                </button>
            </div>
           @* <div class="grid_4">
              <button id="btnProduction2Period" class="t-button" onclick=" return printProduction2Period(); ">
                <span class='t-icon t-insert'></span>
               In báo cáo hằng ngày
            </button>
            </div>*@
        </fieldset>
    </div>
    <div class="clear">
    </div>

    <div class="cover-div">
        @{
            Html.Telerik().Grid<Production2PeriodModel>()
                .Name("gridProductionMonthly")
                .DataKeys(keys => keys.Add(f => f.InvId).RouteKey("invId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectSectionInventory", "Section"))
                .Columns(columns =>
                    {
                        columns.Bound(f => f.GlobalIndex).Width(35)
                             .ClientTemplate("<#= GlobalIndex #>")
                             .HeaderTemplate("<strong>STT</strong>");
                        columns.Bound(f => f.ProductCode).Width(85)
                               .HeaderTemplate("<strong>Mã SP</strong>")
                               .HtmlAttributes(new { style = "text-align: center;" });
                        columns.Bound(f => f.SectionName).Width(85)
                               .HeaderTemplate("<strong>Tên công đoạn</strong>")
                               .HtmlAttributes(new { style = "text-align: center;" });
                        columns.Bound(f => f.SectionProductivity).Width(60)
                               .HeaderTemplate("Năng suất</br>(s/pc)")
                            //.HtmlAttributes(new { style = "border-left:black 3px double;"})
                               .ClientTemplate("<#= SectionProductivity == null ? 0 : $.telerik.formatString('{0:n1}', SectionProductivity) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        // so lieu
                        columns.Bound(f => f.EarlyQuantity).Width(65)
                             .HeaderTemplate("Tồn đầu</br>(kg)")
                             .HtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" })
                             .Aggregate(agg => agg.Sum())
                             .Format("{0:n3}")
                               .FooterHtmlAttributes(new { style = "text-align: right;" })
                             .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n3}', Sum) #>")
                             .ClientFooterTemplate("<#= $.telerik.formatString('{0:n3}', Sum) #>");
                        //
                        columns.Bound(f => f.Import).Width(60)
                               .HeaderTemplate("Nhập</br>(kg)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= Import == 0 ? '-' : $.telerik.formatString('{0:n3}', Import) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n3}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n3}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" });
                        columns.Bound(f => f.ImportPeriod).Width(60)
                               .HeaderTemplate("LK nhập</br>(kg)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= ImportPeriod == 0 ? '-' : $.telerik.formatString('{0:n3}', ImportPeriod) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n3}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n3}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        //
                        columns.Bound(f => f.Export).Width(60)
                           .HeaderTemplate("Xuất</br>(kg)")
                           .Aggregate(agg => agg.Sum())
                           .ClientTemplate("<#= Export == 0 ? '-' : $.telerik.formatString('{0:n3}', Export) #>")
                           .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n3}', Sum) #></div>")
                           .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n3}', Sum) #></div>")
                           .FooterTemplate("<span id='tongcot1'></span>")
                           .HtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" });
                        columns.Bound(f => f.ExportPeriod).Width(60)
                               .HeaderTemplate("LK Xuất</br>(kg)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= ExportPeriod == 0 ? '-' : $.telerik.formatString('{0:n3}', ExportPeriod) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n3}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n3}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        //
                        columns.Bound(f => f.LastQuantity).Width(65)
                               .HeaderTemplate("Tồn cuối</br>(kg)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= LastQuantity == null ? 0 : $.telerik.formatString('{0:n3}', LastQuantity) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n3}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n3}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" });
                    })
                      .Scrollable(f => f.Height(510))
                //.Scrollable(f => f.Height(auto))
                //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .Groupable(c => c.Groups(g => g.Add(e=> e.ProductCode)))
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnError("grid_OnError"))
                .Groupable()
                .Render();
        }
    </div>
</div>

<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
        )
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

<style type="text/css">
    #windowReport {
        /*
            float: right;
            Position: relative;
            */
        min-height: 580px;
        top: 15%;
    }

    #result {
        height: 520px;
        overflow: hidden;
    }

    #ReportBody {
        padding-bottom: 25px;
        margin-bottom: 25px;
    }

    .tb-witdh td {
        width: 55px;
    }
</style>
