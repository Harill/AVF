@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "Phiếu SX2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
    <script type="text/javascript">
        function grid_OnEdit(e) {
            if (e.mode == 'insert')
                e.cell.parentNode.style.backgroundColor = "#F4FA58";
                productId = e.dataItem.ProductId;
        }

        var productId = 0;


        var section = 1;
        var productivity = 10;
        var secionNext = 2;
        var machine = 3;
        var employee = 4;
        var quantity = 11;
        var time = 12;

        function grid_OnSave(e) {
            var $productCode = $(e.cell).find('#ProductCode');
            var $sectionName = $(e.cell).find('#SectionName');
            var $sectionNext = $(e.cell).find('#SectionNextName');
            var $machineName = $(e.cell).find('#MachineName');
            var $employeeName = $(e.cell).find('#EmployeeName');
            var quanlity = $(e.cell).find('#Quantity').val();
            var type = $("#Type").data("tComboBox").value();
            if (type == "")
                type = 2;
            if ($productCode.length > 0) {
                var productCode = $productCode.data("tComboBox"),
                    productSelectItem = productCode.selectedIndex > -1 ? productCode.data[productCode.selectedIndex] : null;

                if (productSelectItem) {
                    e.values["ProductCode"] = productSelectItem.Text;
                    e.values["ProductId"] = productSelectItem.Value;
                    productId = productSelectItem.Value;
                    $.ajax({
                        type: 'post',
                        data: { productId: productSelectItem.Value, productionSectionId: 0, employeeType: type },
                        dataType: 'json',
                        url: '@Url.Action("GetProductSection", "Section",new{area="Factory"})',
                        timeout: 20000,
                        success: function(data) {
                            if (data == '9') {
                                alert("Lỗi! Không tìm thấy sản phẩm ! Liên hệ admin");
                            } else if (data == '8') {
                                alert("Lỗi! Sản phẩm không có công đoạn 2 ! Liên hệ admin");
                            } else if (data == '0') {
                                alert("Lỗi!");
                            } else {
                                e.cell.parentElement.childNodes[section].textContent = data.SectionName;
                                e.dataItem.SectionName = data.SectionName;
                                e.dataItem.ProductionSectionId = data.ProductionSectionId;
                                
                                e.cell.parentElement.childNodes[secionNext].textContent = data.SectionNextName;
                                e.dataItem.SectionNextName = data.SectionNextName;
                                e.dataItem.SectionNext = data.SectionNext;


                                e.cell.parentElement.childNodes[machine].textContent = data.MachineName;
                                e.dataItem.MachineName = data.MachineName;
                                e.dataItem.MachineId = data.MachineId;

                                e.cell.parentElement.childNodes[employee].textContent = data.EmployeeName;
                                e.dataItem.EmployeeName = data.EmployeeName;
                                e.dataItem.EmployeeId = data.EmployeeId;

                                e.cell.parentElement.childNodes[productivity].textContent = data.SectionProductivityKgInHour;
                                e.dataItem.SectionProductivity = data.SectionProductivity;
                                e.dataItem.SectionProductivityKgInHour = data.SectionProductivityKgInHour;
                                e.cell.parentElement.childNodes[quantity].textContent = data.SectionProductivityKgInHour;
                                e.cell.parentElement.childNodes[time].textContent = (e.dataItem.Quantity / data.SectionProductivityKgInHour).format(1);

                            }
                        }
                    });
                }
            } else if ($sectionName.length > 0) {

                if ($sectionName.length > 0) {
                    var sectionName = $sectionName.data("tComboBox"),
                        sectionSelectItem = sectionName.selectedIndex > -1 ? sectionName.data[sectionName.selectedIndex] : null;

                    if (sectionSelectItem) {
                        e.values["SectionName"] = sectionSelectItem.Text;
                        e.values["ProductionSectionId"] = sectionSelectItem.Value;
                        $.ajax({
                            type: 'post',
                            data: { productId: productId, productionSectionId: sectionSelectItem.Value, employeeType: type },
                            dataType: 'json',
                            url: '@Url.Action("GetProductSection", "Section",new{area="Factory"})',
                        timeout: 20000,
                        success: function (data) {
                            if (data == '0') {
                                alert("Lỗi!");
                            } else {


                                e.cell.parentElement.childNodes[secionNext].textContent = data.SectionNextName;
                                e.dataItem.SectionNextName = data.SectionNextName;
                                e.dataItem.SectionNext = data.SectionNext;


                                e.cell.parentElement.childNodes[machine].textContent = data.MachineName;
                                e.dataItem.MachineName = data.MachineName;
                                e.dataItem.MachineId = data.MachineId;

                                e.cell.parentElement.childNodes[employee].textContent = data.EmployeeName;
                                e.dataItem.EmployeeName = data.EmployeeName;
                                e.dataItem.EmployeeId = data.EmployeeId;
                                
                                e.cell.parentElement.childNodes[productivity].textContent = data.SectionProductivityKgInHour;
                                e.dataItem.SectionProductivity = data.SectionProductivity;
                                e.dataItem.SectionProductivityKgInHour = data.SectionProductivityKgInHour;
                                e.cell.parentElement.childNodes[quantity].textContent = data.SectionProductivityKgInHour;
                                e.cell.parentElement.childNodes[time].textContent = (e.dataItem.Quantity / data.SectionProductivityKgInHour).format(1);
                            }
                        }
                         });
                    }
                }
            } else if ($machineName.length > 0) {
                var machineName = $machineName.data("tComboBox"),
                    machineSelectItem = machineName.selectedIndex > -1 ? machineName.data[machineName.selectedIndex] : null;

                if (machineSelectItem) {
                    e.values["MachineName"] = machineSelectItem.Text;
                    e.values["MachineId"] = machineSelectItem.Value;
                }
            } else if ($employeeName.length > 0) {
                var employeeName = $employeeName.data("tComboBox"),
                    employeeSelectItem = employeeName.selectedIndex > -1 ? employeeName.data[employeeName.selectedIndex] : null;

                if (employeeSelectItem) {
                    e.values["EmployeeName"] = employeeSelectItem.Text;
                    e.values["EmployeeId"] = employeeSelectItem.Value;
                }
            }
            else if ($sectionNext.length > 0) {
                var sectionNext = $sectionNext.data("tComboBox"),
                    sectionNextItem = sectionNext.selectedIndex > -1 ? sectionNext.data[sectionNext.selectedIndex] : null;

                if (sectionNextItem) {
                    e.values["SectionNextName"] = sectionNextItem.Text;
                    e.values["SectionNext"] = sectionNextItem.Value;
                }
            }
            else if (!isNaN(parseInt(quanlity))) {
                var productionSectionId = e.dataItem.ProductionSectionId;
                $.ajax({
                    type: 'post',
                    data: { productId: productId, productionSectionId: productionSectionId, employeeType: type },
                    dataType: 'json',
                    url: '@Url.Action("GetProductSection", "Section",new{area="Factory"})',
                    timeout: 20000,
                    success: function (data) {
                        if (data == '0') {
                            alert("Lỗi!");
                        } else {
                            var sumQuantity = parseFloat(quanlity) / data.SectionProductivityKgInHour;

                            e.cell.parentElement.childNodes[quantity].textContent = sumQuantity.format(1);
                        }
                    }
                });
            }
        }

        function grid_OnSubmitChanges(e) {

            var date = $("#MonthlyDate").data("tDatePicker").value();
            if (date === null)
                date = "";
            else {
                date = $.telerik.formatString('{0:dd/MM/yyyy}', date);
            }
            var msg = "Cập nhật ngày:" + date;
            if ($.telerik.formatString('{0:dd/MM/yyyy}', new Date()) == date)
                msg += "\n\n(Trùng ngày hiện tại)";
            //if()
            if (confirm(msg)) {
                e.values = $.extend(e.values,
                    {
                        date: date
                    }
                );
                return true;
            } else {
                return false;
            }
        }

        function section_OnDataBinding(e) {
            e.data = $.extend(e.data, {
                productId: productId
            });
        }

        function type_Onload() {
            var combobox = $('#Type').data('tComboBox');
            var dataSource =
            [
                { Text: "A.Văn", Value: "2" },
                { Text: "A.Mẫn", Value: "3" }
            ];
            combobox.dataBind(dataSource);
        }

        function type_OnChange() {
            RefreshGrid("gridProduction2");
        }

        function grid_OnDataBinding(args) {

            var type = $("#Type").data("tComboBox").value();
            if (type == "")
                type = 2;
            args.data = $.extend(args.data, {
                employeeType: type
            });

        }
    </script>


<div class="title">Tạo gia công sản xuất 2</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

    <fieldset>
        <legend>Thông tin phiếu</legend>
        <div class="grid_4">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("Type")
                            //.DataBinding(binding => binding.Ajax().Select("SelectStatus", "Orders"))
                            .HtmlAttributes(new { style = "width: 150px" })
                            .DropDownHtmlAttributes(new { style = "width: 250px" })
                            .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                            .HighlightFirstMatch(true)
                            .AutoFill(true)
                            .ClientEvents(events => events.OnChange("type_OnChange").OnLoad("type_Onload"))
                            .Render();
                    }
                </div>
             <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("MonthlyDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
    </fieldset>
</div>
<div class="clear"></div>


<div class="cover-div">
    @{
        Html.Telerik().Grid<Production2Model>()
            .Name("gridProduction2")
            .DataKeys(keys => keys.Add(f => f.ProductionSectionId).RouteKey("productionSectionId"))
            .ToolBar(bar =>
                {
                    bar.Insert().ButtonType(GridButtonType.ImageAndText).Text("Thêm mới");
                    bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu tất cả").CancelText("Hủy");
                })
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectProduction2Rotate", "Section", new { employeeType = (byte)MyUtilities.Sales.EmployeeType.Production2 })
                                                     .Update("UpdateProduction2Rotate", "Section")
            )
            .Columns(columns =>
                {
                    columns.Bound(f => f.ProductCode).Width(70).Title("Mã SP")
                           .HtmlAttributes(new { style = "border-bottom:black 1px dotted;" });
                    columns.Bound(f => f.SectionName).Width(100).Title("Tên công đoạn")
                           .HtmlAttributes(new { style = "border-bottom:black 1px dotted;" });
                    columns.Bound(f => f.SectionNextName).Width(100).Title("Công đoạn kế")
                           .HtmlAttributes(new { style = "border-bottom:black 1px dotted;" });
                    columns.Bound(f => f.MachineName).Title("Máy").Width(60)
                           .HtmlAttributes(new { style = "border-bottom:black 1px dotted;" });
                    columns.Bound(f => f.EmployeeName).Title("Nhân viên").Width(100)
                           .HtmlAttributes(new { style = "border-bottom:black 1px dotted;border-right:black 1px solid;" });
                    columns.Bound(f => f.Quantity).Width(65)
                        .HeaderTemplate("Số lượng</br>(kg)")
                        .HtmlAttributes(new { style = "text-align:right;border-bottom:black 1px dotted;" })
                           .Format("{0:n3}");
                    columns.Bound(f => f.QuantityDefect).Width(65)
                        .HeaderTemplate("Phế phẩm</br>(kg)")
                        .HtmlAttributes(new { style = "text-align:right;border-bottom:black 1px dotted;" })
                           .Format("{0:n3}");
                    columns.Bound(f => f.QuantityLost).Width(65)
                        .HeaderTemplate("Hao hụt</br>(kg)")
                        .HtmlAttributes(new { style = "text-align:right;border-bottom:black 1px dotted;border-right:black 1px solid;" })
                           .Format("{0:n3}");
                    columns.Bound(f => f.Time).Width(65)
                        .HeaderTemplate("Thời gian</br>làm (h)")
                        .HtmlAttributes(new { style = "text-align:right;border-bottom:black 1px dotted;" })
                           .Format("{0:n1}");
                    columns.Bound(f => f.OverTime).Width(65)
                        .HeaderTemplate("Tăng ca</br>(h)")
                        .HtmlAttributes(new { style = "text-align:right;border-bottom:black 1px dotted;border-right:black 1px solid;" })
                           .Format("{0:n1}");
                    columns.Bound(f => f.SectionProductivityKgInHour).Width(65)
                        .HeaderTemplate("NS</br>(Kg/h)")
                        .HtmlAttributes(new { style = "text-align:right;border-bottom:black 1px dotted;" })
                           .Format("{0:n3}");
                    columns.Bound(f => f.NumberToPeriod).Width(65)
                        .HeaderTemplate("Theo NS</br>(h)")
                        .HtmlAttributes(new { style = "text-align:right;border-bottom:black 1px dotted;" })
                           .Format("{0:n1}");
                    columns.Bound(f => f.Note).Title("Ghi chú")
                           .HtmlAttributes(new { style = "border-bottom:black 1px dotted;" });

                    columns.Command(commands => commands.Delete().Text("").ButtonType(GridButtonType.Image)).Width(50).Title("");
                })
            .ClientEvents(events => events.OnEdit("grid_OnEdit")
                                          .OnSave("grid_OnSave")
                                          .OnDataBinding("grid_OnDataBinding")
                                          .OnSubmitChanges("grid_OnSubmitChanges")
                                          .OnError("grid_OnError")
            )
            .Editable(editing => editing.Mode(GridEditMode.InCell))
            .KeyboardNavigation(keys => keys.Enabled(true))
            .KeyboardNavigation()
            .Footer(false)
            .Render();
    }
</div>
<div class="clear"></div>
<br />
