
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Outside Process Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title">Outsource Management</div>                     @*Quản lý gia công ngoài  *@

<div class="cover-div">
@{
    Html.Telerik().Grid<OutsideProcessModel>()
        .Name("grid")
        .DataKeys(keys => keys.Add(f => f.ProcessId).RouteKey("processId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).Text("Add New").ImageHtmlAttributes(new { style = "margin-left:0px;" }))
        .DataBinding(dataBinding => dataBinding.Ajax()
            .Select("SelectOutsideProcess", "Production", new { area = "Factory" })
            .Insert("InsertOutsideProcess", "Production", new { area = "Factory" })
            .Update("UpdateOutsideProcess", "Production", new { area = "Factory" })
        )
        .Columns(columns => {
            columns.Command(cmd => cmd.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(100);
            columns.Bound(f => f.Name).Title("Name");
            columns.Bound(f => f.Price).Width(110).Title("Price (USD/KG)");
            columns.Bound(f => f.Active).Width(100).Title("Active");
            columns.Bound(f => f.ModifiedDate).Width(120).Title("Modified Date").ReadOnly(true)
                   .Format("{0:dd/MM/yyyy HH:mm}");
            columns.Bound(f => f.ModifiedUser).Width(110).Title("Modified User").ReadOnly(true)
                   .Format("{0:dd/MM/yyyy HH:mm}");
        })
        .ClientEvents(events => events.OnError("grid_OnError"))
        .Render();
}
</div>

