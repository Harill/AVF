<link href="@Url.Content("~/Content/Isotope.css")" rel="stylesheet" type="text/css" />
<style media="screen,print">
    /* resize container */
    .container_24 {
        width: 100%;
    }

    .title {
        padding: 0 15px;
    }

    /* filter area */
    #filters {
        margin: 0;
    }

    #options li {
        float: left;
        display: list-item;
    }

    #options .selected {
        background-color: #13F;
        text-shadow: none;
        color: white;
    }

    #options li a {
        display: block;
        padding: 0.4em 0.5em;
        background-color: #DDD;
        color: #222;
        font-weight: bold;
        text-shadow: 0 1px hsla( 0, 0%, 100%, 0.5 );
        background: none;
    }

        #options li a:hover {
            background-color: cornflowerblue;
            font-weight: bolder;
        }

        #options li a:active {
            background-color: cornflowerblue;
            font-weight: bolder;
        }


    /* item list area */
    .container {
        position: relative;
        overflow: hidden;
        height: auto;
        width: 270px;
        float: left;
    }

    #container-2 {
        margin-right: 100px;
    }

    .entity {
        /*width: 260px;*/
        height: 44px;
        margin: 5px;
        float: left;
        overflow: hidden;
        position: relative;
        background: #888;
        color: #222;
        -webkit-border-radius: 10px;
        -moz-border-radius: 10px;
        border-radius: 10px;
    }

    .entity.large {
        /* expanded item */
        /*width: 260px;*/
        height: 130px;
        z-index: 100;
        -webkit-border-radius: 10px;
        -moz-border-radius: 10px;
        border-radius: 10px;
    }

        .entity.machine {
            background: #F00;
            background: hsl( 0, 100%, 50%);
        }

    #revok1 {
        background-size: cover;
        background-position: center;
    }

    .entity * {
        margin: 0;
    }

    .entity .line1 {
        height: 20px;
    }

    .entity .line2 {
        height: 20px;
    }

    .entity .line3 {
        height: auto;
        padding-top: 5px;
        padding-left: 5px;
    }

    .entity .line4 {
        height: 20px;
    }

    .entity .line-item {
        height: 100%;
        float: left;
        padding-top: 2px;
        margin: auto;
    }

    .clickable .entity:hover {
        cursor: pointer;
        border: 1px aquamarine;
    }

        .clickable .entity:hover .highlight {
            text-shadow: 0 0 5px white, 0 0 5px white;
            font-weight: bold;
            font-size: larger;
        }

    .entity a:hover {
        text-shadow: 0 0 10px white,0 0 10px white;
        font-size: larger;
    }

    .itemLeft {
        text-align: left;
    }

    .itemRight {
        text-align: Right;
    }
</style>

<div class="title">AVF Machine Diagram</div>
<div class="clear"></div>
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        <fieldset>
            <legend>Filter</legend>
            <div class="grid_2">
                &nbsp;
            </div>
                <section id="options" class="clearfix">
                    <ul id="filters" class="option-set clearfix" data-option-key="filter">
            <li><a href="#" data-filter="*" class="selected t-button" onclick="li_OnClick()">All</a></li>
                        </ul>

                </section>
            <div class="grid_2">
                Status
            </div>

            <div>
                <section id="options" class="clearfix">
                    <ul id="filters" class="option-set clearfix" data-option-key="filter">
@{
    foreach (var state in Model.ListState) {
                        <li><a href="#" data-filter=".@state.StateCode" class="t-button" 
                            style="background-color: #@state.WarrningColor;">
                            (@state.WarrningPoint) @state.Description
                            </a></li>
    }
}

                       @* <li><a href="#" data-filter=".M-01" class="t-button">Bình thường</a></li>
                        <li><a href="#" data-filter=":not(.M-01)" class="t-button">Không bình thường</a></li>*@
                    </ul>
                </section>
            </div>
            <div class="clear"></div>
            <div class="grid_2">
                Feature
            </div>

            <div>
                <section id="options" class="clearfix">
                    <ul id="filters" class="option-set clearfix" data-option-key="filter">
@{
    foreach (var func in Model.ListFunction) {
                        <li><a href="#" data-filter=".@func.Code" class="t-button">(@func.Count) @func.Code</a></li>
    }
}
                        </div>
            <div class="clear"></div>

            <div>
            <div class="grid_2">
                Type
            </div>
                <section id="options" class="clearfix">
                    <ul id="filters" class="option-set clearfix" data-option-key="filter">
@{
    foreach (var type in Model.ListType) {
                        <li><a href="#" data-filter=".@type.Code" class="t-button">(@type.Count) @type.Code</a></li>
    }
}
                        </div>
    </fieldset>
</div>
<div class="clear"></div>
@{
    int i = 0;
    var columnWidth = 260;
    var columnSpace = 10;
    var space = 100;
    var divWidth = ((columnWidth + columnSpace) * Model.ListMachineDiagram.Count + space) + "px";
    var containerWidth = (columnWidth + columnSpace) + "px";
    var entityWidth = columnWidth + "px";
    <div style="min-width:@divWidth;">
        @{
            foreach (var list in Model.ListMachineDiagram) {
                i++;
            <div id='container-@i' class="clickable clearfix isotope container" style="width: @containerWidth;">
            @{
                foreach (var entity in list) {
                    <div class='element-@i entity isotope-item ms-@entity.StateCode mf-@entity.MachineFunction mt-@entity.MachineType'
                             style="width:@entityWidth; position: relative; transform: translate3d(5px, 5px, 0px); text-align: left; background-color: white;">

                        <div class="line1">
                            <div class="line-item" style='width: 60%; text-align: left; background-color: #@entity.WarrningColor;'>
                                <span class="itemLeft highlight" style="margin-left: 10px">@entity.MachineName | @entity.MachineType | @entity.MachineFunction</span>
                            </div>
                            <div class="line-item" style='width: 40%; text-align: right; background-color: #ccc2d6; color: #3333cc;'>
                                <span class="itemRight" style="padding-top: 5px; margin-right: 10px; font-weight: bold">@entity.ProductCode</span>
                            </div>
                        </div>

                        <div class="line2">
                            <div class="line-item" style='width: 35%; text-align:center; font-weight:bold; background-color: #@entity.WarrningColor; color: #3333cc;'>
                                <div class="machineTiming" id="machine-@entity.MachineId" machineid ="@entity.MachineId" seconds="@entity.Seconds">
                                    <timing>
                                    <day  class="totalDays"></day>
                                    <time  class="timing">0</time>
                                </timing>
                                </div>
                            </div>
                            <div class="line-item" style="width: 65%; text-align: center; background-color: #996600; color: white;">
                                <span class="itemLeft">@entity.MaterialCode</span>
                            </div>
                        </div>

                        <div class="line3">
                            <div style="height: 10px; float: left; padding-bottom: 2px;">
                                <span class="itemLeft">Status: @entity.StateName</span>
                            </div><br />
                            <div style="height: 10px; float: left; padding-bottom: 2px;">
                                <span class="itemLeft">Start date: @entity.StartDateString</span>
                            </div><br />
                            <div style="height: 10px; float: left; padding-bottom: 2px;">
                                <span class="itemLeft">End date: @entity.EndDateString</span>
                            </div><br />
                            <div style="height: 10px; float: left; padding-bottom: 2px;">
                                <span class="itemLeft">Productivity: @entity.ProductionPerDayStr</span>
                            </div><br />
                            <div style="height: 10px; float: left; padding-bottom: 2px;">
                                <span class="itemLeft">Production Quantity: @entity.ProductionStr</span>
                            </div>
                        </div>

                        <div class="line4">
                            <div style="width: 100%; height: 10px; float: left; text-align: center;">
                                <span class="itemRight">@{ @Html.ActionLink("More", "MachineLog", "Machine", new { id = entity.MachineId }, null)}</span>| 
                            <span class="itemRight">@{ @Html.ActionLink("QC/QA", "ProductionOnTesting", "Production", new { machineId = entity.MachineId, productId = entity.ProductId }, null)}</span>
                            </div>
                        </div>
                    </div>

                    if (list.Last().MachineId == entity.MachineId) {
                    <div style="overflow: hidden; height: 100px; width: 230px; padding-right: 5px; display: block; float: left">
                    </div>
                    }
                }
                }
            </div>
            }
        }
    </div>
}

<div class="clear"></div>
