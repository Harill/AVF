@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@model MachineDiagram
@{
    ViewBag.Title = "Production Testing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        function ShowMachineIndex() {
            var combobox = document.getElementById('cboMachineIndex');
            //var combobox = $("#cboMachineIndex");
            if (combobox.hidden == true)
                combobox.hidden = false;
            else
                combobox.hidden = true;
        }

        function MachineIndex_OnChange() {

            var machineId = $("#machineId").text();
            var combobox = $(this).data('tComboBox');
            var message = "Đổi vị trí với: " + combobox.$text.val();
            message += "\nĐồng ý lưu ??";
            if (confirm(message)) {
                // Save it!
                $.ajax({
                    type: 'post',
                    data: {
                        machineIdFrom: machineId,
                        machineIdTo: combobox.$element.val()
                    },
                    dataType: 'json',
                    url: '@Url.Action("SwapMachineIndex", "Machine")',
                    timeout: 20000,
                    success: function(data) {
                        if (data == 0) {
                            alert("lỗi");
                            combobox.text("");
                            combobox.close();
                        } else if (data == 9) {
                            alert("lỗi ! vui lòng F5 để làm lại");
                            combobox.text("");
                            combobox.close();
                        } else if (data == 8)
                            alert("lỗi ! vui lòng chọn lại vị trí cần đổi!");
                        else {
                            alert("Đổi vị trí: "+data + " thành công");
                            document.getElementById('MachineDiagramName').innerText = data;
                            combobox.text("");
                            combobox.close();
                            document.getElementById('cboMachineIndex').hidden = true;
                        }
                    }
                });
            } else {
                //e.preventDefault();
                combobox.text("");
                combobox.close();
            }
        }

    </script>
}
<span id="machineId" hidden>@Model.MachineId</span>
<div class="title">Đo kiểm sản xuất</div>
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

        <fieldset>
            <legend>Thông tin</legend> 
          <div class="grid_3">Máy:</div>
            
          <div class="grid_3">Sản phẩm</div>
          <div class="grid_3">Nhân viên đo</div>
          <div class="grid_3">Trực thuộc</div>
            
        <div class="clear"></div>
            <div class="grid_3">@Model.MachineName</div>
            <div class="grid_3">@Model.ProductCode</div>
            <div class="grid_3"></div>
            <div class="grid_3"></div>
        </fieldset>
</div>

