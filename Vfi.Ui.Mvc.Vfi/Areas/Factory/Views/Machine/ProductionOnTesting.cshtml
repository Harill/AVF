<div class="title">Nhật ký máy</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<MachineLogModel>()
            .Name("gridMachineLog")
            .DataKeys(key => key.Add(f => f.MachineId).RouteKey("machineId"))
            .DataBinding(
                dataBinding => dataBinding.Ajax().Select("SelectMachineLogsById", "Machine", new { machineId = @Model.MachineId }))
            .Columns(columns =>
                {
                    columns.Bound(f => f.ModifiedDate).Title("Ngày ghi").Width(85).Format("{0:dd/MM/yyyy HH:mm:ss}");
                    columns.Bound(f => f.TypeName).Width(100).Title("Loại");
                    columns.Bound(f => f.Note).Width(765).Title("Nhật ký");
                    columns.Bound(f => f.ModifiedUser).Width(70).Title("Người tạo");
                })
            .Editable(editing => editing.Mode(GridEditMode.InLine))
            .Scrollable(f => f.Height("auto"))
            .ClientEvents(e => e.OnError("grid_OnError"))
            //.HtmlAttributes(new { style = "width: 950px;" })
            .Sortable()
            .Filterable()
            .Pageable(p => p.PageSize(10))
            .Resizable(resizing => resizing.Columns(true))
            .Render();    
    }
