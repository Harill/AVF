@using Telerik.Web.Mvc.UI
@{
    Html.Telerik().ComboBox()
        .Name(ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty))
        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMachineState", "Machine", new { area = "Factory"}).Delay(350))
        //.HtmlAttributes(new { style = "width: 200px" })
        .DropDownHtmlAttributes(new { style = "width: 200px" })
        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
        .HighlightFirstMatch(true)
        .AutoFill(true)
        .ClientEvents(e => e.OnClose("state_OnChange"))
        .Render();
}
