
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@model GroupMachineDiagram
@{
    ViewBag.Title = "Sơ đồ máy CNC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
   
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.isotope.min.js")"   ></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/easytimer.min.js")"   ></script>
    <script type="text/javascript">
        $(function () {
            var $container = $("#container-1");
            //khoang cach giua cac item
            $container.isotope({
                itemSelector: '.element-1',
            });
            $container.delegate('.element-1', 'click', function () {
                $(this).toggleClass('large');
                $container.isotope('reLayout');
            });

            var $container2 = $("#container-2");
            //khoang cach giua cac item
            $container2.isotope({
                itemSelector: '.element-2',
            });
            $container2.delegate('.element-2', 'click', function () {
                $(this).toggleClass('large');
                $container2.isotope('reLayout');
            });

            var $container3 = $("#container-3");
            //khoang cach giua cac item
            $container3.isotope({
                itemSelector: '.element-3',
            });
            $container3.delegate('.element-3', 'click', function () {
                $(this).toggleClass('large');
                $container3.isotope('reLayout');
            });

            var $container4 = $("#container-4");
            //khoang cach giua cac item
            $container4.isotope({
                itemSelector: '.element-4',
            });
            $container4.delegate('.element-4', 'click', function () {
                $(this).toggleClass('large');
                $container4.isotope('reLayout');
            });

            $('#filters a').click(function () {
                var selector = $(this).attr('data-filter');
                
                $container.isotope({ filter: selector });
                $container2.isotope({ filter: selector });
                $container3.isotope({ filter: selector });
                $container4.isotope({ filter: selector });
                return false;
            });
        });

        $(document).ready(function () {
            //timerTarget(1);
            //timerTarget(2);
            //timerTarget(3);
            var machineTimings = document.getElementsByClassName('machineTiming');
            console.log(machineTimings.length);
            for (var i = 0; i < machineTimings.length; i++) {
                var element = machineTimings[i];
                //console.log(element);
                var machineId = element.getAttribute('machineid');
                //console.log(machineId);
                timerTarget2(machineId);
            }
            document.getElementById("title").childNodes[1].style.color = 'steelblue';
            document.getElementById("logindisplay").childNodes[1].style.color = 'steelblue';
        });
        function timerTarget2(target) {
            var timer = new easytimer.Timer();
            var seconds = $('#machine-' + target).attr('seconds');
            var sec_num = Math.floor(seconds);
            timer.start({ startValues: { seconds: sec_num } });
            timer.addEventListener('secondsUpdated', function (e) {
                $('#machine-' + target + ' .timing').html(timer.getTimeValues().toString(['hours', 'minutes']));
                $('#machine-' + target + ' .totalDays').html(dayStr(timer.getTotalTimeValues().days));
            });
        }
        function dayStr(days) {
            if (days > 0)
                return days + 'N';
            return '';
        }
    </script>
}
<style>
    body {
        background-image: url("");
    }

    .container_24 {
        width: 100%;
    }

    .title {
        padding: 0 15px;
    }

    .isotope-item {
        z-index: 2;
    }

    .isotope-hidden.isotope-item {
        pointer-events: none;
        z-index: 1;
    }

    .isotope,
    .isotope .isotope-item {
        -webkit-transition-duration: 0.8s;
        -moz-transition-duration: 0.8s;
        -ms-transition-duration: 0.8s;
        -o-transition-duration: 0.8s;
        transition-duration: 0.8s;
    }

    .isotope {
        -webkit-transition-property: height, width;
        -moz-transition-property: height, width;
        -ms-transition-property: height, width;
        -o-transition-property: height, width;
        transition-property: height, width;
    }

        .isotope .isotope-item {
            -webkit-transition-property: -webkit-transform, opacity;
            -moz-transition-property: -moz-transform, opacity;
            -ms-transition-property: -ms-transform, opacity;
            -o-transition-property: -o-transform, opacity;
            transition-property: transform, opacity;
        }

    .entity.machine {
        background: #F00;
        background: hsl( 0, 100%, 50%);
    }

    #revok1 {
        background-size: cover;
        background-position: center;
    }

    .entity * {
        margin: 0;
    }

    .entity .name {
        left: 0.5em;
        bottom: 1.6em;
        font-size: 1.05em;
    }

    .clickable .entity:hover {
        cursor: pointer;
        border: 1px aquamarine;
    }

        .clickable .entity:hover h3 {
            text-shadow: 0 0 10px white,0 0 10px white;
        }

    .isotope a:hover {
        text-shadow: 0 0 10px white,0 0 10px white;
        font-size: 14px;
    }

    .clickable .entity:hover h1 {
        text-shadow: 0 0 5px white,0 0 5px white;
        font-weight: bold;
        font-size: 17px;
    }

    .clickable .entity:hover h2 {
        color: white;
    }


    .entity {
        width: 260px;
        height: 40px;
        margin: 5px;
        float: left;
        overflow: hidden;
        position: relative;
        background: #888;
        color: #222;
        -webkit-border-radius: 10px;
        -moz-border-radius: 10px;
        border-radius: 10px;
    }

        .entity.large {
            width: 260px;
            height: 120px;
            z-index: 100;
            -webkit-border-radius: 10px;
            -moz-border-radius: 10px;
            border-radius: 10px;
        }

    .itemInfo {
        width: 100%;
        display: block;
    }

    .itemLeft {
        text-align: left;
    }

    .itemRight {
        text-align: Right;
    }

    .column {
        text-align: Right;
    }
    
    #container-1 {
        margin-right: 100px;
    }
    #container-3 {
        margin-right: 100px;
    }

    #filters {
        margin: 0;
    }

    #options li {
        float: left;
        display: list-item;
    }

    #options .selected {
        background-color: #13F;
        text-shadow: none;
        color: white;
    }

    #options li a {
        display: block;
        padding: 0.4em 0.5em;
        background-color: #DDD;
        color: #222;
        font-weight: bold;
        text-shadow: 0 1px hsla( 0, 0%, 100%, 0.5 );
        background: none;
    }

        #options li a:hover {
            background-color: cornflowerblue;
            font-weight: bolder;
        }

        #options li a:active {
            background-color: cornflowerblue;
            font-weight: bolder;
        }
</style>

