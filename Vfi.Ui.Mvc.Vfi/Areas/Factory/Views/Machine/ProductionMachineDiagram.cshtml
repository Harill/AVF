        //box-shadow: inset 0 0 0 1000px
        i++;
            <div id='container-@i' class="clickable clearfix isotope" style="position: relative; overflow: hidden; height: auto;width: 270px;float: left;">
                @{
        foreach (var entity in list) {
                        <div class='element-@i machine-@entity.MachineType entity isotope-item @entity.StateCode @entity.MachineFunction @entity.MachineType '  id="revok" data-symbol="@entity.MachineState" data-category="@entity.MachineType" 
                             style="position: relative; transform: translate3d(5px, 5px, 0px); text-align: left; background-color: white;">
                            <div style=" height: 40px; display: block; text-align: center">
                                <div style='width: 60%; height: 18px; float: left; text-align: left; padding-top: 2px; background-color: #@entity.WarrningColor;'>
                                    <h1 class="name" style="margin-left: 10px">@entity.MachineName | @entity.MachineType | @entity.MachineFunction</h1>
                                </div>
                                <div style='width: 40%; height: 18px; float: left; text-align: right; padding-top: 2px; background-color: #ccc2d6; color: #3333cc;'>
                                    <span class="itemRight" style="padding-top: 5px; margin-right: 10px; font-weight: bold" >@entity.ProductCode</span>
                                </div>
                                
                                <div style='width: 35%; height: 18px; float: left; padding-top: 2px; text-align:center; font-weight:bold; background-color: #@entity.WarrningColor; color: #3333cc;'>
                                    <div class="machineTiming" id="machine-@entity.MachineId" machineid ="@entity.MachineId" seconds="@entity.Seconds">
                                        <timing>
                                            <day  class="totalDays"></day>
                                            <time  class="timing">0</time>
                                        </timing>
                                    </div>
                                </div>
                                <div style="width: 65%; height: 20px; float: left; text-align: center; background-color: #996600   ; color: white; padding-top: 2px">
                                    <span class="itemLeft">@entity.MaterialCode</span>
                                </div>
                            </div>

                            <div style="width: 200px; height: 100%; display: block;padding-top: 5px; padding-left: 5px;">
                                <div style="width: 100%; display: block;">
                                    <div style="width: 100%; height: 10px; float: left;padding-bottom: 2px; ">
                                        <span class="itemLeft">Tình trạng:</span>
                                        <span class="itemRight">@entity.StateName</span>
                                    </div>
                                    <div style="width: 100%; height: 10px; float: left;padding-bottom: 2px; ">
                                        <span class="itemLeft">Ngày bắt đầu:</span>
                                        <span class="itemRight">@entity.StartDateString</span>
                                    </div>
                                    <div style="width: 100%; height: 10px; float: left;padding-bottom: 2px; ">
                                        <span class="itemLeft">Ngày kết thúc:</span>
                                        <span class="itemRight">@entity.EndDateString</span>
                                    </div>
                                    <div style="width: 100%; height: 10px; float: left;padding-bottom: 2px; ">
                                        <span class="itemLeft">Năng suất máy:</span>
                                        <span class="itemRight">@entity.ProductionPerDayFormat</span>
                                    </div>
                                    <div style="width: 100%; height: 10px; float: left;padding-bottom: 2px; ">
                                        <span class="itemLeft">Tổng sản lượng:</span>
                                        <span class="itemRight">@entity.ProductionStr</span>
                                    </div>
                                   @* <div style="width: 100%; height: 10px; float: left;padding-bottom: 2px; ">
                                        <span class="itemLeft">Dự báo sản xuất:</span>
                                        <span class="itemRight">@entity.ForecastsQualityFormat</span>
                                    </div>*@
                                </div>
                                <div style="width: 100%; height: 10px; float: left; text-align: center;">
                                    <span class="itemRight">@{ @Html.ActionLink("Chi tiết hơn", "MachineLog", "Machine", new { id = entity.MachineId }, null)}</span> | 
                                    <span class="itemRight">@{ @Html.ActionLink("Đo kiểm", "ProductionOnTesting", "Production", new { machineId = entity.MachineId, productId = entity.ProductId }, null)}</span>
                                </div>
                            </div>

                        </div>

            if (list.Last().MachineId == entity.MachineId) {
                            <div style="overflow: hidden; height: 100px; width: 230px; padding-right: 5px;display: block;float: left">
                            </div>
            }
        }
                }
            </div>
    }
    }

