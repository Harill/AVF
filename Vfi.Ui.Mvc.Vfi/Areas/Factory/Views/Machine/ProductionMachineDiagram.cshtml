.isotope-item {
  z-index: 2;
}
.isotope-hidden.isotope-item {
  pointer-events: none;
  z-index: 1;
}
.isotope,
.isotope .isotope-item {
  -webkit-transition-duration: 0.8s;
     -moz-transition-duration: 0.8s;
      -ms-transition-duration: 0.8s;
       -o-transition-duration: 0.8s;
          transition-duration: 0.8s;
}
.isotope {
  -webkit-transition-property: height, width;
     -moz-transition-property: height, width;
      -ms-transition-property: height, width;
       -o-transition-property: height, width;
          transition-property: height, width;
}
.isotope .isotope-item {
  -webkit-transition-property: -webkit-transform, opacity;
     -moz-transition-property:    -moz-transform, opacity;
      -ms-transition-property:     -ms-transform, opacity;
       -o-transition-property:      -o-transform, opacity;
          transition-property:         transform, opacity;
}
.entity.machine          { background: #F00; background: hsl(   0, 100%, 50%); }
#revok1 {
	background-size:cover;
	background-position:center;
}
.entity * {margin: 0;}
.entity .name {
  left: 0.5em;  bottom: 1.6em;  font-size: 1.05em;  }
.clickable .entity:hover {cursor: pointer;
    border: 1px aquamarine;}.clickable .entity:hover h3 {
  text-shadow:0 0 10px white,0 0 10px white;
}.isotope a:hover{
  text-shadow:0 0 10px white,0 0 10px white;
    font-size: 14px;
}.clickable .entity:hover h1 {
  text-shadow:0 0 5px white,0 0 5px white;
  font-weight: bold;
    font-size: 17px;
}
.clickable .entity:hover h2 {color: white;}

.entity {
  width: 260px;
  height: 40px;
  margin: 5px;  float: left;
  overflow: hidden;
  position: relative;
  background: #888;
  color: #222;
  -webkit-border-radius: 10px;
      -moz-border-radius: 10px;
          border-radius: 10px;
}
.entity.large{
  width: 260px;
  height: 120px;
  z-index: 100;
  -webkit-border-radius: 10px;
      -moz-border-radius: 10px;
          border-radius: 10px;
}
.itemInfo {
    width:100%;
    display:block;
}
.itemLeft {
    text-align: left;
}
.itemRight {
    text-align: Right;
}
.column {
    text-align: Right;
}

#container-2 {
    margin-right: 100px;
}
    #filters {
        margin: 0;
    }

        #options li {
            float: left;
            display: list-item;
        }

        #options .selected {
            background-color: #13F;
            text-shadow: none;
            color: white;
        }

        #options li a {
            display: block;
            padding: 0.4em 0.5em;
            background-color: #DDD;
            color: #222;
            font-weight: bold;
            text-shadow: 0 1px hsla( 0, 0%, 100%, 0.5 );
            background: none;
        }

            #options li a:hover {
                background-color: cornflowerblue;
                font-weight: bolder;
            }

            #options li a:active {
                background-color: cornflowerblue;
                font-weight: bolder;
            }
</style>
