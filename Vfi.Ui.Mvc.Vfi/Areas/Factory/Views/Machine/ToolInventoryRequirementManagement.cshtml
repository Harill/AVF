@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Yêu cầu tồn kho";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        var startGrid = false;

        function grid_OnDataBinding(args) {

            if (startGrid) {
                var toolType = $("#ToolType").data('tComboBox').value();
                if (toolType === "")
                    toolType = 0;

                var toolName = $("#ToolName").data('tAutoComplete').value();

                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }

                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }
                args.data = $.extend(args.data,
                {
                    toolName: toolName,
                    toolTypeId: toolType,
                    fromDate: fromDate,
                    toDate: toDate
                });
            }
        }

        function grid_OnSave(e) {
            var toolType = $("#ToolType").data('tComboBox').value();
            if (toolType === "")
                toolType = 0;

            var toolName = $("#ToolName").data('tAutoComplete').value();

            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }

            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            }
            e.values = $.extend(e.values,
                {
                    toolName: toolName,
                    toolTypeId: toolType,
                    fromDate: fromDate,
                    toDate: toDate
                }
            );
        }
    </script>

