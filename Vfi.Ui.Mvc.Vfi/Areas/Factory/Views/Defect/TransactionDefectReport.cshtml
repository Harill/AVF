@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "No-Good Products Report (NG Report)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {
            if (startGrid) {
                var index = 0;
                var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;

                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                args.data = $.extend(args.data, {
                    fromDate: fromDate,
                    toDate: toDate,
                    productCode: productCodeNameForMonthly,
                    customerId: customerId
                });
            }
        }
        var index = 0;


        var startGrid = false;
        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("grid");
        }

    </script>
    <!-- report -->
    <script type="text/javascript">
        function printProductionDefect() {

            var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

            var customerId = $("#CustomerForMonthly").data('tComboBox').value();
            if (customerId === "")
                customerId = 0;

            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#ToDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }
            $('#result').load('@Url.Action("PrintDefectReport", "Defect")',
            {
                fromDate: fromDate,
                toDate: toDate,
                customerId: customerId,
                productCode: productCodeNameForMonthly,
            }, function (data) {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
            return false;
        }

    </script>
}

<div class="title">No-Good Products Report (NG Report)</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: auto;">
 
            <div class="grid_4 prefix_15">
                <button id="btnProductInvTotal" class="t-button" onclick=" return printProductionDefect(); ">
                    <span class='t-icon t-insert'></span>
                    Print Report
                </button>
            </div>
        
        <div class="clear"></div>
        <fieldset>
            <legend>Criteria Filtering</legend>
            <div class="grid_2">
                @Html.Label("Customer Code");
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("CustomerForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 275px" })
                        //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_2">
                Product Code
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeNameForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" } ))
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("FromDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ToDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="grid_4 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2(); ">
                <span class='t-icon t-insert'></span>
                Find
            </button>
            </div>
           

        </fieldset>
    </div>
    <div class="clear">
        
    </div>

    <div class="cover-div">
        @{
            Html.Telerik().Grid<DefectReportModel>()
                .Name("grid")
                .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectTransactionDefectReport", "Defect",
                                                                 new { area = "Factory", fromDate = "", toDate = "", customerId = 0, productCode = "" }))
                .Columns(columns => {
                    columns.Bound(f => f.ProductId)
                           .ClientTemplate("<#= ++index #>")
                           .HeaderTemplate("<strong>Index</strong>").Width(45);

                    columns.Bound(f => f.ReportDateStr).Width(55)
                           .HeaderTemplate("<strong>Report</br>Date</strong>")
                           .HtmlAttributes(new { style = "text-align: center;" });
                    columns.Bound(f => f.GroupName).Width(55)
                           .HeaderTemplate("<strong>Group</br>Name</strong>")
                           .HtmlAttributes(new { style = "text-align: center;" });
                    columns.Bound(f => f.Shift).Width(55)
                           .HeaderTemplate("<strong>Shift</strong>")
                           .HtmlAttributes(new { style = "text-align: center;" });
                    columns.Bound(f => f.MachineName).Width(55)
                           .HeaderTemplate("<strong>Machine</strong>")
                           .HtmlAttributes(new { style = "text-align: center;" });
                    columns.Bound(f => f.ProductCode).Width(70)
                           .HeaderTemplate("<strong>Product</br>Code</strong>")
                           .FooterTemplate("<span id='sum'></span>")
                           .HtmlAttributes(new { style = "text-align: center;" })
                           .Aggregate(agg => agg.Count())
                           .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                           .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                           .FooterTemplate("<span id='tongcot1'></span>");
                    // don hang
                    
                    columns.Bound(f => f.Quantity).Width(80)
                           .HeaderTemplate("<strong>Quantity</br>(pcs)</strong>")
                           .HtmlAttributes(new { style = "text-align: right;" })
                           .Aggregate(agg => agg.Sum())
                           .Format("{0:n0}")
                           .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>")
                           .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>")
                           .FooterTemplate("<span id='tongcot1'></span>");

                    columns.Bound(f => f.IssueWarehouseName).Width(55)
                           .HeaderTemplate("<strong>Warehouse</br>Export</strong>")
                           .HtmlAttributes(new { style = "text-align: center;" });
                    columns.Bound(f => f.TransactionCode).Width(55)
                           .HeaderTemplate("<strong>Transaction</br>Code</strong>")
                           .HtmlAttributes(new { style = "text-align: center;" });
                })
                .Scrollable(f => f.Height(510))
                //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnError("grid_OnError"))
                .Groupable()
                .Render();
        }
    @*@{ Html.Telerik().ScriptRegistrar().OnDocumentReady("applyFrozenColumns();"); }*@
    </div>
</div>

<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
        )
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

<style type="text/css">
    #windowReport {
        /*
            float: right;
            Position: relative;
            */
        min-height: 580px;
        top: 15%;
    }

    #result {
        height: 520px;
        overflow: hidden;
    }

    #ReportBody {
        padding-bottom: 25px;
        margin-bottom: 25px;
    }

    .tb-witdh td {
        width: 55px;
    }
</style>
