@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Product-Inv Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">
        var startGrid = false;

        function gridProductInventoryForMonthly_onDataBinding(args) {
            if (startGrid && !onLoading) {
                OnLoadingData();
                var productCode = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();


                //var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
                //if (monthlyDate === null)
                //    monthlyDate = "";
                //else
                //    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;
                var chkOrder = $("input[name='chkOrder']").attr('checked');
                var chkInventory = $("input[name='chkInventory']").attr('checked');

                args.data = $.extend(args.data, {
                    chkOrder: chkOrder,
                    chkInventory: chkInventory,
                    customerId: customerId,
                    productCode: productCode,
                    monthlyDate: "a"
                });
            }
        }

        var index = 0;

        function grid_OnDataBound() {
            OnLoadedData();
        }

    </script>
    <!-- report -->
    <script type="text/javascript">

        function printProductInvTotal() {

            if (!onLoading) {
                OnLoadingData();
                //var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
                //if (monthlyDate === null)
                //    monthlyDate = "";
                //else
                //    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;

                var chkOrder = $("input[name='chkOrder']").attr('checked');
                var chkInventory = $("input[name='chkInventory']").attr('checked');
                $('#result').load('@Url.Action("PrintProductCurrentReport", "Reporting")',
                    {
                        customerId: customerId,
                        chkOrder: chkOrder,
                        chkInventory: chkInventory,
                        monthlyDate: "a"
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }

    </script>
}

<div class="title">Product-Inv Report</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

        <fieldset>
            <legend>Product-Inv Report</legend>

            <div class="grid_7">
                <div class="grid_2">
                    @Html.Label("Customer Code")
                </div>
                <div class="grid_4">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("CustomerForMonthly")
                            .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                            .HtmlAttributes(new { style = "width: 150px" })
                            .DropDownHtmlAttributes(new { style = "width: 275px" })
                            //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                            .AutoFill(true)
                            .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                            .Render();
                    }
                </div>
                <div class="clear"></div><br />
                <div class="grid_2">
                    @Html.Label("Product Code")
