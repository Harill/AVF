@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model MaterialInventoryModel
@{
    ViewBag.Title = "Annual Materials Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">

        var startGrid = false;
        var index = 0;
        function grid_OnDataBinding(args) {

            if (startGrid) {
                var materialTypeId = $("#MaterialTypeName").data('tComboBox').value();
                if (materialTypeId === "")
                    materialTypeId = 0;

                var year = $("#Year").val();
                if (year === null || year === "")
                    year = new Date().getYear() + 1;
                var materialName = $("#MaterialCodeName").data("tAutoComplete").value();
                args.data = $.extend(args.data,
                {
                    materialCode: materialName,
                    materialTypeId: materialTypeId,
                    year: year
                });
                index = 0;
            }
        }

        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("gridMaterial");
        }
    </script>

}

    <div class="title">Annual Materials Report</div>

    <div id="pnlInv">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        <fieldset>
            <legend>Annual Materials Report</legend>
            <div class="grid_2_5"> Material Type </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("MaterialTypeName")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxAllMaterialType", "Material", new {area = ""}))
                        .HtmlAttributes(new {style = "width: 150px"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        .SelectedIndex(0)
                        .Render();
                }
            </div>
            <div class="grid_1_5"> Material </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("MaterialCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedMaterialInventory", "Inv", new {materialTypeId = 0}))
                        //.HtmlAttributes(new { style = "width: 185px; " })
                        .DropDownHtmlAttributes(new {style = "width: 250px; "})
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_1"> Year </div>
            <div class="grid_2">
                    @{
                        Html.Telerik().AutoComplete()
                            .Name("Year")
                            .Value(DateTime.Now.Year + "")
                            .HtmlAttributes(new {style = "width: 40px"})
                            .Render();
                    }
                </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick="return RefreshGrid2(); ">
                    <span class='t-icon t-insert'></span>
                    Find
                </button>
            </div>
        </fieldset>

    </div>
    <div class="clear"></div>
    <div class="cover-div">
