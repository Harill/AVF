@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "Production Material Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        var startGrid = false;
        var index = 0;

        function grid_OnDataBinding(args) {

            if (startGrid) {
                var materialTypeId = $("#MaterialTypeName").data('tComboBox').value();
                if (materialTypeId === "")
                    materialTypeId = 0;

                var materialName = $("#MaterialCodeName").data("tAutoComplete").value();
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                args.data = $.extend(args.data,
                {
                    materialCode: materialName,
                    materialTypeId: materialTypeId,
                    fromDate: fromDate,
                    toDate: toDate
                });
            }
            index = 0;
        }

        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("grid");
        }
    </script>
}

    <div class="title">Production Material Report</div>   @*Báo cáo theo dõi nguyên liệu sản xuất*@

    <div id="pnlInv">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        <fieldset>
            <legend>Criteria Filtering</legend>
            <div class="grid_1_5">
                Material Type
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("MaterialTypeName")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxAllMaterialType", "Material", new {area = ""}))
                        .HtmlAttributes(new {style = "width: 150px"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        .SelectedIndex(0)
                        .Render();
                }
            </div>
            <div class="grid_1_5">
                Material
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("MaterialCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedMaterialInventory", "Inv", new {materialTypeId = 0}))
                        //.HtmlAttributes(new { style = "width: 185px; " })
                        .DropDownHtmlAttributes(new {style = "width: 250px; "})
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_1">
                Date
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Now.AddDays(-7))
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("toDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Now)
                        .Render();
                }
            </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick="return RefreshGrid2(); ">
                    <span class='t-icon t-insert'></span>
                    Find
                </button>
            </div>
        </fieldset>

    </div>
    <div class="clear"></div>
    <div class="cover-div">
    @{
        Html.Telerik().Grid<MaterialProductionReport>()
            .Name("grid")
            .DataKeys(keys => keys.Add(f => f.MaterialId).RouteKey("materialId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectMaterialProductionReport", "Reporting",
                    new
                    {
                        materialCode = "",
                        materialTypeId = 0,
                        fromDate = "",
                        toDate = ""
                    })
            )
            .Columns(columns =>
            {
                columns.Bound(f => f.MaterialId).Width(55).ReadOnly(true).Title("Index")
                    .ClientTemplate("<#= ++index #>");
                columns.Bound(f => f.MaterialTypeCode).Width(50).ReadOnly(true)
                    .HeaderTemplate("Type");
                columns.Bound(f => f.MaterialName).Width(80).ReadOnly(true)
                    .HeaderTemplate("<strong>Material</br>Name</strong>")
                    .Aggregate(agg => agg.Count())
                    .ClientGroupFooterTemplate("<#= Count #>")
                    .ClientFooterTemplate("<#= Count #>")
                    .HtmlAttributes(new {style = "text-align: left;"});
                columns.Bound(f => f.Shape).Width(55).ReadOnly(true)
                    .HeaderTemplate("<strong>Shape</strong>")
                    .HtmlAttributes(new {style = "text-align: center;"});
                columns.Bound(f => f.OutDiameter).Width(50).ReadOnly(true)
                    .HeaderTemplate("<strong>OD</strong>")
                    .HtmlAttributes(new {style = "text-align: center;"});
                columns.Bound(f => f.InDiameter).Width(50).ReadOnly(true)
                    .HeaderTemplate("<strong>ID</strong>")
                    .HtmlAttributes(new {style = "text-align: center;"});
                columns.Bound(f => f.DiameterType).Width(80).ReadOnly(true)
                    .HeaderTemplate("<strong>Tolerance</strong>")                   // Dung</br>sai
                    .HtmlAttributes(new {style = "text-align: center;border-right: 1px solid black;"});
                //
                columns.Bound(f => f.EarlyQuantity).Width(80).ReadOnly(true)
                    .HeaderTemplate("<strong>Early</br>Inv</br>(kg)</strong>")               //Tồn</br>đầu
                    .Format("{0:n2}")
                    .HtmlAttributes(new {style = "text-align: right;"});
                columns.Bound(f => f.Import).Width(70).ReadOnly(true)
                    .HeaderTemplate("<strong>Buying</br>Import</br>(kg)</strong>")               //Nhập</br>mua
                    .Format("{0:n2}")
                    .HtmlAttributes(new {style = "text-align: right;"});
                columns.Bound(f => f.Export).Width(70).ReadOnly(true)
                    .HeaderTemplate("<strong>Uses</br>(kg)</strong>")                       //Sử</br>dụng
                    .Format("{0:n2}")
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.LastQuantity).Width(80).ReadOnly(true)
                    .HeaderTemplate("<strong>Last</br>Inv</br>(kg)</strong>")                       //Tồn</br>cuối
                    .Format("{0:n2}")
                    .HtmlAttributes(new { style = "text-align: right;border-right: 1px solid black;" });
                //
                columns.Bound(f => f.ProductCode).Width(120).ReadOnly(true)
                    .HeaderTemplate("<strong>Product</strong>");
                columns.Bound(f => f.MachineName).Width(80).ReadOnly(true)
                    .HeaderTemplate("<strong>Machine</strong>")                //Máy</br>SX
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.ProductionWeight).Width(90).ReadOnly(true)
                    .Format("{0:n3}")
                    .HeaderTemplate("<strong>Workpiece</br>Weight</strong>");              //TL phoi
                columns.Bound(f => f.ProductInv).Width(80).ReadOnly(true)
                    .HeaderTemplate("<strong>Product</br>Inv(pcs)</strong>")        //Tồn kho</br>SP
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.ProductForecast).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Production</br>Forecast</br>ByPO</strong>")            //Dự báo</br>sản xuất</br>theo PLM
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.OrderForecast).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Order</br>Forecast</br>Inv(pcs)</strong>")           //Dự báo</br>đơn hàng</br>tồn (pcs)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.AvgOrder).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Avg Order</br>From</br>M1</strong>")                //TB ĐH</br>từ</br>đầu năm
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.OrderQuantity).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Remaining</br>Order</br>(pcs)</strong>")              //Đơn hàng</br>còn lại</br>(pcs)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.RequireInv).Width(120).ReadOnly(true)
                    .HeaderTemplate("<strong>Inv</br>Require(pcs)</strong>")               //Yêu cầu</br>tồn (pcs)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.ProductionPlan).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Productivity</br>(pcs/day)</strong>")             //Năng suất</br>(pcs/day)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.ProductionQuantity).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Production</br>Quantity</br>(pcs)</strong>")             //Sản lượng</br>(pcs)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;border-right: 1px solid black;" });
                //
                columns.Bound(f => f.ProductionPlanDateString).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Production</br>Delay</br>(Plan)</strong>")          //    Ngày</br>ngưng SX</br>(KH)
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.ProductionDateString).Width(90).ReadOnly(true)
                    .HeaderTemplate("<strong>Production</br>Delay</br>(Actual)</strong>")              //Ngày</br>ngưng SX</br>(TT)
                    .HtmlAttributes(new { style = "text-align: right;border-right: 1px solid black;" });
                //
                columns.Bound(f => f.AvgExport).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Avg Material</br>Import</br>(kg/day)</strong>")            //TB</br>xuất NL</br>(kg/ngày)
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.ExportDateString).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Out Of</br>Material</br>Date</strong>")                     //Ngày</br>hết NL
                    .HtmlAttributes(new { style = "text-align: right;border-right: 1px solid black;" });
                //
                columns.Bound(f => f.RequireInvKg).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Inv</br>Plan</br>Product(kg)</strong>")                // Kế hoạch</br>tồn kho</br>SP (kg
                    .Format("{0:n2}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.AvgExport).Width(130).ReadOnly(true)
                    .HeaderTemplate("<strong>Material</br>Back-up Plan</br>(kg)</strong>")       //Dự phòng</br>nguyên liệu</br>(kg)
                    .Format("{0:n2}")
                    .HtmlAttributes(new { style = "text-align: right;border-right: 1px solid black;" });
                //
                columns.Bound(f => f.PoQuantity).Width(80).ReadOnly(true)
                    .HeaderTemplate("<strong>PO</br>Material</br>(kg)</strong>")             //PO</br>nguyên liệu
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.PoDate).Width(80).ReadOnly(true)
                    .HeaderTemplate("<strong>PO Date</br>(Nearest)</strong>")              //Ngày PO</br>(gần nhất)<
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.MaterialUse).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Production Material</br>(On Machine)</strong>")                 //NLSX</br>(theo máy)
                    .Format("{0:n2}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.ProductionQuantityByTrack).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Production</br>Cumulative</strong>")                 //Luỹ kế</br>sản xuất
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.MaterialUseKgByTrack).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Production</br>Material</br>Cumulative</strong>")          //Luỹ kế</br>NLSD
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.ProductExport).Width(100).ReadOnly(true)
                    .HeaderTemplate("<strong>Import</br>Cumulative</strong>")                         //Luỹ kế</br>xuất
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                //
            })
            .Scrollable(f => f.Height(510))
            //.HtmlAttributes(new { style = "width: 950px;" })
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .Groupable()
            .ClientEvents(events => events.OnError("grid_OnError")
                .OnDataBinding("grid_OnDataBinding"))
            .Render();
    }
    </div>
    </div>

    <!-- windown -->
    @{
        Html.Telerik().Window()
            .Name("windowReport")
            .Modal(true)
            .Draggable(true)
            .Content
            (
                @<text>
                    <div id="result"></div>
                 </text>
            )
            //.ClientEvents(e => e.OnLoad("Window_onLoad"));
            .Visible(false)
            .Width(960)
            .Render();
    }

    <style type="text/css">
        #windowReport {
            /*
            float: right;
            Position: relative;
            */
            min-height: 580px;
            top: 15%;
        }

        #result {
            height: 520px;
            overflow: hidden;
        }

        #ReportBody {
            padding-bottom: 25px;
            margin-bottom: 25px;
        }

        .tb-witdh td {
            width: 55px;
        }
    </style>

