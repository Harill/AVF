@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Production2 Plan";
    //Sản xuất 2
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        startGrid = false;
        var index = 0;
        function grid_OnDataBinding(e) {

            if (startGrid && !onLoading) {
                OnLoadingData();
                var productCode = $("#ProductCode").data("tAutoComplete").value();

                var customerId = $("#Customer").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;

                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                e.data = $.extend(e.data, {
                    fromDate: fromDate,
                    toDate: toDate,
                    productCode: productCode,
                    customerId: customerId,
                });
            }
            index = 0;
        }
        function PrintExpectedProduction2Plan() {
            if (!onLoading) {
                OnLoadingData();
                var productCode = $("#ProductCode").data("tAutoComplete").value();

                var customerId = $("#Customer").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;

                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                $('#result').load('@Url.Action("PrintExpectedProduction2Plan", "Reporting")',
                    {
                        fromDate: fromDate,
                        toDate: toDate,
                        productCode: productCode,
                        customerId: customerId,
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }
        function grid_OnRowDataBound(e) {
            if (e.dataItem.OrderDueDate != null && e.dataItem.OrderDueDate < Date.now()) {
                e.row.cells[12].bgColor = 'red';
            }
            if (e.dataItem.ForecastDueDate != null && e.dataItem.ForecastDueDate < Date.now()) {
                e.row.cells[18].bgColor = 'red';
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }

        if (!onLoading) {
            OnLoadingData();
        }
    </script>
}


<div class="title">Production2 Plan</div>       @*Kế hoạch sản xuất 2*@
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

    <fieldset>
        <legend>Criteria Filtering</legend>
            <div class="grid_2">
                @Html.Label("Customer Code")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Customer")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 275px" })
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_2">
                @Html.Label("Product Code")
@*                @Html.LabelFor(f => f.ProductCodeName)*@
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCode")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                        .DropDownHtmlAttributes(new { style = "width: 200px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
        <div class="grid_3">
            @{
                    Html.Telerik().DatePicker()
                        .Name("FromDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Now.Year,DateTime.Now.Month,1))
                        .Render();
            }
            @{
                    Html.Telerik().DatePicker()
                        .Name("ToDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1))
                        .Render();
            }
        </div>
        <div class="grid_3">
        </div>
        <div class="grid_3">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('grid'); ">
                <span class='t-icon t-insert'></span>
                Find    
		        <span class="loadButton"></span>
            </button>
        </div>
        <div class="grid_3">
            <button id="btnProductInvTotal2" class="t-button" onclick=" return PrintExpectedProduction2Plan(); ">
                <span class='t-icon t-insert'></span>
                Print Report
		        <span class="loadButton"></span>
            </button>
        </div>

    </fieldset>
</div>

<div class="cover-div">
    @{
