                            .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                            .FooterHtmlAttributes(new { style = "text-align: center;" });

                    columns.Bound(f => f.SectionCount).Width(60)
                           .HeaderTemplate("Section")                  //Công<br/>đoạn
                           .HtmlAttributes(new { style = "text-align: center;border-left:1px solid black;" })
                           .Aggregate(agg => agg.Sum())
