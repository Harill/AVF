@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Sản xuất 2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        startGrid = false;
        var index = 0;
        function grid_OnDataBinding(e) {

            if (startGrid && !onLoading) {
                OnLoadingData();
                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                e.data = $.extend(e.data, {
                    fromDate: fromDate,
                    toDate: toDate,
                });
            }
            index = 0;
        }
        function PrintExpectedProduction2Plan() {
            if (!onLoading) {
                OnLoadingData();
                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                $('#result').load('@Url.Action("PrintExpectedProduction2Plan", "Reporting")',
                    {
                        fromDate: fromDate,
                        toDate: toDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }
        function grid_OnRowDataBound(e) {
            if (e.dataItem.OrderDueDate != null && e.dataItem.OrderDueDate < Date.now()) {
                e.row.cells[12].bgColor = 'red';
            }
            if (e.dataItem.ForecastDueDate != null && e.dataItem.ForecastDueDate < Date.now()) {
                e.row.cells[18].bgColor = 'red';
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }

        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }
        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }

        if (!onLoading) {
            OnLoadingData();
        }
    </script>
}


<div class="title">Kế hoạch sản xuất 2</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

    <fieldset>
        <legend>Tiêu chí trích lọc</legend>
        <div class="grid_3">
            @{
                    Html.Telerik().DatePicker()
                        .Name("FromDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Now.Year,DateTime.Now.Month,1))
                        .Render();
            }
        </div>
        <div class="grid_3">
            @{
                    Html.Telerik().DatePicker()
                        .Name("ToDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1))
                        .Render();
            }
        </div>
        <div class="grid_3">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('grid'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
		        <span class="twoToneButton"></span>
            </button>
        </div>
        <div class="grid_3">
            <button id="btnProductInvTotal2" class="t-button" onclick=" return PrintExpectedProduction2Plan(); ">
                <span class='t-icon t-insert'></span>
                In báo cáo
		        <span class="twoToneButton"></span>
            </button>
        </div>

    </fieldset>
</div>

