                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.RealProductions[6].ProductionQuantity).Width(80)
                               .HeaderTemplate("<span id='Day7'>D[07]</br>Actual</span>")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;border-right: 2px solid black;" });

                        columns.Bound(f => f.ProductionCountCalculate).Width(120)
                               .HeaderTemplate("Production</br>Days</br>(days)")               //Số ngày</br>sản xuất</br>(ngày)
                               .Format("{0:n0}")
                               .HtmlAttributes(new { style = "text-align: right;border-right: 2px solid black;" });
                        columns.Bound(f => f.ProductionQuantity).Width(100)
                               .HeaderTemplate("Production</br>Actual</br>(pcs/week)")           //Thực tế</br>sản xuất</br>(pcs/tuần)
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.ProductionQuantityCalculate).Width(100)
                               .HeaderTemplate("Production</br>Plan</br>(pcs/week)")          //Kế hoạch</br>sản xuất</br>(pcs/tuần)
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.WeeklyPlanExecuteCalculate).Width(100)
                               .HeaderTemplate("Remaining</br>Plan</br>(pcs/week)")       //Kế hoạch</br>còn lại</br>(pcs/tuần)
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.WeeklyPlanRateCalculate).Width(100)
                               .HeaderTemplate("Actual/Plan</br>(%)")                 //TT/KH</br>(%)
                               .Format("{0:n0}")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.OrderNote).Width(150)
                               .HeaderTemplate("Order</br>Note");         //Ghi chú</br>đơn hàng
                    
                    })
                .Scrollable(f => f.Height(510))
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .Selectable()
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnRowDataBound("grid_OnRowDataBound")
                                            .OnRowSelect("grid_OnRowSelect")
                                            .OnError("grid_OnError")
                                            .OnDataBound("grid_OnDataBound"))
                .Groupable()
                .Render();
    }
</div>
