@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Employee Revenue Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{

   
    <script type="text/javascript">

        function RefreshGrid2() {
            $("#SalesChart").data("tChart").refresh();
        }

        function Chart_OnDataBinding(e) {
            //var year = $("#Year").data("tAutoComplete").value();
            //if (year === "")
            //    year = getDate().year;
            //e.data = $.extend(e.data, {
            //    year: year
            //});
        }
    </script>
}

    <div class="title">Employee Revenue Report
        @*Báo cáo doanh thu nhân viên*@

    </div>
    <div class="clear"></div>
    <br />

    <div id="pnlInvMonthly">
        <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
            <fieldset>
                <legend>Filters</legend>
                <div class="grid_1">
                    @Html.Label("Year")
                </div>
                <div class="grid_1">
                    @{
                        Html.Telerik().AutoComplete()
                            .Name("Year")
                            .Value(DateTime.Now.Year + "")
                            .HtmlAttributes(new {style = "width: 42px"})
                            .Render();
                    }
                </div>
                <div class="grid_3 prefix_1">
                    <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2(); ">
                        <span class='t-icon t-insert'></span>
                       Find
                    </button>
                </div>
            </fieldset>
        </div>
        <div class="clear">
        </div>

        <div class="cover-div" style="background: white">
              
            @{
                Html.Telerik().Chart<EmployeeChart>()
                    .Name("SalesChart")
                    //.Theme(Html.GetCurrentTheme())
                    .Title("Representative Sales vs. Total Sales")
                    .Legend(legend => legend
                                          .Position(Telerik.Web.Mvc.UI.ChartLegendPosition.Bottom)
                    )
                    .SeriesDefaults(series =>
                                    series.Bar().Labels(labels => labels.Visible(true).Format("${0:#,##0}"))
                    )
                    .Series(series =>
                        {
                            //series.Bar("EmployeeName").Name("Nhân viên");
                            series.Bar(s => s.TotalSales).Name("Total Sales")
                                  .Labels(labels => labels
                                                        .Position(Telerik.Web.Mvc.UI.ChartBarLabelsPosition.InsideEnd)
                                );
                        })
                    .CategoryAxis(axis => axis
                                              .Categories(s => s.ReportDateString)
                    )
                    .ValueAxis(axis => axis
                                           .Numeric().Labels(labels => labels.Format("${0:#,##0}"))
                    )
                    .DataBinding(dataBinding => dataBinding
                                                    .Ajax().Select("GetSalesInfo", "Reporting")
                    )
                    .HtmlAttributes(new {style = "width: 670px; height: 500px;"})
                    .Render();
            }
        </div>
    </div>

    <!-- windown -->
    @{
        Html.Telerik().Window()
            .Name("windowReport")
            .Modal(true)
            .Draggable(true)
            .Content
            (
                @<text>
                     <div id="result"></div>
                 </text>
            )
            //.ClientEvents(e => e.OnLoad("Window_onLoad"));
            .Visible(false)
            .Width(960)
            .Render();
    }

    <style type="text/css">
        #windowReport {
            /*
            float: right;
            Position: relative;
            */
            min-height: 580px;
            top: 15%;
        }

        #result {
            height: 520px;
            overflow: hidden;
        }

        #ReportBody {
            padding-bottom: 25px;
            margin-bottom: 25px;
        }

        .tb-witdh td {
            width: 55px;
        }
    </style>
