@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "General Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">

        function gridProductInventoryForMonthly_onDataBinding(args) {

            var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

            var customerId = $("#CustomerForMonthly").data('tComboBox').value();

            var month = $("#Month").data("tDropDownList").value();
            if (month === null)
                month = new Date().getMonth() + 1;
            var type = $("#Type").data("tDropDownList").value();
            if (type === null)
                type = 2;
            var year = $("#Year").val();
            if (year === null || year == "")
                month = new Date().getYear() + 1;
            if (customerId == 0)
                customerId = 0;

            args.data = $.extend(args.data, {
                type: type,
                customerId: customerId,
                productName: productCodeNameForMonthly,
                month: month,
                year: year
            });

        }
        var index = 0;

        function gridProductInventoryForMonthly_onDataBound() {
            //var sum = 0;
            //$("span[name='sumMonthly']").each(function () {
            //    sum = sum + parseInt($(this).text());
            //});
            //$("#sumMonthly").text(sum);

            //for (var i = 7; i <= 18; i++) {
            //    var total = 0;
            //    $("span[name='cot" + i + "']").each(function () {
            //        total = total + parseInt($(this).text());
            //    });
            //    $("#tongcot" + i).text(total);
            //}
        }
    </script>
    <!-- report -->
    <script type="text/javascript">
        function printImportExportProduction() {

            var month = $("#Month").data("tDropDownList").value();
            if (month === null)
                month = new Date().getMonth() + 1;
            var type = $("#Type").data("tDropDownList").value();
            if (type === null)
                type = 2;
            var year = $("#Year").val();
            if (year === null || year == "")
                month = new Date().getYear() + 1;

            $('#result').load('@Url.Action("PrintImportExportProduction", "Inv")',
                {
                    type: type,
                    month: month,
                    year: year
                }, function (data) {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        //function applyFrozenColumns() {
        //    $('#CustomerGrid').freezeGridColumn(2);
        //}
        function type_onLoad() {
            var combobox = $('#Type').data('tDropDownList');
            var dataSource =
            [
                { Text: "Tất cả", Value: "1" },
                { Text: "Trong tháng", Value: "2" }
            ];

            combobox.dataBind(dataSource);
            combobox.value("Trong tháng");
        }
        function month_onLoad() {
            var combobox = $('#Month').data('tDropDownList');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            combobox.value(new Date().getMonth() + 1);
        }
    </script>
}

<div class="title">Báo cáo xuất nhập tồn thành phẩm</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">


        <div class="clear"></div>
            <div class="grid_4 prefix_15">
        
                <button id="btnImportExportProduction" class="t-button" onclick=" return printImportExportProduction(); ">
                    <span class='t-icon t-insert'></span>
                    Xuất báo cáo
                </button>
            </div>
        <br />

        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
            <div class="grid_3">
                @{
                       Html.Telerik().DropDownList()
                           .Name("Type")
                           .HtmlAttributes(new {style = "width: 100px"})
                           .DropDownHtmlAttributes(new { style = "width: 100px" })
                           //.Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                          // .HighlightFirstMatch(true)
                           //.AutoFill(true)
                           .ClientEvents(events => events.OnLoad("type_onLoad"))
                           .Render();
                   }
            </div>
            <div class="grid_2">
                @Html.Label("Mã  KH")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("CustomerForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 275px" })
                        //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_2">
                @Html.LabelFor(f => f.ProductCodeName)
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeNameForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                        .DropDownHtmlAttributes(new { style = "width: 200px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            
            <div class="grid_1">
                @Html.Label("Tháng")
            </div>
            <div class="grid_1">
                @{
                    Html.Telerik().DropDownList()
                        .Name("Month")
                        .HtmlAttributes(new {style = "width: 40px"})
                        .DropDownHtmlAttributes(new {style = "width: 40px"})
                        //.Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        // .HighlightFirstMatch(true)
                        //.AutoFill(true)
                        .ClientEvents(events => events.OnLoad("month_onLoad"))
                        .Render();
                }
            </div>
            
            <div class="grid_1">
                @Html.Label("Năm")
            </div>
            <div class="grid_1">
               
                @{
                    Html.Telerik().AutoComplete()
                        .Name("Year")
                        .Value(DateTime.Now.Year+"")
                        .HtmlAttributes(new {style = "width: 42px"})
                        .Render();
                }
            </div>
            
            <div class="grid_4 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridMaterialInventoryForMonthly'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
            </div>
        </fieldset>
    </div>
    <div class="clear">
        
    </div>

    <div class="cover-div">
        @{
            Html.Telerik().Grid<IEProcutionModel>()
                .Name("gridMaterialInventoryForMonthly")
                .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectImportExportProductionReport", "Inv",
                                                                 new { type = 2 ,customerId = 0, productName = "", month = DateTime.Now.Month, year = DateTime.Now.Year }))
                .Columns(columns =>
                    {
                        columns.Bound(f => f.ProductId)
                               .ClientTemplate("<#= ++index #>")
                               .HeaderTemplate("<strong>STT</strong>").Width(50);
                        columns.Bound(f => f.CustomerCode)
                               .HeaderTemplate("<strong>Mã KH</strong>")
                               .FooterTemplate("<span id='sum'></span>").Width(75)
                               .HtmlAttributes(new {style = "text-align: center;"});
                        columns.Bound(f => f.ProductCode)
                               .HeaderTemplate("<strong>Mã SP</strong>")
                               .HtmlAttributes(new {style = "text-align: center;"})
                               .Aggregate(agg => agg.Count())
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>").Width(100);
                        // don hang
                        columns.Bound(f => f.EarlyQuantity).Title("Tồn đầu")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= EarlyQuantity == null ? 0 : $.telerik.formatString('{0:n0}', EarlyQuantity) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>").Width(100)
                               .HtmlAttributes(new {style = "text-align: right;"});
                        columns.Bound(f => f.TotalImportQuantity).Title("Tổng nhập")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= TotalImportQuantity == null ? 0 : $.telerik.formatString('{0:n0}', TotalImportQuantity) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>").Width(100)
                               .HtmlAttributes(new {style = "text-align: right;"});
                        columns.Bound(f => f.TotalExportQuantity).Title("Tổng xuất")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= TotalExportQuantity == null ? 0 : $.telerik.formatString('{0:n0}', TotalExportQuantity) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>").Width(100)
                               .HtmlAttributes(new {style = "text-align: right;"});
                        columns.Bound(f => f.LastQuantity).Title("Tồn cuối")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= LastQuantity == null ? 0 : $.telerik.formatString('{0:n0}', LastQuantity) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>").Width(100)
                               .HtmlAttributes(new {style = "text-align: right;"});
                        // du bao
                        
                    })
                .Scrollable(f => f.Height(510))
                //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .ClientEvents(events => events
                                            .OnDataBinding("gridProductInventoryForMonthly_onDataBinding")
                                            .OnDataBound("gridProductInventoryForMonthly_onDataBound"))
                .Groupable()
                .Render();
        }
    @*@{ Html.Telerik().ScriptRegistrar().OnDocumentReady("applyFrozenColumns();"); }*@
    </div>
</div>

<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
        )
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

