                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .FooterHtmlAttributes(new { style = "text-align: center;border-right:black 3px double;" });
                        columns.Bound(f => f.ProductivityInWeekPlan).Width(100).ReadOnly(true)
                               .HeaderTemplate("Plan</br>Productivity</br>(pcs/week)")                     //KH tuần</br>(pcs)
                               .Format("{0:n0}")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .Aggregate(agg => agg.Sum())
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.ProductivityInWeekReal).Width(100).ReadOnly(true)
                               .HeaderTemplate("Actual</br>Productivity</br>(pcs/week)")                     //TT tuần</br>(pcs)
                               .Format("{0:n0}")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .Aggregate(agg => agg.Sum())
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.ProductivityInWeekRate).Width(100).ReadOnly(true)
                               .HeaderTemplate("Actual</br>/Plan</br>(%)")                    //Tỉ lệ</br>TT/KH(%)
                               .Format("{0:n0}")
                               .HtmlAttributes(new { style = "text-align: center;border-right:black 3px double;" })
                               .Aggregate(agg => agg.Sum())
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .FooterHtmlAttributes(new { style = "text-align: center;border-right:black 3px double;" });
                    })
                .Scrollable(f => f.Height(510))
                //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .ClientEvents(events => events
                                            .OnDataBinding("gridProductionSX1Report_onDataBinding")
                                            .OnDataBound("grid_OnDataBound")
                                            .OnError("grid_OnError"))
                .Groupable()
                .Render();
        }
        @*@{ Html.Telerik().ScriptRegistrar().OnDocumentReady("applyFrozenColumns();"); }*@
    </div>
</div>

