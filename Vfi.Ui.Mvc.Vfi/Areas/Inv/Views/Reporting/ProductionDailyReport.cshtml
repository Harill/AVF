@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Daily-Production Report";
    //Báo cáo sản xuất hàng ngày
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">

        function gridProductionSX1Report_onDataBinding(args) {

            if (!onLoading) {
                OnLoadingData();
                var cames = $("input[name='chkCames']").attr('checked');
                var cnc = $("input[name='chkCnc']").attr('checked');
                var phay = $("input[name='chkPhay']").attr('checked');
                var vf1 = $("input[name='chkVF1']").attr('checked');
                var vf2 = $("input[name='chkVF2']").attr('checked');
                var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();
                var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
                if (monthlyDate === null)
                    monthlyDate = "";
                else {
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);
                }
                args.data = $.extend(args.data, {
                    productName: productCodeNameForMonthly,
                    monthlyDate: monthlyDate,
                    cames: cames,
                    cnc: cnc,
                    phay: phay,
                    vf1: vf1,
                    vf2: vf2,
                });
            }
            index = 0;
        }

        var index = 0;

    </script>
    <!-- report -->
    <script type="text/javascript">
        function printProductionSx1() {

            if (!onLoading) {
                OnLoadingData();
                var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
                if (monthlyDate === null)
                    monthlyDate = "";
                else
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

                var cames = $("input[name='chkCames']").attr('checked');
                var cnc = $("input[name='chkCnc']").attr('checked');
                var phay = $("input[name='chkPhay']").attr('checked');
                var vf1 = $("input[name='chkVF1']").attr('checked');
                var vf2 = $("input[name='chkVF2']").attr('checked');

                $('#result').load('@Url.Action("PrintProductionDailyReport", "Reporting")',
                    {
                        monthlyDate: monthlyDate,
                        cames: cames,
                        cnc: cnc,
                        phay: phay,
                        vf1: vf1,
                        vf2: vf2
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }
        function printProductionSx1InMonth() {

            if (!onLoading) {
                OnLoadingData();
                var month = $("#Month").data("tDropDownList").value();
                if (month === null)
                    month = new Date().getMonth() + 1;
                var year = $("#Year").val();
                if (year === null || year === "")
                    year = new Date().getYear() + 1;
                var shift = $("#Ca").data("tAutoComplete").value();
                $('#result').load('@Url.Action("PrintProductionMonthlyReport", "Reporting")',
                    {
                        month: month,
                        year: year,
                        shift: shift
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function printProductionMonthly() {
            if (!onLoading) {
                OnLoadingData();
                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                $('#result').load('@Url.Action("PrintProductionMonthlyDateReport", "Reporting")',
                    {
                        fromDate: fromDate,
                        toDate: toDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }


        function month_onLoad() {
            var combobox = $('#Month').data('tDropDownList');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            combobox.value(new Date().getMonth() + 1);
        }

        function RefreshGrid2(name) {
            if (!onLoading) {
                RefreshGrid(name);
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

    </script>
}

