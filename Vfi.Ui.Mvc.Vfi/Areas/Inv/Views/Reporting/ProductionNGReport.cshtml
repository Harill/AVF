@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "NG Production";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {
            if (startGrid && !onLoading) {
                OnLoadingData();
                var productCode = $("#ProductCode").data("tAutoComplete").value();

                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                args.data = $.extend(args.data, {
                    fromDate: fromDate,
                    toDate: toDate,
                    productCode: productCode,
                });
                index = 0;
            }
        }

        var index = 0;

        function grid_OnDataBound() {
            OnLoadedData();
        }

        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
        var startGrid = false;

    </script>

}

<div class="title">
    NG Production Report
    @*Báo cáo sản xuất tổng hợp*@
</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

        <fieldset>
            <legend>Filters</legend>
            <div class="grid_1_5">
                Machine
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("Machine")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMachine", "Machine", new { area = "Factory" }))
                        .DropDownHtmlAttributes(new { style = "width: 100%; " })
                         .HtmlAttributes(new { style = "width: 100%; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_1_5">
                @Html.Label("Product Code")
@*                @Html.LabelFor(f => f.ProductCodeName)*@
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCode")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                        .DropDownHtmlAttributes(new { style = "width: 100%; " })
                        .HtmlAttributes(new { style = "width: 100%; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                        .Render();
                }
            </div>
            <div class="grid_2">
                @{
                    Html.Telerik().DatePicker()
                        .Name("toDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="grid_3 prefix_1">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('gridProduction'); ">
                    <span class='t-icon t-insert'></span>
                    Find
                    <span class="loadButton"></span>
                </button>
            </div>
        </fieldset>
    </div>
    <div class="clear">
    </div>

    <div class="cover-div">
        @{
            Html.Telerik().Grid<ProductionNGReportModel>()
                .Name("gridProduction")
                .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectProductionNGReport", "Reporting",
                                                                 new {
                                                                     fromDate = "",
                                                                     toDate = "",
                                                                     productCode = "",
                                                                 })
                )
                .Columns(columns => {
                        columns.Bound(f => f.ProductId).Width(40)
                               .ClientTemplate("<#= ++index #>")
                               .HeaderTemplate("<strong>No.</strong>");
                        columns.Bound(f => f.CustomerCode).Width(70).Title("Customer</br>Code")
                               .HtmlAttributes(new { style = "text-align: center;" });
                        columns.Bound(f => f.ProductCode).Width(100).Title("Product</br>Code")
                               .HtmlAttributes(new { style = "text-align: center;" })
                               .Aggregate(agg => agg.Count())
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                               .FooterHtmlAttributes(new { style = "text-align: center;" });
                        columns.Bound(f => f.UnitPrice).Width(70).Title("Unit</br>Price")           // Don gia
                               .Format("{0:n0}")
                               .HtmlAttributes(new { style = "text-align: right;border-right:1px black solid" });

                        // so lieu
                        columns.Bound(f => f.Production1Reprocess).Title("Production1</br>Reprocess").Width(70)              //SX1 CXL
                               .Aggregate(agg => agg.Sum())
                              .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.Production1Defect).Title("Production1</br>Scrap").Width(70)                   //SX1 PP
                               .Aggregate(agg => agg.Sum())
                              .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });

                        // so lieu
                        columns.Bound(f => f.CNCReprocess).Title("CNC</br>Reprocess").Width(70)                       //CNC CXL
                               .Aggregate(agg => agg.Sum())
                              .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.CNCDefect).Title("CNC</br>Scrap").Width(70)                   //CNC PP
                               .Aggregate(agg => agg.Sum())
                              .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });

                        // so lieu
                        columns.Bound(f => f.Production2Reprocess).Title("Production2</br>Reprocess").Width(70)         //SX2 CXL
                               .Aggregate(agg => agg.Sum())
                              .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.Production2Defect).Title("Production2</br>Scrap").Width(70)            //SX2 PP
                               .Aggregate(agg => agg.Sum())
                              .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });

                        // so lieu
                        columns.Bound(f => f.Reprocess).Title("Other</br>Reprocess").Width(70)          //Khác CXL
                               .Aggregate(agg => agg.Sum())
                              .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.Defect).Title("Other</br>Scrap").Width(70)                 //Khác PP
                               .Aggregate(agg => agg.Sum())
                              .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                    
                        // so lieu
                        columns.Bound(f => f.TotalReprocess).Title("Total</br>Reprocess").Width(70)     //Tổng CXL
                               .Aggregate(agg => agg.Sum())
                              .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.TotalDefect).Title("Total</br>Scrap").Width(70)            //Tổng PP
                               .Aggregate(agg => agg.Sum())
                              .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                    
                    
                    })
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnDataBound("grid_OnDataBound")
                                            .OnError("grid_OnError"))
                .Scrollable(f => f.Height(510))
                //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .Groupable()
                .Render();
        }
@*@{ Html.Telerik().ScriptRegistrar().OnDocumentReady("applyFrozenColumns();"); }*@
    </div>
</div>

<!-- windown -->
