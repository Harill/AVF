@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model MaterialInventoryModel
@{
    ViewBag.Title = "Báo cáo tài nguyên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        var startGrid = false;
        function grid_OnDataBinding(args) {

            if (startGrid && !onLoading) {
                OnLoadingData();

                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);

                args.data = $.extend(args.data,
                {
                    fromDate: fromDate,
                    toDate: toDate
                });
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
            if (startGrid) {
                RefreshChart();
            }
        }

        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
    </script>

    <script>
        function chart_OnDataBound(e) {
            //alert('a');
        }


        function RefreshChart() {
            var fromYear = '', toYear = '';
            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromYear = $.telerik.formatString('{0:yyyy}', fromDate);
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#ToDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toYear = $.telerik.formatString('{0:yyyy}', toDate);
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            }
            var title = 'Báo cáo kết quả sử dụng tài nguyên ';
            if (fromYear !== toYear) {
                title += fromYear + "-" + toYear;
            }
            else {
                title += fromYear;
            }
            $("#chart").data("tChart").options.title.text = title;
            $("#chart").data("tChart").rebind({
                fromDate:fromDate,
                toDate: toDate
            });
        }
    </script>
}
<div class="title">Báo cáo tài nguyên</div>

<div id="pnlInv">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("FromDate")
                        .Format("MM/yyyy")
                        .Value(new DateTime(DateTime.Now.Year-1,1,1))
                        .Render();
                }
            </div><div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ToDate")
                        .Format("MM/yyyy")
                        .Value(new DateTime(DateTime.Now.Year-1, 12, 1))
                        .Render();
                }
            </div>
            <div class="grid_5">
                <button id="btnRefesh" class="t-button" onclick="return RefreshGrid2('grid'); ">
                    <span class='t-icon t-insert'></span>
                    Làm mới
                    <span class="loadButton"></span>
                </button>
                <br />
                    (chỉ lấy tối đa 12 tháng trong thời gian chỉ định)
            </div>
        </fieldset>

    </div>
    <div class="clear"></div>
