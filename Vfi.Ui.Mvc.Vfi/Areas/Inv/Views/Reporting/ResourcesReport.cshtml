</div>

     <div class="cover-div" style="background: white;">
              
            @{
                Html.Telerik().Chart<ResourcesReportModel>()
                    .Name("chart")
                    //.ChartArea(area => area.Background("#ccff00"))
                        //.PlotArea(area => area.Background("#ccff00"))

                    //.Theme(Html.GetCurrentTheme())
                    .DataBinding(dataBinding => dataBinding.Ajax()
                        .Select("SelectResourcesChartReport", "Reporting", new { fromDate = "", toDate = "" })
                    )
                    .Title("Báo cáo kết quả sử dụng tài nguyên ")
                    .Legend(legend => legend.Position(Telerik.Web.Mvc.UI.ChartLegendPosition.Bottom)
                    )
                    //.PlotArea(plotArea => plotArea.Margin(20))

                    //.SeriesDefaults(series =>
                    //                series.Bar().Labels(labels => labels.Visible(true).Format("${0:#,##0}"))
                    //)

                    .Series(series => {
                        series.Column(s => s.ProductionPrice).Name("Sản xuất 1").Stack(true)
                              .Labels(labels => labels.Visible(true)
                                  .Format("{0:n0}")
                                  .Position(Telerik.Web.Mvc.UI.ChartBarLabelsPosition.OutsideEnd)
                            );
                        series.Column(s => s.ProductionCNCPrice).Name("Phay CNC").Stack(true)
                              .Labels(labels => labels.Visible(true)
                                  .Format("{0:n0}")
                                  .Position(Telerik.Web.Mvc.UI.ChartBarLabelsPosition.OutsideEnd)
                            );
                        series.Column(s => s.Production2Price).Name("Sản xuất 2").Stack(true)
                              .Labels(labels => labels.Visible(true)
                                  .Format("{0:n0}")
                                  .Position(Telerik.Web.Mvc.UI.ChartBarLabelsPosition.OutsideEnd)
                            );
                    })
                    .Series(series => {
                        series.Line(s => s.MaterialUsePrice).Name("Nguyên liệu SD").Stack(true);
                        series.Line(s => s.ToolExportPrice).Name("Xuất CC").Stack(true);
                        series.Line(s => s.FuelExportPrice).Name("Xuất NL").Stack(true);
                    })
                    //.Series(series => {
                    //    series.Line(s => s.MaterialUsePrice).Name("NLSD");
                    //})
                    .CategoryAxis(axis => axis.Categories(s => s.Month)//.Orientation(Telerik.Web.Mvc.UI.ChartAxisOrientation.Horizontal)
                    )
                    .ValueAxis(axis => axis.Numeric().Labels(labels => labels.Format("{0:n0}"))
                    )
                    //.ChartBarSeries(x=> x.Orientation(Telerik.Web.Mvc.UI.ChartSeriesOrientation.Vertical))
                    
                    .HtmlAttributes(new { style = "min-width: 800px; height: 500px;" })
