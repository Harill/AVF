                        .HtmlAttributes(new { style = "text-align: right;" })
                        .Aggregate(agg => agg.Sum())
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align: right;" });
                    columns.Bound(f => f.NGPercent).Width(60)
                        .HeaderTemplate("<strong>Tỉ lệ</br>NG</br>(%)</strong>")
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" })
                        //.Aggregate(agg => agg.Sum())
                        //.ClientFooterTemplate("<#= $.telerik.formatString('{0:n3}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align: right;" });
                    columns.Bound(f => f.NGDefectQuantityAfter).Width(75)
                        .HeaderTemplate("<strong>Sau SX1</br>NG</br>(pcs)</strong>")
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align: right;" })
                        .Aggregate(agg => agg.Sum())
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align: right;" });
                    //columns.Bound(f => f.DefectQuantityAfter).Width(70)
                    //    .HeaderTemplate("<strong>Sau SX1</br>PP</br>(pcs)</strong>")
                    //    .Format("{0:n0}")
                    //    .HtmlAttributes(new { style = "text-align: right;" })
                    //    .Aggregate(agg => agg.Sum())
                    //    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    //    .FooterHtmlAttributes(new { style = "text-align: right;" });
                    columns.Bound(f => f.NGAfterPercent).Width(70)
                        .HeaderTemplate("<strong>Sau SX1</br>TL NG</br>(%)</strong>")
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" })
                        //.Aggregate(agg => agg.Sum())
                        //.ClientFooterTemplate("<#= $.telerik.formatString('{0:n3}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align: right;" });
                    columns.Bound(f => f.ExportQuantity).Width(80)
                        .HeaderTemplate("<strong>Hàng SX</br>xuất bán</br>(pcs)</strong>")
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align: right;" })
                        .Aggregate(agg => agg.Sum())
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align: right;" });
                    columns.Bound(f => f.ReturnQuantity).Width(70)
                        .HeaderTemplate("<strong>Hàng SX</br>trả hàng</br>(pcs)</strong>")
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align: right;" })
                        .Aggregate(agg => agg.Sum())
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align: right;" });
                    //
                })
                .Scrollable(f => f.Height(280))
                .Resizable(f => f.Columns(true))
                .ClientEvents(events => events.OnError("grid_OnError")
                    .OnDataBinding("grid_OnDataBinding")
                    .OnDataBound("grid_OnDataBound"))
                .Render();
        }
    </div>


    
