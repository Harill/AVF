@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "Material Order Plan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnError(e) {
            alert("Grid Error");
        }


        var startGrid = false;
        function grid_OnDataBinding(args) {

            var month = $("#Month").val();
            if (month === null)
                month = new Date().getMonth() + 1;
            var year = $("#Year").val();
            if (year === null || year == "")
                year = new Date().getYear() + 1;
            var monthCount = $("#MonthCount").val();
            if (monthCount === null || monthCount == "")
                monthCount = 3;
            var materialCode = $("#MaterialCodeName").data("tAutoComplete").value();
            var isAll = $("input[name='chkAll']").attr('checked');
            args.data = $.extend(args.data, {
                materialCode: materialCode,
                month: month,
                year: year,
                monthCount: monthCount,
                isAll: isAll,
            });
            index = 0;
            $("#ForecastByMonthHeader")[0].innerText = (monthCount + " Month");
            $("#RequireByMonthHeader")[0].innerText = (monthCount + " Month");
        }
        var index = 0;
        function grid_OnRowDataBound(e) {
            if (e.dataItem.HasProductDuplicate) {
                e.row.childNodes[3].bgColor = "#F4FA58";
            }
        }

        function gridDetail_OnDataBinding(args) {
            var month = $("#Month").val();
            if (month === null)
                month = new Date().getMonth() + 1;
            var year = $("#Year").val();
            if (year === null || year == "")
                year = new Date().getYear() + 1;
            var monthCount = $("#MonthCount").val();
            if (monthCount === null || monthCount == "")
                monthCount = 3;
            args.data = $.extend(args.data, {
                month: month,
                year: year,
                monthCount: monthCount,
            });

        }

        function gridDetail_OnLoad(e) {
            var monthCount = $("#MonthCount").val();
            e.target.getElementsByClassName("ForecastByMonthHeaderDetail")[0].innerText = (monthCount + " Month");
        }
        function RefreshGrid2() {
            OnLoadingData();
            startGrid = true;
            RefreshGrid("gridPlan");
        }


        // Loading button
        //     <span class="twoToneButton"></span>


        function grid_OnDataBound() {
            OnLoadedData();
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (loading)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }
    </script>
}

<div class="title">Material-Order Expected</div> @*Dự kiến đặt hàng nguyên liệu*@
<div class="clear"></div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1000px;">
    <fieldset>
        <legend>Filters</legend>

        <div class="grid_2">
           Material
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("MaterialCodeName")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedMaterialInventory", "Inv", new { materialTypeId = 0 }))
                    //.HtmlAttributes(new { style = "width: 185px; " })
                    .DropDownHtmlAttributes(new { style = "width: 250px; " })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>

        <div class="grid_2">
            @Html.Label("Plan")
        </div>
        <div class="grid_1">
            @{
                Html.Telerik().IntegerTextBox()
                    .Name("MonthCount")
                    .Value(3)
                    .MinValue(1)
                    .MaxValue(12)
                    //.HtmlAttributes(new {style = "width: 42px"})
                    .InputHtmlAttributes(new { style = "width: 30px" })
                    .Render();
            }
        </div>
        <div class="grid_2">
            @Html.Label("Month")  | 
        </div>

        <div class="grid_1">
            @Html.Label("Month")
        </div>
        <div class="grid_1">
            @{
                Html.Telerik().IntegerTextBox()
                    .Name("Month")
                    .Value(DateTime.Now.Month)
                    .MinValue(1)
                    .MaxValue(12)
                    //.HtmlAttributes(new {style = "width: 42px"})
                    .InputHtmlAttributes(new { style = "width: 30px" })
                    .Render();
            }
        </div>

        <div class="grid_1">
            @Html.Label("Year")
        </div>
        <div class="grid_1_5">

            @{
                Html.Telerik().AutoComplete()
                    .Name("Year")
                    .Value(DateTime.Now.Year + "")
                    .HtmlAttributes(new { style = "width: 42px" })
                    .Render();
            }
        </div>
        <div class="grid_2_5">
            <label>
                <input type="checkbox" id="chkAll" name="chkAll" />
                See All @*Xem tất cả*@
            </label>
        </div>
        <div class="grid_5 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('gridPlan'); ">
                <span class='t-icon t-insert'></span>
                Find
                <span class="twoToneButton"></span>
            </button>
        </div>
    </fieldset>
</div>
<div class="clear">
</div>

