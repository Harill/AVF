@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Weekly Production Report";
    //Báo cáo sản xuất hàng tuần
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">

        function gridProductionSX1Report_onDataBinding(args) {

            var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

            var customerId = $("#CustomerForMonthly").data('tComboBox').value();

            var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
            if (monthlyDate === null)
                monthlyDate = "";
            else {
                monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);
            }
            if (customerId == 0)
                customerId = 0;
            //var remainingOrder = $("input[name='chkRemainingOrder']").attr('checked');
            //var nextOder = $("input[name='chkNextOder']").attr('checked');
            //var DHTK = $("input[name='chkDonHangThangKe']").attr('checked');
            //var DHCL = $("input[name='chkDonHangConLai']").attr('checked');


            args.data = $.extend(args.data, {
                //chkRemainingOrder: remainingOrder,
                //chkNextOder: nextOder,
                //chkDonHangThangKe: true,
                //chkDonHangConLai: true,
                customerId: customerId,
                productName: productCodeNameForMonthly,
                monthlyDate: monthlyDate//$.telerik.formatString('{0:dd/MM/yyyy}', toDate )
            });

        }
        var index = 0;

        function gridProductionSX1Report_onDataBound() {
            //var sum = 0;
            //$("span[name='sumMonthly']").each(function () {
            //    sum = sum + parseInt($(this).text());
            //});
            //$("#sumMonthly").text(sum);

            //for (var i = 7; i <= 18; i++) {
            //    var total = 0;
            //    $("span[name='cot" + i + "']").each(function () {
            //        total = total + parseInt($(this).text());
            //    });
            //    $("#tongcot" + i).text(total);
            //}
        }
    </script>
    <!-- report -->
    <script type="text/javascript">
        function printProductionSx1() {

            var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
            if (monthlyDate === null)
                monthlyDate = "";
            else
                monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

            var remainingOrder = $("input[name='chkRemainingOrder']").attr('checked');
            var nextOder = $("input[name='chkNextOder']").attr('checked');
            //var DHTK = $("input[name='chkDonHangThangKe']").attr('checked');
            //var DHCL = $("input[name='chkDonHangConLai']").attr('checked');

            $('#result').load('@Url.Action("PrintProductionWeeklyReport", "Inv")',
                {
                    //chkRemainingOrder: remainingOrder,
                    //chkNextOder: nextOder,
                    //chkDonHangThangKe: true,
                    //chkDonHangConLai: true,
                    monthlyDate: monthlyDate
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }


    </script>
}

<div class="title">Weekly Production Report
 @*   Báo cáo sản xuất hàng tuần*@
</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">


        <div class="clear"></div>
            <div class="grid_4 prefix_15">
        
                <button id="btnProductInvTotal" class="t-button" onclick=" return printProductionSx1(); ">
                    <span class='t-icon t-insert'></span>
                   Print Report
                </button>
            </div>
        <br />

        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
            <div class="grid_2">
                @Html.Label("Customer Code")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("CustomerForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 275px" })
                        //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_2">
                @Html.Label("Product Code")
@*                @Html.LabelFor(f => f.ProductCodeName)*@
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeNameForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("MonthlyDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="grid_4 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridProductionSX1Report'); ">
                <span class='t-icon t-insert'></span>
                Find
            </button>
            </div>

        </fieldset>
    </div>
    <div class="clear">
        
    </div>

    <div class="cover-div">
        @{
            Html.Telerik().Grid<ProductionWeeklyModel>()
                .Name("gridProductionSX1Report")
                .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectProductionWeeklyReport", "Inv"))
                .Columns(columns =>
                    {
                        columns.Bound(f => f.ProductId)
                               .ClientTemplate("<#= ++index #>")
                               .HeaderTemplate("<strong>No.</strong>").Width(60);

                        columns.Bound(f => f.CustomerCode)
                               .HeaderTemplate("<strong>Customer</br>Code</strong>")
                               .FooterTemplate("<span id='sum'></span>").Width(75)
                               .HtmlAttributes(new { style = "text-align: center;" });
                        columns.Bound(f => f.ProductCode)
                               .HeaderTemplate("<strong>Product</br>Code</strong>")
                               .HtmlAttributes(new {style = "text-align: left;"})
                               .Aggregate(agg => agg.Count())
                               .ClientGroupFooterTemplate("<div style='text-align: left; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                               .ClientFooterTemplate("<div style='text-align: left; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>").Width(100);
                        // don hang
                        columns.Bound(f => f.OrderLast)
                               .HeaderTemplate("<strong>Remaining</br>Order</strong>")         //Đơn Hàng</br>còn lại
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= OrderLast == null ? 0 : $.telerik.formatString('{0:n0}', OrderLast) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>").Width(100)
                               .HtmlAttributes(new {style = "text-align: right;"});
                        columns.Bound(f => f.OrderNext)
                               .HeaderTemplate("<strong>Next Month</br>Order</strong>")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= OrderNext == null ? 0 : $.telerik.formatString('{0:n0}', OrderNext) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>").Width(100)
                               .HtmlAttributes(new {style = "text-align: right;"});
                        columns.Bound(f => f.OrderNextDate).Width(100)
                               .HeaderTemplate("<strong>Nearest</br>Delivery</br>Date</strong>")                 //Ngày giao hàng</br>gần nhất
                               .ClientTemplate("<#= OrderNextDate == null ? '' : $.telerik.formatString('{0:dd/MM}', OrderNextDate) #>")
                               .HtmlAttributes(new {style = "text-align: right;"});
                        //ton tong
                        columns.Bound(f => f.TotalProductInv).Width(100)
                               .HeaderTemplate("<strong>Total Inv</br>(pcs)</strong>")           //Tồn tổng</br>(pcs)
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= TotalProductInv == null ? 0 : $.telerik.formatString('{0:n0}', TotalProductInv) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new {style = "text-align: right;"});
                        //nguyên liệu
                        columns.Bound(f => f.MaterialName).Width(90)
                               .HeaderTemplate("<strong>Material</br>Name</strong>")
                               .HtmlAttributes(new { style = "text-align: left;" });
                        columns.Bound(f => f.MaterialDesignNo).Width(120)
                               .HeaderTemplate("<strong>Describe</strong>")
                               .HtmlAttributes(new { style = "text-align: left;" });
                        columns.Bound(f => f.TotalMaterialInvKg).Width(100)
                               .HeaderTemplate("<strong>Material</br>Inv(kg)</strong>")         //Tồn kho NL</br>(kg)
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= TotalMaterialInvKg == null ? 0 : $.telerik.formatString('{0:n0}', TotalMaterialInvKg) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new {style = "text-align: right;"});
                        columns.Bound(f => f.ExpectedEndMaterialDay).Width(100)
                               .HeaderTemplate("<strong>Estimated</br>(days)</strong>")              //Dự trù</br>(ngày)
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= ExpectedEndMaterialDay == null ? 0 : $.telerik.formatString('{0:n0}', ExpectedEndMaterialDay) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        //kế hoạch
                        columns.Bound(f => f.DailyProduction).Width(100)
                               .HeaderTemplate("<strong>Productivity</br>(pcs/day)</strong>")                 //Năng xuất</br>(pcs/ngày)
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= DailyProduction == null ? 0 : $.telerik.formatString('{0:n0}', DailyProduction) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new {style = "text-align: right;"});
                        columns.Bound(f => f.MachineRunningDay).Width(100)
                               .HeaderTemplate("<strong>Days</br>Machine</br>Running</strong>")                     //Số ngày</br>chạy máy
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= MachineRunningDay == null ? 0 : $.telerik.formatString('{0:n0}', MachineRunningDay) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.DayOne).Width(100)
                               .HeaderTemplate("<strong>Friday</strong>")           //Thứ 6
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= DayOne == null ? 0 : $.telerik.formatString('{0:n0}', DayOne) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.DayTwo).Width(100)
                               .HeaderTemplate("<strong>Saturday</strong>")         //Thứ 7
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= DayTwo == null ? 0 : $.telerik.formatString('{0:n0}', DayTwo) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.DayThree).Width(100)
                               .HeaderTemplate("<strong>Monday</strong>")               //Thứ 2
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= DayThree == null ? 0 : $.telerik.formatString('{0:n0}', DayThree) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.DayFour).Width(100)
                               .HeaderTemplate("<strong>Tuesday</strong>")         //Thứ 3
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= DayFour == null ? 0 : $.telerik.formatString('{0:n0}', DayFour) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.DayFive).Width(100)
                               .HeaderTemplate("<strong>Wednesday</strong>")                 //Thứ 4
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= DayFive == null ? 0 : $.telerik.formatString('{0:n0}', DayFive) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.DaySix).Width(100)
                               .HeaderTemplate("<strong>Thursday</strong>")                    //Thứ 5
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= DaySix == null ? 0 : $.telerik.formatString('{0:n0}', DaySix) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        // thieu hang
                        columns.Bound(f => f.OrderLastRemaining).Width(100)
                               .HeaderTemplate("<strong>Out Of Stock</br>In Month</strong>")           //Thiếu hàng</br>trong tháng
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= OrderLastRemaining == null ? 0 : $.telerik.formatString('{0:n0}', OrderLastRemaining) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new {style = "text-align: right;"});
                        columns.Bound(f => f.OrderNextRemaining).Width(100)
                               .HeaderTemplate("<strong>Out Of Stock</br>Next Month</strong>")                //Thiếu hàng</br>tháng kế
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= OrderNextRemaining == null ? 0 : $.telerik.formatString('{0:n0}', OrderNextRemaining) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new {style = "text-align: right;"});
                    })
                .Scrollable(f => f.Height(510))
                //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .ClientEvents(events => events
                                            .OnDataBinding("gridProductionSX1Report_onDataBinding")
                                            .OnDataBound("gridProductionSX1Report_onDataBound")
                                            .OnError("grid_OnError"))
                .Groupable()
                .Render();
        }
    @*@{ Html.Telerik().ScriptRegistrar().OnDocumentReady("applyFrozenColumns();"); }*@
    </div>
</div>

<!-- windown -->
