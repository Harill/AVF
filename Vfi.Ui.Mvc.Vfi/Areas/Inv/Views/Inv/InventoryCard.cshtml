@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "Product-Inv Card";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .highslide-container div {
        font-family: Verdana, Helvetica;
        font-size: 10pt;
    }

    .highslide-container table {
        background: none;
    }

    .highslide {
        outline: none;
        text-decoration: none;
    }

    .highslide img {
        border: 2px solid silver;
    }

    .highslide:hover img {
        border-color: gray;
    }

    .highslide-active-anchor img {
        visibility: hidden;
    }

    .highslide-gallery .highslide-active-anchor img {
        border-color: black;
        visibility: visible;
        cursor: default;
    }

    .highslide-image {
        border-width: 2px;
        border-style: solid;
        border-color: white;
    }

    .highslide-wrapper, .highslide-outline {
        background: white;
    }

    .glossy-dark {
        background: #111;
    }

    .highslide-number {
        display: none;
        font-weight: bold;
        color: gray;
        font-size: .9em;
    }

    .highslide-caption {
        display: none;
        font-size: 1em;
        padding: 5px;
        width: 100%;
        text-align: center;
        font-weight: bold;
        /*background: white;*/
    }

    .highslide-heading {
        display: none;
        font-weight: bold;
        margin: 0.4em;
    }

    .highslide-dimming {
        /*position: absolute;*/
        background: black;
    }

    a.highslide-full-expand {
        display: block;
        margin: 0 10px 10px 0;
        width: 34px;
        height: 34px;
    }

    .highslide-loading {
        display: block;
        color: black;
        font-size: 9px;
        font-weight: bold;
        text-transform: uppercase;
        text-decoration: none;
        padding: 3px;
        border: 1px solid white;
        background-color: white;
        padding-left: 22px;
        background-repeat: no-repeat;
        background-position: 3px 1px;
    }

    a.highslide-credits,
    a.highslide-credits i {
        padding: 2px;
        color: silver;
        text-decoration: none;
        font-size: 10px;
        display: none;
    }

    a.highslide-credits:hover,
    a.highslide-credits:hover i {
        color: white;
        background-color: gray;
    }

    .highslide-move, .highslide-move * {
        cursor: move;
    }

    .highslide-viewport {
        display: none;
        position: fixed;
        width: 100%;
        height: 100%;
        z-index: 1;
        background: none;
        left: 0;
        top: 0;
    }

    .highslide-overlay {
        display: none;
    }

    .hidden-container {
        display: none;
    }
    /* Example of a semitransparent, offset closebutton */
    .closebutton {
        position: relative;
        top: -15px;
        left: 15px;
        width: 30px;
        height: 30px;
        cursor: pointer;
        /* NOTE! For IE6, you also need to update the highslide-ie6.css file. */
    }

    .highslide-controls {
        display: none;
    }
</style>
@section Scripts{
    
<script type="text/javascript">
    hs.graphicsDir = '';
    hs.align = 'center';
    hs.transitions = ['expand', 'crossfade'];
    hs.outlineType = '';
    hs.fadeInOut = true;
    hs.numberPosition = 'caption';
    hs.dimmingOpacity = 0.75;

    // Add the controlbar
    if (hs.addSlideshow)
        hs.addSlideshow({
            //slideshowGroup: 'group1',
            interval: 5000,
            repeat: false,
            useControls: true,
            fixedControls: 'fit',
            overlayOptions: {
                opacity: .75,
                position: 'bottom center',
                hideOnMouseOut: true
            }
        });
</script>
    <script type="text/javascript">
        function gridYear_OnDataBinding(e) {
            var lot = $("#LotNumber").data("tAutoComplete").value();
            var productId = $("#ProductCode").data('tComboBox').value();
            if (productId === "")
                productId = 0;
            e.data = $.extend(e.data, {
                productId: productId,
                lotNumber: lot
            });
        }

        function gridInventory_OnDataBinding(e) {
            var lot = $("#LotNumber").data("tAutoComplete").value();
            var productId = $("#ProductCode").data('tComboBox').value();
            if (productId === "")
                productId = 0;
            e.data = $.extend(e.data, {
                productId: productId,
                lotNumber: lot
            });
        }

        function DisplayPicture() {
            $('#result').empty();
            @*var productId = $("#ProductCode").data('tComboBox').value();
            if (productId === "")
                productId = 0;
            if (productId !== 0) {
                $('#result').load('@Url.Action("GetProductPicture", "Inv")',
                    {
                        productId: productId
                    });
            }*@
        }

        function gridProduct_OnDataBinding(args) {
            var productId = $("#ProductCode").data('tComboBox').value();
            if (productId === "")
                productId = 0;
            if (productId !== 0) {
                args.data = $.extend(args.data, {
                    customerId: 0,
                    status: 0,
                    productCode: "",
                    productId: productId
                });
            }
        }

        function RefreshGrids() {
            RefreshGrid("gridInventory");
            RefreshGrid("gridInventoryCard"); 
            RefreshGrid("gridProduct");
            DisplayPicture();
        }

    </script>
}

<div class="title">Product Inventory Card</div>
<div class="clear"></div>
<br/>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
    <fieldset>
        <legend>Criteria Filtering </legend>
        <div class="grid_2">
            Prodcut
        </div>
        <div class="grid_6">
             @{
                Html.Telerik().ComboBox()
                    .Name("ProductCode")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProductFullCodeName", "Product", new { area = "" }))
                    .HtmlAttributes(new {style = "width: 200px"})
                    .DropDownHtmlAttributes(new {style = "width: 275px"})
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
        
        <div class="grid_1">Lot</div>
        <div class="grid_3">
            @{
                Html.Telerik().AutoComplete()
                    .Name("LotNumber")
                    .Value("")
                    .HtmlAttributes(new { style = "width: 100%" } )
                    .Render();
            }
        </div>
        <div class="grid_3 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrids(); ">
                <span class='t-icon t-insert'></span>
                Find
            </button>
        </div>
<div class="grid_4" id="result"></div>
    </fieldset>
</div>
<div class="clear">
</div>

