@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Finished-Inv";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {

            var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

            var customerId = $("#CustomerForMonthly").data('tComboBox').value();
            if (customerId == 0)
                customerId = 0;

            var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
            if (monthlyDate === null)
                monthlyDate = "";
            else
                monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);


            args.data = $.extend(args.data, {
                customerId: customerId,
                productCode: productCodeNameForMonthly,
                monthlyDate: monthlyDate
            });

        }
        var index = 0;

        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (dataItem.Weight == 0)
                e.row.childNodes[3].style.backgroundColor = "#F4FA58";
        }
    </script>
}

<div class="title">Finished-Inventory Report
    @*Báo cáo xuất nhập tồn kho thành phẩm*@</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

        <fieldset>
            <legend>Filter</legend>
           
            <div class="grid_1_5">
                @Html.Label("Customer")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("CustomerForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 275px" })
                        //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_1_5">
                @Html.Label("Product")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeNameForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                        .DropDownHtmlAttributes(new { style = "width: 200px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
             <div class="grid_3">
                    @{
                        Html.Telerik().DatePicker()
                            .Name("MonthlyDate")
                            .Format("dd/MM/yyyy")
                            .Value(DateTime.Now)
                            .Render();
                    }
                </div>
            <div class="grid_3 prefix_1">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridProductionMonthly'); ">
                    <span class='t-icon t-insert'></span>
                    Find
                </button>
            </div>
        </fieldset>
    </div>
    <div class="clear">
    </div>

    <div class="cover-div">
        @{
            Html.Telerik().Grid<FinishInvModel>() 
                .Name("gridProductionMonthly")
                .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectFinishInvManagement", "Inv",
                                                                 new {customerId = 0, productCode = "", monthlyDate = DateTime.Now.ToString("dd/MM/yyyy") }))
                .Columns(columns =>
                    {
                        columns.Bound(f => f.GlobalIndex).Width(35)
                               .ClientTemplate("<#= GlobalIndex #>")
                               .HeaderTemplate("<strong>No.</strong>");
                        columns.Bound(f => f.CustomerCode).Width(70)
                               .HeaderTemplate("<strong>Customer</br>Code</strong>")
                               .HtmlAttributes(new { style = "text-align: center;" });
                        columns.Bound(f => f.ProductCode).Width(85)
                               .HeaderTemplate("<strong>Product</br>Code</strong>")
                               .HtmlAttributes(new { style = "text-align: center;" })
                               .Aggregate(agg => agg.Count())
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>");
                        columns.Bound(f => f.Weight).Width(60)
                               .HeaderTemplate("Weight")
                            //.HtmlAttributes(new { style = "border-left:black 3px double;"})
                               .ClientTemplate("<#= Weight == null ? 0 : $.telerik.formatString('{0:n3}', Weight) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        // so lieu
                        columns.Bound(f => f.EarlyInventory).Width(65)
                               .HeaderTemplate("First-Inv</br>(pcs)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= EarlyInventory == null ? 0 : $.telerik.formatString('{0:n0}', EarlyInventory) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" });
                        columns.Bound(f => f.EarlyInventoryKg).Width(65)
                               .HeaderTemplate("First-Inv</br>(g)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= EarlyInventoryKg == null ? 0 : $.telerik.formatString('{0:n0}', EarlyInventoryKg) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        //
                        columns.Bound(f => f.ImportQc).Width(60)
                               .HeaderTemplate("QC</br>Entry</br>(pcs)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= ImportQc == null ? 0 : $.telerik.formatString('{0:n0}', ImportQc) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" });
                        columns.Bound(f => f.ImportQcInMonth).Width(100)
                               .HeaderTemplate("QC Cumulative</br>Entry</br>(pcs)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= ImportQcInMonth == null ? 0 : $.telerik.formatString('{0:n0}', ImportQcInMonth) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;border-right:black 3px double;" });
                        //
                        columns.Bound(f => f.ExportKd).Width(60)
                               .HeaderTemplate("Sale</br>Release</br>(pcs)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= ExportKd == null ? 0 : $.telerik.formatString('{0:n0}', ExportKd) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.ExportKdInMonth).Width(60)
                               .HeaderTemplate("Sale</br>Cumulative</br>Release(pcs)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= ExportKdInMonth == null ? 0 : $.telerik.formatString('{0:n0}', ExportKdInMonth) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        //
                        columns.Bound(f => f.ExportCxl).Width(100)
                               .HeaderTemplate("Reprocessing</br>Release</br>(pcs)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= ExportCxl == null ? 0 : $.telerik.formatString('{0:n0}', ExportCxl) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.ExportCxlInMonth).Width(100)
                               .HeaderTemplate("Reprocessing</br>Cumulative</br>Release(pcs)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= ExportCxlInMonth == null ? 0 : $.telerik.formatString('{0:n0}', ExportCxlInMonth) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        //
                        columns.Bound(f => f.TotalExport).Width(60)
                               .HeaderTemplate("Total</br>Release(pcs)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= TotalExport == null ? 0 : $.telerik.formatString('{0:n0}', TotalExport) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        //
                        columns.Bound(f => f.LastInventory).Width(65)
                               .HeaderTemplate("Last-Inv</br>(pcs)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= LastInventory == null ? 0 : $.telerik.formatString('{0:n0}', LastInventory) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" });
                        columns.Bound(f => f.LastInventoryKg).Width(65)
                               .HeaderTemplate("Last-Inv</br>(g)")
                               .Aggregate(agg => agg.Sum())
                               .ClientTemplate("<#= LastInventoryKg == null ? 0 : $.telerik.formatString('{0:n0}', LastInventoryKg) #>")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .FooterTemplate("<span id='tongcot1'></span>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                    })
                .Scrollable(f => f.Height(510))
                //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnRowDataBound("grid_OnRowDataBound")
                                            .OnError("grid_OnError"))
                .Groupable()
                .Render();
        }
    </div>
</div>
