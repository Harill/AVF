@{
    Html.Telerik().ComboBox()
        .Name(ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty))
        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxReferenceItemInventory", "PurchaseOrder", new { area = "Purchasing", classified = 0, referenceId = 0 }).Delay(350))
        //.HtmlAttributes(new { style = "width: 150px" })
        .DropDownHtmlAttributes(new { style = "width: 250px" })
        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
        .HighlightFirstMatch(true)
        .AutoFill(true)
        .ClientEvents(events => events.OnDataBinding("itemInventoryGrid_OnDataBinding"))
        .Render();
}
