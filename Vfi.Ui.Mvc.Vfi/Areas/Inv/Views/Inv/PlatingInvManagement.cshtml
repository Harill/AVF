@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Plating-Inv";
    //Kho Xi mạ
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {

            var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

            var customerId = $("#CustomerForMonthly").data('tComboBox').value();
            if (customerId == 0)
                customerId = 0;

            var platingType = $('#PlatingType').data('tDropDownList').value();
            if (platingType == "")
                platingType = 0;
            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            var toDate = $("#ToDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);


            args.data = $.extend(args.data, {
                customerId: customerId,
                productCode: productCodeNameForMonthly,
                platingType: platingType,
                fromDate: fromDate,
                toDate: toDate,
            });

        }
        var index = 0;

        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (dataItem.Weight == 0)
                e.row.childNodes[3].style.backgroundColor = "#F4FA58";
        }
    </script>
}

<div class="title">Plating Inventory Report
    @*Báo cáo xuất nhập tồn kho NCU*@</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 5px; padding-right: 5px; width: 1090px;">

        <fieldset>
            <legend>Filters</legend>
           
            <div class="grid_2">
                @Html.Label("Customer")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("CustomerForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 275px" })
                        //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_1_5">
                @Html.Label("Product")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeNameForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                        .DropDownHtmlAttributes(new { style = "width: 200px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            
           <div class="grid_4">
            @{
                Html.Telerik().DropDownList()
                    .Name("PlatingType")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxPlatingType", "PurchaseOrder", new { area = "Purchasing" }))
                    .DropDownHtmlAttributes(new { style = "width: 150px" })
                    .Render();
            }
        </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("FromDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Now.Year,DateTime.Now.Month,1))
                        .Render();
                }
            </div>
            <div class="grid_3">
                    @{
                        Html.Telerik().DatePicker()
                            .Name("ToDate")
                            .Format("dd/MM/yyyy")
                            .Value(DateTime.Now)
                            .Render();
                    }
                </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridProductionMonthly'); ">
                    <span class='t-icon t-insert'></span>
                   Find
                </button>
            </div>
        </fieldset>
    </div>
    <div class="clear">
    </div>

    <div class="cover-div">
        @{
            Html.Telerik().Grid<PlatingInvModel>()
                .Name("gridProductionMonthly")
                .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectPlatingInvManagement", "Inv",
                                                                 new {customerId = 0, productCode = "", monthlyDate = DateTime.Now.ToString("dd/MM/yyyy") }))
                .Columns(columns =>
                    {
                        columns.Bound(f => f.GlobalIndex)
                               .ClientTemplate("<#= GlobalIndex #>")
                               .HeaderTemplate("<strong>No.</strong>").Width(50);
                        columns.Bound(f => f.CustomerCode)
                               .HeaderTemplate("<strong>Customer</br>Code</strong>").Width(85)
                               .HtmlAttributes(new { style = "text-align: center;" });
                        columns.Bound(f => f.ProductCode).Width(100)
                               .HeaderTemplate("<strong>Product</br>Code</strong>")
                               .HtmlAttributes(new { style = "text-align: center;" })
                               .Aggregate(agg => agg.Count())
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>");
                        columns.Bound(f => f.Weight).Title("Weight").Width(90)
                               .Format("{0:n3}")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        // so lieu
                        columns.Bound(f => f.EarlyInventory).Width(90)
                               .HeaderTemplate("First-Inv</br>(pcs)")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .HtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" });
                        columns.Bound(f => f.EarlyInventoryKg).Width(80)
                               .HeaderTemplate("First-Inv</br>(g)")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.ImportWaiting).Width(100)
                               .HeaderTemplate("Outsourcing</br>Entry(pcs))")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .HtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" });
                        columns.Bound(f => f.ExportQcB).Width(80)
                               .HeaderTemplate("QC/B</br>Release(pcs)")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .HtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" });
                        columns.Bound(f => f.LastInventory).Width(75)
                               .HeaderTemplate("Last-Inv</br>(pcs)")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .HtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" });
                        columns.Bound(f => f.LastInventoryKg).Width(75)
                              .HeaderTemplate("Last-Inv</br>(g)")
                              .Aggregate(agg => agg.Sum())
                               .Format("{0:n0}")
                              .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                              .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                              .HtmlAttributes(new { style = "text-align: right;" });
                    })
                //.Scrollable(f => f.Height(510))
                //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnRowDataBound("grid_OnRowDataBound")
                                            .OnError("grid_OnError"))
                .Groupable()
                .Render();
        }
    </div>
</div>
