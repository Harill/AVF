    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function grid_OnEdit(e) {

            var mode = e.mode;
            var form = e.form;

            var classifiedName = $(form).find('#ClassifiedName');
            var classifiedNameData = $(form).find('#ClassifiedName').data('tDropDownList');

            if (mode == 'insert') {

            }
            else if (mode == 'edit') {

                var nodes = $(form).find('#ClassifiedName');
                nodes[0].parentNode.parentNode.innerHTML = e.dataItem.ClassifiedName;
                //var nodes = $(form).find('#MaxColumn');
                //nodes[0].parentNode.parentNode.innerHTML = e.dataItem.MaxColumn;
                //var nodes = $(form).find('#MaxRow');
                //nodes[0].parentNode.parentNode.innerHTML = e.dataItem.MaxRow;
            }
        }

        function gridDrawer_OnRowDataBound(e) {
            if (!e.dataItem.ReferenceInvCode || e.dataItem.ReferenceInvCode === "")
                e.row.getElementsByClassName("chkId")[0].parentNode.innerHTML = "";
        }

        function PrintInventoryOnShelfCard() {

            var $checkedRecords = $("input[name='chkIds']:checked")

            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 kệ");
                return;
            }

            var a = {};
            checkedRecords = "";
            for (var i = 0; i < $checkedRecords.length; i++) {
                if ($checkedRecords[i] === "0") continue;
                a[i] = $checkedRecords[i].value;

                checkedRecords += $checkedRecords[i].value;
                if (i < ($checkedRecords.length - 1))
                    checkedRecords += ":";
            }
            if (checkedRecords.length > 0) {
                $('#result').load('@Url.Action("PrintInventoryOnShelfCards", "Warehouse")',
                    {
                        checkedRecords: checkedRecords,
                    }, function () {
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;

        }

        @*function DuplicateDrawer(drawerId) {
            $.ajax({
                type: 'post',
                data: { drawerId: drawerId },
                dataType: 'json',
                url: '@Url.Action("DuplicateInventoryDrawer", "Warehouse", new { area = "Inv" })',
                timeout: 20000,
                success: function (data) {
                    if (data == 9)
                        alert("Lỗi !");
                    else {
                        alert("Nhân bản thành công !");
                    }
                }
            });
            return false;
        }*@
    </script>
}

<div class="title">Warehouse shelving  Management
 @*   Quản lý thông tin kho kệ*@

</div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<InventoryShelfModel>()
            .Name("gridWarehouse")
            .DataKeys(key => key.Add(f => f.ShelfId).RouteKey("shelfId"))
            .ToolBar(
                toolbar =>
                toolbar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).Text("Add New").ImageHtmlAttributes(new { style = "margin-left:0" }))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectInventoryShelf", "Warehouse")
                                          .Insert("InsertInventoryShelf", "Warehouse")
                                          .Update("UpdateInventoryShelf", "Warehouse"))
            .Columns(columns => {
                columns.Command(c => c.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(98).Title("").HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.ClassifiedName).Title("Classified").Width(150);        //Phân loại
                columns.Bound(f => f.MaxColumn).Title("Column").Width(100);             //Số cột
                columns.Bound(f => f.MaxRow).Title("Row").Width(100);           //Số dòng
                columns.Bound(f => f.ShelfName).Title("Shelf Name");                // ten^ ke.
                //columns.Bound(f => f.WarehouseName).Title("Kho").Width(100);

                columns.Bound(f => f.Active).Title("Active").Width(45)
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.ModifiedDate).Title("M-Date").Width(150).ReadOnly(true)
                    .Format("{0:dd/MM/yyyy HH:mm}");
                columns.Bound(f => f.ModifiedUser).Title("M-User").Width(100).ReadOnly(true);
            })

        .DetailView(details => details.ClientTemplate(

            Html.Telerik().TabStrip()
                .Name("TabStrip_<#= ShelfId #>")
