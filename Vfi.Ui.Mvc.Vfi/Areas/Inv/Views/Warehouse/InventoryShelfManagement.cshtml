                                           columns.Bound(f => f.ModifiedDate).Title("M-Date").Width(120).ReadOnly(true)
                                               .Format("{0:dd/MM/yyyy HH:mm}");
                                           columns.Bound(f => f.ModifiedUser).Title("M-User").Width(80).ReadOnly(true);
                                           columns.Command(c => c.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Title("Delete</br>Material").Width(55);       //Bỏ NL
                                       })
                                       .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
                                       .ClientEvents(e => e.OnError("grid_OnError"))
                                       .Pageable(page => page.PageSize(10))
