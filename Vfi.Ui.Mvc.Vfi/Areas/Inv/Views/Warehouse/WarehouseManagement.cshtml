@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "Warehouse Management";
    //Quản lý kho
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title">Warehouse Management
@*    Quản lý thông tin các kho*@

</div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

    <fieldset>
        <legend>Mô tả cấu hình kho:</legend>
        <span>Quy trình chính: là các kho sử dụng trong quy trình chính thức. Áp dụng cho kế hoạch</span><br/>
        <span>Quy trình ngoài: là các kho bất quy trình. Phải được phân quyền kho mới có thể dùng</span>
    </fieldset>
</div>
<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<WarehouseModel>()
            .Name("gridWarehouse")
            .DataKeys(key => key.Add(f => f.WarehouseId).RouteKey("warehouseId"))
            .ToolBar(
                toolbar =>
                toolbar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).Text("Add New").ImageHtmlAttributes(new { style = "margin-left:0" }))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectWarehouse", "Warehouse")
                                          .Insert("InsertWarehouse", "Warehouse")
                                          .Update("UpdateWarehouse", "Warehouse"))
            .Columns(columns => {
                columns.Bound(f => f.Idx).Title("No.").Width(45)
                    .HtmlAttributes(new { style = "text-align:center" }); ;
                columns.Command(command => command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(98).Title("").HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.WarehouseName).Title("Warehouse Name");
                columns.Bound(f => f.ShortName).Title("Short Name");

                columns.Bound(f => f.Active).Title("Active").Width(45)
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.IsMainProcess).Width(55).Title("Main</br>Process")          //Quy trình</br>chính
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsMainProcess' <#=IsMainProcess? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.IsOutOfProcess).Width(55).Title("Outsite</br>Process")         //Quy trình</br>ngoài
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsOutOfProcess' <#=IsOutOfProcess? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.AutoGenerateProcess).Width(55).Title("Product</br>Process")                   //Quy trình</br>sản phẩm
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='AutoGenerateProcess' <#=AutoGenerateProcess? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.ModifiedDate).Width(45).ReadOnly(true).Title("M_Date") 
                    .Format("{0:dd/MM/yyyy HH:mm}");
                columns.Bound(f => f.ModifiedUser).Width(45).ReadOnly(true).Title("M_User");
            })
            .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("TabStrip_<#= WarehouseId #>")
                    .SelectedIndex(0)
                    .Items(items =>
                        {
                            items.Add().Text("Section").Content(
                Html.Telerik().Grid<WarehouseModel>()
                    .Name("gridProcess_<#= WarehouseId #>")
                    .DataKeys(key => key.Add(f => f.WarehouseId).RouteKey("warehouseId"))
                    .DataBinding(dataDindings => dataDindings.Ajax()
                        .Select("SelectWarehouseProcessConfiguration", "Warehouse", new { warehouseId = "<#= WarehouseId #>", })
                        .Update("UpdateWarehouseProcessConfiguration", "Warehouse"))
                    .Columns(columns => {
                        columns.Command(command => command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(98).Title("").HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsProduction).Width(45).Title("Production1")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsProduction' <#=IsProduction? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsCncMilling).Width(45).Title("Milling-CNC")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsCncMilling' <#=IsCncMilling? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsProduction2).Width(45).Title("Production2")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsProduction2' <#=IsProduction2? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsProduction2Process).Width(45).Title("Production2 Processing")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsProduction2Process' <#=IsProduction2Process? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsHeatTreatment).Width(45).Title("Heat Treatment")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsHeatTreatment' <#=IsHeatTreatment? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsPolish).Width(45).Title("Polishing")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsPolish' <#=IsPolish? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsPlating).Width(45).Title("Plating")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsPlating' <#=IsPlating? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsQC).Width(45).Title("QC")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsQC' <#=IsQC? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsPacking).Width(45).Title("Packing")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsPacking' <#=IsPacking? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsFinish).Width(45).Title("Producted")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsFinish' <#=IsFinish? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsReprocessing).Width(45).Title("Reprocessing")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsReprocessing' <#=IsReprocessing? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center;" });
                        columns.Bound(f => f.IsDefect).Width(45).Title("Scrap")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsDefect' <#=IsDefect? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center;" });
                    })
                    .ClientEvents(events => events.OnError("grid_OnError"))
                    .ToHtmlString());

                           items.Add().Text("Function").Content(
                Html.Telerik().Grid<WarehouseModel>()
                    .Name("gridFunction_<#= WarehouseId #>")
                    .DataKeys(key => key.Add(f => f.WarehouseId).RouteKey("warehouseId"))
                    .DataBinding(dataDindings => dataDindings.Ajax()
                        .Select("SelectWarehouseFunctionConfiguration", "Warehouse", new { warehouseId = "<#= WarehouseId #>", })
                        .Update("UpdateWarehouseFunctionConfiguration", "Warehouse"))
                    .Columns(columns => {
                        columns.Command(command => command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(98).Title("").HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.CanInternal).Width(45).Title("Internal</br>Entry/Release")
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='CanInternal' <#=CanInternal? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.CanStock).Width(45).Title("Inv")           //Tính</br>tồn kho
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='CanStock' <#=CanStock? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.CanPurchase).Width(45).Title("Purchase</br>Entry")               //Nhập</br>mua hàng
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='CanPurchase' <#=CanPurchase? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.CanWeighing).Width(45).Title("Weighing")                   //Cân</br>hàng
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='CanWeighing' <#=CanWeighing? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsDestroy).Width(45).Title("Cancel</br>Warehouse")                      //Kho</br>hủy
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsDestroy' <#=IsDestroy? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.IsTransfer).Width(45).Title("Transit</br>Warehouse")                       //Kho</br>trung chuyển
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsTransfer' <#=IsTransfer? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                    })
                    .ClientEvents(events => events.OnError("grid_OnError"))
                    .ToHtmlString());
                        })
            .ToHtmlString()
                               ))
            .ClientEvents(e => e.OnError("grid_OnError")
                                .OnRowSelect("grid_OnRowSelect"))
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
            //.Pageable(page => page.PageSize(10))
            .Sortable()
            .Render();
    }
</div>
