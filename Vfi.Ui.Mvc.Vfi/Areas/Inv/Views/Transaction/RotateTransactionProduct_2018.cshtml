</div>
<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ProductInventoryRotateModel>()
            .Name("gridProductInventory")
            .ToolBar(bar => bar.Template(
                @<text>
                     <div class="grid_7">
                         <button class="t-button" id="btnPickupProductId" name="btnPickupProductId" onclick=" PickupProductId() ">
                             <span class='t-icon t-insert'></span>
                             Chọn các sản phẩm vào lưới
                         </button>
                     </div>
                     <div class="clear"></div>
                 </text>
                                ))
            .DataKeys(keys => keys.Add(f => f.ProductInventoryIssueId).RouteKey("productInventoryIssueId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectProductInventoryByCustomerAndWarehouse", "Inv",
                                                             new { customerId = 0, warehouseId = 0, eoi = MyUtilities.Transaction.EoIEnum.Rotate, productName = "" })

            )
            .Columns(columns =>
                {
                    columns.Bound(f => f.ProductInventoryId).Title("Chọn").Width(75)
                           .ClientTemplate("<input type='checkbox' name='chkProductIds' value='<#= ProductInventoryId #>' />")
                           .HtmlAttributes(new {style = "text-align:center"});
                    columns.Bound(f => f.ProductCode).Width(250);
                    columns.Bound(f => f.ProductWeight).Width(100).Title("TL sản phẩm (g/pc)")
                        //.HeaderTemplate("TL sản phẩm</br>(g/pc)")
                           .ClientTemplate("<#= ProductWeight == null ? 0 : $.telerik.formatString('{0:n3}', ProductWeight) #>");
                    //columns.Bound(f => f.TotalQtyExport);
                    //columns.Bound(f => f.TotalQtyImport);
                    //columns.Bound(f => f.ProductId).Width(250);
                    columns.Bound(f => f.TotalQty).Title("Tồn kho xuất (pcs)").Width(100)
                           .ClientTemplate("<#= TotalQty == null ? 0 : $.telerik.formatString('{0:n0}', TotalQty) #>");
                    columns.Bound(f => f.AvailableQty).Title("Có thể xuất (pcs)").Width(100)
                           .ClientTemplate("<#= AvailableQty == null ? 0 : $.telerik.formatString('{0:n0}', AvailableQty) #>");
                    //columns.Bound(f => f.AvailableQty);
                    //columns.Bound(f => f.UnavailableQty);
                    //columns.Bound(f => f.Active).Width(75)
                    //   .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                    //   .HtmlAttributes(new { style = "text-align:center" });
                    columns.Bound(f => f.Note).Title("");
                })
            .Scrollable(f => f.Height("auto"))
            .Scrollable(f => f.Height(200))
            .Resizable(f => f.Columns(true))
            //.Pageable(f => f.Style(GridPagerStyles.Status))
            .ClientEvents(events => events.OnError("grid_OnError").OnDataBinding("gridProductInventory_onDataBinding").OnRowDataBound("grid_OnRowDataBound"))
            .Render();
    }
</div>
