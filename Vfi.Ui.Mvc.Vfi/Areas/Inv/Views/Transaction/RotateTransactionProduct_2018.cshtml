        function gridProductInventoryDetail_onSave(e) {
            var productId = e.dataItem.ProductId;
            //tong realnumber
            var spanReals, i, innerText, sumReal = 0, sumRealKg = 0;
            var productQuantity = 0;
            var quantityKg = $(e.cell).find('#QuantityKg').val();
            if (!isNaN(parseInt(quantityKg))) {
                if (e.dataItem.ProductWeight == 0 && parseFloat(quantityKg) != 0) {
                    alert("Lỗi! Sản phẩm chưa có trọng lượng! Không thể nhập khối lượng chuyển");
                } else {
                    spanReals = $("span[name='QuantityKg']");
                    for (i = 0; i < spanReals.length; i++) {
                        innerText = spanReals[i].innerText;
                        innerText = innerText.replace(/,/g, '');
                        sumRealKg = sumRealKg + parseInt(innerText);
                    }
                    sumRealKg = sumRealKg + parseInt(quantityKg);
                    $("#TotalQtyKg").text(sumRealKg.format(0));
                    productQuantity = parseInt(parseInt(quantityKg) / e.dataItem.ProductWeight);
                    e.cell.parentElement.getElementsByClassName("Quantity")[0].textContent = productQuantity.format(0);
                    e.dataItem.Quantity = productQuantity;
                    //quantityCell.textContent = productQuantity.format(0);

                    spanReals = $("span[name='Quantity']");
                    for (i = 0; i < spanReals.length; i++) {
                        innerText = spanReals[i].innerText;
                        innerText = innerText.replace(/,/g, '');
                        sumReal = sumReal + parseInt(innerText);
                    }
                    //sumReal = sumReal + parseInt(quantity);
                    $("#TotalQty").text(sumReal.format(0));
                }
            }

            var quantity = $(e.cell).find('#Quantity').val();
            if (!isNaN(parseInt(quantity))) {
                // var quantity = $(e.cell).find('#Quantity').val();
                spanReals = $("span[name='Quantity']");
                for (i = 0; i < spanReals.length; i++) {
                    innerText = spanReals[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumReal = sumReal + parseInt(innerText);
                }
                sumReal = sumReal + parseInt(quantity);
                $("#TotalQty").text(sumReal.format(0));
                productQuantity = parseInt(quantity);
                e.cell.parentElement.getElementsByClassName("QuantityKg")[0].textContent = 0;
                e.dataItem.QuantityKg = 0;

                spanReals = $("span[name='QuantityKg']");
                for (i = 0; i < spanReals.length; i++) {
                    innerText = spanReals[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumRealKg = sumRealKg + parseInt(innerText);
                }
                $("#TotalQtyKg").text(sumRealKg.format(0));
            }
            var warehouseIssue = $("#WarehouseIssueName").data('tDropDownList').value();
            $.ajax({
                type: 'post',
                data: {
                    warehouseId: warehouseIssue,
                    productId: productId,
                    quality: productQuantity
                },
                dataType: 'json',
                url: '@Url.Action("CheckProductInventory", "Transaction")',
                timeout: 20000,
                success: function (data) {
                    //alert(data);
                    if (data[0] == 1) {
                        //alert("");
                    } else if (data[0] == 0) {
                        alert("Số lượng bạn nhập với các giao dịch trước đó có thể đã quá so với sản phẩm tồn kho\n" +
                            "Kho thiếu " + ((data[1]) * -1));
                    }
                    //else if (data == 2) {
                    //    $('#lookupTransactionCodeExisted').attr('class', 'imgUnAvailable');
                    //    $('#txtTransactionCodeHidden').val(0);
                    //}
                }
            });
        }

        function gridProductInventoryDetail_onSubmitChanges(e) {

            var flag = InputValidation();

            if (flag == false)
                e.preventDefault();
            else {

                var transactionCode = $("#TransactionCode").val();

                var warehouseIssueName = $('#WarehouseIssueName').data('tDropDownList').value();
                var warehouseReceiptName = $('#WarehouseReceiptName').data('tDropDownList').value();
                var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
                if (monthlyDate === null)
                    monthlyDate = "";
                else
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

                e.values = $.extend(e.values,
                    {
                        transactionCode: transactionCode,

                        warehouseIssueId: warehouseIssueName,
                        warehouseReceiptId: warehouseReceiptName,
                        warehouseId: warehouseReceiptName,

                        materialOrProduct: false,
                        exportOrImport: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Rotate)",
                        date: monthlyDate
                    }
                );
                }
            }
        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            if (dataItem.ProductWeight == 0)
                e.row.childNodes[2].style.backgroundColor = "#F4FA58";
            if (dataItem.AvailableQty == 0 && dataItem.AvailableQty != dataItem.TotalQty)
                e.row.childNodes[4].style.backgroundColor = "#F4FA58";
        }

            function gridProduct_OnRowDataBound(e) {
                var dataItem = e.dataItem; //FA5858 F4FA58
                if (dataItem.ProductWeight == 0)
                    e.row.childNodes[2].style.backgroundColor = "#F4FA58";
            }

    </script>

    <!-- input validation -->
    <script type="text/javascript">
        function InputValidation() {
            var strMsgAlert = "";

            //        var materialClassifiedName = $('#MaterialClassifiedName').data('tDropDownList').value();
            //        var materialTypeName = $('#MaterialTypeName').data('tDropDownList').value();

            // var txtTransactionCodeHidden = $("#txtTransactionCodeHidden").val();

            var warehouseIssueName = $('#WarehouseIssueName').data('tDropDownList').value();
            var warehouseReceiptName = $('#WarehouseReceiptName').data('tDropDownList').value();

            //        if (materialClassifiedName === "") {
            //            strMsgAlert += "Vui lòng chọn phân loại nguyên liệu.\t\r\n";
            //        }
            //        if (materialTypeName === "") {
            //            strMsgAlert += "Vui lòng chọn loại nguyên liệu.\t\r\n";
            ////        }

            //        if (txtTransactionCodeHidden === "0") {
            //            strMsgAlert += "Số đơn không hợp lệ.\t\r\n";
            //        }

            if (warehouseIssueName === "") {
                strMsgAlert += "Vui lòng chọn kho xuất.\t\r\n";
            }
            if (warehouseReceiptName === "") {
                strMsgAlert += "Vui lòng chọn kho nhập.\t\r\n";
            }
            if (warehouseIssueName === warehouseReceiptName) {
                strMsgAlert += "Không thể cùng kho xuất nhập.\t\r\n";
            }

            if (strMsgAlert === "")
                return true;

            alert(strMsgAlert);
            return false;
        }
    </script>


<div class="title">Luân chuyển kho</div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

    <div class="grid_3">Khách hàng:</div>
    <div class="grid_7">
        @{
            Html.Telerik().ComboBox()
                .Name("Customer")
                .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                .HtmlAttributes(new { style = "width: 250px" })
                .DropDownHtmlAttributes(new { style = "width: 325px" })
                .ClientEvents(events => events.OnChange("customer_onChange"))
                .AutoFill(true)
                .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                .Render();
        }
    </div>
    <div class="grid_2">Sản phẩm:</div>
    <div class="grid_4">
        @{
            Html.Telerik().AutoComplete()
                .Name("ProductCodeName")
                .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                .HtmlAttributes(new { style = "width: 200px; " })
                .DropDownHtmlAttributes(new { style = "width: 250px; " })
                .Encode(false)
                .AutoFill(true)
                .HighlightFirstMatch(true)
                .ClientEvents(events => events
                    .OnChange("autoComplete_onChange")
                )
                .Render();
        }
    </div>
    <div class="clear"></div>
    <br />

    <fieldset>
        <legend>Thông tin phiếu lệnh nhập</legend>

        @*        <div class="grid_2">@Html.LabelFor(f=>f.TransactionCode)</div>
        <div class="grid_1"><div id="lookupTransactionCodeExisted">&nbsp;</div></div>
        <div class="grid_4">
            @Html.TextBoxFor(f=>f.TransactionCode, new {style ="color: maroon;"})
            @Html.Hidden("txtTransactionCodeHidden")
        </div> *@


        <div class="grid_2">
            @Html.LabelFor(f => f.WarehouseIssueName)
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().DropDownList()
                    .Name("WarehouseIssueName")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxImportWarehouse", "Warehouse"))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px; height: 250px;" })
                    .ClientEvents(events => events.OnChange("warehouseIssueName_onChange"))
                    .Render();                                              
            }
        </div>

        <div class="grid_2">@Html.LabelFor(f => f.WarehouseReceiptName)</div>
        <div class="grid_4">
            @{
                Html.Telerik().DropDownList()
                    .Name("WarehouseReceiptName")
                    //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxRotateWarehouse", "Warehouse"))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px; height: 250px;" })
                    .ClientEvents(events => events.OnChange("warehouseReceiptName_onChange"))
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("MonthlyDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
