<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">Chi tiết lệnh xuất nhập sản phẩm</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ProductInventoryRotateModel>()
            .Name("gridProductInventoryDetail")
            .ToolBar(bar => bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu lại").CancelText("Huỷ bỏ"))
            .DataKeys(keys => keys.Add(f => f.ProductInventoryId).RouteKey("productInventoryId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("InputProductInventoryByRotate", "Inv",
                new {  warehouseIssue = 0, warehouseReceipt = 0 })
                .Update("UpdateTransactionProductInventory", "Transaction"))
            .Columns(columns =>
            {
                columns.Bound(f => f.CustomerCode).Width(50).Title("Mã KH").ReadOnly(true);
                columns.Bound(f => f.ProductCode).Width(100).ReadOnly(true)
                    .Aggregate(agg => agg.Count())
                                   .ClientGroupFooterTemplate("<div style='text-align: center; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                                   .ClientFooterTemplate("<div style='text-align: center; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                                   ;
                columns.Bound(f => f.ProductWeight).Title("TL sản phẩm (g/pc)").Width(100).ReadOnly(true)
                    //.HeaderTemplate("TL sản phẩm</br>(g/pc)")
                    .ClientTemplate("<#= ProductWeight == null ? 0 : $.telerik.formatString('{0:n3}', ProductWeight) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                //columns.Bound(f => f.TotalQty).Width(125).ReadOnly(true);
                //columns.Bound(f => f.UnavailableQty).Width(125).ReadOnly(true);
                columns.Bound(f => f.TotalQtyExport).Title("Tồn kho xuất (pcs)").ReadOnly(true).Width(100)
                    .ClientTemplate("<#= TotalQtyExport == null ? 0 : $.telerik.formatString('{0:n0}', TotalQtyExport) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.TotalQtyExportKg).Title("Tồn kho xuất (g)").ReadOnly(true).Width(100)
                    .ClientTemplate("<#= TotalQtyExportKg == null ? 0 : $.telerik.formatString('{0:n0}', TotalQtyExportKg) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.AvailableQty).Width(125).ReadOnly(true).Title("SL có thể chuyển")
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.TotalQtyImport).Title("Tồn kho nhập (pcs)").ReadOnly(true).Width(100)
                    .ClientTemplate("<#= TotalQtyImport == null ? 0 : $.telerik.formatString('{0:n0}', TotalQtyImport) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                //columns.Bound(f => f.TotalQtyImport).ReadOnly(true);
                columns.Bound(f => f.QuantityKg).Width(100).Title("TL xuất (g)")
                       .ClientTemplate("<span name='QuantityKg' class='QuantityKg' ><#= QuantityKg == null ? 0 : $.telerik.formatString('{0:n0}', QuantityKg) #></span>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterTemplate("<span id='TotalQtyKg'></span>");
                columns.Bound(f => f.Quantity).Width(100).Title("SL xuất (pcs)")
                       .ClientTemplate("<span name='Quantity' class='Quantity'><#= Quantity == null ? 0 : $.telerik.formatString('{0:n0}', Quantity) #></span>")
                              .HtmlAttributes(new { style = "text-align: right;" })
                       .FooterTemplate("<span id='TotalQty'></span>");

                columns.Bound(f => f.Note).Title("Ghi Chú");
                columns.Bound(f => f.ProductInventoryId).Title("Ghi Chú").Hidden(true);
                columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image).Text("")).Width(50).Title("");
            })
            .ClientEvents(events => events
                .OnSave("gridProductInventoryDetail_onSave")
                .OnSubmitChanges("gridProductInventoryDetail_onSubmitChanges")
                .OnError("grid_OnError")
                .OnDataBound("gridProductInventoryDetail_onDataBound")
                .OnRowDataBound("gridProduct_OnRowDataBound")
            )
            .Editable(f => f.Mode(GridEditMode.InCell))
            // .Footer(true)
            .Resizable(f => f.Columns(true))
            .Render();   
    }
</div>
