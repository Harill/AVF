@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "Duyệt nhập xuất nguyên liệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- approve stockorder -->
    <script type="text/javascript">
        function ApproveTransaction() {
            $("#btnApproveTransaction").attr('disabled', 'disabled');
            var $checkedRecords = $("input[name='chkTransactionIds']:checked");

            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 nguyên liệu");
                return;
            }
            OnLoadingData();
            $.post('@Url.Action("ApproveTransactionForMaterial", "Transaction")',
                {
                    //checkedRecords: $checkedRecords.map(function () { return value; })
                    checkedRecords: $checkedRecords.eq(0).val()
                },
                function (data) {

                    if (data === "okie") {
                        RefreshGrid("gridTransaction");
                    } else {
                        alert(data);
                    }
                    OnLoadedData();
                });
            $("#btnApproveTransaction").removeAttr('disabled');
        }

        var indexSignature1 = 0;
        var countSignature1 = 0;

        var index1 = 0;
        var count1 = 0;

        function Grid_OnRowDataBound(e) {
            var check = e.dataItem.IsNormal;
            if (!check)
                e.row.style.backgroundColor = "#F4FA58";
            // chu ky nhap GCN
            var dataItem = e.dataItem;
            if (dataItem.PurchasingSignatureType == 0) {
                document.getElementsByClassName("t-button purchasing")[indexSignature1 - countSignature1].parentNode.innerHTML = "<span class='t-icon t-cancel'></span>";
                document.getElementsByClassName("chkCheck")[index1 - count1].parentNode.innerHTML = "";
                countSignature1++;
                count1++;
            } else if (dataItem.PurchasingSignatureType == 1) {
                document.getElementsByClassName("t-button purchasing")[indexSignature1 - countSignature1].parentNode.innerHTML = "<span class='t-icon t-insert'></span>";
                countSignature1++;
            } else if (dataItem.PurchasingSignatureType == 2) {
                document.getElementsByClassName("chkCheck")[index1 - count1].parentNode.innerHTML = "";
                count1++;
            } else {
                document.getElementsByClassName("t-button purchasing")[indexSignature1 - countSignature1].parentNode.innerHTML = "";
                countSignature1++;

            }
            indexSignature1++;
            index1++;
        }
    </script>

    <!-- grid Transaction -->
    <script type="text/javascript">

        function gridTransaction_onDataBinding(args) {
            var txtTransactionCodeSearch = $("#txtTransactionCodeSearch").val();

            args.data = $.extend(args.data, {
                status: Number("@((byte)MyUtilities.Transaction.Status.Open)"),
                transactionCode: txtTransactionCodeSearch,
                mop: true
            });

            indexSignature1 = 0;
            countSignature1 = 0;

            index1 = 0;
            count1 = 0;
        }

        function PrintForm(val) {
            alert(val);
            $('#result').load('@Url.Action("PrintTransactionMaterial", "Inv")',
            {
                transactionId: val
            }, function () {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
            return false;
        }

        function Signature(transactionId) {
            $.ajax({
                type: 'post',
                data: { transactionId: transactionId },
                dataType: 'json',
                url: '@Url.Action("ImportMaterialSignature", "Transaction", new { area = "Inv" })',
                timeout: 20000,
                success: function (data) {
                    if (data == 9)
                        alert("Lỗi không tìm thấy phiếu !");
                    else {
                        alert("Thêm chữ ký thành công !");
                        RefreshGrid("gridTransaction");
                        indexSignature1 = 0;
                        countSignature1 = 0;
                        index1 = 0;
                        count1 = 0;
                    }
                }
            });
            return false;
        }
        function PrintForm(val) {
            alert(val);
            $('#result').load('@Url.Action("PrintTransactionMaterial", "Inv")',
            {
                transactionId: val
            }, function () {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
            return false;
        }
        function PrintCard(val) {
            alert(val);
            $('#result').load('@Url.Action("PrintTransactionMaterialCard", "Inv")',
            {
                transactionId: val
            }, function () {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
            return false;
        }

        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
    </script>
}

<div class="title">Duyệt phiếu xuất nhập nguyên liệu</div>

<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">Sổ lệnh</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionModel>()
            .Name("gridTransaction")
            .DataKeys(keys => keys.Add(f => f.TransactionId).RouteKey("transactionId"))
            .ToolBar(bar => bar.Template(
        @<text>
        <div class="grid_9">
            <button class="t-button" id="btnApproveTransaction" name="btnApproveTransaction" onclick=" ApproveTransaction() ">
                <span class='t-icon t-insert'></span>
                Duyệt các sổ lệnh
                <span class="loadButton"></span>
            </button>
        </div>
        <div class="clear"></div>
        </text>
))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectWaitingMaterialTransactions", "Transaction")
                                                     .Delete("CancelTransactionMaterial", "Transaction")
            )
            .Columns(columns => {
                columns.Bound(f => f.TransactionId).Title("Chọn").Width(50)
                       .ClientTemplate("<input type='radio' name='chkTransactionIds' class='chkCheck'  value='<#= TransactionId #>' />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.TransactionCode).Width(100);
                columns.Bound(f => f.CreatedDate).Width(90)
                       .Format("{0:dd/MM/yyyy}");
                columns.Bound(f => f.EoIName).Width(100);
                columns.Bound(f => f.TotalQuality).Width(100)
                       .HeaderTemplate("Tổng SL</br>(cây)")
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align: right;" });
                //columns.Bound(f => f.TotalQualityKg).Width(100)
                //       .HeaderTemplate("Tổng SL</br>(Kg)")
                //       .Format("{0:n2}")
                //       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.StatusName).Width(75);
                columns.Bound(f => f.SpecialNote).Title("Ghi chú");
                columns.Bound(f => f.ModifiedUser).Width(75).Title("Người làm");
                columns.Bound(f => f.ModifiedDate).Width(90).Title("Ngày làm")
                       .Format("{0:dd/MM/yyyy HH:mm}");
                columns.Bound(f => f.TransactionId).Title("In").Width(50)
                       .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' class='t-button' onclick=PrintForm(<#= TransactionId #>) />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.TransactionId).Title("Card").Width(50)
                       .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' class='t-button printcard' onclick=PrintCard(<#= TransactionId #>) />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.TransactionId).Title("Quản lý</br>xác nhận").Width(50)
                       .ClientTemplate("<button class='t-button purchasing' id='QLM_<#= TransactionId #>' onclick=Signature(<#= TransactionId #>) ><span class='t-icon t-insert'></span></button>")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Command(c => c.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(50);
            })
            .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("TabStrip_<#= TransactionId #>")
                    .SelectedIndex(0)
                    .Items(items =>
                           items.Add().Text("Thông tin chi tiết").Content(
                               Html.Telerik().Grid<TransactionDetailModel>()
                                   .Name("gridTransactionDetail_<#= TransactionId #>")
                                   .DataBinding(dataDindings => dataDindings.Ajax()
                                                                            .Select("SelectTransactionDetailByTransactionId", "Transaction",
                                                                                    new { transactionId = "<#= TransactionId #>" }))
                                   .Columns(columns => {
                                       columns.Bound(f => f.MaterialTypeName).Title("Loại NL").Width(100)
                                              .HtmlAttributes(new { style = "text-align: center;" });
                                       columns.Bound(f => f.MaterialName).Title("Tên NL").Width(80)
                                              .Aggregate(agg => agg.Count())
                                              .FooterHtmlAttributes(new { style = "text-align: center;" })
                                              .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>");
                                       columns.Bound(f => f.DesignCode).Title("Quy cách").Width(120);
                                       columns.Bound(f => f.Length).Width(75)
                                              .HeaderTemplate("Dài</br>(mm)");
                                       columns.Bound(f => f.VendorName).Title("NCC").Width(100)
                                              .HtmlAttributes(new { style = "text-align: center;" });
                                       columns.Bound(f => f.UnitWeight).Width(70)
                                              .HeaderTemplate("TL</br>(kg/cây)")
                                              .Format("{0:n3}")
                                              .HtmlAttributes(new { style = "text-align: right;" });
                                       columns.Bound(f => f.LotNumber).Width(100)
                                              .HtmlAttributes(new { style = "text-align: center;" });
                                       columns.Bound(f => f.AvailableQuantity).Width(70)
                                              .HeaderTemplate("Tồn kho</br>(cây)")
                                              .Format("{0:n2}")
                                              .HtmlAttributes(new { style = "text-align: right;" });
                                       columns.Bound(f => f.Quantity).Width(100)
                                              .HeaderTemplate("SL chuyển</br>(cây)")
                                              .Format("{0:n2}")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .Aggregate(agg => agg.Sum())
                                              .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                                              .FooterHtmlAttributes(new { style = "text-align: right;" });
                                       columns.Bound(f => f.QuantityKg).Width(100)
                                              .HeaderTemplate("SL chuyển</br>(Kg)")
                                              .Format("{0:n2}")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .Aggregate(agg => agg.Sum())
                                              .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                                              .FooterHtmlAttributes(new { style = "text-align: right;" });
                                       columns.Bound(f => f.Note);
                                   })
            .ClientEvents(events => events.OnError("grid_OnError"))
                                   .ToHtmlString()
                               )
                    )
                    .ToHtmlString()
                                       ))
            .Selectable()
            .ClientEvents(events => events
                                        .OnRowSelect("grid_OnRowSelect")
                                        .OnDataBinding("gridTransaction_onDataBinding")
                                        .OnRowDataBound("Grid_OnRowDataBound")
            .OnError("grid_OnError"))
            //.Pageable(f=>f.PageSize(5))
            .Render();
    }
</div>

@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
)
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .ClientEvents(e => e.OnOpen("window_onopen"))
        .Visible(false)
        .Width(960)
        .Render();
}

<script>
    function window_onopen(e) {
        //alert("b");
        $("#rptvPageImportMaterial_ReportToolbar_ExportGr_FormatList_DropDownList option[value='XLS']").remove();
        $("#rptvPageImportMaterial_ReportToolbar_ExportGr_FormatList_DropDownList option[value='RTF']").remove();
        $("#rptvPageImportMaterial_ReportToolbar_ExportGr_FormatList_DropDownList option[value='MHTML']").remove();
    }
</script>
