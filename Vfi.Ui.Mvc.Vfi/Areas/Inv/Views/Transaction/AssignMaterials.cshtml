
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model Vfi.Ui.Mvc.Vfi.Areas.Inv.Models.ImportSX1Model
@{
    ViewBag.Title = "Assign Material";
    //Phiếu Phát Nguyên Liệu
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
   
    <script type="text/javascript">
        function grid_OnDataBinding(e) {
            
            var factory = $("#Factory").data('tComboBox').value();
            e.data = $.extend(e.data, {
                factory: factory
            });
            
        }

        function grid_OnSave(e) {
            var $materialCode = $(e.cell).find('#MaterialInventoryCode');
            if ($materialCode.length > 0) {
                var materialCode = $materialCode.data("tComboBox"),
                    materialCodeSelectItem = materialCode.selectedIndex > -1 ? materialCode.data[materialCode.selectedIndex] : null;

                if (materialCodeSelectItem) {
                    e.values["MaterialInventoryCode"] = materialCodeSelectItem.Text;
                    e.values["MaterialInventoryId"] = materialCodeSelectItem.Value;
                    $.ajax({
                        type: 'post',
                        data: { machineId: e.dataItem.MachineId, materialInventoryId: materialCodeSelectItem.Value },
                        dataType: 'json',
                        url: '@Url.Action("GetAssignMaterial", "Material",new{area=""})',
                        timeout: 20000,
                        success: function (data) {
                            if (data == '9') {
                                alert("Lỗi! Không tìm thấy tồn nguyên liệu");
                            } else if (data == '0') {
                                alert("Lỗi!");
                            } else {
                                e.cell.parentElement.childNodes[2].textContent = data[0];
                                e.cell.parentElement.childNodes[3].textContent = data[1];
                            }
                        }
                     });
                }
            }
           
            //tong number1
            var number1 = $(e.cell).find('#MaterialUse1').val();
            if (!isNaN(parseInt(number1))) {
                var sum = 0.0;
                var spans = $("span[name='MaterialUse1']");
                number1 = parseFloat(number1);
                for (var i = 0; i < spans.length; i++) {
                    var innerText = spans[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sum = sum + parseFloat(innerText);
                }
                sum = sum + number1;
                $("#TotalMaterialUse1").text(sum);
                if (number1 > e.dataItem.DiffMaterial) {
                    e.cell.bgColor = "yellow";
                } else {
                    e.cell.bgColor = "";
                }
            }

        }

        function grid_OnRowDataBound(e) {
            //if (e.dataItem.IsLimit) {
            //    e.row.style.backgroundColor = "#FA5858";
            //}
        }
        function grid_onSubmitChanges(e) {
            var importDate = $("#ImportDate").data("tDatePicker").value();
            if (importDate === null)
                importDate = "";
            else
                importDate = $.telerik.formatString('{0:dd/MM/yyyy}', importDate);

            var caNumber = $("#CaNumber").data("tDropDownList").value();
            var caName = $("#CaName").data("tDropDownList").value();
            
           // console.log(e.values);
            e.values = $.extend(e.values,
                {
                    importDate: importDate,
                    caNumber: caNumber,
                    caName: caName,
                }
            );

            productIds = {};
            productIds[0] = 0;
        }

        function CaNumber_onload() {
            var combobox1 = $('#CaNumber').data('tDropDownList');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" }
            ];

            combobox1.dataBind(dataSource);
            //combobox1.Text("1");
        }

        function CaName_onload() {
            var combobox2 = $('#CaName').data('tDropDownList');
            var dataSource =
            [
                { Text: "A", Value: "A" },
                { Text: "B", Value: "B" },
                { Text: "C", Value: "C" },
                { Text: "D", Value: "D" }
            ];

            combobox2.dataBind(dataSource);
        }

        function Factory_Onload() {
            var combobox = $('#Factory').data('tComboBox');
            var dataSource =
            [
                { Text: "VF1", Value: "VF1" },
                { Text: "VF2", Value: "VF2" }
            ];

            combobox.dataBind(dataSource);
        }
    </script>
}

    <div class="title">Create Assign Material
@*        Tao phieu phat nguyen lieu*@
    </div>
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

        <fieldset>
            <legend>Order Detail</legend> 
@*            Thong tin phieu*@
            <div class="grid_7">
               
            </div>
            <div class="grid_4">Date Of Product Use
               @* Ngày sử dụng sản phẩm*@</div>
            <div class="grid_4">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ImportDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            @*<div class="clear" style ="margin-bottom: 10px"></div>*@
        
            <div class="grid_1">Shift</div>
            <div class="grid_2">
                @{
                    Html.Telerik().DropDownList()
                        .Name("CaNumber")
                        .HtmlAttributes(new {style = "width: 40px"})
                        .DropDownHtmlAttributes(new {style = "width: 40px"})
                        .ClientEvents(events => events.OnLoad("CaNumber_onload"))
                        .Render();
                }
            </div>
            <div class="grid_2">
                @{
                    Html.Telerik().DropDownList()
                        .Name("CaName")
                        .HtmlAttributes(new {style = "width: 40px"})
                        .DropDownHtmlAttributes(new {style = "width: 40px"})
                        .ClientEvents(events => events.OnLoad("CaName_onload"))
                        .Render();
                }
            </div>
            <div class="clear"></div><br />
            <div class="grid_2">Factory: </div>
            <div class="grid_2">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Factory")
                        .ClientEvents(events => events.OnLoad("Factory_Onload"))
                        .Render();
                }
            </div>
        </fieldset>
    </div>
    <div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<SmartProductionModel>()
            .Name("gridPurchaseOrderDetailPartial")
            .DataKeys(keys => keys.Add(f => f.SmartId).RouteKey("smartId"))
            .ToolBar(bar => {
                    //bar.Insert().ButtonType(GridButtonType.ImageAndText).Text("Thêm dòng mới");
                    bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).SaveText("Save All").CancelText("Cancel All");
                })
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectAssignMaterials", "Machine", new { area = "Factory" })
                                                     .Update("UpdateAssignMaterialsProduction", "Transaction")
            )
            .Columns(columns => {
                columns.Bound(f => f.MachineName).Width(100).Title("Machine").ReadOnly(true);
                columns.Bound(f => f.ProductCode).Width(150).Title("Product").ReadOnly(true);
                columns.Bound(f => f.MaterialInventoryCode).Width(200).Title("Material - Lot").ReadOnly(true);
                columns.Bound(f => f.MaterialInvTotal).Width(75).ReadOnly(true)
                    .HeaderTemplate("Inv</br(bar)")                     //Tồn kho</br>(cây)
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align: right;border-left:1px solid black;" });
                columns.Bound(f => f.MaterialInvOnMachine).Width(70).ReadOnly(true)
                    .HeaderTemplate("Machine</br>Inv</br(bar)")                    //Tồn máy</br>(cây)
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.DiffMaterial).Width(100).ReadOnly(true)
                    .HeaderTemplate("Machine Inv</br>Actual</br(bar)")                  //Tồn máy</br> TT(cây)
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.MaterialUse1).Width(70)
                       .HeaderTemplate("Assign</br>Quantity</br>(bar)")                //SL Phát</br>(cây)
                       .HeaderHtmlAttributes(new { @class = "edit-column" })
                       .ClientTemplate("<span name='MaterialUse1'><#= MaterialUse1 == null ? 0 : $.telerik.formatString('{0:n2}', MaterialUse1) #></span>")
                       .FooterTemplate("<span id='TotalMaterialUse1'></span>")
                       .HtmlAttributes(new { style = "text-align: right;border-right:1px solid black;" });
                columns.Bound(f => f.Note).Title("Note");
                columns.Bound(f => f.TotalMaterialInv).Width(90).ReadOnly(true)
                    .HeaderTemplate("Σ Material</br>Inv(kg)")                     //Σ tồn</br>NL(kg)
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align: right;border-left:1px solid black;" });
                columns.Bound(f => f.MaterialLimitQuantity).Width(90).ReadOnly(true)
                    .HeaderTemplate("Material</br>Quantity</br>Limited(kg)")                       //Hạn mức</br>NL(kg)
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.ProductLimitQuantity).Width(95).ReadOnly(true)
                    .HeaderTemplate("Product</br>Quantity</br>Limited(pcs)")                      //Hạn mức</br>SP(pcs)
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.MaterialUsedQuantity).Width(90).ReadOnly(true)
                    .HeaderTemplate("Material</br>Used")                 //NL</br>đã SD
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.MaterialLimitLeft).Width(90).ReadOnly(true)
                    .HeaderTemplate("Material</br>Limited</br>Remaining")                        //HM NL</br>còn lại
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.ProductionQuantity).Width(70).ReadOnly(true)
                    .HeaderTemplate("Product</br>Used")                             //SP</br>đã SX
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align: right;" });
            })
            .ClientEvents(events => events
                                        .OnDataBinding("grid_OnDataBinding")
                                        .OnSave("grid_OnSave")
                                        .OnSubmitChanges("grid_onSubmitChanges")
                                        .OnError("grid_OnError")
                                        .OnRowDataBound("grid_OnRowDataBound")
            )
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            .KeyboardNavigation(keys => keys.EditOnTab(true))
            .Resizable(resizing => resizing.Columns(true))
            .Scrollable(f => f.Height(510))
            // .Footer(false)
            .Render();
    }
</div>
<div class="clear"></div><br />