<script type="text/javascript">
    function customer_onChange() {
        RefreshGrid("gridProductInventory");
    }

    function warehouseIssue_onChange() {

        var warehouseIssue = $("#WarehouseIssueName").data('tDropDownList').value();
        $.ajax({
            type: 'post',
            data: {
                warehouseId: warehouseIssue
            },
            dataType: 'json',
            url: '@Url.Action("SelectComboBoxWarehouseRotateById", "Warehouse", new { area = "Inv" })',
            timeout: 20000,
            success: function (data) {
                $("#WarehouseReceiptName").data('tDropDownList').dataBind(data);
                RefreshGrid("gridProductInventory");
                RefreshGrid("gridProductInventoryDetail");
            }
        });
    }
    function warehouseReceipt_onChange() {

        RefreshGrid("gridProductInventory");
        RefreshGrid("gridProductInventoryDetail");
    }
    function gridProductInventory_onDataBinding(args) {

        var customerId = $("#Customer").data('tComboBox').value();
        var warehouseIssue = $("#WarehouseIssueName").data('tDropDownList').value();

        var productCode = $("#ProductCodeName").data("tAutoComplete").value();

        if (warehouseIssue === "") {
            warehouseIssue = 0;
        }
        if (customerId === "") {
            customerId = 0;
        }

        args.data = $.extend(args.data, {
            customerId: customerId,
            warehouseId: warehouseIssue,
            productCode: productCode
        });

    }

    function autoComplete_onChange() {
        RefreshGrid("gridProductInventory");
    }
</script>

<script type="text/javascript">
    function PickupProductId() {

        var $checkedRecords = $("input[name='chkProductIds']:checked")
        //var $checkedRecords = $("input[name='chkMaterialIds']:checked");

        if ($checkedRecords.length < 1) {
            alert("Vui lọn chọn ít nhất 1 sản phẩm");
            return;
        }

        //$.ajaxSettings.traditional = false;
        var a = {};
        var ids = "";
        //var $b = (a);

        for (var i = 0; i < $checkedRecords.length; i++) {
            if ($checkedRecords[i] === "0") continue;
            a[i] = $checkedRecords[i].value;

            ids += $checkedRecords[i].value;
            if (i < ($checkedRecords.length - 1))
                ids += ":";
        }

        var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
        if (monthlyDate === null)
            monthlyDate = "";
        else
            monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);
        var warehouseIssue = $("#WarehouseIssueName").data('tDropDownList').value();
        if (warehouseIssue === "")
            warehouseIssue = 0;
        var warehouseReceipt = $("#WarehouseReceiptName").data('tDropDownList').value();
        if (warehouseReceipt === "")
            warehouseReceipt = 0;
        $("#gridProductInventoryDetail").data("tGrid").rebind({
            productIds: ids,
            warehouseIssue: warehouseIssue,
            warehouseReceipt: warehouseReceipt,
            monthlyDate: monthlyDate
        });
        index = 0;
    }
</script>

<!-- client event grid material inventory -->
<script type="text/javascript">
    var spanReals, i, innerText, sumReal = 0, sumRealKg = 0;
    function calculateSumKg(quantityKg) {
        spanReals = $("span[name='QuantityKg']");
        for (i = 0; i < spanReals.length; i++) {
            innerText = spanReals[i].innerText;
            innerText = innerText.replace(/,/g, '');
            sumRealKg = sumRealKg + parseInt(innerText);
        }
        sumRealKg = sumRealKg + parseInt(quantityKg);
        $("#TotalQtyKg").text(sumRealKg.format(0));
    }

    function calculateSum(quantity) {
        spanReals = $("span[name='Quantity']");
        for (i = 0; i < spanReals.length; i++) {
            innerText = spanReals[i].innerText;
            innerText = innerText.replace(/,/g, '');
            sumReal = sumReal + parseInt(innerText);
        }
        sumReal = sumReal + parseInt(quantity);
        $("#TotalQty").text(sumReal.format(0));
    }

    function gridProductInventoryDetail_onSave(e) {
        //tong realnumber
        var productQuantity = e.dataItem.Quantity;
        var isRotateAll = $("input[name='IsRotateAll']");
        var quantityKg = $(e.cell).find('#QuantityKg').val();
        var quantity = $(e.cell).find('#Quantity').val();
        var spanIsRotateAll = e.cell.parentElement.getElementsByClassName("IsRotateAll_" + e.dataItem.ProductInventoryIssueId)[0];
        var spanQuantity = e.cell.parentElement.getElementsByClassName("Quantity")[0];
        var spanQuantityKg = e.cell.parentElement.getElementsByClassName("QuantityKg")[0];
        sumReal = 0, sumRealKg = 0;
        if (isRotateAll.attr('checked')) {
            e.dataItem.Quantity = e.dataItem.AvailableQty;
            spanQuantity.textContent = e.dataItem.Quantity.format(0);
            e.dataItem.QuantityKg = e.dataItem.AvailableQtyKg;
            spanQuantityKg.textContent = e.dataItem.QuantityKg.format(0);
            calculateSumKg(0);
            calculateSum(0);
        }
        else if (!isNaN(parseInt(quantityKg))) {
            if (e.dataItem.ProductWeight === 0 && parseFloat(quantityKg) === 0) {
                alert("Lỗi! Sản phẩm chưa có trọng lượng! Không thể nhập khối lượng chuyển");
            } else {
                productQuantity = parseInt(parseInt(quantityKg) / e.dataItem.ProductWeight);
                spanQuantity.textContent = productQuantity.format(0);
                e.dataItem.Quantity = productQuantity;
                if (e.dataItem.Quantity === e.dataItem.AvailableQty) {
                    spanIsRotateAll.checked = true;
                } else {
                    spanIsRotateAll.checked = false;
                }
                calculateSumKg(quantityKg);
                calculateSum(0);
            }
        } else if (!isNaN(parseInt(quantity))) {
            productQuantity = parseInt(quantity);
            spanQuantityKg.textContent = (productQuantity * e.dataItem.ProductWeight).format(0);
            e.dataItem.QuantityKg = (productQuantity * e.dataItem.ProductWeight).format(0);

            if (productQuantity === e.dataItem.AvailableQty) {
                spanIsRotateAll.checked = true;
            } else {
                spanIsRotateAll.checked = false;
            }
            calculateSum(quantity);
            calculateSumKg(0);
        }

        var productInventoryId = e.dataItem.ProductInventoryId;
        $.ajax({
            type: 'post',
            data: {
                productInvId: productInventoryId,
                quality: productQuantity
            },
            dataType: 'json',
            url: '@Url.Action("CheckProductInventoryById", "Transaction")',
            timeout: 20000,
            success: function (data) {
                //alert(data);
                if (data[0] === 1) {
                    //alert("");
                } else if (data[0] === 0) {
                    alert("Số lượng bạn nhập với các giao dịch trước đó có thể đã quá so với sản phẩm tồn kho\n" +
                        "Kho thiếu " +
                        ((data[1]) * -1));
                }
            }
        });
    }

    var index = 0;

    function gridProductInventoryDetail_onSubmitChanges(e) {

        var flag = InputValidation();

        if (flag === false)
            e.preventDefault();
        else {

            var warehouseIssueName = $('#WarehouseIssueName').data('tDropDownList').value();
            var warehouseReceiptName = $('#WarehouseReceiptName').data('tDropDownList').value();

            var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
            if (monthlyDate === null)
                monthlyDate = "";
            else
                monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

            e.values = $.extend(e.values,
                {
                    warehouseIssueId: warehouseIssueName,
                    warehouseReceiptId: warehouseReceiptName,
                    date: monthlyDate
                }
                );
        }
    }

    function gridProductInv_OnRowDataBound(e) {
        var warehouseReceiptName = $('#WarehouseReceiptName').data('tDropDownList').value();
        var dataItem = e.dataItem; //FA5858 F4FA58
        // to mau
        if (dataItem.ProductWeight === 0)
            e.row.childNodes[3].style.backgroundColor = "#F4FA58";
        if (dataItem.AvailableQty === 0 || dataItem.AvailableQty !== dataItem.TotalQty)
            e.row.childNodes[7].style.backgroundColor = "#F4FA58";

        // validate
        var canCheck = true;
        if (dataItem.AvailableQty > 0 && warehouseReceiptName !== "") {
            var warehouseIssue = $("#WarehouseIssueName").data('tDropDownList').value();
            if (warehouseIssue === '');
            if (["8", "16", "21"].includes(warehouseIssue)) {
                // special case
            }
            else {
                if (dataItem.NextWarehouseId === -1) { }
                else if (warehouseIssue === "31" && warehouseReceiptName === "32") { }
                else {
                    warehouseReceiptName = "|" + warehouseReceiptName + "|";
                    //if (dataItem.NextWarehouseIds !== warehouseReceiptName) {
                    if (dataItem.NextWarehouseIds.indexOf(warehouseReceiptName) === -1) {
                        //e.row.childNodes[0].innerHTML = "";
                        canCheck = false;
                    }
                }
            }
        } else {
            //e.row.childNodes[0].innerHTML = "";
            canCheck = false;
        }
        if (!canCheck) { 
            e.row.childNodes[0].innerHTML = "";
        }

    }

    function gridProduct_OnRowDataBound(e) {
        var dataItem = e.dataItem; //FA5858 F4FA58
        if (dataItem.ProductWeight === 0)
            e.row.childNodes[3].style.backgroundColor = "#F4FA58";
    }

    function checkAll() {
        if ($("input[name='chkAll']").attr('checked')) {
            var checkBoxes = $("input[name='chkProductIds']");
            for (i = 0; i < checkBoxes.length; i++) {
                checkBoxes[i].checked = true;
            }
        }
    }

</script>

<!-- input validation -->
<script type="text/javascript">
    function InputValidation() {
        var strMsgAlert = "";
        var warehouseIssueName = $('#WarehouseIssueName').data('tDropDownList').value();
        var warehouseReceiptName = $('#WarehouseReceiptName').data('tDropDownList').value();

        if (warehouseIssueName === "") {
            strMsgAlert += "Vui lòng chọn kho xuất.\t\r\n";
        }
        if (warehouseReceiptName === "") {
            strMsgAlert += "Vui lòng chọn kho nhập.\t\r\n";
        }
        if (warehouseIssueName === warehouseReceiptName) {
            strMsgAlert += "Không thể cùng kho xuất nhập.\t\r\n";
        }

        if (strMsgAlert === "")
            return true;

        alert(strMsgAlert);
        return false;
    }
</script>
