@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Utilities

@{
    ViewBag.Title = "Cancel Forms ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
<!-- approve stockorder -->
<script type="text/javascript">
    function CancelTransaction() {
        $("#btnCancelTransaction").attr('disabled', 'disabled');

        var $checkedRecords = $("input[name='chkTransactionIds']:checked");

        if ($checkedRecords.length < 1) {
            alert("Vui lọn chọn ít nhất 1 nguyên liệu");
            return;
        }

        $.post('@Url.Action("CancelTransactionForProduct", "Transaction")',
            {
                //checkedRecords: $checkedRecords.map(function () { return value; })
                checkedRecords: $checkedRecords.eq(0).val()
            },
            function (data) {
                $("#btnCancelTransaction").removeAttr('disabled');

                if (data === "okie") {
                    RefreshGrid("gridTransaction");
                }
                else
                    alert(data);
            });
    }
</script>


}

<div class="title">Cancel Product-Warehouse Forms
    @*Hủy lệnh thành phẩm*@</div>

<div class="t-info-sha" style="padding-left: 15px; width:250px; color: Maroon;">Forms Sheet</div>
<div class="cover-div">
@{
    Html.Telerik().Grid<TransactionModel>()
        .Name("gridTransaction")
        .DataKeys(keys => keys.Add(f => f.TransactionId).RouteKey("transactionId"))
        .ToolBar(bar => bar.Template(
            @<text>
                 <div class="grid_7">
                     <button class="t-button" id="btnCancelTransaction" name="btnCancelTransaction" onclick=" CancelTransaction() ">
                         <span class='t-icon t-insert'></span>
                         Cancel Forms
                         @*Hủy các sổ lệnh*@
                     </button>
                 </div>
                 <div class="clear"></div>
             </text>
                            ))
        .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectWaitingProductTransactions", "Transaction")
        )
        .Columns(columns =>
            {
                columns.Bound(f => f.TransactionId).Title("Select").Width(75)
                       .ClientTemplate("<input type='radio' name='chkTransactionIds' value='<#= TransactionId #>' />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.TransactionCode).Title("Transaction Code").ReadOnly(true);
                columns.Bound(f => f.CreatedDate).Title("Date").Width(100).ReadOnly(true)
                    .Format("{0:dd/MM/yyyy}");
                columns.Bound(f => f.WarehouseIssueName).Title("Warehouse-Release").ReadOnly(true);
                columns.Bound(f => f.WarehouseReceiptName).Title("Warehouse-Entry").ReadOnly(true);
                columns.Bound(f => f.TotalQuality).Title("Total Quantity").ReadOnly(true)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right" });
                columns.Bound(f => f.ModifiedUser).Title("M-User").ReadOnly(true);
                columns.Bound(f => f.ModifiedDate).Title("M-Date").Width(100).ReadOnly(true)
                    .Format("{0:dd/MM/yyyy}");
                columns.Bound(f => f.TransactionId).Title("Print").Width(45).ReadOnly(true)
                    .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' class='t-button' onclick=PrintForm(<#= TransactionId #>) />")
                    .HtmlAttributes(new { style = "text-align:center" });
            })
        .DetailView(details => details.ClientTemplate(

            Html.Telerik().TabStrip()
                .Name("TabStrip_<#= TransactionId #>")
                .SelectedIndex(0)
                .Items(items =>

                       items.Add().Text("Detail").Content(

                           Html.Telerik().Grid<TransactionDetailModel>()
                               .Name("gridTransactionDetail_<#= TransactionId #>")
                               .DataBinding(dataDindings => dataDindings.Ajax()
                                                                        .Select("SelectTransactionDetailByTransactionId", "Transaction",
                                                                                new {transactionId = "<#= TransactionId #>"}))
                               .Columns(columns =>
                               {
                                   columns.Bound(f => f.CustomerCode).Title("Customer Code").Width(100);
                                   columns.Bound(f => f.ProductCode).Title("Product Code").Width(100);
                                   columns.Bound(f => f.LotNumber).Title("Lot").Width(200);
                                   columns.Bound(f => f.UnitWeight).Title("Weight(g/pc)").Width(50);
                                   columns.Bound(f => f.AvailableQuantity).Width(75).Title("Inv")
                                       .HtmlAttributes(new { style = "text-align: right;" })
                                       .Format("{0:n0}");
                                   columns.Bound(f => f.Quantity).Width(75).Title("Quantity(PCS)")
                                       .HtmlAttributes(new { style = "text-align: right;" })
                                       .Format("{0:n0}").Aggregate(agg => agg.Sum())
                                       .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                       .FooterHtmlAttributes(new { style = "text-align: right;" });
                                   columns.Bound(f => f.QuantityKg).Width(75).Title("Weight(g)")
                                       .HtmlAttributes(new { style = "text-align: right;" })
                                       .Format("{0:n0}")
                                       .Aggregate(agg => agg.Sum())
                                       .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                       .FooterHtmlAttributes(new { style = "text-align: right;" });
                                   columns.Bound(f => f.Note).Title("Note");
                                   columns.Bound(f => f.MaterialCode).Width(250).Title("Material");
                                   columns.Bound(f => f.MaterialTypeName).Width(75).Title("Type");
                                   columns.Bound(f => f.Identity).Width(50).Title("Code");
                                   })
                               .ClientEvents(events => events.OnError("grid_OnError"))
                               .ToHtmlString()

                           )
                )
                .ToHtmlString()
                                   ))
        .Selectable()
        .ClientEvents(events => events.OnError("grid_OnError")
                                      .OnRowSelect("grid_OnRowSelect")
        )
        //.Pageable(f=>f.PageSize(5))
        .Render();
}
</div>