@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    Html.Telerik().ComboBox()
        .Name(ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty))
        //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxProductInv", "Inv", new { area = "Inv", warehouseId = MyUtilities.Warehouse.Cnc }).Delay(350))
        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProductInv", "Inv", new { area = "Inv", warehouseId =0 }).Delay(350))
        //.HtmlAttributes(new { style = "width: 100%" })
        .InputHtmlAttributes(new { style = "width: 100%" })
        .DropDownHtmlAttributes(new {style = "width: 200%"})
        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
        .HighlightFirstMatch(true)
        .AutoFill(true)
        .ClientEvents(e => e.OnDataBinding("productInvCode_OnDataBinding"))
        .Render();
}
