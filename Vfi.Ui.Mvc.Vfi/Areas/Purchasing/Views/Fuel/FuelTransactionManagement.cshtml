@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@{
    ViewBag.Title = "Fuel Management";
    //Quản lý phiếu nhiên liệu
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function grid_onDataBinding(args) {
            var fuelCode = $("#FuelCode").data("tAutoComplete").value();
            var statusValue = $("#Status").data("tComboBox").value();
                if (statusValue === "")
                    statusValue = 1;
            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }
            args.data = $.extend(args.data, {
                fuelCode: fuelCode,
                status: statusValue,
                fromDate: fromDate,
                toDate: toDate,
            });
            fuelindex1 = 0;
            fuelcount1 = 0;
        }

        function status_onChange() {
            RefreshGrid("gridFuel");
        }
        function status_onload() {
            var combobox = $('#Status').data('tComboBox');
            var dataSource =
            [
                { Text: "Not Approved", Value: "1" },
                { Text: "Approved", Value: "2" },
                { Text: "Canceled", Value: "3" },
            ];
            combobox.dataBind(dataSource);
        }

        function month_onload() {
            var combobox = $('#Month').data('tComboBox');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            combobox.text(new Date().getMonth() + 1);
        }

        var fuelindex1 = 0;
        var fuelcount1 = 0;

        function gridFuel_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (dataItem.PurchasingSignature == 0) {
                if (dataItem.PurchasingSignatureType == 0) {
                    document.getElementsByClassName("t-button purchasing")[fuelindex1 - fuelcount1].parentNode.innerHTML = "<span class='t-icon t-cancel'></span>";
                    fuelcount1++;
                }
            } else {
                document.getElementsByClassName("t-button purchasing")[fuelindex1 - fuelcount1].parentNode.innerHTML = "<span class='t-icon t-insert'></span>";
                fuelcount1++;
            }
            if (dataItem.InvManager !== 2) {
                e.row.getElementsByClassName("t-button t-grid-delete t-button-icon")[0].parentNode.innerHTML = "";
            }
            if (!dataItem.CanUpdate) {
                e.row.getElementsByClassName("t-button rollback_" + e.dataItem.TransactionId)[0].parentNode.innerHTML = "";
            }
            fuelindex1++;
        }

        function FuelSignature(transactionId, type) {
            $.ajax({
                type: 'post',
                data: { transactionId: transactionId, type: type },
                dataType: 'json',
                url: '@Url.Action("FuelSignature", "User",new{area=""})',
                timeout: 20000,
                success: function () {
                    alert("Thêm chữ ký thành công !");
                    RefreshGrid("gridFuel");
                    fuelindex1 = 0;
                    fuelcount1 = 0;
                }
            });
            return false;
        }

        function PrintForm(val) {
            alert(val);
            $('#result').load('@Url.Action("PrintImportFuel", "Fuel")',
            {
                importId: val
            }, function () {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
        return false;
        }


        function month_onLoad() {
            var combobox = $('#Month').data('tComboBox');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            if (new Date().getMonth() == 12)
                combobox.value = "1";
            else combobox.value(new Date().getMonth() + 1);
        }

        function printFuelInvInMonth() {

            var vendorId = $("#FuelVendor").data('tComboBox').value();
            if (vendorId === "")
                vendorId = 0;
            var month = $('#Month').data('tComboBox').value();
            var year = $('#Year').data('tAutoComplete').text();

            $('#result').load('@Url.Action("PrintFuelInvTotalInMonth", "Fuel")',
                {
                    vendorId:vendorId,
                    month: month,
                    year: year
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function RollbackTransaction(id) {
            var message = "Phục hồi lệnh trở về chưa duyệt";
            message += "\nĐồng ý ??";
            if (confirm(message)) {
                $.ajax({
                    type: 'post',
                    data: { transactionId: id },
                    dataType: 'json',
                    url: '@Url.Action("CreateRollbackTransaction", "Fuel", new { area = "Purchasing" })',
                    timeout: 20000,
                    success: function (res) {
                        if (res.Code === 1) {
                            alert("Đã lưu " + res.Data);
                            if (res.Message && res.Message != "") {
                                alert(res.Message);
                            }
                            RefreshGrid("gridTransaction");
                        } else {
                            alert("Lỗi! " + res.Message);
                        }
                    }
                });
            } else {
            }
        }
    </script>
}

<div class="title">Fuel & Package & Chemical Information Management
   @* Quản lý thông tin nhập hàng nhiên liệu & bao bì & hóa chất*@</div>
<div id="pnlInvPeriod">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
             <div class="grid_2">Supplier</div>
        <div class="grid_7">
            @{
                Html.Telerik().ComboBox()
                    .Name("FuelVendor")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxFuelVendor", "Vendor", new { area = "Purchasing"}))
                    .HtmlAttributes(new { style = "width: 250px" })
                    .DropDownHtmlAttributes(new { style = "width: 325px" })
                    .AutoFill(true)
                    .Filterable(f=>f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
                <div class="grid_1">
                    @Html.Label("Month")
                </div>
                 <div class="grid_2">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("Month")
                            .HtmlAttributes(new {style = "width: 40px"})
                            .DropDownHtmlAttributes(new {style = "width: 40px"})
                            //.Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                            // .HighlightFirstMatch(true)
                            //.AutoFill(true)
                            .ClientEvents(events => events.OnLoad("month_onLoad"))
                            .Render();
                    }
                </div>
            
                <div class="grid_1">
                    @Html.Label("Year")
                </div>
                <div class="grid_2">
                    @{
                        Html.Telerik().AutoComplete()
                            .Name("Year")
                            .Value(DateTime.Now.Year+"")
                            .HtmlAttributes(new {style = "width: 40px"})
                            .Render();
                    }
                </div>
                <div class="grid_7">
                    <button id="btnMaterialInv" class="t-button" onclick=" return printFuelInvInMonth(); ">
                        <span class='t-icon t-insert'></span>
                        Print Inv-Report
@*                        Xuất báo cáo tồn kho*@
                    </button>
                </div>
                
       
        <div class="clear"></div>
        <br />

        <fieldset>
            <legend>Filters</legend>
            
            <div class="grid_1">Fuel</div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("FuelCode")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxAllFuel", "Material", new {area = ""}).Delay(350))
                        .HtmlAttributes(new {style = "width: 150px"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .Render();
                }
            </div>
            <div class="grid_1">
                Status
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Status")
                        //.DataBinding(binding => binding.Ajax().Select("SelectStatus", "Orders"))
                        .HtmlAttributes(new {style = "width: 150px"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .ClientEvents(events => events.OnChange("status_onChange").OnLoad("status_onload"))
                        //.Enable(false)
                        .Render();
                }
            </div>
            
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))
                        .Render();
                } 
            </div>
            <div class="grid_2">
                @{
                    Html.Telerik().DatePicker()
                        .Name("toDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1))
                        .Render();
                }
            </div>
            
            <div class="grid_3 prefix_1">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridFuel'); ">
                    <span class='t-icon t-insert'></span>
                    Find
                </button>
            </div>
        </fieldset>
    </div>
    <div class="clear"></div>
    <div class="cover-div">
        @{
            Html.Telerik().Grid<TransactionFptModel>()
                .Name("gridFuel")
                .DataKeys(keys => keys.Add(f => f.TransactionId).RouteKey("transactionId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectTransactionFuel", "Fuel",
                                                                 new
                                                                     {
                                                                         fuelCode = "",
                                                                         status = (byte)Vfi.Ui.Mvc.Vfi.Utilities.MyUtilities.Sales.Status.Waiting,
                                                                         fromDate = "",
                                                                         toDate = ""
                                                                     })

                        //.Delete("CancelTransactionFuel", "Fuel",
                        //                                         new {
                        //                                             fuelCode = "",
                        //                                             status = (byte)Vfi.Ui.Mvc.Vfi.Utilities.MyUtilities.Sales.Status.Waiting,
                        //                                             fromDate = "",
                        //                                             toDate = ""
                        //                                         })
                        )
                .Columns(columns =>
                    {
                        columns.Bound(f => f.TransactionDate).Width(75).Title("Date")
                               .ClientTemplate("<strong><#= TransactionDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', TransactionDate) #></strong>");
                        columns.Bound(f => f.PoCode).Width(90).Title("PO Code");
                        columns.Bound(f => f.TransactionCode).Width(95).Title("Transaction</br>Code");          // so phieu
                        columns.Bound(f => f.EoIName).Width(70)
                               .HeaderTemplate("<span style='text-decoration:underline'>Release</span></br>Entry")
                               .HtmlAttributes(new { style = "text-align:center;" });
                        columns.Bound(f => f.TotalQuantity).Width(65).Title("Total</br>Quantity")
                               .HtmlAttributes(new { style = "text-align:right;" })
                               .ClientTemplate("<#= TotalQuantity == null ? 0 : $.telerik.formatString('{0:n2}', TotalQuantity) #>");
                        columns.Bound(f => f.TotalPrice).Width(75)
                               .HeaderTemplate("Total Amount</br>(VND)")
                               .HtmlAttributes(new { style = "text-align:right;" })
                               .ClientTemplate("<#= TotalPrice == null ? 0 : $.telerik.formatString('{0:n0}', TotalPrice) #>");
                        columns.Bound(f => f.ModifiedUser).Width(75).Title("M-User");
                        columns.Bound(f => f.ModifiedDate).Width(80).Title("M-Date")
                               .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm:ss}', ModifiedDate) #>");
                        columns.Bound(f => f.TransactionId).Title("Print").Width(55)
                               .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' class='t-button' onclick=PrintForm(<#= TransactionId #>) />")
                               .HtmlAttributes(new { style = "text-align:center" }); 
                        columns.Bound(f => f.TransactionId).Title("Puschase</br>Manager").Width(80)           //QL Mua
                               .ClientTemplate("<button class='t-button purchasing' id='QLM_<#= TransactionId #>' onclick=FuelSignature(<#= TransactionId #>,1) ><span class='t-icon t-insert'></span></button>")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.TransactionId).Title("").Width(50).ReadOnly(true)
                               .ClientTemplate("<input type='button' id='rollback_<#= TransactionId #>' value='Rollback' class='t-button rollback_<#= TransactionId #>' onclick='RollbackTransaction(<#= TransactionId #>)' />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        
                    })
                .DetailView(details => details.ClientTemplate(
                    Html.Telerik().TabStrip()
                        .Name("TabStrip_<#= TransactionId #>")
                        .SelectedIndex(0)
                        .Items(items =>
                               items.Add().Text("Detail").Content(
                                   Html.Telerik().Grid<TransactionFptDetailModel>()
                                       .Name("gridTransactionDetail_<#= TransactionId #>")
                                       .DataBinding(dataDindings => dataDindings.Ajax()
                                                                                .Select("SelectImportFuelDetail", "Fuel",
                                                                                        new { transactionId = "<#= TransactionId #>" }))
                                       .Columns(columns =>
                                       {
                                           columns.Bound(f => f.VendorName).Title("Supplier").Width(170);
                                           columns.Bound(f => f.FuelName).Title("Detail Name").Width(120);         //Tên chi tiết
                                           columns.Bound(f => f.FuelDesignNo).Title("Specification").Width(200);            // Quy cach
                                           columns.Bound(f => f.LotNumber).Width(90).Title("Lot")
                                                  .HtmlAttributes(new { style = "text-align: right;" });
                                           columns.Bound(f => f.TotalInv).Width(100).Title("Total-Inv")
                                                  .Format("{0:n2}")
                                                  .HtmlAttributes(new { style = "text-align: right;" });
                                           columns.Bound(f => f.Quantity).Width(100).Title("Quantity")
                                                  .Format("{0:n2}")
                                                  .HtmlAttributes(new { style = "text-align: right;" });
                                           columns.Bound(f => f.UnitPrice).Width(110).Title("Unit Price</br>(VND)")             // Đơn giá 
                                                  .Format("{0:n2}")
                                                  .HtmlAttributes(new { style = "text-align: right;" });
                                           columns.Bound(f => f.Price).Width(120).Title("Total Amount</br>(VND)")             //Thành tiền 
                                                  .Format("{0:n2}")
                                                  .HtmlAttributes(new { style = "text-align: right;" });
                                           columns.Bound(f => f.UnitMeasure).Width(100).Title("Unit Measure");
                                           columns.Bound(f => f.Note).Title("Note");
                                           })
                .ClientEvents(events => events.OnError("grid_OnError"))
                                       .ToHtmlString()
                                   )
                        )
                        .ToHtmlString()
                                           ))
                .Selectable()
                .Groupable()
                .Reorderable(f => f.Columns(true))
                .Resizable(f => f.Columns(true))
                .Sortable()
                .Filterable()
                .ClientEvents(events => events.OnDataBinding("grid_onDataBinding")
                                              .OnRowDataBound("gridFuel_OnRowDataBound")
                                              .OnRowSelect("grid_OnRowSelect")
                                              .OnError("grid_OnError"))
                .Scrollable(f => f.Height(510))
                .Render();
        }
    </div>
    
</div>
<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
        )
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .ClientEvents(e => e.OnOpen("window_onopen"))
        .Render();
}

<script>
    function window_onopen(e) {
        //alert("b");
        $("#rptvPageImportFuelForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='XLS']").remove();
        $("#rptvPageImportFuelForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='RTF']").remove();
        $("#rptvPageImportFuelForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='MHTML']").remove();
    }
</script>
