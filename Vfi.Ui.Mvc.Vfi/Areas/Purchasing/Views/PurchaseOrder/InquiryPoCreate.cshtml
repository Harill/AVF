@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@model PurchaseOrderModel
@{
    ViewBag.Title = "Tạo yêu cầu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">

        function grid_OnEdit(e) {

            var dataItem = e.dataItem;
            var form = e.form;
           var  referenceId = dataItem.ReferenceId;
            var classified = $('#MaterialClassifiedName').data('tDropDownList').value();
            if (classified != 0) {
                $.ajax({
                    type: 'post',
                    data: { classified: classified, referenceId: referenceId },
                    dataType: 'json',
                    url: '@Url.Action("CheckPoReferenceUnitPrice", "PurchaseOrder", new { area = "Purchasing" })',
                            timeout: 20000,
                            success: function (data) {
                                var linePrice = $(form).find("#UnitPrice").data("tTextBox");
                                if (linePrice != null) {
                                    linePrice.value(data);
                                }
                                dataItem.UnitPrice = data;
                            }
            });
            }
        }

        var orderQty = {};
        var unitPrice = {};
        var materialIds = {};
        classifiedId = 0;
        materialIds[0] = 0;

        function grid_OnSave(e) {
            // bind data
            var $codeName = $(e.cell).find('#ReferenceCode');

            if ($codeName.length > 0) {
                var codeName = $codeName.data("tComboBox"),
                    codeNameSelectItem = codeName.selectedIndex > -1 ? codeName.data[codeName.selectedIndex] : null;

                if (codeNameSelectItem) {
                    e.values["ReferenceCode"] = codeNameSelectItem.Text;
                    e.values["ReferenceId"] = codeNameSelectItem.Value;
                }
            }
            var $vendorCode = $(e.cell).find('#VendorCode');

            if ($vendorCode.length > 0) {
                var vendorCode = $vendorCode.data("tComboBox"),
                    vendorCodeSelectItem = vendorCode.selectedIndex > -1 ? vendorCode.data[vendorCode.selectedIndex] : null;

                if (vendorCodeSelectItem) {
                    e.values["VendorCode"] = vendorCodeSelectItem.Text;
                    e.values["VendorId"] = vendorCodeSelectItem.Value;

                }
            }
            // // 
            var $lineTotal = $(e.cell).find('#LineTotal');
            if ($lineTotal.length > 0) {
                var lineTotal = $lineTotal.data("tTextBox");
                e.values["LineTotal"] = lineTotal.value();
            }
            var quantity = $(e.cell).find('#OrderQty').val();
            var text = "";
            if (!isNaN(parseInt(quantity))) {
                var sumOrderQty = 0;
                var spanOrderQtys = $("span[name='OrderQty']");
                for (var i = 0; i < spanOrderQtys.length; i++) {
                    var innerText = spanOrderQtys[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumOrderQty = sumOrderQty + parseFloat(innerText);
                }
                sumOrderQty = sumOrderQty + parseFloat(quantity);
                $("#TotalOrderQty").text(sumOrderQty.format(2));
            }
            var total = $(e.cell).find('#LineTotal').val();
            if (!isNaN(parseFloat(total))) {
                var sumLineTotal = 0;
                var spanlineTotals = $("span[name='LineTotal']");
                for (i = 0; i < spanlineTotals.length; i++) {
                    innerText = spanlineTotals[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumLineTotal = sumLineTotal + parseFloat(innerText);
                }
                sumLineTotal = sumLineTotal + parseFloat(total);
                $("#TotalLineTotal").text(sumLineTotal.format(2));
            }
            // bind data
        }

        function grid_OnSubmitChanges(e) {

                var materialClassified = $('#MaterialClassifiedName').data('tDropDownList').value();
                e.values = $.extend(e.values,
                    {
                        materialClassifiedId: materialClassified,
                    }
                );
            //}
        }

        function materialClassified_OnChange() {
            var classified = $('#MaterialClassifiedName').data('tDropDownList').value();
            $.ajax({
                type: 'post',
                data: { classified: classified },
                dataType: 'json',
                url: '@Url.Action("SelectComboBoxVendorByClassified", "PurchaseOrder", new { area = "Purchasing" })',
                timeout: 20000,
                success: function (data) {
                    RefreshGrid("grid");
                }
            });
        }

    </script>
}


<div class="title">Tạo phiếu yêu cầu mua hàng</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

    <fieldset>
        <legend>Thông tin phiếu yêu cầu</legend>

        <div class="grid_5">@Html.LabelFor(f => f.MaterialClasstifiedName)</div>

        <div class="grid_5">
            @{
                Html.Telerik().DropDownList()
                    .Name("MaterialClassifiedName")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMaterialClassified", "Material", new { area = "" }))
                    .HtmlAttributes(new { style = "width: 175px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .ClientEvents(e => e.OnChange("materialClassified_OnChange"))
                    .Render();                                              
            }
        </div>
    </fieldset>
</div>
<div class="clear"></div>


<div class="cover-div">
    @{
        Html.Telerik().Grid<InquiryPoModel>()
            .Name("grid")
            .DataKeys(keys => keys.Add(f => f.InquiryId).RouteKey("inquiryId"))
            .ToolBar(bar =>
                         {
                             bar.Insert().ButtonType(GridButtonType.ImageAndText).Text("Thêm mới");
                             bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu lại").CancelText("Hủy");
                         })
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectPurchaseOrderDetail", "PurchaseOrder")
                .Update("CreateNewInquiryPo", "PurchaseOrder")
            )
            .Columns(columns =>
            {
                columns.Bound(f => f.VendorCode).Width(150).Title("NCC");
                columns.Bound(f => f.ReferenceCode).Width(250).Title("Mã");
                columns.Bound(f => f.Unit).Width(90).Title("ĐVT");
                columns.Bound(f => f.Currency).Width(90).Title("Tiền tệ");
                columns.Bound(f => f.OrderQty).Width(100)
                    .ClientTemplate("<span name='OrderQty'><#= OrderQty == null ? 0 : $.telerik.formatString('{0:n}', OrderQty) #></span>")
                           .FooterTemplate("<span id='TotalOrderQty'></span>");
                columns.Bound(f => f.UnitPrice).Width(100)
                    .ClientTemplate("<#= UnitPrice == null ? 0 : $.telerik.formatString('{0:n}', UnitPrice) #>");
                //columns.Bound(f => f.LineTotal).Width(100)
                //       .ClientTemplate("<span name='LineTotal'><#= LineTotal == null ? 0 : $.telerik.formatString('{0:n}', LineTotal) #></span>")
                //           .FooterTemplate("<span id='TotalLineTotal'></span>");


                columns.Bound(f => f.DueDate).Width(100)
                       .ClientTemplate("<#= DueDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', DueDate) #>");
                columns.Bound(f => f.Note);
                columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(70).Title("");
            })
            .ClientEvents(events => events
                .OnEdit("grid_OnEdit")
                .OnSave("grid_OnSave")
                .OnSubmitChanges("grid_OnSubmitChanges")
                .OnError("grid_OnError")
            )
            .Editable(editing => editing.Mode(GridEditMode.InCell))
            .KeyboardNavigation()
            .Footer(true)
            .Render();
    }
</div>
