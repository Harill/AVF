@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@{
    ViewBag.Title = "Đổi trạng thái phiếu GCN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
      
        function PrintExportForm(val) {
            var $item = $('#id_' + val);
            var $formType = $item.attr('ftype');
            $('#result').load('@Url.Action("PrintImportExportForm", "Inv",new{area="Inv"})',
                {
                    transactionId: val,
                    formType: $formType,
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem;

            if (dataItem.TotalExportPrice > dataItem.TotalImportPrice)
                e.row.style.backgroundColor = "#F4FA58";
        }
    </script>
}

<div class="title">Đổi trạng thái phiếu GCN</div>

<div class="cover-div">
