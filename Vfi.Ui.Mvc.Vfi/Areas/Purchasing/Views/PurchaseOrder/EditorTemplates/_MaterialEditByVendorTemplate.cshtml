<script>
    function material_onDataBinding(e) {
        var classified = $('#MaterialClassifiedName').data('tDropDownList').value();

        e.data = $.extend(e.data, {
            classified: classified,
        });
    }
</script>


@{
    Html.Telerik().ComboBox()
        .Name(ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty))
        .DataBinding(binding => binding.Ajax()
                                       .Select("SelectComboBoxMaterialByTypeId", "PurchaseOrder", new {area = "Purchasing", classified = 0, typeId = 0})
                                       .Delay(350))
        .HtmlAttributes(new {style = "width: 150px"})
        .DropDownHtmlAttributes(new {style = "width: 250px"})
        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
        .HighlightFirstMatch(true)
        .AutoFill(true)
        .ClientEvents(events => events.OnDataBinding("material_onDataBinding"))
        .Render();
}
