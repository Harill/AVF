@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@model MaterialInventoryModel
@{
    ViewBag.Title = "Export/Import Tools";
    //Công cụ xuất nhập
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- $.() -->


    <!-- binding -->
    <script type="text/javascript">

        var startGrid = false;

        function ToolType_OnChange() {
            RefreshGrid("gridInventory");
        }

        function gridInventory_OnDataBinding(args) {

            if (startGrid && !onLoading) {
                OnLoadingData();
                var vendor = $("#Vendor").data("tComboBox").value();
                if (vendor === "") {
                    vendor = 0;
                }
                var reportType = $("#ReportType").data("tDropDownList").value();
                if (reportType === null)
                    reportType = 2;
                var toolType = $("#ToolType").data('tComboBox').value();
                if (toolType === "")
                    toolType = 0;

                //var materialName = $("#MaterialCodeName").data("tAutoComplete").value();
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }
                var toolName = $("#ToolName").data('tAutoComplete').value();
                var type = $("#Type").data('tDropDownList').value();
                if (type === "")
                    type = 0;
                var identity = $("#Identity").data('tComboBox').value();
                args.data = $.extend(args.data,
                {
                    vendorId: vendor,
                    toolName: toolName,
                    toolTypeId: toolType,
                    type: type,
                    identity: identity,
                    reportType: reportType,
                    fromDate: fromDate,
                    toDate: toDate
                });
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }

        function Type_OnLoad() {
            var combobox = $('#Type').data('tDropDownList');
            var dataSource =
            [
                { Text: "All", Value: "0" },
                { Text: "Warehouse A", Value: "1" },
                { Text: "Warehouse B", Value: "2" }
            ];

            combobox.dataBind(dataSource);
            combobox.select(0);
        }

        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }

    </script>

    <!-- report -->
    <script type="text/javascript">

        function printMaterialInvTotalInMonth() {
            if (!onLoading) {
                OnLoadingData();
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }
                var type = $('#Type').data('tDropDownList').value();
                if (type === "")
                    type = 0;
                $('#result').load('@Url.Action("PrintToolInvTotalInMonth", "Tool")',
                    {
                        type: type,
                        fromDate: fromDate,
                        toDate: toDate
                    },
                    function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function printAssignProductionTool() {
            if (!onLoading) {
                OnLoadingData();
                $('#result').load('@Url.Action("PrintAssignProductionTool", "Tool")',
                    {},
                    function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function printProductionTool() {
            if (!onLoading) {
                OnLoadingData();
                $('#result').load('@Url.Action("PrintProductionTool", "Tool")',
                    {},
                    function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }


        function printProductionToolByDay() {
            if (!onLoading) {
                OnLoadingData();
                var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
                if (monthlyDate === null)
                    monthlyDate = "";
                else
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

                $('#result').load('@Url.Action("PrintProductionToolByDay", "Tool")',
                    { monthlyDate: monthlyDate },
                    function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;



        }

        function printToolInvInMonth() {
            if (!onLoading) {
                OnLoadingData();
                var vendor = $("#Vendor").data("tComboBox").value();
                if (vendor === "") {
                    vendor = 0;
                }
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
                }
                var type = $('#Type').data('tDropDownList').value();
                if (type === "")
                    type = 0;
                var identity = $('#Identity').data('tComboBox').value();
                var toolType = $("#ToolType").data('tComboBox').value();
                if (toolType === "")
                    toolType = 0;
                $('#result').load('@Url.Action("PrintToolInvTotalInMonth", "Tool")',
                    {
                        vendorId: vendor,
                        fromDate: fromDate,
                        toDate: toDate,
                        type: type,
                        toolTypeId: toolType,
                        identity: identity,
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function reportType_onLoad() {
            var combobox = $('#ReportType').data('tDropDownList');
            var dataSource =
            [
                { Text: "All", Value: "1" },
                { Text: "Developments", Value: "2" }    
                //Diễn biến
            ];

            combobox.dataBind(dataSource);
            combobox.select(1);
        }

    </script>

}

