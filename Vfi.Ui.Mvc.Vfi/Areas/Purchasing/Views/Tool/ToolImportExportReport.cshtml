                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxToolIdentity", "Tool", new { area = "Purchasing" }))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DropDownList()
                    .Name("ReportType")
                    .HtmlAttributes(new { style = "width: 100%" })
                    .ClientEvents(events => events.OnLoad("reportType_onLoad"))
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("fromDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                    .Render();
