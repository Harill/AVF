@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "Material Quote Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        function gridMaterial_onEdit(e) {
            var mode = e.mode;
            var form = e.form;

            var materialTypeName = $(form).find('#MaterialTypeName');
            var materialTypeNameData = $(form).find('#MaterialTypeName').data('tDropDownList');
            if (mode == 'insert') {

            }
            else if (mode == 'edit') {
                materialTypeNameData.reload();
                materialTypeName.bind('dataBound', function () { // your code 
                    materialTypeNameData.select(function (item) {
                        return item.Text == e.dataItem['MaterialTypeName'];
                    });
                });
            }
        }

    </script>
}

<div class="title">Quản lý báo giá nguyên liệu</div>
