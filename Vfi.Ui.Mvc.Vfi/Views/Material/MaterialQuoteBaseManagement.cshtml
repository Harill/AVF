<div class="cover-div">
@{
    Html.Telerik().Grid<MaterialQuoteBaseModel>()
        .Name("gridMaterial")
        .DataKeys(key => key.Add(f => f.BaseId).RouteKey("baseId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).Text("Add New").ImageHtmlAttributes(new {style = "margin-left:0px;"}))
        .DataBinding(
            dataBinding => dataBinding.Ajax()
                                      .Select("SelectMaterialQuoteBase", "Material", new { area = "" })
                                      .Insert("InsertMaterialQuoteBase", "Material")
                                      .Update("UpdateMaterialQuoteBase", "Material"))
        .Columns(columns =>
            {
                columns.Command(command =>
                                command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).UpdateText("Update").InsertText("Add").CancelText("Cancel").Text("Edit")
                    ).Width(90).Title("Commands").HtmlAttributes(new {style = "text-align:center"});
                //columns.Bound(f => f.VendorCodeName).Width(150)
                //       .ClientTemplate("<strong><#= VendorCodeName #></strong>");
                columns.Bound(f => f.MaterialTypeName).Width(100)
                       .HeaderTemplate("Material Type")                                                     // Loại</br>nguyên liệu
                       .ClientTemplate("<strong><#= MaterialTypeName #></strong>");
                columns.Bound(f => f.MaterialName).Width(100)
                       .HeaderTemplate("Material Name");                                                                         // Tên</br>nguyên liệu
                 columns.Bound(f => f.MaterialShape).Width(50)
                       .HtmlAttributes(new {style = "text-align:center;"})
                       .HeaderTemplate("Shape");                                                                         // Hình</br>dạng
                columns.Bound(f => f.MaterialDiameterType).Width(50)
                       .HtmlAttributes(new { style = "text-align:center;" })
                       .HeaderTemplate("Tolerance");                                                                            // Dung</br>sai
                columns.Bound(f => f.BasePrice).Width(50)
                       .HtmlAttributes(new { style = "text-align:center;" })
                       .HeaderTemplate("Value");                                                                                //Giá trị
                columns.Bound(f => f.ModifiedUser).Title("M-User").ReadOnly(true).Width(70);                         //Người tạo
                columns.Bound(f => f.ModifiedDate).Title("M-Date").ReadOnly(true).Width(80)                          //Ngày tạo
                       .Format("{0:dd/MM/yyyy HH:mm}");
            })

        .DetailView(details => details.ClientTemplate(

            Html.Telerik().TabStrip()
                .Name("TabStrip_<#= BaseId #>")
                .SelectedIndex(0)
                .Items(items =>

                       items.Add().Text("Detail").Content(                      // Chi tiet

                           Html.Telerik().Grid<MaterialQuoteBaseDetailModel>()
                               .Name("gridDetail_<#= BaseId #>")
                               .DataKeys(key => key.Add(f => f.DetailId).RouteKey("detailId"))
                               .ToolBar(
                                   toolbar =>
                                   toolbar.Insert().Text("Add").ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))
                               .DataBinding(
                                   dataBinding => dataBinding.Ajax()
                                                             .Select("SelectMaterialQuoteBaseDetail", "Material", new { area = "", baseId = "<#= BaseId #>" })
                                                             .Insert("InsertMaterialQuoteBaseDetail", "Material", new { area = "", baseId = "<#= BaseId #>" })
                                                             .Update("UpdateMaterialQuoteBaseDetail", "Material", new { area = "" })
                               )
                               .Columns(columns => {
                                       columns.Command(command =>
                                                       command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image).UpdateText("Update").CancelText("Cancel").Text("Edit").InsertText("Add new")
                                           ).Width(40).Title("").HtmlAttributes(new { style = "text-align:center" });
                                       columns.Bound(f => f.FromOutDiameter).Width(50).Title(">= Diameter");                                    //đường kính
                                       columns.Bound(f => f.ToOutDiameter).Width(50).Title("< Diameter");                                       //đường kính
                                       columns.Bound(f => f.InDiameter).Width(50).Title("Inner Diameter</br>(If)");                             //đường kính trong (Neu co)
                                       columns.Bound(f => f.Value).Width(50).Title("Addition Value");                                              // gia tri them
                                       columns.Bound(f => f.Price).Width(50).Title("Value").ReadOnly(true);                                     // gia tri
                                   })
                               .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
                               .ClientEvents(e => e.OnError("grid_OnError"))
                               .ToHtmlString()
                           ))

                .ToHtmlString()
                                   ))
        .Selectable()
        .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
        .ClientEvents(events => events.OnEdit("gridMaterial_onEdit")
                                      .OnRowSelect("grid_OnRowSelect")
                                      //.OnDataBinding("gridMaterial_OnDataBinding")
                                      .OnError("grid_OnError"))
        //.Pageable(page => page.PageSize(10).Style(GridPagerStyles.NextPreviousAndNumeric))
        .Scrollable(f => f.Height(500))
        .Sortable()
        .Filterable()
        .Resizable(f => f.Columns(true))
        .Reorderable(f => f.Columns(true))
        .Render();
}
</div>

