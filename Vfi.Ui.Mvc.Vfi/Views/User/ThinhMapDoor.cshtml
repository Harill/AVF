    function EditProduction(value) {

        var transactionCode = $("#ProductionTransaction").data("tAutoComplete").value();
        var oldProduct = $('#OldProductionProduct').data('tComboBox').value();
        var newProduct = $('#NewProductionProduct').data('tComboBox').value();
        var machine = $('#ProductionMachine').data('tDropDownList').value();
        switch (value) {
        case 1:
            $.ajax({
                type: 'post',
                data: { transactionCode: transactionCode, oldProduct: oldProduct, newProduct: newProduct, machineId: machine },
                dataType: 'json',
                url: '@Url.Action("ChangeProductionProduct", "User")',
                timeout: 20000,
                success: function(data) {
                    if (data == -1)
                        alert("lỗi");
                    else if (data == 9)
                        alert("lỗi ! không tìm thấy máy sản xuất và mã sản xuất");
                    else if (data == 8)
                        alert("lỗi ! không tìm thấy phiếu sử dụng");
                    else if (data == 7)
                        alert("lỗi ! lỗi nguyên liệu trên máy");
                    else if (data == 6)
                        alert("lỗi ! phiếu sử dụng này chưa duyệt ! phải hủy bằng tay");
                        //else if (data == 5)
                        //    alert("lỗi ! sản phẩm này đã được giao ! Không thể thay đổi số lượng");
                    else
                        alert(data);
                }
            });
            break;
        }
    }

