                        //}
                        //$('#post').html(msg);
                        console.log(exception);
                        alert('error; ' + exception);
                    },
                });
                break;
            case 32:
                $.ajax({
                    type: 'post',
                    data: {},
                    dataType: 'json',
                    url: '@Url.Action("ChinhTienTeSanPham", "User")',
                    timeout: 20000,
