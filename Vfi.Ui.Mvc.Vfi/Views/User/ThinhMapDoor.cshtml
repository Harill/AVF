<style>
    
    .twoToneButton.spinning {
        background-color: #212121;
        padding-right: 40px;
    }

    .twoToneButton.spinning:after {
        content: '';
        position: absolute;
        right: 6px;
        top: 50%;
        width: 0;
        height: 0;
        position: absolute;
    }

    .twoToneButton.spinning:before {
        content: "";
        width: 0px;
        height: 0px;
        border-radius: 50%;
        right: 6px;
        top: 50%;
        position: absolute;
    
    }
</style>

<script type="text/javascript">
    
    function Edit(value) {
        var orderNumber = $("#OrderNumber").data("tAutoComplete").value();
        switch (value) {
        //tao invoice ao?
        case 1:
            $.ajax({
                type: 'post',
                data: { orderNumber: orderNumber },
                dataType: 'json',
                url: '@Url.Action("CreateVitureInvoice", "User")',
                timeout: 20000,
                success: function (data) {
                    if (data == 1) {
                        alert("Thành công");
                        Clear();
                    }
                    else if (data == -1)
                        alert("lỗi");
                    else if (data == 9)
                        alert("lỗi ! không tìm thấy đơn hàng");
                    else if (data == 8)
                        alert("lỗi ! vui lòng duyệt đơn hàng !");
                }
            });
            break;
        // duyet lai don hang
        case 2:
            $.ajax({
                type: 'post',
                data: { orderNumber: orderNumber },
                dataType: 'json',
                url: '@Url.Action("ReApproveOrder", "User")',
                timeout: 20000,
                success: function (data) {
                    if (data == 1) {
                        alert("Thành công");
                        Clear();
                    }
                    else if (data == -1)
                        alert("lỗi");
                    else if (data == 9)
                        alert("lỗi ! không tìm thấy đơn hàng");
                    else if (data == 8)
                        alert("lỗi ! đơn hàng chưa duyệt!");
                }
            });
            break;
        // doi tien te
        case 3:
            var currency = $('#CurrencyCode').data('tDropDownList').value();
            $.ajax({
                type: 'post',
                data: { orderNumber: orderNumber, currency: currency },
                dataType: 'json',
                url: '@Url.Action("ChangeCurrencyCode", "User")',
                timeout: 20000,
                success: function (data) {
                    if (data == 1) {
                        alert("Thành công");
                        Clear();
                    }
                    else if (data == -1)
                        alert("lỗi");
                    else if (data == 9)
                        alert("lỗi ! không tìm thấy đơn hàng");
                }
            });
            break;
        // chinh gia trong don hang
        case 4:
