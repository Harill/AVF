@using Vfi.Server.Core.DataModel.Models.System
@{
    ViewBag.Title = "UserFunction";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var strAssignWarehousePermissionForUser = Url.RouteUrl(new { controller = "Permission", action = "AssignWarehousePermissionForUser" });    
}

<script type="text/javascript">

    $(document).ready(function () {

        resetForm();
    });

    function resetForm() {
        $("#result").hide();
        $("#functionDiv").hide();
        $("#btnCreateFunction").hide();
    }

    function startForm() {
        $("#btnCreateFunction").show();
        $("#result").show();
        $("#functionDiv").show();
    }
</script>
<!-- checked user -->
<script type="text/javascript">

    var gridUser = $('#GridUser').data('tGrid');

    function displayCheckedUsers() {
        var gridUser = $('#GridUser').data('tGrid');

        //var $checkedRecords = $(':checked');
        var $userId = $("input[name='rdioUser']:checked").val();

        var test = "";
        if ($userId.length < 1) {
            alert('Check a few grid rows first.');
            resetForm();

            return;
        }
        else {
            startForm();

            //$("#lblUsername").val( $currentUsername);

            $('#result').load('@Url.Action("DisplayCheckedUserForWarehousePermission", "User")',
            {
                userId: $userId
            });
        }
    }

</script>
<!-- Create Function For user-->
<script type="text/javascript">
    function createFunctionForUser() {

        var $checkedImport = $("input[name='IsUserImportWarehouse']:checked");
        var $checkedRotate = $("input[name='IsUserRotateWarehouse']:checked");
        alert($checkedImport.length);
        alert($checkedRotate.length);
        var $userId = $("input[name='rdioUser']:checked").val();
        alert($userId);

        var cImport = {};
        for (var i = 0; i < $checkedImport.length; i++) {
            cImport[i] = $checkedImport[i].value;
        }
        var cRotate = {};
        for (var j = 0; j < $checkedRotate.length; j++) {
            cRotate[j] = $checkedRotate[j].value;
        }
        try{

            $.post("@strAssignWarehousePermissionForUser",
                    {
                        checkedImport: cImport,
                        checkedRotate: cRotate,
                        userId: $userId
                    },
                    function (data) {

                        alert("Create Function Successful !");

                        resetForm();
                            });


        }catch(err){alert("Co Loi !");}
        return false;
    }
</script>

<div class="title">User Function</div>

<div class="t-info-sha">

    <div class="userDiv">
        <button class="t-button t-state-default" onclick="displayCheckedUsers()">Check users</button>
        @{
            var gridUser = Html.Telerik().Grid<UserModel>();
    
            gridUser.Name("GridUser");
            gridUser.DataKeys(key => key.Add(u => u.UserId));
            gridUser.DataBinding(dataBindings => dataBindings.Ajax()
                                                    .Select("SelectActiveUser", "User"));
            gridUser.Columns(columns =>
                                 {
                                     columns.Bound(u => u.UserId)
                                         .ClientTemplate("<input type='radio' name='rdioUser'value='<#= UserId #>' />")
                                         .Title("Check").Width(35)
                                         .HtmlAttributes(new {style = "text-align:center"});
                                     columns.Bound(u => u.Username).Width(100);
                                     columns.Bound(u => u.FullName).Width(200);
                                 });
            gridUser.Sortable();
            gridUser.Footer(false);
            gridUser.Render();
        }
    </div>

    <div class="functionDiv">
        <input type="button" class="t-button t-state-default" onclick="return createFunctionForUser();" 
                id="btnCreateFunction" name="btnCreateFunction" value="Create Function For User/Group " />

        <div id="result"></div>
    </div>

    <div class="clear"></div>

</div>

@section css{

<style type="text/css" >
    .userDiv
    {
        width: 350px;
        float: left;
    }
    
    .functionDiv
    {
        margin-left: 355px;
        width: 350px;
    }
    
    .userWorGroupDiv
    {
    }
    
    .clear
    {
        clear: both;
    }
    
    .workgroup-label
    {
        vertical-align: top;
        padding-right: .4em;
    }
    
    #approveDiv
    {
        display: none;
    }
</style>

}