@using Vfi.Ui.Mvc.Vfi.Models
@{
    ViewBag.Title = "Product Management (Compare Pricing)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        function gridProduct_OnDataBinding(args) {
            if (startGrid) {
                var materialTypeId = $("#MaterialTypeName").data('tComboBox').value();
                if (materialTypeId === "")
                    materialTypeId = 0;
                var customer = $("#Customer").data("tComboBox").value();
                if (customer === "")
                    customer = 0;
                var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
                args.data = $.extend(args.data, {
                    customerId: customer,
                    materialTypeId: materialTypeId,
                    productCode: productCodeName
                });
            }
            index = 0;
        }
        
        //function grid_OnSave(e) {
        //    var customer = $("#Customer").data("tComboBox").value();
        //    if (customer === "")
        //        customer = 0;
        //    var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
        //    e.values = $.extend(e.values,
        //        {
        //            customerId: customer,
        //            productCode: productCodeName
        //        }
        //    );
        //    index = 0;
        //}
        var index = 0;
        var startGrid = false;
        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid('gridProductPricing');
            index = 0;
        }
    </script>
}

<div class="title">Product Management (Compare Pricing)</div>
<div id="pnlInvPeriod">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

        <fieldset>
            <legend>Filters</legend>
            <div class="grid_2_5">
                Material Type
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("MaterialTypeName")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxAllMaterialType", "Material", new {area = ""}))
                        .HtmlAttributes(new {style = "width: 150px"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        .SelectedIndex(0)
                        .Render();
                }
            </div>
            <div class="grid_2">
                Customer
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Customer")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>

            <div class="grid_1_5">Product</div>
            <div class="grid_5">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                        .HtmlAttributes(new { style = "width: 150px; " })
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Value("")
                        .Render();
                }
            </div>
        
            <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid2(); ">
                <span class='t-icon t-insert'></span>
                Find
            </button>
        </fieldset>
    </div>
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ProductPricingModel>()
            .Name("gridProductPricing")
            .DataKeys(key => key.Add(f => f.ProductId).RouteKey("productId"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectProductComparePricing", "Product", 
                                          new { area = "", customerId = -1,materialTypeId = 0, productCode = "" })
                                          )
            .Columns(columns => {
                columns.Bound(f => f.CustomerCode).Width(80).ReadOnly(true)
                        .HeaderTemplate("<strong>Customer</br>Code</strong>")
                        .HeaderHtmlAttributes(new { style = "text-align:center;" })
                        .HtmlAttributes(new { style = "text-align:center;" })
                        .ClientTemplate("<strong><#= CustomerCode #></strong>");
                columns.Bound(f => f.ProductName).Width(150).ReadOnly(true)
                        .HeaderTemplate("<strong>Product</br>Name</strong>")
                        .HeaderHtmlAttributes(new { style = "text-align:center" })
                        .ClientTemplate("<strong><#= ProductName #></strong>");
                columns.Bound(f => f.ProductDesignNo).Width(100).ReadOnly(true)
                        .HeaderTemplate("<strong>Customer's</br>Product Code</strong>")
                        .HeaderHtmlAttributes(new { style = "text-align:center" })
                        .ClientTemplate("<strong><#= ProductDesignNo #></strong>");
                columns.Bound(f => f.ProductCode).Width(100).ReadOnly(true)
                        .HeaderTemplate("<strong>VF's</br>Product Code</strong>")
                        .HeaderHtmlAttributes(new { style = "text-align:center" })
                        .ClientTemplate("<strong><#= ProductCode #></strong>");
                columns.Bound(f => f.OutDiameterDesign).Width(50)
                        .HeaderTemplate("<strong>OD</strong>")
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.Length).Width(60)
                        .HeaderTemplate("<strong>Length</strong>")
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.MaterialWeight).Width(70)
                        .HeaderTemplate("<strong>Material</br>Weight</strong>")
                        .Format("{0:n3}")
                        .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.ProductWeight).Width(70)
                        .HeaderTemplate("<strong>Product</br>Weight</strong>")
                        .Format("{0:n3}")
                        .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.MaterialCode).Width(120).ReadOnly(true)
                        .HeaderTemplate("<strong>Material</br>Code</strong>")
                        .HeaderHtmlAttributes(new { style = "text-align:center" })
                        .ClientTemplate("<strong><#= MaterialCode #></strong>");
                columns.Bound(f => f.MaterialPrice).Width(70)
                        .HeaderTemplate("<strong>Material</br>Price</strong>")
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.ProductMaterialPrice).Width(70)
                        .HeaderTemplate("<strong>Material</br>Price</strong>")
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.ProductPrice).Width(70)
                        .HeaderTemplate("<strong>Sale</br>Price</strong>")
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.DiffPrice).Width(90)
                        .HeaderTemplate("<strong>Diff</br>Sale Price</strong>")
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.DiffPriceRate).Width(70)
                        .HeaderTemplate("<strong>Sale</br>Rate</strong>")
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.WorkpiecePrice).Width(70)
                        .HeaderTemplate("<strong>Scrap</br>Price</strong>")
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.WorkpiecePriceRate).Width(70)
                        .HeaderTemplate("<strong>Scrap</br>Rate</strong>")
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align:right" });
                
            })
            .ClientEvents(events => events.OnDataBinding("gridProduct_OnDataBinding")
                                          //.OnSave("grid_OnSave")
                                          .OnError("grid_OnError"))
            .Selectable()
            .Scrollable(f => f.Height(510))
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .Render();
    }
</div>
