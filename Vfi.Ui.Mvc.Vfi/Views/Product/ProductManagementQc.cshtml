@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Models
@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "Product Management (QC)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        function grid_OnSave() {

            var statusValue = 0;
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            e.values = $.extend(e.values,
                {
                    customer: customer,
                    statusValue: statusValue,
                    productCodeName: productCodeName,
                }
            );
        }

        function gridProduct_OnDataBinding(args) {
            //var statusValue = $("#Status").data("tComboBox").value();
            //if (statusValue === "")
            var statusValue = 0;
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            args.data = $.extend(args.data, {
                customerId: customer,
                status: statusValue,
                productCode: productCodeName
            });
        }

        function customer_onChange() {
            RefreshGrid("gridProduct");
        }

    </script>
}
<div class="title">Product Management (QC)</div>
<div id="pnlInvPeriod">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

        <fieldset>
            <legend>Criteria Filtering</legend>

            <div class="grid_1_5">
                Customer Code
            </div>
            <div class="grid_5">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Customer")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .ClientEvents(events => events.OnChange("customer_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_1_5">Product</div>
            <div class="grid_5">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                        .HtmlAttributes(new { style = "width: 150px; " })
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Value("")
                        //.ClientEvents(events => events.OnClose("ProductCodeName_OnClose"))
                        .Render();
                }
            </div>
            <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid('gridProduct'); ">
                <span class='t-icon t-insert'></span>
                Find
            </button>
        </fieldset>
    </div>
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ProductModel>()
            .Name("gridProduct")
            .DataKeys(key => key.Add(f => f.ProductId).RouteKey("productId"))

            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectProduct", "Product", new { area = "", active = true, status = 0, customerId = -1, productCode = "", productId = 0, productName = "" })
            )
            .Columns(columns =>
                {
                    columns.Bound(f => f.CustomerCode).Width(50).ReadOnly(true)
                           .HeaderTemplate("<strong>Customer</br>Code</strong>")
                           .HeaderHtmlAttributes(new {style = "text-align:center;"})
                           .HtmlAttributes(new {style = "text-align:center;"})
                           .ClientTemplate("<strong><#= CustomerCode #></strong>");
                    columns.Bound(f => f.ProductCode).Width(100).ReadOnly(true)
                           .HeaderTemplate("<strong>Product</br>Code</strong>")
                           .HeaderHtmlAttributes(new {style = "text-align:center"})
                           .ClientTemplate("<strong><#= ProductCode #></strong>")
                           .Aggregate(agg => agg.Count())
                           .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                        ;
                    //columns.Bound(f => f.ForecastsQuality).Width(70)
                    //       .HeaderTemplate("Dự báo</br>sản xuất")
                    //       .Format("{0:n0}")
                    //       .HtmlAttributes(new {style = "text-align:right;"});
                    //columns.Bound(f => f.SectionCount).Width(70).ReadOnly(true)
                    //       .HeaderTemplate("Tổng</br>công đoạn");
                })
                .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("TabStrip_<#= ProductId #>")
                    .SelectedIndex(0)
                    .Items(items => {
                        items.Add().Text("Testing").Content(
                            Html.Telerik().Grid<ProductionTestingModel>()
                                .Name("gridProductionTesting_<#= ProductId #>")
                                .DataKeys(key => key.Add(f => f.WarehouseId).RouteKey("warehouseId"))
                                .DataBinding(
                                    dataBinding => dataBinding.Ajax()
                                                              .Select("SelectProductionTesting", "Production", new { area = "Factory", customerId = 0, productId = "<#= ProductId #>", productCode = "" })
                                                              .Update("UpdateProductionTesting", "Production", new { area = "Factory", productId = "<#= ProductId #>" })
                                )
                                .Columns(columns => {
                                    columns.Command(command =>
                                                    command.Edit().ButtonType(GridButtonType.Image)
                                        ).Width(45).Title("").HtmlAttributes(new { style = "text-align:center" });
                                    columns.Bound(f => f.Idx).Width(50).Title("Index").ReadOnly(true)
                                           .Format("{0:n0}");
                                    columns.Bound(f => f.WarehouseName).Width(150).Title("Stage</br>Name").ReadOnly(true)
                                                .ClientTemplate("<strong><#= WarehouseName #></strong>");
                                    columns.Bound(f => f.Note).Title("Note");
                                    columns.Bound(f => f.ModifiedDate).Width(100).Title("M-Date").ReadOnly(true)
                                           .Format("{0:dd/MM/yyyy HH:mm}");
                                    columns.Bound(f => f.ModifiedUser).Width(100).Title("M-User").ReadOnly(true);
                                    //columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(30).Title("");
                                })
                            .DetailView(details2 => details2.ClientTemplate(
                                Html.Telerik().TabStrip()
                                    .Name("TabStripTesting_<#= ProductId #>")
                                    .SelectedIndex(0)
                                    .Items(items3 => {
                                        items3.Add().Text("Detail").Content(
                                                 Html.Telerik().Grid<ProductionTestingDetailModel>()
                                                     .Name("gridProductionTestingDetail_<#= ProductId #>_<#= WarehouseId #>")
                                                     .DataKeys(key => key.Add(f => f.DetailId).RouteKey("detailId"))
                                                     .ToolBar(t => t.Insert().Text("Add New")
                                                            .ButtonType(GridButtonType.ImageAndText)
                                                            .ImageHtmlAttributes(new { style = "margin-left:0px;" })
                                                            )
                                                      .DataBinding(
                                                          dataBinding => dataBinding.Ajax()
                                                                                      .Select("SelectProductionTestingDetail", "Production", new { area = "", customerId = 0, productCode = "", productId = "<#= ProductId #>", warehouseId = "<#= WarehouseId #>" })
                                                                                      .Insert("InsertProductionTestingDetail", "Production", new { area = "", productId = "<#= ProductId #>", warehouseId = "<#= WarehouseId #>" })
                                                                                      .Update("UpdateProductionTestingDetail", "Production", new { area = "", productId = "<#= ProductId #>", warehouseId = "<#= WarehouseId #>" })
                                                      )
                                                     .Columns(columns => {
                                                         columns.Command(command =>
                                                                         command.Edit().ButtonType(GridButtonType.Image).UpdateText("Cập nhật").CancelText("Hủy").Text("Sửa").InsertText("Thêm mới")
                                                             ).Width(50).Title("").HtmlAttributes(new { style = "text-align:center" });
                                                         columns.Bound(f => f.Idx).Width(50).Title("Index")
                                                                .Format("{0:n0}");
                                                         columns.Bound(f => f.TestingCode).Width(50).Title("Code");
                                                         columns.Bound(f => f.TestingName).Width(200).Title("Name ▲ Ø ± ᴼ ⌖ ⌾ ⌯ // ⊥ </br> ∠ ⌭ ▱ ⦣ ◯ ─ ⌓ ⌒ ↗ ⌰");
                                                         columns.Bound(f => f.MinNumber).Width(80).Title("Min");
                                                         columns.Bound(f => f.MaxNumber).Width(80).Title("Max");
                                                         columns.Bound(f => f.TestRate).Width(80).Title("Rate</br>(h/time)");
                                                         columns.Bound(f => f.Active).Width(50)
                                                                 .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                                                                 .HtmlAttributes(new { style = "text-align:center" });
                                                         columns.Bound(f => f.MachineTypeName).Title("Measuring</br>Tool").ReadOnly(true);
                                                         columns.Bound(f => f.ModifiedDate).Width(100).Title("M-Date").ReadOnly(true)
                                                                .Format("{0:dd/MM/yyyy HH:mm}");
                                                         columns.Bound(f => f.ModifiedUser).Width(80).Title("M-User").ReadOnly(true);
                                                     })
                                                     .DetailView(details3 => details3.ClientTemplate(
                                                        Html.Telerik().TabStrip()
                                                            .Name("TabStripTestingDetail_<#= DetailId #>")
                                                            .SelectedIndex(0)
                                                            .Items(items4 => {
                                                                items4.Add().Text("Tools").Content(
                                                                            Html.Telerik().Grid<ProductionTestingMachineModel>()
                                                                                .Name("gridProductionTestingMachine_<#= DetailId #>")
                                                                                .DataKeys(key => key.Add(f => f.TestingToolId).RouteKey("testingToolId"))
                                                                                .ToolBar(
                                                                                    toolbar =>
                                                                                    toolbar.Insert().Text("Add New").ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))
                                                                                .DataBinding(
                                                                                    dataBinding => dataBinding.Ajax()
                                                                                                                .Select("SelectProductionTestingMachine", "Production", new { area = "", testingDetailId = "<#= DetailId #>" })
                                                                                                                .Insert("InsertProductionTestingMachine", "Production", new { area = "", testingDetailId = "<#= DetailId #>" })
                                                                                                                .Update("UpdateProductionTestingMachine", "Production", new { area = "", testingDetailId = "<#= DetailId #>" })
                                                                                )
                                                                                .Columns(columns => {
                                                                                    columns.Command(command =>
                                                                                                    command.Edit().ButtonType(GridButtonType.Image).UpdateText("Update").CancelText("Cancel").Text("Fix").InsertText("Add Neww")
                                                                                        ).Width(50).Title("").HtmlAttributes(new { style = "text-align:center" });
                                                                                    columns.Bound(f => f.Idx).Width(70).Title("Index");
                                                                                    columns.Bound(f => f.MachineTypeName).Width(120).Title("Measuring Tool");
                                                                                    columns.Bound(f => f.Active).Width(50)
                                                                                            .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                                                                                            .HtmlAttributes(new { style = "text-align:center" });
                                                                                    columns.Bound(f => f.ModifiedDate).Width(100).Title("M-Date").ReadOnly(true)
                                                                                        .Format("{0:dd/MM/yyyy HH:mm}");
                                                                                    columns.Bound(f => f.ModifiedUser).Width(80).Title("M-User").ReadOnly(true);
                                                                                })
                                                                                .Editable(editing => editing.Mode(GridEditMode.InLine))
                                                                                .ClientEvents(e => e.OnError("grid_OnError"))
                                                                                .ToHtmlString());
                                                            })
                                                            .ToHtmlString()))
                                                     .Editable(editing => editing.Mode(GridEditMode.InLine))
                                                     .ClientEvents(e => e.OnError("grid_OnError"))
                                                     .ToHtmlString());

                                        items3.Add().Text("Note").Content(
                                                 Html.Telerik().Grid<ProductionTestingNoteModel>()
                                                     .Name("gridProductionTestingNote_<#= ProductId #>_<#= WarehouseId #>")
                                                     .DataKeys(key => key.Add(f => f.NoteId).RouteKey("noteId"))
                                                     .ToolBar(
                                                         toolbar =>
                                                         toolbar.Insert().Text("Thêm mới").ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))
                                                      .DataBinding(
                                                          dataBinding => dataBinding.Ajax()
                                                                                      .Select("SelectProductionTestingNote", "Production", new { area = "", productId = "<#= ProductId #>", warehouseId = "<#= WarehouseId #>" })
                                                                                      .Insert("InsertProductionTestingNote", "Production", new { area = "", productId = "<#= ProductId #>", warehouseId = "<#= WarehouseId #>" })
                                                                                      .Update("UpdateProductionTestingNote", "Production", new { area = "", productId = "<#= ProductId #>", warehouseId = "<#= WarehouseId #>" })
                                                      )
                                                     .Columns(columns => {
                                                         columns.Command(command =>
                                                                         command.Edit().ButtonType(GridButtonType.Image).UpdateText("Update").CancelText("Cancel").Text("Fix").InsertText("Add Neww")
                                                             ).Width(50).Title("").HtmlAttributes(new { style = "text-align:center" });
                                                         columns.Bound(f => f.Idx).Width(100).Title("Index");
                                                         columns.Bound(f => f.Note).Title("Note");
                                                         columns.Bound(f => f.Active).Width(50)
                                                                 .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                                                                 .HtmlAttributes(new { style = "text-align:center" });
                                                         columns.Bound(f => f.ModifiedDate).Width(100).Title("M-Date").ReadOnly(true)
                                                                .Format("{0:dd/MM/yyyy HH:mm}");
                                                         columns.Bound(f => f.ModifiedUser).Width(80).Title("M-User").ReadOnly(true);
                                                     })
                                                     .Editable(editing => editing.Mode(GridEditMode.InLine))
                                                     .ClientEvents(e => e.OnError("grid_OnError"))
                                                     .ToHtmlString());
                                    })
                                    .ToHtmlString()))
                                .Editable(editing => editing.Mode(GridEditMode.InLine))
                                .ClientEvents(e => e.OnError("grid_OnError"))
                                .ToHtmlString()
                            );
                    }
                    )
                    .ToHtmlString()
                                       ))
            .Editable(editing => editing.Mode(GridEditMode.InLine))
            .Selectable()
            .Scrollable(f => f.Height(510))
            //.HtmlAttributes(new { style = "width: 1100px;" })
            .ClientEvents(events => events.OnDataBinding("gridProduct_OnDataBinding")
                                          .OnError("grid_OnError")
                                          .OnSave("grid_OnSave")
                                          .OnRowSelect("grid_OnRowSelect")
                                          )
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .Render();
    }
</div>
