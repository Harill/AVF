@using Telerik.Web.Mvc.UI
@{
    Html.Telerik().ComboBox()
        .Name(ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty))
        .DataBinding(binding => binding.Ajax().Select("SelectComboboxProcessClassified", "Machine", new { area = "Factory" })
                                       .Delay(350))
        //.HtmlAttributes(new { style = "width: 200px" })
        .DropDownHtmlAttributes(new {style = "min-width: 300px"})
        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
        .HighlightFirstMatch(true)
        .AutoFill(true)
        .Render();
}
