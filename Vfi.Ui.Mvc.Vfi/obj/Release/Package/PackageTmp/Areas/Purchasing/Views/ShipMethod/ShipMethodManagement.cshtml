@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@{
    ViewBag.Title = "Shiping Method Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title">Shipping-Information
  @*  Phương thức thanh toán*@</div>
<div class="cover-div">
@{
    Html.Telerik().Grid<ShipMethodModel>()
        .Name("gridShipMethod")
        .DataKeys(keys => keys.Add(f => f.ShipMethodId).RouteKey("shipMethodId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).Text("Add New").ImageHtmlAttributes(new { style = "margin-left:0" }))
        .DataBinding(dataBindings=>dataBindings.Ajax()
            .Select("SelectShipMethod","ShipMethod").Insert("InsertShipMethod","ShipMethod").Update("UpdateShipMethod","ShipMethod")
        )
        .Columns(columns=> {
            columns.Command(command =>command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image))
                .Width(98).Title("").HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.Name).Title("Shipping Method Name");
            columns.Bound(f => f.ShipBase).Width(150).Title("Price(USD/kg)");
            //columns.Bound(f => f.ShipRate).Width(110);
            columns.Bound(f => f.Active).Width(45).Title("Active")
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.ModifiedDate).Width(150).Title("M-Date").ReadOnly(true)
                .Format("{0:dd/MM/yyyy HH:mm}");
            columns.Bound(f => f.ModifiedUser).Width(100).Title("M-User").ReadOnly(true);
        })
        .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
        .ClientEvents(e=> e.OnError("grid_OnError"))
        .Pageable(page => page.PageSize(10))
        .Sortable()
        .Render();  
}
</div>