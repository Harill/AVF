@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@{
    ViewBag.Title = "Tools Inventory Card";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
       
        function GridInventory_OnDataBinding(e) {
            var toolId = $("#ToolCode").data('tComboBox').value();
            if (toolId == "")
                toolId = 0;
            e.data = $.extend(e.data, {
                toolId: toolId
            });
        }
        function GridYear_OnDataBinding(e) {
            var productId = $("#ToolCode").data('tComboBox').value();
            if (productId == "")
                productId = 0;
            e.data = $.extend(e.data, {
                productId: productId
            });
        }
        function RefreshGrids() {
            RefreshGrid("gridInventory");
            //RefreshGrid("");
        }
    </script>
}

<div class="title">Tools Inventory Card</div>
<div class="clear"></div>
<br/>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1000px;">
    <fieldset>
        <legend>Filters</legend>
        <div class="grid_12">
        <div class="grid_2">
            Product
        </div>
        <div class="grid_6">
             @{
                 Html.Telerik().ComboBox()
                    .Name("ToolCode")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxTool", "Material", new { area = "" }).Delay(350))
                    .HtmlAttributes(new { style = "width: 230px" })
                    .DropDownHtmlAttributes(new { style = "width: 300px" })
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .Render();
            }
          
        </div>
    <div class="grid_2 prefix_1">
        <button id="btnRefesh" class="t-button" onclick=" return RefreshGrids(); ">
            <span class='t-icon t-insert'></span>
            Find
        </button>
    </div>

        </div>
        <div class="grid_10">
            @{
                Html.Telerik().Grid<TransactionFptDetailModel>()
                    .Name("gridInventory")
                    //.DataKeys(key => key.Add(f => f.ProductId).RouteKey("productId"))
                    .DataBinding(
                        dataBinding => dataBinding.Ajax()
                                                  .Select("SelectToolInventory", "Tool", new { area = "Purchasing", toolId = 0})
                    )
                    .Columns(columns =>
                        {
                            columns.Bound(f => f.VendorName).Width(150).Title("Supplier");
                            columns.Bound(f => f.LotNumber).Width(40).ReadOnly(true).Title("Lot");
                            columns.Bound(f => f.UnitMeasure).Width(70).Title("Unit Measure").ReadOnly(true);
                            columns.Bound(f => f.TotalInv).Width(70)
                                .HeaderTemplate("Inv")
                                .Format("{0:n0}")
                                .HtmlAttributes(new { style = "text-align:right" });
                        })
                    .ClientEvents(events => events.OnDataBinding("GridInventory_OnDataBinding")
                                                  .OnError("grid_OnError"))
                    //.HtmlAttributes(new {style = "width: 950px;"})
                    //.Resizable(resizing => resizing.Columns(true))
                    .Footer(false)
                    .Render();
            }
        </div>
    </fieldset>
</div>
<div class="clear">
</div>
