@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@model MaterialInventoryModel
@{
    ViewBag.Title = "Assign Tool(Production2)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- binding -->
    <script type="text/javascript">
        function gridToolInventory_OnDataBinding(args) {
            var toolName = $("#ToolName").data('tAutoComplete').value();
            var typeId = $("#ToolType").data('tComboBox').value();
            if (typeId === "")
                typeId = 0;
            var type = $('#Type').data('tDropDownList').value();
            if (type === "")
                type = 0;
            args.data = $.extend(args.data, {
                vendorId: 0,
                toolCode: toolName,
                typeId: typeId,
                type: type,
                productId: 0
            });
        }

        function ToolType_OnChange() {
            RefreshGrid("gridToolInventory");
        }

    </script>

    <!-- pickup material -->
    <script type="text/javascript">
        function PickupId() {
            var $checkedRecords = $(':checked');
            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 nguyên liệu");
                return;
            }
            var a = {};
            var ids = "";
            for (var i = 0; i < $checkedRecords.length; i++) {
                a[i] = $checkedRecords[i].value;

                ids += $checkedRecords[i].value;
                if (i < ($checkedRecords.length - 1))
                    ids += ":";
            }
            $("#gridToolInventoryDetail").data("tGrid").rebind({
                invIds: ids
            });
        }
        function gridToolInventoryDetail_OnSave(e) {
            var $machineName = $(e.cell).find('#MachineName');

            if ($machineName.length > 0) {
                var machineName = $machineName.data("tComboBox"),
                    machineNameSelectItem = machineName.selectedIndex > -1 ? machineName.data[machineName.selectedIndex] : null;

                if (machineNameSelectItem) {
                    e.values["MachineName"] = machineNameSelectItem.Text;
                    e.values["MachineId"] = machineNameSelectItem.Value;
                }
            }
            var $productCode = $(e.cell).find('#ProductCode');

            if ($productCode.length > 0) {
                var productCode = $productCode.data("tComboBox"),
                    productCodeSelectItem = productCode.selectedIndex > -1 ? productCode.data[productCode.selectedIndex] : null;

                if (productCodeSelectItem) {
                    e.values["ProductCode"] = productCodeSelectItem.Text;
                    e.values["ProductId"] = productCodeSelectItem.Value;
                }
            }
        }

        function Type_OnLoad() {
            var combobox = $('#Type').data('tDropDownList');
            var dataSource =
            [
                { Text: "All", Value: "0" },
                { Text: "A-Warehouse", Value: "1" },
                { Text: "B-Warehouse", Value: "2" }
            ];

            combobox.dataBind(dataSource);
            combobox.select(0);
        }

        function gridToolInventoryDetail_OnSubmitChanges(e) {
            var exportDate = $("#ExportDate").data("tDatePicker").value();
            if (exportDate === null)
                exportDate = "";
            else
                exportDate = $.telerik.formatString('{0:dd/MM/yyyy}', exportDate);
            var department = $("#Department").val();
            var description = $("#Description").val();
            e.values = $.extend(e.values,
                {
                    exportOrImport: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Export)",
                    exportDate: exportDate,
                    productId: 0,
                    machineId:0,
                    department: department,
                    description: description
                }
            );
        }   

        function gridToolInventory_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            // to mau
            if (dataItem.AvailInv !== dataItem.TotalInv)
                e.row.childNodes[6].style.backgroundColor = "#F4FA58";
        }
        function gridToolInventoryDetail_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            // to mau
            if (dataItem.AvailInv !== dataItem.TotalInv)
                e.row.childNodes[4].style.backgroundColor = "#F4FA58";
        }

    </script>
}

<div class="title">Assign Tool (Production2)</div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 960px;">
    <fieldset>
        <legend>Assign Information</legend>
        <div class="grid_13">
            <div class="grid_7">
                
            <div class="grid_2_5">Assign Date</div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ExportDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
                <div class="clear"></div>
                <br />
                <div class="grid_2_5">Department</div>
                <div class="grid_3">
                    @{
                        Html.Telerik().AutoComplete()
                            .Name("Department")
                            .DataBinding(binding => binding.Ajax().Select("SelectComboBoxDepartment", "Material", new {area = ""}))
                            .HtmlAttributes(new {style = "width: 130px"})
                            .DropDownHtmlAttributes(new {style = "width: 130px"})
                            .AutoFill(true)
                            .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                            .Render();
                    }

                </div>
                <div class="clear"></div>
                <br/>
                <div class="grid_2_5">Tool Type</div>
                <div class="grid_3_5">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("ToolType")
                            .DataBinding(binding => binding.Ajax().Select("SelectComboBoxToolType", "Tool", new {area = "Purchasing"}))
                            .HtmlAttributes(new {style = "width: 130px"})
                            .DropDownHtmlAttributes(new {style = "width: 130px"})
                            .AutoFill(true)
                            .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                            .ClientEvents(e => e.OnChange("ToolType_OnChange"))
                            .Render();
                    }
                </div>
                <div class="clear"></div>
                <br />
                
        <div class="grid_2_5">Tool Name</div>
        <div class="grid_3_5">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ToolName")
                    .HtmlAttributes(new {style = "width: 100%"})
                    .Render();
            }
        </div>
                <div class="clear"></div>
            </div>
            <div class="grid_4">
        <div class="grid_3">
            @{
                Html.Telerik().DropDownList()
                    .Name("Type")
                    .HtmlAttributes(new { style = "width: 100%" })
                    .ClientEvents(events => events.OnLoad("Type_OnLoad"))
                    .Render();
            }
        </div>
                <div class="clear"></div>
                <br />
                <br />
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridToolInventory'); ">
                    <span class='t-icon t-insert'></span>
                    Find
                </button>
            </div>
            </div>
        </div>
        <div class="grid_3">
                <div class="grid_2">Note</div>
                <div class="grid_7">@Html.TextArea("Description", new { @class = "multi-line", style = "height:70px" })</div>
        </div>

    </fieldset>
</div>
<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionFptDetailModel>()
            .Name("gridToolInventory")
            .ToolBar(bar => bar.Template(
        @<text>
        <div class="grid_7">
            <button class="t-button" id="btnPickupId" name="btnPickupId" onclick=" PickupId() ">
                <span class='t-icon t-insert'></span>
               Select Tools
            </button>
        </div>
        <div class="clear"></div>
        </text>
))
            .DataKeys(keys => keys.Add(f => f.ToolInvId).RouteKey("toolInvId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectExportToolInv", "Tool", new { toolCode = "", vendorId = 0, typeId = 0, type = 0, productId = 0 }))
            .Columns(columns =>
                {
                    columns.Bound(f => f.ToolInvId).Title("Select").Width(75)
                           .ClientTemplate("<input type='checkbox' name='chklIds' value='<#= ToolInvId #>' />")
                           .HtmlAttributes(new { style = "text-align:center" });
                    columns.Bound(f => f.ToolName).Width(100).Title("Tool Name");
                    columns.Bound(f => f.ToolFullCodeName).Width(150).Title("Tool Code");
                    columns.Bound(f => f.VendorCodeName).Width(150).Title("Supplier");
                    columns.Bound(f => f.LotNumber).Width(75).Title("Lot");
                    columns.Bound(f => f.TotalInv).Width(75).Title("Total Inv")
                        .HtmlAttributes(new { style = "text-align:right;" })
                           .Format("{0:n2}");
                    columns.Bound(f => f.AvailInv).Width(75).Title("Remaining Inv")
                        .HtmlAttributes(new { style = "text-align:right;" })
                           .Format("{0:n2}");
                    columns.Bound(f => f.UnitMeasure).Title("Unit Measure").Width(75);
                })
            .Scrollable(f => f.Height(200))
            .ClientEvents(events => events.OnDataBinding("gridToolInventory_OnDataBinding")
                .OnRowDataBound("gridToolInventory_OnRowDataBound")
                .OnError("grid_OnError"))
            .Render();
    }
</div>
<div class="clear"></div>
<br />
<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">Tool-Assign Deatil</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionFptDetailModel>()
            .Name("gridToolInventoryDetail")
            .ToolBar(bar => bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).SaveText("Save").CancelText("Cancel"))
            .DataKeys(keys => keys.Add(f => f.ToolInvId).RouteKey("toolInvId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectExportToolInventory", "Tool", new { invIds = "",machineId= 0,productId =0 })
                .Update("UpdateAssignTool2", "Tool"))
            .Columns(columns =>
            {
                columns.Bound(f => f.VendorCodeName).Width(150).Title("Supplier").ReadOnly(true);
                columns.Bound(f => f.ToolFullCodeName).Width(250).Title("Tool").ReadOnly(true);
                columns.Bound(f => f.UnitMeasure).Width(70).Title("Unit Measure").ReadOnly(true);
                columns.Bound(f => f.TotalInv).Width(70).ReadOnly(true)
                       .HeaderTemplate("Inv")
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.AvailInv).Width(70).ReadOnly(true)
                       .HeaderTemplate("Remaining Inv")
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.LotNumber).Width(50).ReadOnly(true).Title("Lot");
                columns.Bound(f => f.TaxInvoiceDateString).Width(70).ReadOnly(true).Title("Entry Date");
                columns.Bound(f => f.Quantity).Width(70)
                       .HeaderTemplate("Assign Quantity")
                       .HeaderHtmlAttributes(new { @class = "edit-column" })
                       .HtmlAttributes(new { style = "text-align: right;" })
                       .ClientTemplate("<span name='Quantity'><#= Quantity == null ? 0 : $.telerik.formatString('{0:n2}', Quantity) #></span>")
                       .FooterTemplate("<span id='TotalQuantity'></span>");
                columns.Bound(f => f.MachineName).Width(75).Title("Machine")
                       .HeaderHtmlAttributes(new { @class = "edit-column" });
                columns.Bound(f => f.ProductCode).Width(75).Title("Product")
                       .HeaderHtmlAttributes(new { @class = "edit-column" });
                columns.Bound(f => f.Note);
                columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(40).Title("");
            })
            .ClientEvents(events => events
                .OnSave("gridToolInventoryDetail_OnSave")
                .OnRowDataBound("gridToolInventoryDetail_OnRowDataBound")
                .OnSubmitChanges("gridToolInventoryDetail_OnSubmitChanges")
                .OnError("grid_OnError")
            )
            .Editable(f => f.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            // .Footer(true)
            .Render();   
    }
</div>
