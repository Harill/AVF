@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@{
    ViewBag.Title = "Outsourcing-Note Management";
    //QL Phiếu GCN
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function grid_onDataBinding(args) {

            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 1;

            //var month = $('#Month').val();
            //var year = $('#Year').data('tAutoComplete').text();

            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            args.data = $.extend(args.data, {
                status: statusValue,
                fromDate: fromDate,
                toDate: toDate,
            });
            index = 0;
            count = 0;
        }

        var index = 0;
        var count = 0;
        
        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem;

            //if (!dataItem.IsPurchasingManager) {
            //    document.getElementsByClassName("t-button t-grid-edit t-button-icon")[index - count].parentNode.innerHTML = "";
            //    count++;
            //}
            //index++;
             
            if (dataItem.TotalExportPrice > dataItem.TotalImportPrice)
                e.row.style.backgroundColor = "#F4FA58";
        }
        
        function status_onChange() {
            RefreshGrid("gridPlating");
        }
        function status_onload() {
            var combobox = $('#Status').data('tComboBox');
            var dataSource =
            [
                { Text: "Not Approve", Value: "1" },
                { Text: "Approved", Value: "4" },
                { Text: "Completed", Value: "2" },
                { Text: "Cancel", Value: "3" },
            ];
            combobox.dataBind(dataSource);
        }

        function PrintExportForm(val) {
            var $item = $('#id_' + val);
            var $formType = $item.attr('ftype');
            $('#result').load('@Url.Action("PrintImportExportForm", "Inv", new { area = "Inv" })',
                {
                    transactionId: val,
                    formType: $formType,
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }
        
        function PrintPlatingForm(val) {
            $('#result').load('@Url.Action("PrintPlatingForm", "PurchaseOrder", new { area = "Purchasing" })',
                {
                    exportId: val,
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }
        function printPlatingPriceReport() {

            var vendorCodeName = $('#VendorCodeName').data('tDropDownList').value();
            if (vendorCodeName === "") vendorCodeName = 0;
            if (vendorCodeName == 0) return false;

            //var month = $('#Month').val();
            //var year = $('#Year').data('tAutoComplete').text();

            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            $('#result').load('@Url.Action("PrintPlatingPriceReport", "PurchaseOrder", new { area = "Purchasing" })',
               {
                   vendorId: vendorCodeName,
                   fromDate: fromDate,
                   toDate: toDate
               }, function () {
                   var window = $('#windowReport').data('tWindow');
                   window.open();
               });
            return false;
        }
        function gridDetail_OnRowDataBound(e) {
            if (!e.dataItem.PurchaseManager)
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
        }
        function gridExportDetail_OnRowDataBound(e) {
            if (!e.dataItem.IsInvManager)
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
        }
        function gridImportDetail_OnRowDataBound(e) {
            if (!e.dataItem.IsInvManager)
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
        }
        function gridDetail_OnEdit(e) {
            productId = e.dataItem.ProductId;
        }
        var productId = 0;
        function plating_OnDataBinding(e) {
            e.data = $.extend(e.data, {
                productId: productId
            });
        }
    </script>
}

<div class="title">Outsourcing-Not Management
   @* Quản lý thông tin phiếu GCN*@</div>
<div id="pnlInvPeriod">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; ">
          
        <div class="clear"></div>
        <br />

        <fieldset>
            <legend>Filters</legend>

            <div class="grid_1">
                Status
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Status")
                        //.DataBinding(binding => binding.Ajax().Select("SelectStatus", "Orders"))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .ClientEvents(events => events.OnChange("status_onChange").OnLoad("status_onload"))
                        //.Enable(false)
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                        .Render();
                }
            </div>
            <div class="grid_3">
                    @{
                        Html.Telerik().DatePicker()
                            .Name("toDate")
                            .Format("dd/MM/yyyy")
                            .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddSeconds(-1))
                            .Render();
                    }
                </div>
          

            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridPlating'); ">
                    <span class='t-icon t-insert'></span>
                   Find
                </button>
            </div>
            
            <div class="grid_5">
                @{
                    Html.Telerik().DropDownList()
                        .Name("VendorCodeName")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxPlatingVendor", "Vendor"))
                        .HtmlAttributes(new { style = "width: 175px" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .Render();                                              
                }
            </div>
            <div class="grid_4">
                <button id="btnPlatingPriceReport" class="t-button" onclick=" return printPlatingPriceReport(); ">
                    <span class='t-icon t-insert'></span>
                    Print Report
                </button>
            </div>
        </fieldset>
    </div>
    <div class="clear"></div>
    <div class="cover-div">
        @{
            Html.Telerik().Grid<PlatingFormModel>()
                .Name("gridPlating")
                .DataKeys(keys => keys.Add(f => f.FormId).RouteKey("formId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                    .Select("SelectManagePlatingForm", "PurchaseOrder",
                        new
                        {
                            status = (byte) Vfi.Ui.Mvc.Vfi.Utilities.MyUtilities.Sales.Status.Waiting,
                            fromDate = "",
                            toDate = ""
                        })
                //.Update("UpdatePlatingManage", "PurchaseOrder")
                )
                .Columns(columns =>
                {
                    //columns.Command(f => f.Edit().ButtonType(GridButtonType.Image)).Title("").Width(30);
                    columns.Bound(f => f.VendorCodeName).Width(150).Title("Supplier").ReadOnly(true);
                    columns.Bound(f => f.PlatingTypeName).Width(100).Title("Type");
                    columns.Bound(f => f.CreateDate).Width(100).Title("Entry Date").ReadOnly(true)
                        .Format("{0:dd/MM/yyyy}");
                    columns.Bound(f => f.PlatingFormNumber).Width(100).Title("Number").ReadOnly(true);
                    columns.Bound(f => f.CurrencyCode).Width(70).Title("Currency")
                        .HtmlAttributes(new {style = "text-align:right"});
                    columns.Bound(f => f.ExchangeRate).Width(70).Title("Exchange Rate")
                        .Filterable(false)
                        .HtmlAttributes(new {style = "text-align:right"})
                        .ClientTemplate("<#= ExchangeRate == null ? 0 : $.telerik.formatString('{0:n0}', ExchangeRate) #>");
                    columns.Bound(f => f.TotalExportPrice).Width(100).Title("Release Price").ReadOnly(true)
                        .Filterable(false)
                        .HtmlAttributes(new {style = "text-align:right"})
                        .Format("{0:n0}")
                        .FooterHtmlAttributes(new {style = "text-align: right;"})
                        .Aggregate(agg => agg.Sum())
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");
                    columns.Bound(f => f.TotalImportPrice).Width(100).Title("Entry Price").ReadOnly(true)
                        .Filterable(false)
                        .HtmlAttributes(new {style = "text-align:right"})
                        .Format("{0:n0}")
                        .FooterHtmlAttributes(new {style = "text-align: right;"})
                        .Aggregate(agg => agg.Sum())
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");
                    columns.Bound(f => f.Note).Title("Note");
                    columns.Bound(f => f.CreateUser).Width(70).Title("M-User").ReadOnly(true);
                    columns.Bound(f => f.CreateDate).Title("M-Date").Width(90).ReadOnly(true)
                        .Format("{0:dd/MM/yyyy HH:mm}");
                    
                })
                .DetailView(details => details.ClientTemplate(
                    Html.Telerik().TabStrip()
                        .Name("TabStrip_<#= FormId #>")
                        .SelectedIndex(0)
                        .Items(items =>
                        {
                            items.Add().Text("Detail").Content(
                                Html.Telerik().Grid<PlatingDetailModel>()
                                    .Name("gridDetail_<#= FormId #>")
                                    .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
                                    .DataBinding(dataDindings => dataDindings.Ajax()
                                        .Select("SelectPlatingFormDetail", "PurchaseOrder",
                                            new { formId = "<#= FormId #>" })
                                        .Update("UpdatePlatingFormDetail", "PurchaseOrder")
                                    )
                                    .Columns(columns =>
                                    {
                                        columns.Command(command => command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(50).Title("");
                                        columns.Bound(f => f.ProductCode).Width(200).Title("Product Code").ReadOnly(true);
                                        columns.Bound(f => f.UnitPrice).Width(100).Title("Price")
                                               .HtmlAttributes(new { style = "text-align:right" })
                                        .ClientTemplate("<#= UnitPriceString #>");
                                        columns.Bound(f => f.Unit).Width(50).Title("Unit Measure").ReadOnly(true);
                                        columns.Bound(f => f.QuantityRequirement).Width(100).Title("Required Quantity").ReadOnly(true)
                                               .HtmlAttributes(new { style = "text-align:right" })
                                               .Format("{0:n0}");
                                        columns.Bound(f => f.ExportString).Width(100).Title("Release Quantity").ReadOnly(true)
                                               .HtmlAttributes(new { style = "text-align:right" });
                                        columns.Bound(f => f.ImportString).Width(100).Title("Entry Quantity").ReadOnly(true)
                                               .HtmlAttributes(new { style = "text-align:right" });
                                        columns.Bound(f => f.ExportDateRequirement).Width(90).Title("Release Date").ReadOnly(true)
                                               .ClientTemplate("<#= ExportDateRequirement == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ExportDateRequirement) #>");
                                        columns.Bound(f => f.ImportDateRequirement).Width(90).Title("Delivery Date").ReadOnly(true)
                                               .ClientTemplate("<#= ImportDateRequirement == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ImportDateRequirement) #>");
                                        columns.Bound(f => f.Note).Title("Note");
                                    })
                                    .ClientEvents(events => events.OnError("grid_OnError")
                                        .OnRowDataBound("gridDetail_OnRowDataBound"))
                                    .ToHtmlString()
                                );
                            items.Add().Text("Delivery-Note").Content(
                                Html.Telerik().Grid<ExportGCN_NCUModel>()
                                    .Name("gridExport_<#= FormId #>")
                                    .DataBinding(dataDindings => dataDindings.Ajax()
                                        .Select("SelectExportPlating", "PurchaseOrder",
                                            new { formId = "<#= FormId #>" })
                                            )
                                    .Columns(columns => {
                                        columns.Bound(f => f.ExportDate).Width(100).Title("Release Date")
                                               .Format("{0:dd/MM/yyyy}");
                                        columns.Bound(f => f.TransactionCode).Width(120).Title("Code");     //Mã giao dịch
                                        columns.Bound(f => f.TotalNumber).Width(70).Title("Total Quantity(pcs)")
                                               .Format("{0:n0}")
                                               .HtmlAttributes(new { style = "text-align:right" });
                                        columns.Bound(f => f.TotalWeight).Width(70).Title("Total Weight(g)")
                                               .Format("{0:n0}")
                                               .HtmlAttributes(new { style = "text-align:right" });
                                        columns.Bound(f => f.TransactionId).Title("Form").Width(45)         //Biễu mẫu
                                               .ClientTemplate("<input type='button' id='id_<#= ExportFormId #>' value='In'  class='t-button' onclick=PrintPlatingForm(<#= ExportFormId #>) />")
                                               .HtmlAttributes(new { style = "text-align:center" });
                                        columns.Bound(f => f.TransactionId).Title("Delivery-Note").Width(45)              //PXK
                                               .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' ftype='7' class='t-button' onclick=PrintExportForm(<#= TransactionId #>) />")
                                               .HtmlAttributes(new { style = "text-align:center" });
                                        columns.Bound(f => f.ModifiedUser).Width(75).Title("M-User");
                                        columns.Bound(f => f.ModifiedDate).Width(90).Title("M-Date")
                                               .Format("{0:dd/MM/yyyy HH:mm}");
                                    })
                                    .DetailView(exportDetails => exportDetails.ClientTemplate(
                                        Html.Telerik().Grid<ManageImportExportDetailModel>()
                                            .Name("gridExportDetail_<#= TransactionId #>")
                                            .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
                                            .DataBinding(dataDindings => dataDindings.Ajax()
                                                .Select("SelectFormDetailByTransactionId", "Transaction",
                                                    new { area = "Inv", transactionId = "<#= TransactionId #>", formType = 7 })
                                                .Update("UpdateExportPlatingDetail", "Transaction", new { area = "Inv" })
                                                    )
                                            .Columns(columns => {
                                                columns.Command(command => command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(50).Title("");
                                                columns.Bound(f => f.ProductCode).Width(100).Title("Product").ReadOnly(true);
                                                columns.Bound(f => f.Number).Width(100).Title("Quantity(PCS)").ReadOnly(true)
                                                        .Format("{0:n0}")
                                                        .HtmlAttributes(new { style = "text-align: right;" });
                                                columns.Bound(f => f.Weight).Width(100).Title("Weight(g)").ReadOnly(true)
                                                        .Format("{0:n0}")
                                                       .HtmlAttributes(new { style = "text-align: right;" });
                                                columns.Bound(f => f.Package).Width(100).Title("Packing");
                                                columns.Bound(f => f.Note).Title("Note");
                                            })
                                            .ClientEvents(events => events.OnError("grid_OnError")
                                        .OnRowDataBound("gridExportDetail_OnRowDataBound"))
                                            .ToHtmlString()
                                        )
                                    )
                                    .Selectable()
                                    .ClientEvents(events => events.OnError("grid_OnError").OnRowSelect("grid_OnRowSelect"))
                                    .ToHtmlString()
                                );

                            items.Add().Text("Received-Note").Content(
                                Html.Telerik().Grid<ImportNCU_QCBModel>()
                                    .Name("gridImport_<#= FormId #>")
                                    .DataBinding(dataDindings => dataDindings.Ajax()
                                        .Select("SelectImportPlating", "PurchaseOrder",
                                            new {formId = "<#= FormId #>"}))
                                    .Columns(columns => {
                                        columns.Bound(f => f.ImportDate).Width(100).Title("Entry Date")
                                               .Format("{0:dd/MM/yyyy}");
                                        columns.Bound(f => f.TransactionCode).Width(120).Title("Code");
                                        columns.Bound(f => f.TotalNumber).Width(70).Title("Total Quantity(pcs)")
                                               .Format("{0:n0}")
                                               .HtmlAttributes(new { style = "text-align:right" });
                                        columns.Bound(f => f.TotalWeight).Width(70).Title("Total Weight(g)")
                                               .Format("{0:n0}")
                                               .HtmlAttributes(new { style = "text-align:right" });
                                        columns.Bound(f => f.TransactionId).Title("Entry Code").Width(45)
                                               .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' ftype='8' class='t-button' onclick=PrintExportForm(<#= TransactionId #>) />")
                                               .HtmlAttributes(new { style = "text-align:center" });
                                        columns.Bound(f => f.ModifiedUser).Width(75).Title("M-User");
                                        columns.Bound(f => f.ModifiedDate).Width(90).Title("M-Date")
                                               .Format("{0:dd/MM/yyyy HH:mm}");
                                    })
                                    .DetailView(exportDetails => exportDetails.ClientTemplate(
                                        Html.Telerik().Grid<ManageImportExportDetailModel>()
                                            .Name("gridImportDetail_<#= TransactionId #>")
                                            .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
                                            .DataBinding(dataDindings => dataDindings.Ajax()
                                                .Select("SelectFormDetailByTransactionId", "Transaction",
                                                    new { area = "Inv", transactionId = "<#= TransactionId #>", formType = 8 })
                                                .Update("UpdateImportPlatingDetail", "Transaction", new { area = "Inv" })
                                                )
                                            .Columns(columns => {
                                                columns.Command(command => command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(50).Title("");
                                                columns.Bound(f => f.ProductCode).Width(100).Title("Product").ReadOnly(true);
                                                columns.Bound(f => f.Number).Width(100).Title("Quantity(PCS)").ReadOnly(true)
                                                       .Format("{0:n0}")
                                                       .HtmlAttributes(new { style = "text-align:right" });
                                                columns.Bound(f => f.Weight).Width(100).Title("Weight(g)").ReadOnly(true)
                                                       .Format("{0:n0}")
                                                       .HtmlAttributes(new { style = "text-align:right" });
                                                columns.Bound(f => f.Package).Width(100).Title("Packing");
                                                columns.Bound(f => f.Note).Title("Note");
                                            })
                                            .ClientEvents(events => events.OnError("grid_OnError")
                                        .OnRowDataBound("gridExportDetail_OnRowDataBound"))
                                            .ToHtmlString()
                                        )
                                    )
                                    .Selectable()
                                    .ClientEvents(events => events.OnError("grid_OnError")
                                        .OnRowSelect("grid_OnRowSelect"))
                                    .ToHtmlString()
                                );
                            items.Add().Text("Specification").Content(
                                Html.Telerik().Grid<PlatingDetailModel>()
                                    .Name("gridDetailInfo_<#= FormId #>")
                                .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
                                    .DataBinding(dataDindings => dataDindings.Ajax()
                                        .Select("SelectPlatingFormDetail", "PurchaseOrder",
                                            new {formId = "<#= FormId #>"})
                                        .Update("UpdatePlatingDetailInfo", "PurchaseOrder")
                                    )
                                    .Columns(columns =>
                                    {
                                        columns.Command(command => command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image))
                                            .Width(50)
                                            .Title("");
                                        columns.Bound(f => f.ProductCode).Width(120).Title("Product Code").ReadOnly(true);
                                        columns.Bound(f => f.PlatingCode).Width(120).Title("Section Name ");
                                        columns.Bound(f => f.Thickness).Width(100)
                                               .HeaderTemplate("Thickness(µm)");
                                        columns.Bound(f => f.SaltSprayTime).Width(100)
                                               .HeaderTemplate("Salt Spray(h)");
                                        columns.Bound(f => f.SpecialRequest).Width(150).Title("Required");
                                        columns.Bound(f => f.Sample).Width(100)
                                               .HeaderTemplate("Sample(pcs)");
                                        columns.Bound(f => f.TestingEquipment).Width(100).Title("Testing Equipment");
                                    })
                                    .ClientEvents(events => events.OnError("grid_OnError")
                                        .OnEdit("gridDetail_OnEdit")
                                        .OnRowDataBound("gridDetail_OnRowDataBound"))
                                    .ToHtmlString()
                                );
                        })
                        .ToHtmlString()
                    ))
                .Groupable()
                .Reorderable(f => f.Columns(true))
                .Resizable(f => f.Columns(true))
                .Sortable()
                .Filterable()
                .Selectable()
                .ClientEvents(events => events.OnError("grid_OnError")
                    .OnDataBinding("grid_onDataBinding")
                    .OnRowDataBound("grid_OnRowDataBound")
                    .OnRowSelect("grid_OnRowSelect"))
                .Scrollable(f => f.Height(510))
                .Render();
        }
    </div>

</div>
