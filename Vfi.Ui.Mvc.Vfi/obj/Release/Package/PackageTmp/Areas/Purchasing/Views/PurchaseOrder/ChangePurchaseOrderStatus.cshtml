@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@{
    ViewBag.Title = "Adjust PO Status";
    //Đổi trạng thái phiếu mua hàng 
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        function gridProduct_onEdit(e) {
            var mode = e.mode;
            var form = e.form;
            if (mode == 'insert') {

            } else if (mode == 'edit') {
                var monthlyDate = e.dataItem['DueDate'];
                if (monthlyDate === null)
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', new Date());
                else
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);
                e.dataItem['DueDate'] = monthlyDate;
            }

        }

        function Grid_OnSave(e) {
            var value = e.values;
            var orderId = value.orderId;
            var statusString = value.StatusName;
            switch (statusString) {
                case "2":
                    $.post('@Url.Action("PurchaseOrderSent", "PurchaseOrder")',
                        {
                            //checkedRecords: $checkedRecords.map(function () { return value; })
                            orderId: orderId
                        },
                        function () {
                            //refreshGrid2();
                        });
                    break;
                case "3": $.post('@Url.Action("PurchaseOrderCancel", "PurchaseOrder")',
                        {
                            //checkedRecords: $checkedRecords.map(function () { return value; })
                            orderId: orderId
                        },
                        function () {
                            //refreshGrid2();
                        });
                    break;
                default :
                    break;
            }
            //$(this).data('tGrid').ajaxRequest();
        }
        
        function Grid_OnDataBinding(e) {

        }

    </script>
}

<div class="title">Adjust PO-Status
    @*Đổi trạng thái phiếu mua hàng*@

</div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<PurchaseOrderModel>()
            .Name("gridChangeOrer")
            .DataKeys(key => key.Add(f => f.PurchaseOrderId).RouteKey("purchaseOrderId"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectApprovedPurchaseOrder", "PurchaseOrder")
                                          .Update("UpdateStatusPurchaseOrder", "PurchaseOrder")
            )
            .Columns(columns =>
                {
                    columns.Command(command =>command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                           .UpdateText("Approved").CancelText("Cancel"))
                           .Width(98).Title("Approve").HtmlAttributes(new {style = "text-align:center"});
                    columns.Bound(f => f.RevisionNumber).Width(100).ReadOnly(true).Title("Order's Number");
                    columns.Bound(f => f.ShipDate).Width(100).ReadOnly(true).Title("Delivery Date")
                           .ClientTemplate("<strong><#= ShipDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ShipDate) #></strong>");
                    columns.Bound(f => f.StatusName).Width(75).Title("Status");
                    columns.Bound(f => f.VendorCodeName).Width(150).ReadOnly(true).Title("Supplier");
                    columns.Bound(f => f.CurrencyCode).Width(60).ReadOnly(true).Title("Currency");
                    columns.Bound(f => f.TotalQuality).Title("Total Quantity").Width(95).ReadOnly(true)
                           .HtmlAttributes(new {style = "text-align: right;"})
                           .ClientTemplate("<#= TotalQuality == null ? 0 : $.telerik.formatString('{0:n}', TotalQuality) #>");
                    columns.Bound(f => f.Tolerance).Width(100).ReadOnly(true).Title("Tolerence")
                           .ClientTemplate("<#= Tolerance == null ? 0 : $.telerik.formatString('{0:n}', Tolerance) #>");
                    columns.Bound(f => f.ShipMethodName).Width(150).ReadOnly(true).Title("Shipping Method");
                    columns.Bound(f => f.PaymentMethodName).Width(150).ReadOnly(true).Title("Payment Method");
                    columns.Bound(f => f.PackagedMethodName).Width(160).ReadOnly(true).Title("Packing Method");
                    columns.Bound(f => f.DeliveryMethodName).Width(150).ReadOnly(true).Title("Delivery Location");
                    columns.Bound(f => f.EmployeeName).Width(100).ReadOnly(true).Title("Employee");
                    columns.Bound(f => f.ModifiedUser).Width(70).ReadOnly(true).Title("M-User");
                    columns.Bound(f => f.ModifiedDate).Title("M-Date").Width(100).Format("{0:dd/MM/yyyy HH:mm:ss}");
                })
            .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("TabStrip_<#= PurchaseOrderId #>")
                    .SelectedIndex(0)
                    .Items(items =>
                           items.Add().Text("Detail").Content(
                               Html.Telerik().Grid<PurchaseOrderDetailModel>()
                                   .Name("gridTransactionDetail_<#= PurchaseOrderId #>")
                                   .DataBinding(dataDindings => dataDindings.Ajax()
                                                                            .Select("SelectPurchaseOrderDetailByPOId", "PurchaseOrder",
                                                                                    new {purchaseOrderId = "<#= PurchaseOrderId #>"}))
                                   .Columns(columns =>
                                       {
                                           columns.Bound(f => f.Code).Width(100);
                                           columns.Bound(f => f.OrderQty).Width(50).Title("Order's Quantity")
                                                  .HtmlAttributes(new {style = "text-align: right;"})
                                                  .ClientTemplate("<#= OrderQty == null ? 0 : $.telerik.formatString('{0:n}', OrderQty) #>");
                                           columns.Bound(f => f.ReceivedQty).Width(50).Title("Rerceived Quantity")
                                                  .HtmlAttributes(new {style = "text-align: right;"})
                                                  .ClientTemplate("<#= ReceivedQty == null ? 0 : $.telerik.formatString('{0:n}', ReceivedQty) #>");
                                           columns.Bound(f => f.RejectedQty).Width(50).Title("Returned")
                                                  .HtmlAttributes(new {style = "text-align: right;"})
                                                  .ClientTemplate("<#= RejectedQty == null ? 0 : $.telerik.formatString('{0:n}', RejectedQty) #>");
                                           columns.Bound(f => f.UnitPrice).Width(50).Title("Unit Price")
                                                  .HtmlAttributes(new {style = "text-align: right;"})
                                                  .ClientTemplate("<#= UnitPrice == null ? 0 : $.telerik.formatString('{0:n}', UnitPrice) #>");
                                           columns.Bound(f => f.LineTotal).Width(100).Title("Total Amount")
                                                  .HtmlAttributes(new {style = "text-align: right;"})
                                                  .ClientTemplate("<#= LineTotal == null ? 0 : $.telerik.formatString('{0:n}', LineTotal) #>");
                                           columns.Bound(f => f.DueDate).Title("Delivery Date").Width(100).Format("{0:dd/MM/yyyy HH:mm:ss}");
                                       })
            .ClientEvents(events => events.OnError("grid_OnError"))
                                   .ToHtmlString()
                               )
                    )
                    .ToHtmlString()
                                       ))
            .Selectable()
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
            .ClientEvents(events => events.OnEdit("gridProduct_onEdit")
                                          .OnRowSelect("grid_OnRowSelect")
                                          .OnSave("Grid_OnSave")
                                          .OnError("grid_OnError"))
            .Pageable(page => page.PageSize(7))
            .Scrollable(f => f.Height("auto"))
            .Sortable()
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
            .Render();
    }
</div>
