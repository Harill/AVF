`@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@using Vfi.Ui.Mvc.Vfi.Models
@model ExportFormTP_KD
@{
    ViewBag.Title = "Revenue Reduce";
    //Giảm trừ doanh thu
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{

    <script type="text/javascript">

        function TaxInvoice_onChange() {
            RefreshGrid("gridTaxInvoice");
        }

        function gridProductInOrder_onDataBinding(args) {

            var customerId = $('#cboCustomer').data('tComboBox').value();
            if (customerId == "")
                customerId = 0;
            //var id = $("#TaxInvoice").data('tComboBox').value();
            //var text = $("#TaxInvoice").data('tComboBox').text();
            args.data = $.extend(args.data, {
                customerId: customerId
            });
        }
    </script>

    <script type="text/javascript">
        function PickupId() {

            var $checkedRecords = $(':checked');
            //var $checkedRecords = $("input[name='chkMaterialIds']:checked");

            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 nguyên liệu");
                return;
            }

            //$.ajaxSettings.traditional = false;
            var a = {};
            var ids = "";

            for (var i = 0; i < $checkedRecords.length; i++) {
                a[i] = $checkedRecords[i].value;

                ids += $checkedRecords[i].value;
                if (i < ($checkedRecords.length - 1))
                    ids += ":";
            }
            $("#gridTaxInvoiceDetail").data("tGrid").rebind({
                //checkedRecords: $checkedRecords.map(function () { return value; }) 
                //checkedRecords: a
                ids: a
            });

        }
    </script>

    <!-- client event grid material inventory -->
    <script type="text/javascript">
        function gridProductInventoryDetail_onDataBound() {
        }

        function gridProductInventoryDetail_onSave(e) {
           var quantity = $(e.cell).find('#Money').val();
            if (!isNaN(parseInt(quantity))) {
                var sumReal = 0;
                var spanReals = $("span[name='Money']");
                for (var i = 0; i < spanReals.length; i++) {
                    var innerText = spanReals[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumReal = sumReal + parseFloat(innerText);
                }
                sumReal = sumReal + parseFloat(quantity);
                $("#TotalMoney").text(sumReal.format(2));
            }
        }

        function gridProductInventoryDetail_onSubmitChanges(e) {

            var importDate = $("#ImportDate").data("tDatePicker").value();
            if (importDate === null)
                importDate = "";
            else
                importDate = $.telerik.formatString('{0:dd/MM/yyyy}', importDate);
            e.values = $.extend(e.values,
                {
                    importDate: importDate
                }
            );
            
        }

        function customer_onChange() {
            RefreshGrid("gridTaxInvoice");
        }

    </script>

}

<div class="title">Revenue Reduce
  @*  Giảm trừ doanh thu*@</div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
    <fieldset>
      <div class="grid_1_5">Customer</div>
         <div class="grid_8">
            @{
                Html.Telerik().ComboBox()
                    .Name("cboCustomer")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new {area = "Sales"}))
                    .HtmlAttributes(new {style = "width: 250px"})
                    .DropDownHtmlAttributes(new {style = "width: 325px;"})
                    .ClientEvents(events => events.OnChange("customer_onChange"))
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
         <div class="grid_2">Input Date</div>
        <div class="grid_2">
                 @{
                     Html.Telerik().DatePicker()
                         .Name("ImportDate")
                         .Format("dd/MM/yyyy")
                         .Value(DateTime.Now)
                         .Render();
                 }
             </div>
    </fieldset>

</div>
<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TaxInvoiceModel>()
            .Name("gridTaxInvoice")
            .ToolBar(bar => bar.Template(
        @<text>
        <div class="grid_7">
            <button class="t-button" id="btnPickupId" name="btnPickupId" onclick="PickupId()">
                <span class='t-icon t-insert'></span>
                Select Invoice
            </button>
        </div>
        <div class="clear"></div>
        </text>
))
            .DataKeys(keys => keys.Add(f => f.TaxInvoiceId).RouteKey("taxInvoiceId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                // .Select("SelectProductInventoryRotateByCustomer", "Inv",
                .Select("SelectTaxInvoice", "Orders"))
            .Columns(columns =>
                         {
                             columns.Bound(f => f.TaxInvoiceId).Title("Select").Width(75)
                                 .ClientTemplate("<input type='checkbox' name='chkIds' value='<#= TaxInvoiceId #>' />")
                                 .HtmlAttributes(new { style = "text-align:center" });
                             columns.Bound(f => f.TaxInvoiceList)
                                    .HeaderTemplate("Invoice").Width(90);
                             //columns.Bound(f => f.InvoiceNumber)
                             //       .HeaderTemplate("Số Invoice").Width(90);
                             columns.Bound(f => f.CustomerCode).Width(50)
                                    .HeaderTemplate("Customer");
                             columns.Bound(f => f.TotalAmountFormat).Width(125)
                                    .HeaderTemplate("Total Amount")
                                    .HtmlAttributes(new { style = "text-align: right;" });
                             columns.Bound(f => f.RequiredAmountFormat).Width(125)
                                    .HeaderTemplate("Remaining Amount")
                                    .HtmlAttributes(new { style = "text-align: right;" });
                             columns.Bound(f => f.CurrencyCode).Width(50).Title("Currency");
                             columns.Bound(f => f.ExchangeRate).Width(50).Title("Exchange Rate");
                             columns.Bound(f => f.TotalAmountVND).Width(125)
                                    .HeaderTemplate("Total Amount(VND)")
                                    .Format("{0:n0}")
                                    .HtmlAttributes(new { style = "text-align: right;" });
                             columns.Bound(f => f.RequiredAmountVND).Width(125)
                                    .HeaderTemplate("Remaining Amounth(VND)")
                                    .Format("{0:n0}")
                                    .HtmlAttributes(new { style = "text-align: right;" });
                             
                         })
            .Scrollable(f => f.Height("auto"))
            .Scrollable(f => f.Height(200))
            .Resizable(f => f.Columns(true))
            //.Pageable(f => f.Style(GridPagerStyles.Status))
            .ClientEvents(events => events.OnDataBinding("gridProductInOrder_onDataBinding").OnError("grid_OnError"))
            .Render();
    }
</div>
<div class="clear"></div>
<br />

<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">Invoice Detail</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TaxInvoiceDetailModel>()
            .Name("gridTaxInvoiceDetail")
            .ToolBar(bar => bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).SaveText("Save").CancelText("Cancel"))
            .DataKeys(keys => keys.Add(f => f.TaxInvoiceId).RouteKey("taxInvoiceId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectTaxInvoiceDetail", "Orders")
                                                     .Update("ReduceTaxInvoiceDetail", "Orders"))
            .Columns(columns =>
            {
                columns.Bound(f => f.TaxInvoiceList).ReadOnly(true)
                       .HeaderTemplate("Invoice").Width(150);
                columns.Bound(f => f.CurrencyCode).ReadOnly(true)
                       .HeaderTemplate("Currency").Width(50);
                columns.Bound(f => f.RequiredAmountFormat).ReadOnly(true)
                       .HeaderTemplate("Debt ").Width(150)
                       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.Money)
                       .HeaderTemplate("Paid").Width(150)       // thanh toan'
                       .Format("{0:n2}")
                       .FooterTemplate("<span id='TotalMoney'></span>")
                       .HtmlAttributes(new { style = "text-align: right;" });
                    //columns.Bound(f => f.Times).ReadOnly(true)
                    //       .HeaderTemplate("Lần nhập").Width(50)
                    //       .ClientTemplate("<span name='Times'><#= Money == null ? 0 : Times #></span>")
                    //       .HtmlAttributes(new { style = "text-align: left;" });
                columns.Bound(f => f.Note)
                       .HeaderTemplate("Note")
                       .HtmlAttributes(new {style = "text-align: left;"});
                columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Title("").Width(50);
                })
            .ClientEvents(events => events
                                        .OnSave("gridProductInventoryDetail_onSave")
                                        .OnSubmitChanges("gridProductInventoryDetail_onSubmitChanges")
                                        .OnError("grid_OnError")
                                        .OnDataBound("gridProductInventoryDetail_onDataBound")
            )
            .Editable(f => f.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            // .Footer(false)
            .Resizable(f => f.Columns(true))
            .Render()
            ;
    }
</div>
