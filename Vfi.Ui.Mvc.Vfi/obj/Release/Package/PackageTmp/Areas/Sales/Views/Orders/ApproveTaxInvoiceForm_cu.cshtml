<div class="title">Duyệt chứng từ</div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<TaxInvoiceModel>()
            .Name("gridTaxInvoice")
            .DataKeys(key => key.Add(f => f.TaxInvoiceId).RouteKey("taxInvoiceId"))
            //.ToolBar(
            //    toolbar =>
            //    toolbar.Insert().ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectPrepareTaxInvoice", "Orders", new {area = "Sales"})
                    //.Insert("InsertOrder", "Orders", new {area = "Sales"})
                                          .Update("UpdateTaxInvoice", "Orders", new { area = "Sales" })
                                          .Delete("CancelTaxInvoice", "Orders", new { area = "Sales" }))
            .Columns(columns =>
                {
                    columns.Command(command =>
                                    command.Edit().ButtonType(GridButtonType.ImageAndText).UpdateText("Duyệt").CancelText("Bỏ")
                        ).Width(98).Title("").HtmlAttributes(new {style = "text-align:center"});

                    columns.Bound(f => f.TaxInvoiceList).Title("Số HĐ").Width(125).ReadOnly(true);
                    columns.Bound(f => f.SetupDate).Title("Ngày lập HĐ").Width(100)
                           .ClientTemplate("<#= SetupDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', SetupDate) #>");
                    //columns.Bound(f => f.InvoiceNumber).Width(75).ReadOnly(true).Title("Số Invoice");
                    //columns.Bound(f => f.PoNumber).Width(125).ReadOnly(true);
                    columns.Bound(f => f.CustomerCode).Title("Mã KH").Width(75).ReadOnly(true);
                    columns.Bound(f => f.CurrencyCode).Title("Tiền tệ").Width(65).ReadOnly(true);
                    columns.Bound(f => f.Tax).Title("Thuế(%)").Width(75).ReadOnly(true);
                    columns.Bound(f => f.ExchangeRate).Title("Tỉ giá").Width(65).ReadOnly(true);
                    columns.Bound(f => f.TotalQuantity).Width(90).ReadOnly(true).Title("Tổng SL")
                           .HtmlAttributes(new { style = "text-align: right;" })
                           .ClientTemplate("<#= TotalQuantity == null ? 0 : $.telerik.formatString('{0:n0}', TotalQuantity) #>");
                    columns.Bound(f => f.TotalAmount).Width(100).ReadOnly(true).Title("Tổng tiền+(%)")
                           .HtmlAttributes(new { style = "text-align: right;" })
                           .ClientTemplate("<#= TotalAmount == null ? 0 : $.telerik.formatString('{0:n2}', TotalAmount) #>");
                    columns.Bound(f => f.TotalAmountVND).Width(100).ReadOnly(true).Title("Tổng tiền VNĐ+(%)")
                           .HtmlAttributes(new { style = "text-align: right;" })
                           .ClientTemplate("<#= TotalAmountVND == null ? 0 : $.telerik.formatString('{0:n2}', TotalAmountVND) #>");
                    columns.Bound(f => f.ModifiedDate).Width(100).ReadOnly(true).Title("Ngày tạo")
                           .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm:ss}', ModifiedDate) #>");
                    //columns.Bound(f => f.ExportId).Title("In").Width(45).ReadOnly(true)
                    //       .ClientTemplate("<input type='button' id='id_<#= ExportId #>' value='In' class='t-button' min-width='20px' onclick=PrintInvoiceForm(<#= ExportId #>) />")
                    //       .HtmlAttributes(new {style = "text-align:center"});

                    columns.Command(command => command.Delete().ButtonType(GridButtonType.Image))
                           .Width(50).Title("Hủy").HtmlAttributes(new {style = "text-align:center;color:red"});

                })
            .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("TabStrip_<#= TaxInvoiceId #>")
                    .SelectedIndex(0)
                    .Items(items =>
                           items.Add().Text("Thông tin chi tiết").Content(

                               Html.Telerik().Grid<InvoiceDetailTempModel>()
                                   .Name("gridTransactionDetail_<#= TaxInvoiceId #>")
                                   .DataKeys(key => key.Add(f => f.DetailId).RouteKey("DetailId"))
                                   .DataBinding(dataDindings =>
                                                dataDindings.Ajax()
                                                            .Select("SelectProductDetailInTaxInvoice", "Orders", new { taxInvoiceId = "<#= TaxInvoiceId #>" })
                                                            .Delete("CancelProductTaxInvoiceDetailByExportDetailId", "Orders")
                                   )
                                   .Columns(columns =>
                                   {
                                       columns.Bound(f => f.ProductCode).Title("Mã SP").Width(50).ReadOnly(true);
                                       //columns.Bound(f => f.OrderNumber).Title("Số ĐH").Width(50).ReadOnly(true);
                                       columns.Bound(f => f.InvoiceNumber).Title("Số Invoice").Width(50).ReadOnly(true);
                                       columns.Bound(f => f.ExportedDate).Title("Ngày xuất").Width(50).ReadOnly(true)
                                              .ClientTemplate("<#= ExportedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ExportedDate) #>");
                                       columns.Bound(f => f.Quantity).Width(70).ReadOnly(true).Title("Số lượng")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .ClientTemplate("<#= Quantity == null ? 0 : $.telerik.formatString('{0:n0}', Quantity) #>");
                                       columns.Bound(f => f.UnitPriceFormat).ReadOnly(true).Width(50).Title("Đơn giá")
                                              .HtmlAttributes(new { style = "text-align: right;" });
                                       columns.Bound(f => f.Amount).Width(70).Title("Tổng tiền").ReadOnly(true)
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .ClientTemplate("<#= Amount == null ? 0 : $.telerik.formatString('{0:n}', Amount) #>");
                                       columns.Command(command =>
                                                       command.Delete().ButtonType(GridButtonType.Image)
                                           ).Width(40).Title("").HtmlAttributes(new { style = "text-align:center" });
                                   })
                                       .ClientEvents(e => e.OnError("Grid_OnError"))
                                   .ToHtmlString()))
                    .ToHtmlString()))
            .Selectable()
            .Editable(editing => editing.Mode(GridEditMode.InLine))
            .ClientEvents(events => events.OnEdit("gridProduct_onEdit")
                                          .OnRowSelect("grid_OnRowSelect")
                                          .OnSave("Grid_OnSave")
                                          .OnDataBinding("Grid_OnDataBinding")
                                          .OnDelete("Grid_OnDelete")
                                          .OnError("grid_OnError"))
            .Scrollable(f => f.Height(500))
            //.HtmlAttributes(new {style = "width: 950px;"})
            .Sortable()
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
            .Scrollable()
            .Render();
    }
</div>

<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
        )
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

