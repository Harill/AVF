@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@{
    ViewBag.Title = "Change Orders-Status";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">

    </script>
}

<div class="title">Change Orders-Status</div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<ManageOrderModel>()
            .Name("gridChangeOrer")
            .DataKeys(key => key.Add(f => f.OrderId).RouteKey("orderId"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                    .Select("SelectApprovedOrder", "SalesOrder", new {area = "Sales"})
                    .Update("UpdateOrderStatus", "SalesOrder", new {area = "Sales"})
            )
            .Columns(columns =>
            {
                columns.Command(command =>
                    command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image).UpdateText("Approve").CancelText("Cancel")
                    ).Width(50).Title("Approve").HtmlAttributes(new {style = "text-align:center"});

                columns.Bound(f => f.DueDate).Title("Delivery Date").Width(100)
                       .ClientTemplate("<#= DueDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', DueDate) #>");
                columns.Bound(f => f.OrderNumber).Title("Sale Order").Width(100).ReadOnly(true);
                columns.Bound(f => f.StatusName).Title("Status").Width(70);
                columns.Bound(f => f.SalesPersonName).Title("Sale Eployee").Width(100).ReadOnly(true);
                columns.Bound(f => f.CustomerCode).Title("Customer Code").Width(75).ReadOnly(true);
                //columns.Bound(f => f.Area).Title("Khu Vực").Width(75).ReadOnly(true);
                columns.Bound(f => f.TotalQuality).Width(100).ReadOnly(true).Title("Total Quantity")
                       .Format("{0:n0}")
                       .HtmlAttributes(new {style = "text-align: right;"})
                       .Aggregate(agg => agg.Sum())
                       .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");
                columns.Bound(f => f.TotalRequired).Width(100).ReadOnly(true).Title("Total Remaining ")
                       .Format("{0:n0}")
                       .HtmlAttributes(new {style = "text-align: right;"})
                       .Aggregate(agg => agg.Sum())
                       .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");
                columns.Bound(f => f.Note).Title("Order Note").ReadOnly(true);
            })
            .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("TabStrip_<#= OrderId #>")
                    .SelectedIndex(0)
                    .Items(items =>
                        items.Add().Text("Detail").Content(
                            Html.Telerik().Grid<OrderDetailModel>()
                                .Name("gridTransactionDetail_<#= OrderId #>")
                                .DataBinding(dataDindings => dataDindings.Ajax()
                                    .Select("SelectOrderDetailByOrderId", "SalesOrder",
                                        new {orderId = "<#= OrderId #>"}))
                                .Columns(columns =>
                                {
                                    columns.Bound(f => f.ProductCode).Title("Product Code");
                                    columns.Bound(f => f.PONumber).Title("PO");
                                    columns.Bound(f => f.OrderQty).Width(98).Title("Quantity")
                                           .HtmlAttributes(new {style = "text-align: right;"})
                                           .Format("{0:n0}");
                                    columns.Bound(f => f.RequiredNumber).Width(98).Title("Remaining")
                                           .HtmlAttributes(new { style = "text-align: right;" })
                                           .Format("{0:n0}");
                                    columns.Bound(f => f.UnitPrice).Title("Unit Price");
                                    columns.Bound(f => f.CustomerDueDate).Width(150).Format("{0:dd/MM/yyyy}").Title("Customer's Required Date");
                                })
                                .ClientEvents(events => events.OnError("grid_OnError"))
                                .ToHtmlString())
                    )
                    .ToHtmlString())
            )
            .Selectable()
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
            .ClientEvents(events => events.OnError("grid_OnError"))
            .Sortable()
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
            .Render();
    }
</div>
