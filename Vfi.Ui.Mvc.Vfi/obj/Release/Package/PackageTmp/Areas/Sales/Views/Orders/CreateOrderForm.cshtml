@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@model OrderModel
@{
    ViewBag.Title = "Đặt Đơn Hàng ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        $(function() {
            // panel display
            //$("#pnlNormal").hide();
            $("#pnlExcel").hide();
            // panel effect
            $("input[name='rdoType'][value='rdoNormal']").attr('checked', 'checked');

            $("input[name='rdoType']").change(function() {
                if ($("input[name='rdoType']:checked").val() === 'rdoExcel') {

                    if ($("#pnlNormal").is(":visible"))
                        runEffectHide("#pnlNormal", "drop");

                    setTimeout(function() {
                        runEffectShow("#pnlExcel", "drop");
                    }, 1200);

                } else if ($("input[name='rdoType']:checked").val() === 'rdoNormal') {

                    if ($("#pnlExcel").is(":visible"))
                        runEffectHide("#pnlExcel", "drop");

                    setTimeout(function() {
                        runEffectShow("#pnlNormal", "drop");
                    }, 1200);
                }
            });
        });
    </script>
    <script type="text/javascript">
        function customer_onChange() {
           
            var customerId = $(this).data('tComboBox').value();

            var cboShipmethod = $("#ShipMethodName").data("tDropDownList");
            var cboPaymentTerm = $("#PaymentTerm").data("tDropDownList");
            var cboEmployee = $("#EmployeeName").data("tDropDownList");
            var cboCurrency = $("#CurrencyCode").data("tDropDownList");
            $.ajax({
                type: 'post',
                data: { customerId: customerId },
                dataType: 'json',
                url: '@Url.Action("GetCustomerById", "Customer")',
                timeout: 20000,
                success: function(res) {
                    if (res.Code != 1) {
                        alert("Lỗi! " + res.Message);
                    } else {
                        $("#BillToAddress").val(res.Data.BillToAddress);
                        $("#ShipToAddress").val(res.Data.ShipToAddress);
                        
                        if (res.Data.CurrencyCode !== "") {
                            $("#CurrencyCode").val(res.Data.CurrencyCode);
                        } else {
                            $("#CurrencyCode").val('');
                            cboCurrency.selectedIndex = -1;
                            cboCurrency.previousValue = "";
                            cboCurrency.value(-1);
                            cboCurrency.text("");
                        }
                        cboCurrency.$text[0].innerHTML = res.Data.CurrencyCode;

                        if (res.Data.ShipMethodId > 0) {
                            $("#ShipMethodName").val(res.Data.ShipMethodId);
                        } else {
                            $("#ShipMethodName").val('');
                            cboShipmethod.selectedIndex = -1;
                            cboShipmethod.previousValue = "";
                            cboShipmethod.value(-1);
                            cboShipmethod.text("");
                        }
                        cboShipmethod.$text[0].innerHTML = res.Data.ShipMethodName;

                        if (res.Data.PaymentMethodId > 0) {
                            $("#PaymentTerm").val(res.Data.PaymentMethodId);
                        } else {
                            $("#PaymentTerm").val('');
                            cboPaymentTerm.selectedIndex = -1;
                            cboPaymentTerm.previousValue = "";
                            cboPaymentTerm.value(-1);
                            cboPaymentTerm.text("");
                        }
                        cboPaymentTerm.$text[0].innerHTML = res.Data.PaymentMethodName;

                        if (res.Data.SalesPersonId > 0) {
                            $("#EmployeeName").val(res.Data.SalesPersonId);
                        } else {
                            $("#EmployeeName").val('');
                            cboEmployee.selectedIndex = -1;
                            cboEmployee.previousValue = "";
                            cboEmployee.value(-1);
                            cboEmployee.text("");
                        }
                        cboEmployee.$text[0].innerHTML = res.Data.SalesPersonName;
                    }
                }
            });
            return false;
        }

    </script>
  
    <script type="text/javascript">

        function gridOrderDetailPartial_onEdit(e) {

            var dataItem = e.dataItem;
            var mode = e.mode;
            var form = e.form;
            //var cell = e.cell;

            //var orderQty = $(form).find("#OrderQty").data("tTextBox");
            //var unitPrice = $(form).find("#UnitPrice").data("tTextBox");
            var lineTotal = $(form).find("#LineTotal").data("tTextBox");
            if (mode === 'insert') {

            }
            if (mode === 'edit') {
                var monthlyDate = e.dataItem['CustomerDueDate'];
                if (monthlyDate === null)
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', new Date());
                else
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);
                e.dataItem['CustomerDueDate'] = monthlyDate;
            }

            dataItem.LineTotal = dataItem.OrderQty * dataItem.UnitPrice;
            if (lineTotal != null) {
                lineTotal.value(dataItem.LineTotal);
            }
            var price = dataItem.UnitPrice;
            if (price === 0) {
                var productId = dataItem.ProductId;
                if (productId !== 0) {
                    $.ajax({
                        type: 'post',
                        data: { productId: productId },
                        dataType: 'json',
                        url: '@Url.Action("CheckUnitPrice", "Product", new {area = ""})',
                        timeout: 20000,
                        success: function(data) {
                            var linePrice = $(form).find("#UnitPrice").data("tTextBox");
                            if (linePrice != null) {
                                linePrice.value(data);
                            }
                            dataItem.UnitPrice = data;
                        }
                    });
                }
            }
        }

        var orderQty = {};
        var unitPrice = {};
        var productIds = {};
        productIds[0] = 0;

        function gridOrderDetailPartial_onSave(e) {
            // bind data
            var $productCode = $(e.cell).find('#ProductCode');

            if ($productCode.length > 0) {
                var productCode = $productCode.data("tComboBox"),
                    productCodeSelectItem = productCode.selectedIndex > -1 ? productCode.data[productCode.selectedIndex] : null;

                if (productCodeSelectItem) {
                    e.values["ProductCode"] = productCodeSelectItem.Text;
                    e.values["ProductId"] = productCodeSelectItem.Value;
                    // AvailableQty
                    e.values["AvailableQty"] = productCodeSelectItem.Value;
                    var flag = true;
                    for (var obj in productIds) {
                        if (obj === productCodeSelectItem.Value) {
                            flag = false;
                            break;
                        }
                    }
                    if (flag === true) {
                        productIds[productCodeSelectItem.Value] = productCodeSelectItem.Value;
                    } else {
                        //e.preventDefault();
                        alert("đã tồn tại sản phẩm trong danh sách");
                    }
                }
            }


            // bind data
            //OrderQty LineTotal
            //tong 
            var quantity = $(e.cell).find('#OrderQty').val();
            var innerText = "", i = 0;
            if (!isNaN(parseInt(quantity))) {
                var sumOrderQty = 0;
                var spanOrderQtys = $("span[name='OrderQty']");
                for (i = 0; i < spanOrderQtys.length; i++) {
                    innerText = spanOrderQtys[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumOrderQty = sumOrderQty + parseInt(innerText);
                }
                sumOrderQty = sumOrderQty + parseInt(quantity);
                $("#TotalOrderQty").text(sumOrderQty.format(0));
            }
            var total = $(e.cell).find('#LineTotal').val();
            if (!isNaN(parseFloat(total))) {
                var sumLineTotal = 0;
                var spanlineTotals = $("span[name='LineTotal']");
                for (i = 0; i < spanlineTotals.length; i++) {
                    innerText = spanlineTotals[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumLineTotal = sumLineTotal + parseFloat(innerText);
                }
                sumLineTotal = sumLineTotal + parseFloat(total);
                $("#TotalLineTotal").text(sumLineTotal.format(4));
            }
        }

        function gridOrderDetailPartial_onSubmitChanges(e) {


            var flag = InputValidation();

            if (flag === false)
                e.preventDefault();
            else {

                var customerId = $('#cboCustomer').data('tComboBox').value(),
                    //orderNumber = $("#OrderNumber").val(),
                    orderNumber = 0,
                    orderDate = $("#OrderDate").data("tDatePicker").value(),
                    poNumber = $("#PoNumber").val(),
                    dueDate = $("#OrderDate").data("tDatePicker").value(),
                    //lotNumber = $("#LotNumber").val(),
                    //modelNumber = $("#ModelNumber").val(),
                    paymentTermId = $('#PaymentTerm').data('tDropDownList').value(),
                    shipMethodName = $('#ShipMethodName').data('tDropDownList').value(),
                    employeeName = $('#EmployeeName').data('tDropDownList').value(),
                    currencyCode = $('#CurrencyCode').data('tDropDownList').value(),
                    billToAddress = $("#BillToAddress").text(),
                    shipToAddress = $("#ShipToAddress").text(),
                    note = $("#Note").val();

                e.values = $.extend(e.values,
                    {
                        customerId: customerId,
                        orderNumber: orderNumber,
                        orderDate: orderDate,
                        poNumber: poNumber,
                        dueDate: dueDate,
                        //lotNumber: lotNumber,
                        //modelNumber: modelNumber,
                        paymentTermId: paymentTermId,
                        shipMethodId: shipMethodName,
                        employeeId: employeeName,
                        currencyCode: currencyCode,
                        billToAddress: billToAddress,
                        shipToAddress: shipToAddress,
                        note: note
                    }
                );
                productIds = {};
            }
        }


        function InputValidation() {
            var strMsgAlert = "";

            var customerId = $('#cboCustomer').data('tComboBox').value(),
                orderDate = $("#OrderDate").data("tDatePicker").value(),
                paymentTermId = $('#PaymentTerm').data('tDropDownList').value(),
                shipMethodName = $('#ShipMethodName').data('tDropDownList').value(),
                employeeName = $('#EmployeeName').data('tDropDownList').value(),
                currencyCode = $('#CurrencyCode').data('tDropDownList').value();

            if (orderDate == null || orderDate === "") {
                strMsgAlert += "Vui lòng chọn ngày giao hàng.\t\r\n";
            }
            if (customerId === "") {
                strMsgAlert += "Vui lòng chọn nhà cung cấp.\t\r\n";
            }
            if (shipMethodName === "") {
                strMsgAlert += "Vui lòng chọn phương thức vận chuyển.\t\r\n";
            }
            if (paymentTermId === "") {
                strMsgAlert += "Vui lòng chọn phương thức giao hàng.\t\r\n";
            }
            if (currencyCode === "") {
                strMsgAlert += "Vui lòng chọn phương thức đóng gói.\t\r\n";
            }
            if (employeeName === "") {
                strMsgAlert += "Vui lòng chọn nhân viên.\t\r\n";
            }

            if (strMsgAlert === "")
                return true;

            alert(strMsgAlert);
            return false;
        }
    </script>
    <script type="text/javascript">

        var fileName = "";

        function upload_OnUpload(e) {
            var files = e.files;
            $.each(files, function() {
                fileName = this.name;
                if (this.extension !== ".xls" && this.extension !== ".xlsx") {
                    alert("Only excel files can be uploaded");
                    e.preventDefault();
                    cancel = true;
                }
                cancel = true;
            });
            $.extend(e.data);
            cancel = false;
        }

        function upload_OnError(args) {
            if (args.textStatus === "modelstateerror" && args.modelState) {
                var message = "Errors:\n";
                $.each(args.modelState, function(key, value) {
                    if ('errors' in value) {
                        $.each(value.errors, function() {
                            message += this + "\n";
                        });
                    }
                });
                args.preventDefault();
                alert(message);
                cancel = true;
            }
        }

        function upload_OnSuccess(e) {
            alert(e.response);
        }

        var isParse = false;

        function gridExcel_OnDataBinding(args) {
            if (fileName !== "") {
                if (!cancel) {
                    var sheetName = $("#SheetName").data("tAutoComplete").value();
                    var productIndex = $("#ProductIndex").data("tAutoComplete").value();
                    var quantityIndex = $("#QuantityIndex").data("tAutoComplete").value();
                    var priceIndex = $("#PriceIndex").data("tAutoComplete").value();
                    var deliveryIndex = $("#DeliveryIndex").data("tAutoComplete").value();
                    if (sheetName !== "") {
                        args.data = $.extend(args.data, {
                            fileName: fileName,
                            productIndex: productIndex,
                            quantityIndex: quantityIndex,
                            priceIndex: priceIndex,
                            deliveryIndex:deliveryIndex,
                            sheetName: sheetName
                        });
                        list = args.data;
                        isParse = true;
                    }
                }
            }
        }

        function grid_OnComplete() {

            if (isParse) {
                $.ajax({
                    type: 'post',
                    data: {},
                    dataType: 'json',
                    url: '@Url.Action("GetExcelParseStatus", "Orders")',
                    timeout: 20000,
                    success: function(data) {
                        var message = "Tổng dòng: " + data[0];
                        message += "\nĐạt: " + data[1];
                        message += "\nLỗi: " + data[2];
                        message += "\nTrùng: " + data[3];
                        message += "\nMô tả: " + data[4];
                        alert(message);
                        isParse = false;
                    }
                });
            }
        }

        var list;
        var cancel = false;

        function SaveAllOrderDetail() {
            var flag = InputValidation();

            if (flag === false)
                return false;
            else {

                var customerId = $('#cboCustomer').data('tComboBox').value(),
                    orderDate = $("#OrderDate").data("tDatePicker").value(),
                    paymentTermId = $('#PaymentTerm').data('tDropDownList').value(),
                    shipMethodName = $('#ShipMethodName').data('tDropDownList').value(),
                    employeeName = $('#EmployeeName').data('tDropDownList').value(),
                    currencyCode = $('#CurrencyCode').data('tDropDownList').value(),
                    billToAddress = $("#BillToAddress").text(),
                    shipToAddress = $("#ShipToAddress").text(),
                    note = $("#Note").val();
                if (orderDate === null) {
                    orderDate = "";
                    //dueDate = "";
                } else {
                    orderDate = $.telerik.formatString('{0:dd/MM/yyyy}', orderDate);
                    //dueDate = $.telerik.formatString('{0:dd/MM/yyyy}', orderDate);
                }
                $.ajax({
                    type: 'post',
                    data: {
                        customerId: customerId,
                        orderDate: orderDate,
                        paymentTermId: paymentTermId,
                        shipMethodId: shipMethodName,
                        employeeId: employeeName,
                        currencyCode: currencyCode,
                        billToAddress: billToAddress,
                        shipToAddress: shipToAddress,
                        note: note
                    },
                    dataType: 'json',
                    url: '@Url.Action("SaveAllOrderDetail", "Orders")',
                    timeout: 20000,
                    success: function(data) {
                        alert(data);
                        fileName = "";
                        RefreshGrid2();
                    }
                });
            }
            return false;
        }

        function RefreshGrid2() {
            cancel = false;
            RefreshGrid("gridOrderDetailByExcel");
            // $(".t-comboBox .t-refresh").trigger('click');
        }

    </script>
}

