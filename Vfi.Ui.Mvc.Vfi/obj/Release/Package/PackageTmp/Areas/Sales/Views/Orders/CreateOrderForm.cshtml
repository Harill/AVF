    <div class="cover-div">
    @{
        Html.Telerik().Grid<OrderDetailModel>()
            .Name("gridOrderDetailByExcel")
            .DataKeys(keys => keys.Add(f => f.OrderDetailId).RouteKey("salesOrderDetailId"))
            .ToolBar(bar => bar.Template(
                @<text>
                    <div class="grid_10">
                        <button class="t-button" id="btnPrint" name="btnPrint" onclick=" SaveAllOrderDetail() ">
                            <span class='t-icon t-insert'></span>
                            Lưu tất cả
                        </button>
                    </div>
                    <div class="clear"></div>
                 </text>))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectOrderDetailByExcel", "Orders",
                    new
                    {
                        fileName = "",
                        productIndex = 0,
                        quantityIndex = 0,
                        priceIndex = 0,
                        deliveryIndex = 0,
                        sheetName = ""
                    }))
            .Columns(columns =>
            {
                columns.Bound(f => f.PONumber).Width(150);
                columns.Bound(f => f.ProductDesignNo).Width(100).ReadOnly(true).Title("Mã SP KH");
                columns.Bound(f => f.ProductName).Width(100).ReadOnly(true).Title("Tên SP");
                columns.Bound(f => f.ProductCode).Width(100).ReadOnly(true).Title("Mã SP VF")
                    .Aggregate(agg => agg.Count())
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                    .HtmlAttributes(new {style = "text-align: left;"});
                columns.Bound(f => f.OrderQty).Width(70).ReadOnly(true)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new {style = "text-align: right;"});
                columns.Bound(f => f.UnitPrice).Width(70).ReadOnly(true)
                    .Format("{0:n4}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.LineTotal).Width(100).ReadOnly(true)
                    .Format("{0:n2}")
                    .HtmlAttributes(new {style = "text-align: right;"})
                    .Aggregate(agg => agg.Sum())
                    .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new {style = "text-align: right;"});
                columns.Bound(f => f.CustomerDueDate).Width(70).ReadOnly(true)
                    .Format("{0:dd/MM/yyyy}");
            })
            .ClientEvents(events => events
                .OnDataBinding("gridExcel_OnDataBinding")
                //.OnSubmitChanges("gridOrderDetailPartial_onSubmitChanges")
                .OnError("grid_OnError")
            )
            //.Editable(editing => editing.Mode(GridEditMode.InCell))
            .KeyboardNavigation()
            .Groupable(group => group.Groups(g => g.Add(model => model.ProductCode)))
            //.Footer(false)
            .Render();
    }
