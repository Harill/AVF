<div class="cover-div" id="pnlNormal">
    @{
        Html.Telerik().Grid<OrderDetailModel>()
            .Name("gridOrderDetail")
            .DataKeys(keys => keys.Add(f => f.OrderDetailId).RouteKey("salesOrderDetailId"))
            .ToolBar(bar =>
                {
                    bar.Insert().ButtonType(GridButtonType.ImageAndText).Text("Thêm SP mới");
                    bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu tất cả").CancelText("Hủy");
                })
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectOrderDetail", "Orders")
                                                     .Update("UpdateOrderDetail", "Orders")
            )
            .Columns(columns =>
                {
                    columns.Bound(f => f.ProductCode).Width(175);
                    columns.Bound(f => f.PONumber).Width(100);
                    columns.Bound(f => f.OrderQty).Width(85)
                           .ClientTemplate("<span name='OrderQty'><#= OrderQty == null ? 0 : $.telerik.formatString('{0:n0}', OrderQty) #></span>")
                           .FooterTemplate("<span id='TotalOrderQty'></span>")
                        ;
                    columns.Bound(f => f.UnitPrice).Width(100);
                    columns.Bound(f => f.LineTotal).Width(85)
                           .ClientTemplate("<span name='LineTotal'><#= LineTotal == null ? 0 : $.telerik.formatString('{0:n4}', LineTotal) #></span>")
                           .FooterTemplate("<span id='TotalLineTotal'></span>")
                        ;
                    columns.Bound(f => f.CustomerDueDate).Width(90)
                           .ClientTemplate("<#= CustomerDueDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', CustomerDueDate) #>");
                    columns.Bound(f => f.IsAlert).Width(50).Title("Lưu ý")
                           .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsAlert' <#=IsAlert? checked='checked' : '' #> />")
                           .HtmlAttributes(new { style = "text-align:center" });
                    columns.Bound(f => f.OrderNote).Title("Ghi chú");
                    columns.Command(commands => commands.Delete()).Width(98).Title("Commands");
                })
            .ClientEvents(events => events
                                        //.OnDataBinding("gridPurchaseOrderDetailPartial_onDataBinding")
                                        .OnEdit("gridOrderDetailPartial_onEdit")
                                        .OnSave("gridOrderDetailPartial_onSave")
                                        .OnSubmitChanges("gridOrderDetailPartial_onSubmitChanges")
                                        .OnError("grid_OnError")
            )
            .Editable(editing => editing.Mode(GridEditMode.InCell))
            .KeyboardNavigation()
            //.Footer(false)
            .Render();
    }
