                                           .ClientTemplate("<#= WorkPiece == null ? 0 : $.telerik.formatString('{0:n2}', WorkPiece) #>");
                                    columns.Bound(f => f.KnifeCut).Width(50).Title("Knife</br>Cut")
                                           .ClientTemplate("<#= KnifeCut == null ? 0 : $.telerik.formatString('{0:n2}', KnifeCut) #>");
                                    columns.Bound(f => f.DeliveryEmployee).Width(75).Title("Delivery</br>Employee");
                                    columns.Bound(f => f.ReceiveEmployee).Width(75).Title("Receive</br>Employee");
                                    columns.Bound(f => f.Note).Title("Note").Width(300);
                                })
                                .ClientEvents(events => events.OnError("grid_OnError"))
                                .ToHtmlString()
                            );

                    }).ToHtmlString()))
            .Selectable()
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
            .ClientEvents(e => e.OnError("grid_OnError")
                .OnRowSelect("grid_OnRowSelect")
                .OnRowDataBound("grid_OnRowDataBound")
                .OnDataBinding("grid_OnDataBinding")
            //.OnSave("grid_OnSave")
            )
            .Scrollable(f => f.Height(500))
            .Sortable()
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
            .Scrollable()
            .Render();
    }
</div>
