                                       columns.Bound(f => f.PONumber).Title("Lệnh Mua").Width(100).ReadOnly(true);
                                       columns.Bound(f => f.Quantity).Width(50).ReadOnly(true).Title("Số lượng")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .ClientTemplate("<#= Quantity == null ? 0 : $.telerik.formatString('{0:n0}', Quantity) #>");
                                       columns.Bound(f => f.UnitPrice).ReadOnly(true).Width(50).Title("Đơn giá")
                                              .ClientTemplate("<#= UnitPriceCurrency == null ? 0 : $.telerik.formatString('{0:n0}', UnitPriceCurrency) #>")
                                              .HtmlAttributes(new { style = "text-align: right;" });
                                       columns.Bound(f => f.Amount).Width(70).Title("Tổng tiền").ReadOnly(true)
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .ClientTemplate("<#= Amount == null ? 0 : $.telerik.formatString('{0:n0}', Amount) #>");
                                       columns.Bound(f => f.Note).Title("Ghi chú").Width(100).ReadOnly(true);
