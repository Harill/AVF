@using System.Collections
@using Telerik.Reporting
@using Telerik.Web.Mvc.UI.Fluent
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@model Vfi.Ui.Mvc.Vfi.Areas.Sales.Models.OrderModel

@{
    ViewBag.Title = "Invocies Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function Grid_OnDataBound(args) {

        }

        function GridVND_OnDataBinding(args) {
            
            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;
            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }

            //    if (customerId == 0)
            //        customerId = 0;

            args.data = $.extend(args.data, {
                fromDate: fromDate,
                toDate: toDate,
                status: statusValue,
                currency: "VND"
            });
        }

        function GridUSD_OnDataBinding(args) {

            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;
            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }

            //    if (customerId == 0)
            //        customerId = 0;

            args.data = $.extend(args.data, {
                fromDate: fromDate,
                toDate: toDate,
                status: statusValue,
                currency: "USD"
            });
        }

        function status_onload() {
            var combobox = $('#Status').data('tComboBox');
            var dataSource =
            [
                { Text: "Chưa xuất HĐ", Value: "1" },
                { Text: "Đã xuất HĐ", Value: "2" },
                { Text: "Huỷ", Value: "3" },
            ];

            combobox.dataBind(dataSource);
        }

        function fromMonth_onLoad() {
            var combobox = $('#FromMonth').data('tDropDownList');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            combobox.value(new Date().getMonth() + 1);
        }

        function toMonth_onLoad() {
            var combobox = $('#ToMonth').data('tDropDownList');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            combobox.value(new Date().getMonth() + 1);
        }

        function PrintInvoiceForm(val) {
            $('#result').load('@Url.Action("PrintInvoice", "Inv",new{ area  = "Inv" })',
                {
                    invoiceId: val
                }, function(data) {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }
        function PrintCustomerIncome() {

            var customerId = $("#cboCustomer").data('tComboBox').value();
            if (customerId == 0 || customerId == "")
                customerId = 0;
            var fromMonth = $("#FromMonth").data("tDropDownList").value();
            if (fromMonth === null)
                fromMonth = new Date().getMonth() + 1;
            var fromYear = $("#FromYear").val();
            if (fromYear === null || fromYear == "")
                fromYear = new Date().getYear() + 1;
            var toMonth = $("#ToMonth").data("tDropDownList").value();
            if (toMonth === null)
                toMonth = new Date().getMonth() + 1;
            var toYear = $("#ToYear").val();
            if (toYear === null || toYear == "")
                toYear = new Date().getYear() + 1;

            $('#result').load('@Url.Action("PrintCustomerIncome", "Inv", new {area = "Inv"})',
                {
                    customerById: customerId,
                    fromMonth: fromMonth,
                    fromYear: fromYear,
                    toMonth: toMonth,
                    toYear: toYear,
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }
    </script>
}

