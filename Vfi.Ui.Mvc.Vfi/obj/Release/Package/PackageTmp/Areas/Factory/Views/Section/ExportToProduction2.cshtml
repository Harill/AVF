@using Telerik.Web.Mvc.UI
@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@model TransactionModel
@{
    ViewBag.Title = "Production2-Release";
    //"Xuất gia công SX 2
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function gridProduction2Inventory_onDataBinding(args) {
            var productCode = $("#ProductCode").data("tAutoComplete").value();

            args.data = $.extend(args.data, {
                eoi: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Import)",
                productCode: productCode
            });

        }

        function autoComplete_onChange() {
            RefreshGrid("gridSelect");
        }
    </script>

    <script type="text/javascript">
        function PickupId() {

            var $checkedRecords = $(':checked');
            //var $checkedRecords = $("input[name='chkMaterialIds']:checked");

            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 nguyên liệu");
                return;
            }

            //$.ajaxSettings.traditional = false;
            var a = {};
            var ids = "";

            for (var i = 0; i < $checkedRecords.length; i++) {
                a[i] = $checkedRecords[i].value;

                ids += $checkedRecords[i].value;
                if (i < ($checkedRecords.length - 1))
                    ids += ":";
            }
            $("#gridProduction2 ").data("tGrid").rebind({
                ids: ids,
                eoi: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Import)",
            });

        }
    </script>

    <!-- client event grid material inventory -->
    <script type="text/javascript">

        function gridProduction2_onSubmitChanges(e) {
            var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
            if (monthlyDate === null)
                monthlyDate = "";
            else
                monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

            e.values = $.extend(e.values,
                {
                    date: monthlyDate
                }
            );

        }

    </script>
}

<div class="title">Production2-Processing-Release
    @*Xuất gia công sản xuất 2*@</div>

<div class="t-info-sha" style="padding-left: 15px;padding-right: 15px; width:920px;">
    
    <fieldset>
        <legend>Release Information</legend>
       
    <div class="grid_1_5">Product</div>
    <div class="grid_6">
        @{
            Html.Telerik().AutoComplete()
                .Name("ProductCode")
                .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductCodeSection", "Section"))
                .HtmlAttributes(new { style = "width: 200px; " })
                .DropDownHtmlAttributes(new { style = "width: 250px; " })
                .Encode(false)
                .AutoFill(true)
                .HighlightFirstMatch(true)
                .ClientEvents(events => events
                    .OnChange("autoComplete_onChange")
                )
                .Render();
        }
    </div>
         <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("MonthlyDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
    </fieldset>
</div>
<div class="clear"></div>

<div class="cover-div">
@{
    Html.Telerik().Grid<Production2Model>()
        .Name("gridSelect")
        .ToolBar(bar => bar.Template(
            @<text>
                 <div class="grid_7">
                     <button class="t-button" id="btnPickupProductId" name="btnPickupId" onclick=" PickupId() ">
                         <span class='t-icon t-insert'></span>
                         Select Product
                     </button>
                 </div>
                 <div class="clear"></div>
             </text>
                            ))
        .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
        .DataBinding(dataBindings => dataBindings.Ajax()
                                                 .Select("SelectProduction2InventoryEoI", "Section",
                                                         new { eoi = MyUtilities.Transaction.EoIEnum.Import, productCode = "" }))
        .Columns(columns =>
            {
                columns.Bound(f => f.ProductId).Title("Select").Width(75)
                       .ClientTemplate("<input type='checkbox' name='chkProductIds' value='<#= ProductId #>' />")
                       .HtmlAttributes(new {style = "text-align:center"});
                columns.Bound(f => f.ProductCode).Width(200).Title("Product Code");
                columns.Bound(f => f.SectionName).Width(200).Title("Section Name");         // Ten Cong Doan
                columns.Bound(f => f.TotalInventory).Width(150)
                       .Title("Production2 Inv(kg)")                  //Tồn kho SX 2 (kg)
                       .HtmlAttributes(new {style = "text-align:right;"})
                       .Format("{0:n3}");
                columns.Bound(f => f.Weight).Width(150)
                       .Title("Weight(g/pc)")
                       .HtmlAttributes(new {style = "text-align:right;"})
                       .Format("{0:n3}");
                columns.Bound(f => f.Unit).Title("Unit Measure").Width(90);
            })
        .Scrollable(f => f.Height("auto"))
        .ClientEvents(events => events.OnDataBinding("gridProduction2Inventory_onDataBinding")
                                      .OnError("grid_OnError"))
        .Scrollable(f => f.Height(200))
        .Resizable(f => f.Columns(true))
        .Render();
}
</div>
<div class="clear"></div><br/>

<div class="t-info-sha" style="padding-left: 15px; width:250px; color: Maroon;">Release Detail</div>
<div class="cover-div">
@{
    Html.Telerik().Grid<Production2Model>()
        .Name("gridProduction2")
        .ToolBar(bar=>bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Save").CancelText("Cancel"))
        .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
        .DataBinding(dataBindings => dataBindings.Ajax()
            .Select("SelectProduction2InventoryByIds", "Section", new { eoi = MyUtilities.Transaction.EoIEnum.Import, ids = "" })
            .Update("ImportProduction2Inventory", "Section"))
        .Columns(columns =>
        {

            columns.Bound(f => f.ProductCode).Width(150).Title("Product Code").ReadOnly(true);
            columns.Bound(f => f.Production2Inventory).Width(100).ReadOnly(true)
                .Title("Production2 Inv")
                .HtmlAttributes(new {style="text-align:right;"})
                   .Format("{0:n3}");
            columns.Bound(f => f.SectionName).Width(150).Title("Section Name").ReadOnly(true);
            columns.Bound(f => f.TotalInventory).Width(100).ReadOnly(true)
                .Title("Section Inv")
                   .Format("{0:n3}");
            columns.Bound(f => f.Unit).Title("Unit Measure").Width(80).ReadOnly(true);
            columns.Bound(f => f.Quantity).Title("Quantity").Width(50)
                .HtmlAttributes(new { style = "text-align:right;" })
                   .Format("{0:n3}");
            columns.Bound(f => f.Note).Title("Note");

            columns.Command(commands => commands.Delete().Text("Delete")).Width(98).Title("");
        })
        .ClientEvents(events => events
            .OnSubmitChanges("gridProduction2_onSubmitChanges")
            .OnError("grid_OnError")
            
        )
        .Editable(f=>f.Mode(GridEditMode.InCell))
        //.Footer(false)
        .Resizable(f => f.Columns(true))
        .Render();   
}
</div>