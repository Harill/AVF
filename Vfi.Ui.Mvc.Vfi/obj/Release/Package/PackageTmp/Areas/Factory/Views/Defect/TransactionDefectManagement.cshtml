@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "Quản lý phiếu lỗi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
<script type="text/javascript">
    function transactionStatus_onChange() {
        RefreshGrid("gridTransaction");
    }

    function grid_OnDataBinding(args) {
        var statusValue = $("#transactionStatus").data("tComboBox").value();

        if (statusValue === "")
            statusValue = 0;

        var fromDate = $("#fromDate").data("tDatePicker").value();
        if (fromDate === null)
            fromDate = "";
        else {
            fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
        }
        var toDate = $("#toDate").data("tDatePicker").value();
        if (toDate === null)
            toDate = "";
        else {
            toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
        }
        args.data = $.extend({}, args.data, {
            status: statusValue,
            fromDate: fromDate,
            toDate: toDate
        });


        //$('#gridTransaction').data('t-grid').ajaxRequest();
        // $("#gridTransaction").page(1);


    }
</script>

<script type="text/javascript">
    function printTransaction(transactionId) {
        alert(transactionId);
        
    }

</script>

<!-- click node grid expand.colapse -->
<script type="text/javascript">
    function printDailyReport() {
        var fromDate = $("#fromDate").data("tDatePicker").value();
        if (fromDate === null)
            fromDate = "";
        else {
            fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
        }
        var toDate = $("#toDate").data("tDatePicker").value();
        if (toDate === null)
            toDate = "";
        else {
            toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
        }

        var productId = $("#ProductCode").data('tComboBox').value();
        if (productId === "")
            productId = 0;
        $('#result').load('@Url.Action("PrintDefectReport", "Defect")',
            {
                fromDate: fromDate,
                toDate: toDate,
                customerId: 0,
                productCode: "",
                productId: productId,
            }, function (data) {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
    }


    function PrintForm(val) {
        alert(val);
        $('#result').load('@Url.Action("PrintTransactionMaterial", "Inv")',
            {
                transactionId: val
            }, function (data) {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
        return false;
    }
</script>
}
<div class="title">Quản lý phiếu lỗi</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
    
        <div class="grid_2">
            Sản phẩm
        </div>
        <div class="grid_6">
             @{
                Html.Telerik().ComboBox()
                    .Name("ProductCode")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProductFullCodeName", "Product", new { area = "" }))
                    .HtmlAttributes(new {style = "width: 200px"})
                    .DropDownHtmlAttributes(new {style = "width: 275px"})
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
        <button id="btnPrintDailyReport" class="t-button" onclick=" return printDailyReport(); ">
            <span class='t-icon t-insert'></span>
            Báo cáo NG
        </button>
        <div class="clear"></div>
    <fieldset>
        <legend>Tiêu chí trích lọc</legend>

        <div class="grid_2">
            Tình trạng
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("transactionStatus")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxTransactionStatus", "Transaction", new { area = "Inv" }))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .ClientEvents(events => events.OnChange("transactionStatus_onChange"))
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("fromDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                    .Render();
            }
        </div>
        <div class="grid_2">
            @{
                Html.Telerik().DatePicker()
                    .Name("toDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
          <div class="grid_4 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridTransaction'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
            </div>
    </fieldset>
</div>
