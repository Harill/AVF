@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Tình trạng máy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    
    <script type="text/javascript">
        function cbo_OnChange(e) {

        }

        function grid_OnEdit(e) {
            var mode = e.mode;
            var form = e.form;
            if (mode == 'insert') {
            } else if (mode == 'edit') {
                var nodes = $(form).find('#MachineName');
                nodes[0].parentNode.parentNode.innerHTML = "<b>" + e.dataItem.MachineName + "</b>";
                nodes = $(form).find('#StateName');
                nodes[0].parentNode.parentNode.innerHTML = "<b>" + e.dataItem.StateName + "</b>";
                nodes = $(form).find('#ProductCode');
                nodes[0].parentNode.parentNode.innerHTML = "<b>" + e.dataItem.ProductCode + "</b>";
                //nodes = $(form).find('#ErrorQuantity');
                //nodes[0].parentNode.parentNode.innerHTML = e.dataItem.ErrorQuantity;
                nodes = $(form).find('#CreateUser');
                nodes[0].parentNode.parentNode.innerHTML = e.dataItem.CreateUser;
                nodes = $(form).find("#CauseDate");
                nodes[0].parentNode.innerHTML = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', e.dataItem.CauseDate);
            }
        }

        function gridDetail_OnEdit(e) {
            var mode = e.mode;
            var form = e.form;
            if (mode == 'insert') {
                nodes = $(form).find("#StatusName");
                nodes[0].parentNode.parentNode.innerHTML = e.dataItem.StatusName;
                nodes = $(form).find('#HowToFix');
                nodes[0].parentNode.innerHTML = "";
                nodes = $(form).find("#FinishDate");
                nodes[0].parentNode.innerHTML = "";
                nodes = $(form).find("#MoreTime");
                nodes[0].parentNode.innerHTML = "";
                nodes = $(form).find("#FixQuantity");
                nodes[0].parentNode.innerHTML = "0";
            } else if (mode == 'edit') {
                var nodes = $(form).find('#EmployeeName');
                nodes[0].parentNode.parentNode.innerHTML = e.dataItem.EmployeeName;
                nodes = $(form).find("#StartDate");
                nodes[0].parentNode.innerHTML = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', e.dataItem.StartDate);
                nodes = $(form).find("#Shift");
                nodes[0].parentNode.innerHTML = e.dataItem.Shift;
                //$.ajax({
                //    type: 'post',
                //    data: { stateId: e.dataItem.StateId },
                //    dataType: 'json',
                //    url: '@Url.Action("GetMachineStateDetailById", "Machine", new {area = "Factory"})',
                //    timeout: 20000,
                //    success: function(data) {
                //        //a
                //        var stateDetail = $('#HowToFix').data('tComboBox');
                //        stateDetail.dataBind(data);
                //    }
                //});
            }
        }

        function DisplayEmployeeState() {
            $('#result').load('@Url.Action("GetEmployeeState", "Machine")',
                {
                    userId: 0
                });
        }

        function TurnOnAuto() {
            SetAutoRefresh(true);
        }

        var auto = false;
        var autoId = 0;

        function SetAutoRefresh(bool) {
            auto = bool;
            if (auto)
                autoId = setInterval('DisplayEmployeeState()', 5000);
            else if (!auto) {
                clearInterval(autoId);
            }
        }
    //var autoId = setInterval('DisplayEmployeeState()', 5000);
    </script>
}

<div class="title">Quản lý thông tin máy</div>

    <button id="btnRefesh2" class="t-button" onclick=" DisplayEmployeeState()">
        <span class='t-icon t-insert'></span>
        Làm mới
    </button>
        <div id="result"></div>
<div class="clear"></div>
    <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridMachine'); ">
        <span class='t-icon t-insert'></span>
        Làm mới
    </button>
<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<MachineRepairFormModel>()
            .Name("gridMachine")
            .DataKeys(key => key.Add(f => f.FormId).RouteKey("formId"))
            //.DataKeys(key => key.Add(f => f.MachineId).RouteKey("machineId"))
            //.DataKeys(key => key.Add(f => f.HowToFix).RouteKey("howToFix"))
            .ToolBar(
                toolbar =>
                toolbar.Insert().ButtonType(GridButtonType.ImageAndText).Text("Thêm mới").ImageHtmlAttributes(new {style = "margin-left:0px;"}))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectMachineErrorState", "Machine", new {machineId = 0, fromDate = "", toDate = "", status = 0})
                                          .Insert("InsertMachineErrorState", "Machine")
                                          .Update("UpdateMachineErrorState2", "Machine")
                                          .Delete("DeleteMachineErrorState", "Machine"))
            .Columns(columns =>
                {
                    columns.Command(command =>
                                    command.Edit().ButtonType(GridButtonType.Image).UpdateText("Cập nhật").CancelText("Hủy").Text("Sửa").InsertText("Thêm")
                        ).Width(45).Title("").HtmlAttributes(new {style = "text-align:center", id = "btnCommand"});

                    columns.Bound(f => f.MachineName).Width(70).Title("Máy")
                           .ClientTemplate("<strong><#= MachineName #></strong>");
                    columns.Bound(f => f.ProductCode).Width(110).Title("SP")
                           .ClientTemplate("<strong><#= ProductCode #></strong>");
                    columns.Bound(f => f.StateName).Width(120).Title("Tình trạng")
                           .ClientTemplate("<strong><#= StateName #></strong>");

                    columns.Bound(f => f.ErrorCause).Width(150).Title("Nguyên nhân");
                    columns.Bound(f => f.ErrorQuantity).Width(60).Title("SL lỗi")
                           .Format("{0:n0}");
                    columns.Bound(f => f.CauseDate).Width(150).Title("TG máy hư")
                           .ClientTemplate("<#= CauseDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', CauseDate) #>");

                    columns.Bound(f => f.EmployeeName).Title("CN sửa").ReadOnly(true)
                           .HtmlAttributes(new {style = "border-right:1px solid black;"});
                    columns.Bound(f => f.CreateUser).Width(100).Title("NV KT");

                    //columns.Bound(f => f.EmployeeName).Width(85).Title("CN sửa");
                    //columns.Bound(f => f.Shift).Width(85).Title("Ca");
                    //columns.Bound(f => f.HowToFix).Title("Khắc phục").Width(125);
                    //columns.Bound(f => f.StartDate).Width(185).Title("Bắt đầu sửa")
                    //       .ClientTemplate("<#= StartDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', StartDate) #>")
                    //       .HtmlAttributes(new {style = "border-right:1px solid black;"});

                    columns.Bound(f => f.StatusName).Width(80).Title("Tình trạng").ReadOnly(true);
                    //columns.Bound(f => f.FinishDate).Width(185).Title("Kết thúc sửa")
                    //       .ClientTemplate("<#= FinishDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', FinishDate) #>");

                    //columns.Bound(f => f.MoreTime).Width(75).Title("Bù ĐM");
                    //columns.Bound(f => f.Note).Width(125).Title("Ghi chú");
                    columns.Bound(f => f.CreateDate).Width(85).Title("Ngày tạo").ReadOnly(true)
                           .Format("{0:dd/MM/yyyy HH:mm}");
                    //columns.Command(c => c.Delete().ButtonType(GridButtonType.Image)).Title("").Width(45);
                })
            .DetailView(details => details.ClientTemplate(

                Html.Telerik().Grid<RepairFormDetailModel>()
                    .Name("gridMachineRepair<#= FormId #>")
                    .DataKeys(key => key.Add(f => f.DetailId).RouteKey("detailId"))
                    .ToolBar(
                        toolbar =>
                        toolbar.Insert().ButtonType(GridButtonType.ImageAndText).Text("Thêm mới").ImageHtmlAttributes(new {style = "margin-left:0px;"}))
                    .DataBinding(dataDindings => dataDindings.Ajax()
                                                             .Select("SelectMachineErrorStateDetail", "Machine", new {formId = "<#= FormId #>"})
                                                             .Insert("InsertMachineErrorStateDetail", "Machine", new {formId = "<#= FormId #>"})
                                                             .Update("UpdateMachineErrorStateDetail", "Machine", new {formId = "<#= FormId #>"})
                                                             .Delete("DeleteMachineErrorStateDetail", "Machine", new { formId = "<#= FormId #>" }))
                    .Columns(columns =>
                        {
                            columns.Command(command =>
                                            command.Edit().ButtonType(GridButtonType.Image).UpdateText("Cập nhật").CancelText("Hủy").Text("Sửa").InsertText("Thêm")
                                ).Width(40).Title("").HtmlAttributes(new {style = "text-align:center", id = "btnCommand2"});

                            columns.Bound(f => f.EmployeeName).Width(120).Title("CN sửa");
                            columns.Bound(f => f.Shift).Width(50).Title("Ca");
                            columns.Bound(f => f.StartDate).Width(150).Title("Bắt đầu sửa")
                                   .ClientTemplate("<#= StartDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', StartDate) #>")
                                   .HtmlAttributes(new {style = "border-right:1px solid black;"});
                            //
                            columns.Bound(f => f.HowToFix).Title("Khắc phục").Width(150);
                            columns.Bound(f => f.FixQuantity).Width(75).Title("SL chỉnh")
                                   .Format("{0:n0}");
                            columns.Bound(f => f.StatusName).Width(75).Title("Trạng thái");
                            columns.Bound(f => f.FinishDate).Width(150).Title("Kết thúc sửa")
                                   .ClientTemplate("<#= FinishDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', FinishDate) #>");

                            columns.Bound(f => f.MoreTime).Width(75).Title("Bù ĐM");
                            columns.Bound(f => f.Note).Title("Ghi chú");
                    //columns.Command(c => c.Delete().ButtonType(GridButtonType.Image)).Title("").Width(45);
                        })
                    .ClientEvents(e => e.OnError("grid_OnError").OnEdit("gridDetail_OnEdit"))
                    .ToHtmlString()))
            .Selectable()
            .Editable(editing => editing.Mode(GridEditMode.InLine))
            .Scrollable(f => f.Enabled(true).Height("auto"))
            .ClientEvents(e => e.OnError("grid_OnError").OnEdit("grid_OnEdit").OnRowSelect("grid_OnRowSelect"))
            .Sortable()
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
            .Render();
    }
</div>
