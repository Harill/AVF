@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Defect Remedy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
<script type="text/javascript">
</script>
}

<div class="title">Quản lý biện pháp xử lý lỗi sản phẩm</div>

<div class="cover-div">
@{
    Html.Telerik().Grid<ProductionDefectRemedyModel>()
        .Name("gridMaterialType")
        .DataKeys(key => key.Add(f => f.RemedyId).RouteKey("remedyId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert().ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0" }))
        .DataBinding(
            dataBinding => dataBinding.Ajax()
                .Select("SelectProductionDefectRemedy", "Defect")
                .Insert("InsertProductionDefectRemedy", "Defect")
                .Update("UpdateProductionDefectRemedy", "Defect"))
        .Columns(columns => {
            columns.Command(command =>
                command.Edit().ButtonType(GridButtonType.Image)
            ).Width(98).Title("").HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.RemedyCode).Title("Mã biện pháp").Width(120);
            columns.Bound(f => f.RemedyName).Title("Tên biện pháp").Width(240);
            columns.Bound(f => f.ProcessWarehouseName).Title("Kho xử lý").Width(240);
            columns.Bound(f => f.Description).Title("Mô tả");
            columns.Bound(f => f.Active).Width(45)
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.ModifiedUser)
                   .Title("Người tạo").ReadOnly(true)
                   .Width(70);
            columns.Bound(f => f.ModifiedDate)
                   .Title("Ngày tạo").ReadOnly(true)
                   .Width(80)
                   .Format("{0:dd/MM/yyyy HH:mm:ss}");
        })
        .Editable(editing => editing.Mode(GridEditMode.InLine))
        .ClientEvents(events => events.OnError("grid_OnError"))
        //.Pageable(page => page.PageSize(10))
        .Sortable()
        .Render();
}
</div>

