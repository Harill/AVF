@using Telerik.Web.Mvc.UI
<script>
    function sectionbyProcess_OnDataBinding(e) {
        e.data = $.extend(e.data, {
            processId: processId,
        });
    }
</script>

@{
    Html.Telerik().ComboBox()
        .Name(ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty))
        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxSectionNextProcess", "Section", new { area = "Factory", processId = 0 }).Delay(350))
        .HtmlAttributes(new {style = "width: 50px"})
        .DropDownHtmlAttributes(new {style = "width: 150px"})
        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
        .HighlightFirstMatch(true)
        .AutoFill(true)
        .ClientEvents(events => events.OnDataBinding("sectionbyProcess_OnDataBinding"))
        .Render();
}
