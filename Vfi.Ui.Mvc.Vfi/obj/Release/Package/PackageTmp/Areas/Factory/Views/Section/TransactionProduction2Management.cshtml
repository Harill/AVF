@using Telerik.Web.Mvc.UI
@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "Quản lý phiếu gia công 2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
<script type="text/javascript">
    function transactionStatus_onChange() {
        RefreshGrid("gridTransaction");
    }

    function grid_OnDataBinding(args) {
        var statusValue = $("#transactionStatus").data("tComboBox").value();

        if (statusValue === "")
            statusValue = 0;

        var fromDate = $("#fromDate").data("tDatePicker").value();
        if (fromDate === null)
            fromDate = "";
        else {
            fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
        }
        var toDate = $("#toDate").data("tDatePicker").value();
        if (toDate === null)
            toDate = "";
        else {
            toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
        }
        args.data = $.extend({}, args.data, {
            status: statusValue,
            fromDate: fromDate,
            toDate: toDate
        });

    }
</script>

<script type="text/javascript">
    function printTransaction(transactionId) {
        alert(transactionId);
    }
    function PrintForm(val) {
        alert(val);
        $('#result').load('@Url.Action("PrintTransactionMaterial", "Inv")',
            {
                transactionId: val
            }, function () {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
        return false;
    }
</script>
}
<div class="title">Quản lý hồ sơ thông tin lệnh về nguyên liệu</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
    <fieldset>
        <legend>Tiêu chí trích lọc</legend>

        <div class="grid_2">
            Tình trạng giao dịch
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("transactionStatus")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxTransactionStatus", "Transaction",new{area="Inv"}))
                    .HtmlAttributes(new {style = "width: 150px"})
                    .DropDownHtmlAttributes(new {style = "width: 250px"})
                    .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .ClientEvents(events => events.OnChange("transactionStatus_onChange"))
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("fromDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                    .Render();
            }
        </div>
        <div class="grid_2">
            @{
                Html.Telerik().DatePicker()
                    .Name("toDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
          <div class="grid_4 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridTransaction'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
            </div>
    </fieldset>
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<Production2TransactionModel>()
           .Name("gridTransaction")
            .DataKeys(keys => keys.Add(f => f.TransactionId).RouteKey("transactionId"))
            .DataBinding(dataBindings => dataBindings.Ajax()

                                                     .Select("SelectProduction2Transaction", "Section",
                                                             new { status = (byte)MyUtilities.Transaction.Status.Open })
            )
            .Columns(columns =>
            {
                columns.Bound(f => f.TransactionCode).Title("Mã phiếu").Width(100);
                columns.Bound(f => f.StatusName).Title("Tình trạng").Width(100);
                columns.Bound(f => f.EoIName).Title("Loại").Width(80);
                columns.Bound(f => f.CreateDate).Title("Ngày báo cáo").Width(100)
                       .HtmlAttributes(new { style = "font-weight:bold;" })
                       .Format("{0:dd/MM/yyyy}");
                columns.Bound(f => f.TotalQuantity).Title("Số lượng").Width(80)
                    .Format("{0:n3}")
                       .HtmlAttributes(new { style = "text-align: right" });
                columns.Bound(f => f.TotalQuantityDefect).Title("Phế phẩm").Width(80)
                    .Format("{0:n3}")
                       .HtmlAttributes(new { style = "text-align: right" });
                columns.Bound(f => f.TotalLost).Title("Hao hụt").Width(80)
                    .Format("{0:n3}")
                       .HtmlAttributes(new { style = "text-align: right" });
                columns.Bound(f => f.Time).Title("Thời gian").Width(80)
                    .Format("{0:n1}")
                       .HtmlAttributes(new { style = "text-align: right" });
                columns.Bound(f => f.OverTime).Title("Tăng ca").Width(80)
                    .Format("{0:n1}")
                       .HtmlAttributes(new { style = "text-align: right" });
                columns.Bound(f => f.ModifiedUser).Title("Người tạo").Width(100);
                columns.Bound(f => f.ModifiedDate).Title("Ngày tạo").Width(100)
                       .Format("{0:dd/MM/yyyy HH:mm:ss}");
                //columns.Bound(f => f.TransactionId).Title("In").Width(45)
                //       .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' class='t-button' onclick=PrintForm(<#= TransactionId #>) />")
                //       .HtmlAttributes(new { style = "text-align:center" });
            })
            .DetailView(details => details.ClientTemplate(

                Html.Telerik().TabStrip()
                    .Name("TabStrip_<#= TransactionId #>")
                    .SelectedIndex(0)
                    .Items(items =>

                           items.Add().Text("Thông tin chi tiết").Content(

                               Html.Telerik().Grid<Production2TransactionDetailModel>()
                                   .Name("gridTransactionDetail_<#= TransactionId #>")
                                   .DataBinding(dataDindings => dataDindings.Ajax()
                                                                            .Select("SelectTransactionDetail", "Section",
                                                                                    new { transactionId = "<#= TransactionId #>" }))
                                   .Columns(columns =>
                                   {
                                       columns.Bound(f => f.ProductCode).Title("Mã SP").Width(100);
                                       //columns.Bound(f => f.UnitMeasure).Title("ĐVT").Width(40);
                                       columns.Bound(f => f.SectionIssueName).Width(140).Title("Công đoạn xuất");
                                       //columns.Bound(f => f.SectionIssueInv).Width(80).Title("Tồn kho")
                                       //       .HtmlAttributes(new { style = "text-align: right;" })
                                       //       .Format("{0:n3}");
                                       columns.Bound(f => f.SectionReceiptName).Width(140).Title("Công đoạn kế");
                                       columns.Bound(f => f.QuantityKg).Width(70).Title("Số lượng")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .Format("{0:n3}");
                                       columns.Bound(f => f.QuantityDefect).Width(70).Title("Phế phẩm")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .Format("{0:n3}");
                                       columns.Bound(f => f.QuantityLost).Width(70).Title("Hao hụt")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .Format("{0:n3}");
                                       columns.Bound(f => f.Time).Title("Thời gian").Width(60)
                                           .Format("{0:n1}")
                                              .HtmlAttributes(new { style = "text-align: right" });
                                       columns.Bound(f => f.OverTime).Title("Tăng ca").Width(60)
                                           .Format("{0:n1}")
                                              .HtmlAttributes(new { style = "text-align: right" });
                                       columns.Bound(f => f.Note).Title("Ghi chú");
                                   })
                                   .ToHtmlString()))
                    .ToHtmlString()
                                       ))
            .Selectable()
                    .Scrollable(f => f.Height(510))
            //.HtmlAttributes(new { style = "width: 950px;" })
                    .Resizable(f => f.Columns(true))
                    .Reorderable(f => f.Columns(true))
                    .Filterable()
                    .Sortable()
                    .Groupable()
            .ClientEvents(events => events
                                        .OnRowSelect("grid_OnRowSelect")
                                            .OnDataBinding("grid_OnDataBinding")
            )
            .Render();
    }
</div>

@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
        )
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

<style type="text/css">
    #windowReport {
        /*
            float: right;
            Position: relative;
            */
        min-height: 580px;
        top: 15%;
    }

    #result {
        height: 520px;
        overflow: hidden;
    }

    #ReportBody {
        padding-bottom: 25px;
        margin-bottom: 25px;
    }

    .tb-witdh td {
        width: 55px;
    }
</style>
