@using Telerik.Web.Mvc.UI
@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@model TransactionModel
@{
    ViewBag.Title = "Xuất gia công SX 2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        function grid_OnSave(e) {

            var $machineName = $(e.cell).find('#MachineName');
            if ($machineName.length > 0) {
                var machineName = $machineName.data("tComboBox"),
                    machineNameSelectItem = machineName.selectedIndex > -1 ? machineName.data[machineName.selectedIndex] : null;

                if (machineNameSelectItem) {
                    e.values["MachineName"] = machineNameSelectItem.Text;
                    e.values["MachineId"] = machineNameSelectItem.Value;
                }
            }
           
            var $employee = $(e.cell).find('#EmployeeName');
            if ($employee.length > 0) {
                var employee = $employee.data("tComboBox"),
                    employeeSelectItem = employee.selectedIndex > -1 ? employee.data[employee.selectedIndex] : null;

                if (employeeSelectItem) {
                    e.values["EmployeeName"] = employeeSelectItem.Text;
                    e.values["EmployeeId"] = employeeSelectItem.Value;
                }
            }

            ////tong number1
            //var number1 = $(e.cell).find('#MaterialUse1').val();
            //if (!isNaN(parseInt(number1))) {
            //    var number = parseInt(number1);
            //    var totalInv = parseInt(e.cell.parentNode.childNodes[2].innerHTML);
            //    if (number > totalInv)
            //        alert("Lỗi ! SL phát cao hơn tồn kho !");
            //    else {
            //        var sum = 0.0;
            //        var span = $("span[name='MaterialUse1']");
            //        for (var i = 0; i < span.length; i++) {
            //            var innerText = span[i].innerText;
            //            innerText = innerText.replace(/,/g, '');
            //            sum = sum + parseInt(innerText);
            //        }
            //        sum = sum + number;
            //        $("#TotalMaterialUse1").text(sum);
            //    }
            //}

        }
        function gridProduction2Inventory_onDataBinding(args) {
            var productCode = $("#ProductCode").data("tAutoComplete").value();

            args.data = $.extend(args.data, {
                eoi: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Export)",
                productCode: productCode
            });
        }
    </script>

    <script type="text/javascript">
        function PickupId() {

            var $checkedRecords = $(':checked');
            //var $checkedRecords = $("input[name='chkMaterialIds']:checked");

            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 nguyên liệu");
                return;
            }

            //$.ajaxSettings.traditional = false;
            var a = {};
            var ids = "";

            for (var i = 0; i < $checkedRecords.length; i++) {
                a[i] = $checkedRecords[i].value;

                ids += $checkedRecords[i].value;
                if (i < ($checkedRecords.length - 1))
                    ids += ":";
            }
            $("#gridProduction2").data("tGrid").rebind({
                ids: ids,
                eoi: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Export)",
            });

        }
    </script>

    <!-- client event grid material inventory -->
    <script type="text/javascript">

        function gridProduction2_onSubmitChanges(e) {
            var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
            if (monthlyDate === null)
                monthlyDate = "";
            else
                monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

            e.values = $.extend(e.values,
                {
                    date: monthlyDate
                }
            );

        }


    </script>
}

<div class="title">Nhập sản phẩm</div>

<div class="t-info-sha" style="padding-left: 15px;padding-right: 15px; width:920px;">
    
    <fieldset>
        <legend>Thông tin phiếu</legend>
       
    <div class="grid_2">Sản phẩm:</div>
    <div class="grid_6">
        @{
            Html.Telerik().AutoComplete()
                .Name("ProductCode")
                .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductCodeSectionInv", "Section"))
                .HtmlAttributes(new { style = "width: 200px; " })
                .DropDownHtmlAttributes(new { style = "width: 250px; " })
                .Encode(false)
                .AutoFill(true)
                .HighlightFirstMatch(true)
                .ClientEvents(events => events
                    .OnChange("autoComplete_onChange")
                )
                .Render();
        }
    </div>
         <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("MonthlyDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
    </fieldset>
</div>
<div class="clear"></div>

<div class="cover-div">
@{
    Html.Telerik().Grid<Production2Model>()
        .Name("gridSelect")
        .ToolBar(bar => bar.Template(
            @<text>
                 <div class="grid_7">
                     <button class="t-button" id="btnPickupProductId" name="btnPickupId" onclick=" PickupId() ">
                         <span class='t-icon t-insert'></span>
                         Chọn các sản phẩm vào lưới
                     </button>
                 </div>
                 <div class="clear"></div>
             </text>
                            ))
        .DataKeys(keys => keys.Add(f => f.SectionInvId).RouteKey("sectionInvId"))
        .DataBinding(dataBindings => dataBindings.Ajax()
                                                 .Select("SelectProduction2InventoryEoI", "Section",
                                                         new { eoi = MyUtilities.Transaction.EoIEnum.Export, productCode = "" }))
        .Columns(columns =>
            {
                columns.Bound(f => f.SectionInvId).Title("Chọn").Width(75)
                       .ClientTemplate("<input type='checkbox' name='chkProductIds' value='<#= SectionInvId #>' />")
                       .HtmlAttributes(new {style = "text-align:center"});
                columns.Bound(f => f.ProductCode).Width(150).Title("Mã SP");
                columns.Bound(f => f.SectionName).Width(150).Title("Tên công đoạn");
                columns.Bound(f => f.Production2Inventory).Width(100)
                       .Title("Tồn kho công đoạn")
                       .Format("{0:n3}");
                columns.Bound(f => f.SectionNextName).Width(150).Title("Công đoạn kế");
                columns.Bound(f => f.TotalInventory).Width(100)
                       .Title("Tồn công đoạn kế")
                       .Format("{0:n3}");
                columns.Bound(f => f.Unit).Title("ĐVT").Width(50);
            })
        .Scrollable(f => f.Height("auto"))
        .ClientEvents(events => events.OnDataBinding("gridProduction2Inventory_onDataBinding").OnError("grid_OnError"))
        .Scrollable(f => f.Height(200))
        .Resizable(f => f.Columns(true))
        .Render();
}
</div>
<div class="clear"></div><br/>

<div class="t-info-sha" style="padding-left: 15px; width:250px; color: Maroon;">Chi tiết lệnh nhập sản phẩm</div>
<div class="cover-div">
@{
    Html.Telerik().Grid<Production2Model>()
        .Name("gridProduction2")
        .ToolBar(bar=>bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu tất cả").CancelText("Bỏ"))
        .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
        .DataBinding(dataBindings => dataBindings.Ajax()
            .Select("SelectProduction2InventoryByIds", "Section", new { eoi = MyUtilities.Transaction.EoIEnum.Export, ids = "" })
            .Update("ExportProduction2Inventory", "Section"))
        .Columns(columns =>
        {
            columns.Bound(f => f.ProductCode).Width(100).Title("Mã SP").ReadOnly(true);
            columns.Bound(f => f.SectionName).Width(100).Title("Tên công đoạn").ReadOnly(true);
            columns.Bound(f => f.Production2Inventory).Width(70).ReadOnly(true)
                .Title("Tồn kho")
                   .Format("{0:n3}");
            columns.Bound(f => f.SectionNextName).Width(100).Title("Công đoạn kế").ReadOnly(true);
            columns.Bound(f => f.Unit).Title("ĐVT").Width(50).ReadOnly(true);
            columns.Bound(f => f.EmployeeName).Title("Nhân viên").Width(100);
            columns.Bound(f => f.MachineName).Title("Máy").Width(75);
            columns.Bound(f => f.Quantity).Title("Số lượng").Width(50)
                .HtmlAttributes(new { style = "text-align:right;" })
                   .Format("{0:n3}");
            columns.Bound(f => f.QuantityDefect).Title("Số lượng PP").Width(50)
                .HtmlAttributes(new { style = "text-align:right;" })
                   .Format("{0:n3}");
            columns.Bound(f => f.Note).Title("Ghi chú");
            
            columns.Command(commands => commands.Delete().Text("Bỏ")).Width(98).Title("");
        })
        .ClientEvents(events => events
            .OnSubmitChanges("gridProduction2_onSubmitChanges")
            .OnError("grid_OnError")
            .OnSave("grid_OnSave")
        )
        .Editable(f=>f.Mode(GridEditMode.InCell))
        //.Footer(false)
        .Resizable(f => f.Columns(true))
        .Render();   
}
</div>