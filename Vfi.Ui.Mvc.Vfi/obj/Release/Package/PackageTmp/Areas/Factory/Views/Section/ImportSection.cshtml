<div class="title">Nhập tồn công đoạn sản xuất 2</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

    <fieldset>
        <legend>Thông tin phiếu</legend>
             <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("MonthlyDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
    </fieldset>
</div>
<div class="clear"></div>


<div class="cover-div">
    @{
        Html.Telerik().Grid<Production2Model>()
            .Name("gridProduction2")
            .DataKeys(keys => keys.Add(f => f.ProductionSectionId).RouteKey("productionSectionId"))
            .ToolBar(bar =>
                {
                    bar.Insert().ButtonType(GridButtonType.ImageAndText).Text("Thêm mới");
                    bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu tất cả").CancelText("Hủy");
                })
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectProduction2Rotate", "Section")
                                                     .Update("UpdateProduction2Import", "Section")
            )
            .Columns(columns =>
                {
                    columns.Bound(f => f.ProductCode).Width(100).Title("Mã SP");
                    columns.Bound(f => f.SectionName).Width(100).Title("Tên công đoạn");
                    columns.Bound(f => f.TotalInventory).Width(50).ReadOnly(true)
                        .HeaderTemplate("Tồn kho</br>(kg)")
                        .HtmlAttributes(new { style = "text-align:right;" })
                           .Format("{0:n3}");
                    //columns.Bound(f => f.MachineName).Title("Máy").Width(75);
                    //columns.Bound(f => f.EmployeeName).Title("Nhân viên").Width(100);
                    columns.Bound(f => f.Quantity).Width(50)
                        .HeaderTemplate("Số lượng</br>(kg)")
                        .HtmlAttributes(new { style = "text-align:right;" })
                           .Format("{0:n3}");
                    //columns.Bound(f => f.QuantityDefect).Width(50)
                    //    .HeaderTemplate("Phế phẩm</br>(kg)")
                    //    .HtmlAttributes(new { style = "text-align:right;" })
                    //       .Format("{0:n3}");
                    //columns.Bound(f => f.Time).Width(50)
                    //    .HeaderTemplate("Thời gian làm</br>(h)")
                    //    .HtmlAttributes(new { style = "text-align:right;" })
                    //       .Format("{0:n0}");
                    //columns.Bound(f => f.OverTime).Width(50)
                    //    .HeaderTemplate("Tăng ca</br>(h)")
                    //    .HtmlAttributes(new { style = "text-align:right;" })
                    //       .Format("{0:n0}");
                    columns.Bound(f => f.Note).Title("Ghi chú");

                    columns.Command(commands => commands.Delete().Text("")).Width(98).Title("");
                })
            .ClientEvents(events => events.OnEdit("gridProduction2_onEdit")
                                          .OnSave("gridProduction2_onSave")
                                          .OnSubmitChanges("gridProduction2_onSubmitChanges")
                                          .OnError("grid_OnError")
            )
            .Editable(editing => editing.Mode(GridEditMode.InCell))
            .KeyboardNavigation()
            .Footer(false)
            .Render();
    }
</div>
<div class="clear"></div>
<br />
