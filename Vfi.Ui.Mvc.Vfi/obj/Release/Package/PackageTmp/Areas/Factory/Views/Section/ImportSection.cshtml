        }

        function gridProduction2_onSubmitChanges(e) {

            var date = $("#MonthlyDate").data("tDatePicker").value();
            if (date === null)
                date = "";
            else {
                date = $.telerik.formatString('{0:dd/MM/yyyy}', date);

            }
            e.values = $.extend(e.values,
                {
                    date: date
                }
            );
        }

        function section_OnDataBinding(e) {
            e.data = $.extend(e.data, {
                productId: productId
            });
        }
       
