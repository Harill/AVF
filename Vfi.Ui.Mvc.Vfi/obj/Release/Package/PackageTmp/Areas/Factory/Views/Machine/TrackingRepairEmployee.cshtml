<div class="cover-div">
    @{
        Html.Telerik().Grid<TrackingRepairEmployeeModel>()
            .Name("gridTracking")
            .DataKeys(key => key.Add(f => f.TrackingId).RouteKey("trackingId"))
            .ToolBar(
                toolbar =>
                toolbar.Insert().Text("Thêm mới").ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectTrackingEmployeeMachine", "Machine", new { fromDate = "", toDate = "" })
                                          .Insert("InsertTrackingEmployeeMachine", "Machine", new { fromDate = "", toDate = "" })
                                          .Update("UpdateTrackingEmployeeMachine", "Machine", new { fromDate = "", toDate = "" })
                                          )
            .Columns(columns =>
                {
                    columns.Command(command =>
                                    command.Edit().ButtonType(GridButtonType.Image).UpdateText("Cập nhật").CancelText("Hủy").Text("Sửa")
                        ).Width(50).Title("").HtmlAttributes(new {style = "text-align:center"});

                    columns.Bound(f => f.MachineName).Width(75).Title("Máy");
                    columns.Bound(f => f.RepairEmployeeName).Width(140).Title("CN sửa");

                    columns.Bound(f => f.QcEmployeeName).Width(140).Title("NV QC");

                    columns.Bound(f => f.StartDate).Width(140).Title("BĐ")
                        .ClientTemplate("<#= StartDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', StartDate) #>");
                    columns.Bound(f => f.FinishDate).Width(140).Title("KT")
                        .ClientTemplate("<#= FinishDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', FinishDate) #>");

                    columns.Bound(f => f.StatusName).Width(50).Title("TT").ReadOnly(true);
                    columns.Bound(f => f.FixTime).Width(50).Title("TG").ReadOnly(true);
                    columns.Bound(f => f.Shift).Width(50).Title("Ca");

                    columns.Bound(f => f.Note).Title("Ghi chú");
                    
                    columns.Bound(f => f.ModifiedDate).Width(100).Title("Ngày sửa").ReadOnly(true)
                        .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy hh:mm}', ModifiedDate) #>");
                    columns.Bound(f => f.ModifiedUser).Width(100).Title("Người sửa").ReadOnly(true);
                })
            .ClientEvents(events => events.OnDataBinding("gridTracking_OnDataBinding")
                                            .OnEdit("gridTracking_OnEdit")
                                            .OnSave("gridTracking_OnSave")
                                            .OnRowDataBound("gridTracking_OnRowDataBound")
                                          .OnError("grid_OnError"))
            .Selectable()
            .Scrollable(f => f.Height(510))
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .Groupable()
            .Render();
    }
</div>
