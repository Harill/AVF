@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "NV theo dõi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        function gridTracking_OnDataBinding(args) {

            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            var toDate = $("#ToDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

            args.data = $.extend(args.data, {
                fromDate: fromDate,
                toDate: toDate
            });
        }

        function gridTracking_OnSave(e) {

            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            var toDate = $("#ToDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

            e.values = $.extend(e.values,
                {
                    fromDate: fromDate,
                    toDate: toDate
                }
            );
        }

        function gridTracking_OnEdit(e) {
            var mode = e.mode;
            var form = e.form;
            if (mode == 'insert') {
                var d = new Date,
                        now = [(d.getMonth() + 1).padLeft(),
                           d.getDate().padLeft(),
                           d.getFullYear()].join('/') + ' ' +
                          [d.getHours().padLeft(),
                           d.getMinutes().padLeft()].join(':');

                var nodes = $(form).find('#StartDate');
                if (!!nodes)
                    nodes[0].value = now;

                var nodes = $(form).find('#FinishDate');
                if (!!nodes)
                    nodes[0].value = now;
            } else if (mode == 'edit') {
            }
        }

        Number.prototype.padLeft = function (base, chr) {
            var len = (String(base || 10).length - String(this).length) + 1;
            return len > 0 ? new Array(len).join(chr || '0') + this : this;
        }

        function gridTracking_OnRowDataBound(e) {
            e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
        }
    </script>
}

