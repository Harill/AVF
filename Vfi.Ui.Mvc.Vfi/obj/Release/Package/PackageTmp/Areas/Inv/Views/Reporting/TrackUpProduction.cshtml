@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Sản phẩm cần lên máy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">

        function gridTrackUpProduct_OnDataBinding(args) {
                var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();
                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId == 0)
                    customerId = 0;

                args.data = $.extend(args.data, {
                    customerId: customerId,
                    productCode: productCodeNameForMonthly,
                });
            
        }
        
    </script>
}

<div class="title">Báo cáo sản phẩm</div>
<div class="clear"></div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
    <fieldset>
        <legend>Tiêu chí trích lọc</legend>
        <div class="grid_2">
            @Html.Label("Mã  KH")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("CustomerForMonthly")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 275px" })
                    //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
        <div class="grid_2">
            @Html.LabelFor(f => f.ProductCodeName)
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ProductCodeNameForMonthly")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                    .DropDownHtmlAttributes(new { style = "width: 250px; " })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>
        <div class="grid_3">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid(gridTrackUpProduct); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
        </div>
    </fieldset>
</div>
<div class="clear">
        
</div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<ForecastOrderDetailModel>()
            .Name("gridTrackUpProduct")
            .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectTrackUpProduct", "Reporting",
                                                             new {customerId = 0, productName = ""}))
            .Columns(columns =>
                {
                    //columns.Bound(f => f.ProductId)
                    //       .ClientTemplate("<#= ++index #>")
                    //       .HeaderTemplate("<strong>STT</strong>").Width(50);

                    columns.Bound(f => f.CustomerCode).Width(75)
                           .HeaderTemplate("<strong>Mã KH</strong>")
                           .HtmlAttributes(new { style = "text-align: center;" });
                    columns.Bound(f => f.ProductCode)
                           .HeaderTemplate("<strong>Mã SP</strong>")
                           .HtmlAttributes(new { style = "text-align: center;" })
                           .Aggregate(agg => agg.Count())
                           .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                           .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>");
                    columns.Bound(f => f.MaterialCode)
                           .HeaderTemplate("<strong>Nguyên liệu</strong>")
                           .HtmlAttributes(new { style = "text-align: center;" });
                    columns.Bound(f => f.PlanQuantity)
                           .HeaderTemplate("<strong>Tổng đơn hàng</strong>")
                           .Format("{0:n0}")
                           .Aggregate(agg => agg.Sum())
                           .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                           .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                           .HtmlAttributes(new {style = "text-align: right;"});
                    columns.Bound(f => f.UploadDate).Width(100)
                           .HeaderTemplate("Ngày lên máy")
                           .Format("{0:dd/MM/yyyy}")
                           .HtmlAttributes(new {style = "text-align: right;"});

                })
            .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("TabOrder_<#= ProductId #>")
                    .SelectedIndex(0)
                    .Items(items =>
                           items.Add().Text("Thông tin chi tiết").Content(
                               Html.Telerik().Grid<OrderDetailModel>()
                                   .Name("gridOrderDetail_<#= ProductId #>")
                                   .DataBinding(dataDindings => dataDindings.Ajax()
                                                                            .Select("SelectTrackUpProductDetail", "Reporting",
                                                                                    new {productId = "<#= ProductId #>"}))
                                   .Columns(columns =>
                                       {
                                           columns.Bound(f => f.OrderNumber).Width(120)
                                                  .HeaderTemplate("Số đơn hàng");
                                           columns.Bound(f => f.OrderQty).Width(70)
                                                  .HeaderTemplate("SL đặt")
                                                  .Format("{0:n0}")
                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                           columns.Bound(f => f.RequiredNumber).Width(70)
                                                  .HeaderTemplate("SL còn lại")
                                                  .Format("{0:n0}")
                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                           columns.Bound(f => f.CustomerDueDate).Width(70)
                                                  .HeaderTemplate("KH yêu cầu")
                                                  .Format("{0:dd/MM/yyyy}")
                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                           columns.Bound(f => f.VFIDueDate).Width(120)
                                                  .HeaderTemplate("Kho duyệt")
                                                  .Format("{0:dd/MM/yyyy}");
                                           columns.Bound(f => f.ProductionDate).Width(70)
                                                  .HeaderTemplate("Ngày lên máy")
                                                  .ClientTemplate("<#= ProductionDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ProductionDate) #>")
                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                           columns.Bound(f => f.MachineRun).Width(50)
                                                  .HeaderTemplate("Máy chạy")
                                                  .ClientTemplate("<#= MachineRun == 0 ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', MachineRun) #>")
                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                       })
                                   .ClientEvents(events => events.OnError("grid_OnError"))
                                   .ToHtmlString()
                               )
                    )
                    .ToHtmlString()
                                       ))
                                       .Selectable()
            .Scrollable(f => f.Height(510))
            //.HtmlAttributes(new { style = "width: 950px;" })
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .ClientEvents(events => events
                                        .OnRowSelect("grid_OnRowSelect")
                                        .OnDataBinding("gridTrackUpProduct_OnDataBinding")
                                        .OnError("grid_OnError"))
            .Groupable()
            .Render();
    }
</div>