                           .FooterTemplate("<span id='TotalQuantityExport2'></span>");
                    columns.Bound(f => f.QuantityPending2).Width(45).Title("CXL 2").ReadOnly(true)
                           .HtmlAttributes(new { style = "text-align: right;" })
                           .ClientTemplate("<#= QuantityPending2 == null ? 0 : $.telerik.formatString('{0:n0}', QuantityPending2) #>")
                           .Aggregate(agg => agg.Sum())
                           .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .FooterTemplate("<span id='TotalQuantityPending2'></span>");
                    columns.Bound(f => f.QuantityDefect2).Width(45).Title("NG 2").ReadOnly(true)
                           .HtmlAttributes(new { style = "text-align: right;" })
                           .ClientTemplate("<#= QuantityDefect2 == null ? 0 : $.telerik.formatString('{0:n0}', QuantityDefect2) #>")
                           .Aggregate(agg => agg.Sum())
                           .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .FooterTemplate("<span id='TotalQuantityDefect2'></span>");

                })
            .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("Detail_<#= MachineId #>_<#= ProductId #>")
                    .SelectedIndex(0)
                    .Items(items =>
                        {
                            items.Add().Text("Nguyên liệu thiết kế").Content(
                                Html.Telerik().Grid<ProductModel>()
                                    .Name("gridMaterialUseDetail_<#= MachineId #>_<#= ProductId #>")
                                    .DataKeys(key => key.Add(f => f.ProductId).RouteKey("productId"))
                                    .DataBinding(dataDindings => dataDindings.Ajax()
                                                                             .Select("SelectProductMaterialDesign", "Product", new { area = "", productId = "<#= ProductId #>", }))
                                    .Columns(columns =>
                                        {
                                            columns.Bound(f => f.MaterialNameDesign).Width(120).Title("Tên NL").ReadOnly(true);
                                            columns.Bound(f => f.OutDiameterDesign).Width(100).Title("Đường kính ngoài").ReadOnly(true);
                                            columns.Bound(f => f.InDiameterDesign).Width(100).Title("Đường kính trong").ReadOnly(true);
                                            columns.Bound(f => f.ShapeDesign).Width(50).Title("Hình dạng").ReadOnly(true);
                                            columns.Bound(f => f.DiameterTypeDesign).Width(50).Title("Dung sai").ReadOnly(true);
                                        })
                                    .ClientEvents(events => events.OnError("grid_OnError"))
                                    .ToHtmlString()
                                );

                            items.Add().Text("Sản phẩm trên máy").Content(
                                Html.Telerik().Grid<TrackUpMachineModel>()
                                    .Name("gridTrackUpMachine_<#= MachineId #>_<#= ProductId #>")
                                    .DataKeys(key => key.Add(f => f.ProductId).RouteKey("productId"))
                                    .DataBinding(dataDindings => dataDindings.Ajax()
                                                                             .Select("SelectTrackUpByMachine", "Transaction", new
                                                                                 {
                                                                                     area = "Inv",
                                                                                     productId = "<#= ProductId #>",
                                                                                     machineId = "<#= MachineId #>",
                                                                                     useDateString = "<#= UseDateString #>",
                                                                                 }))
                                    .Columns(columns =>
                                        {
                                            columns.Bound(f => f.DeliveryDate).Width(75).Title("Ngày lên máy")
                                                   .ClientTemplate("<#= DeliveryDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', DeliveryDate) #>");
                                            columns.Bound(f => f.ProductCode).Width(100).Title("Mã SP")
                                                   .HtmlAttributes(new { style = "font-weight:bold" })
                                                //.ClientTemplate("<strong><#= ProductCode #></strong>")
                                                ;
                                            columns.Bound(f => f.MaterialCode).Width(150).Title("Nguyên liệu")
                                                   .HtmlAttributes(new { style = "font-weight:bold" });
                                            columns.Bound(f => f.RealProductivity).Width(45)
                                                   .HeaderTemplate("Năng</br>Suất")
                                                   .HtmlAttributes(new { style = "text-align:right;" })
                                                   .ClientTemplate("<#= RealProductivity == null ? 0 : $.telerik.formatString('{0:n2}', RealProductivity) #>");
                                            columns.Bound(f => f.RealRate).Width(45)
                                                   .HeaderTemplate("Định</br>Mức")
                                                   .HtmlAttributes(new { style = "text-align:right;" })
                                                   .ClientTemplate("<#= RealRate == null ? 0 : $.telerik.formatString('{0:n2}', RealRate) #>");
                                            columns.Bound(f => f.KnifeCut).Width(45)
                                                   .HeaderTemplate("Dao</br>Cắt")
                                                   .ClientTemplate("<#= KnifeCut == null ? 0 : $.telerik.formatString('{0:n2}', KnifeCut) #>");
                                            columns.Bound(f => f.DeliveryEmployee).Width(55).Title("NV Giao")
                                                   .HtmlAttributes(new { style = "text-align:center;" });
                                            columns.Bound(f => f.ReceiveEmployee).Width(55).Title("NV Nhận")
                                                   .HtmlAttributes(new { style = "text-align:center;" });
                                            columns.Bound(f => f.Note).Width(70).Title("Ghi chú");
                                            columns.Bound(f => f.ModifiedUser).Width(70).Title("Người làm");
                                            columns.Bound(f => f.ModifiedDate).Width(70).Title("Ngày làm")
                                                .Format("{0:dd/MM/yyyy HH:mm:ss}");
                                        })
                                    .ClientEvents(events => events.OnError("grid_OnError"))
                                    .ToHtmlString()
                                );
                        }
                    )
                    .ToHtmlString()
                                       ))
            .Selectable()
            .ClientEvents(events => events
                                        .OnDataBinding("gridExcel_OnDataBinding")
                                        .OnRowDataBound("gridExcel_OnRowDataBound")
                                        .OnComplete("gridExcel_OnComplete")
                                        .OnRowSelect("gridExcel_onRowSelect")
                                        .OnError("grid_OnError"))
            .Resizable(resizing => resizing.Columns(true))
            .Scrollable(f => f.Height(510))
                // .Footer(false)
            .Render();
        }
    </div>
</div>*@
