@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model MaterialInventoryModel
@{
    ViewBag.Title = "Material Use Daily Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- $.() -->
    

    <!-- binding -->
    <script type="text/javascript">

        function month_onLoad() {
            var combobox = $('#Month').data('tComboBox');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            if (new Date().getMonth() == 12)
                combobox.value = "1";
            else combobox.value(new Date().getMonth() + 1);
        }
        var startGrid = false;
        function materialTypeName_onChange() {
            OnLoadingData();
            startGrid = true;
            RefreshGrid("gridMaterialDaily");
        }

        function autoComplete_onDataBinding(args) {
            var materialTypeId = $("#MaterialTypeName").data('tDropDownList').value();

            if (materialTypeId === 0 || $("#MaterialTypeName").data('tDropDownList') == null)
                args.preventDefault();

            args.data = $.extend({}, args.data, { materialTypeId: materialTypeId });
        }


        // grid

        function gridMaterialInventory_onDataBinding(args) {

            var materialTypeId = $("#MaterialTypeName").data('tDropDownList').value();
            if (!materialTypeId)
                materialTypeId = 0;
           
            var materialName = $("#MaterialCodeName").data("tAutoComplete").value();
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            }
            args.data = $.extend(args.data, {
                materialCode: materialName,
                materialTypeId: materialTypeId,
                date: toDate
            });

        }
    </script>


    <!-- report -->
    <script type="text/javascript">
        function grid_OnError(e) {
            alert("Grid Error");
        }

        function print() {
            if (!onLoading) {
                OnLoadingData();
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }
                $('#result').load('@Url.Action("PrintMaterialDaily", "Reporting")',
                    {
                        date: toDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    })
            };
            return false;
        }


        // Loading button
        //     <span class="twoToneButton"></span>
        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }
    </script>

}

