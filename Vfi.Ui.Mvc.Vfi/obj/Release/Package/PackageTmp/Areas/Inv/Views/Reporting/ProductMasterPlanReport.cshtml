@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Kế hoạch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">
        function GetData() {
            var productCode = $("#ProductCodeName").data("tAutoComplete").value();
            var btn = document.querySelector('.twoToneButton');
            if (btn) {
                btn.innerHTML = "<span class='t-icon t-refresh t-loading'></span> Chờ load";
                btn.classList.add('loading');
            }
            var customerId = $("#Customer").data('tComboBox').value();
            if (customerId == 0)
                customerId = 0;
            var reportDate = $("#ReportDate").data("tDatePicker").value();
            if (reportDate === null)
                reportDate = new Date();
            var month = reportDate.getMonth() + 1;
            var year = reportDate.getFullYear();
            $.ajax({
                type: 'post',
                data: {
                    month: month,
                    year: year,
                    customerId: customerId,
                    productCode: productCode,
                },
                dataType: 'json',
                url: '@Url.Action("SelectProductMasterPlanReport", "Reporting", new { area = "Inv" })',
                timeout: 50000,
                success: function (data) {
                    if (data === 'OKIE') {
                        alert("Đã lấy xong báo cáo");
                        startGrid = true;
                        if (btn && btn.className.includes("loading")) {
                            btn.classList.remove('loading');
                            btn.innerHTML = "<span class='t-icon t-refresh'></span>Làm mới";
                        }
                        RefreshGrid('gridOrderPlan');
                        RefreshGrid('gridProductionOrderPlan');
                        RefreshGrid('gridCncOrderPlan');
                        RefreshGrid('gridProduction2OrderPlan');
                        RefreshGrid('gridQcOrderPlan');

                        RefreshGrid('gridForecastPlan');
                        RefreshGrid('gridProductionForecastPlan');
                        RefreshGrid('gridCncForecastPlan');
                        RefreshGrid('gridProduction2ForecastPlan');
                        RefreshGrid('gridQcForecastPlan');

                        RefreshGrid('gridOrderLated');
                        
                    }
                }
            });
        }

        var startGrid = false;
        function gridOrderPlan_OnDataBinding(args) {
            if (startGrid) {
                return true;
            }
            return false;
        }
    </script>
}

<div class="title">Kế hoạch sản xuất</div>
<div class="clear"></div>
<br />
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1000px;">
    <fieldset>

        <legend>Tiêu chí trích lọc</legend>
        <div class="grid_2">
            @Html.Label("Mã KH")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("Customer")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 275px" })
                    //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
        <div class="grid_2">
            @Html.LabelFor(f => f.ProductCodeName)
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ProductCodeName")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                    .DropDownHtmlAttributes(new { style = "width: 250px; " })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("ReportDate")
                    .Format("MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
        <div class="grid_3">
            <button id="btnRefesh" class="t-button twoToneButton" onclick=" return GetData(); ">
                <span class='t-icon t-refresh'></span>
                Làm mới
                <span class="loadButton"></span>
            </button>
        </div>
    </fieldset>
</div>
<div class="clear"></div>
<br />

