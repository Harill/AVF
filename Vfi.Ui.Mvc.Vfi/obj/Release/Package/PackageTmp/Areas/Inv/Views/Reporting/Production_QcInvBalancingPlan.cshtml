                }
            </div>
            <div class="grid_9">
                <div class="grid_2">
                    @Html.Label("PO Date")

                </div>
                <div class="grid_3">
                    @{
                        Html.Telerik().DatePicker()
                            .Name("fromDate")
                            .Format("dd/MM/yyyy")
                            .Value(DateTime.Now)
                            .Render();
                    }
                </div>
                <div class="grid_3">
                    @{
                        Html.Telerik().DatePicker()
                            .Name("toDate")
                            .Format("dd/MM/yyyy")
                            .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(4).AddSeconds(-1))
                            .Render();
                    }
                </div>
                <div class="grid_2">
                    @Html.Label("Report Date")
                </div>
                <div class="grid_3">
                    @{
                        Html.Telerik().DatePicker()
                            .Name("invDate")
                            .Format("dd/MM/yyyy")
                            .Value(DateTime.Now)
                            .Render();
                    }
                </div>

            </div>

            <div class="grid_2_5">
