@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@model ExportGCN_NCUModel
@{
    ViewBag.Title = "Xuất GCN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <style>
        .highslide-container div {
            font-family: Verdana, Helvetica;
            font-size: 10pt;
        }
        .highslide-container table {
            background: none;
        }
        .highslide {
            outline: none;
            text-decoration: none;
        }
        .highslide img {
            border: 2px solid silver;
        }
        .highslide:hover img {
            border-color: gray;
        }
        .highslide-active-anchor img {
            visibility: hidden;
        }
        .highslide-gallery .highslide-active-anchor img {
            border-color: black;
            visibility: visible;
            cursor: default;
        }
        .highslide-image {
            border-width: 2px;
            border-style: solid;
            border-color: white;
        }
        .highslide-wrapper, .highslide-outline {
            background: white;
        }
        .glossy-dark {
            background: #111;
        }

        .highslide-image-blur {
        }
        .highslide-number {
            display: none;
            font-weight: bold;
            color: gray;
            font-size: .9em;
        }
        .highslide-caption {
            display: none;
            font-size: 1em;
            padding: 5px;
            width: 100%;
            text-align: center;
            font-weight: bold;
            /*background: white;*/
        }
        .highslide-heading {
            display: none;
            font-weight: bold;
            margin: 0.4em;
        }
        .highslide-dimming {
            /*position: absolute;*/
            background: black;
        }
        a.highslide-full-expand {
            display: block;
            margin: 0 10px 10px 0;
            width: 34px;
            height: 34px;
        }
        .highslide-loading {
            display: block;
            color: black;
            font-size: 9px;
            font-weight: bold;
            text-transform: uppercase;
            text-decoration: none;
            padding: 3px;
            border: 1px solid white;
            background-color: white;
            padding-left: 22px;
            background-repeat: no-repeat;
            background-position: 3px 1px;
        }
        a.highslide-credits,
        a.highslide-credits i {
            padding: 2px;
            color: silver;
            text-decoration: none;
            font-size: 10px;
            display: none;
        }
        a.highslide-credits:hover,
        a.highslide-credits:hover i {
            color: white;
            background-color: gray;
        }
        .highslide-move, .highslide-move * {
            cursor: move;
        }

        .highslide-viewport {
            display: none;
            position: fixed;
            width: 100%;
            height: 100%;
            z-index: 1;
            background: none;
            left: 0;
            top: 0;
        }
        .highslide-overlay {
            display: none;
        }
        .hidden-container {
            display: none;
        }
/* Example of a semitransparent, offset closebutton */
        .closebutton {
            position: relative;
            top: -15px;
            left: 15px;
            width: 30px;
            height: 30px;
            cursor: pointer;
            /* NOTE! For IE6, you also need to update the highslide-ie6.css file. */
        }
        .highslide-controls {
            display: none 
        }

    </style>

    <script type="text/javascript">
        hs.graphicsDir = '';
        hs.align = 'center';
        hs.transitions = ['expand', 'crossfade'];
        hs.outlineType = '';
        hs.fadeInOut = true;
        hs.numberPosition = 'caption';
        hs.dimmingOpacity = 0.75;

        // Add the controlbar
        if (hs.addSlideshow)
            hs.addSlideshow({
                //slideshowGroup: 'group1',
                interval: 5000,
                repeat: false,
                useControls: true,
                fixedControls: 'fit',
                overlayOptions: {
                    opacity: .75,
                    position: 'bottom center',
                    hideOnMouseOut: true
                }
            });
    </script>

@section Scripts{
  
    <script type="text/javascript">

        var spanReals, i, innerText, sumReal = 0, sumRealKg = 0;
        function grid_onSave(e) {
            //tong realnumber
            sumReal = 0, sumRealKg = 0;
            var productQuantity = 0;
            var isRotateAll = $("input[name='IsRotateAll']");
            var quantityKg = $(e.cell).find('#Weight').val();
            var quantity = $(e.cell).find('#RealNumber').val();
            var spanIsRotateAll = e.cell.parentElement.getElementsByClassName("IsRotateAll_" + e.dataItem.ProductInvId)[0];
            var spanQuantity = e.cell.parentElement.getElementsByClassName("RealNumber")[0];
            var spanQuantityKg = e.cell.parentElement.getElementsByClassName("Weight")[0];
            if (isRotateAll.attr('checked')) {
                e.dataItem.RealNumber = e.dataItem.AvailableInventory;
                spanQuantity.textContent = e.dataItem.RealNumber.format(0);
                e.dataItem.Weight = e.dataItem.AvailableInventoryG;
                spanQuantityKg.textContent = e.dataItem.Weight.format(0);
                calculateSumKg(0);
                calculateSum(0);
            }
            else if (!isNaN(parseInt(quantityKg))) {
                if (e.dataItem.ProductWeight === 0 && parseFloat(quantityKg) != 0) {
                    alert("Lỗi! Sản phẩm chưa có trọng lượng! Không thể nhập khối lượng chuyển");
                } else {

                    productQuantity = parseInt(parseInt(quantityKg) / e.dataItem.ProductWeight);
                    spanQuantity.textContent = productQuantity.format(0);
                    e.dataItem.RealNumber = productQuantity;
                    if (e.dataItem.ProductInventory < e.dataItem.RealNumber) {
                        alert("Số lượng bạn nhập với các giao dịch trước đó có thể đã quá so với sản phẩm tồn kho\n" +
                            "Kho thiếu " + (e.dataItem.RealNumber - e.dataItem.ProductInventory));
                        e.cell.style.background = "red";
                    } else {
                        e.cell.style.background = "none";
                    }
                    if (e.dataItem.Quantity === e.dataItem.AvailableInventory) {
                        spanIsRotateAll.checked = true;
                    } else {
                        spanIsRotateAll.checked = false;
                    }
                    calculateSumKg(quantityKg);
                    calculateSum(0);
                }
            }

            else if (!isNaN(parseInt(quantity))) {
                productQuantity = parseInt(quantity);
                quantityKg = parseFloat(parseInt(productQuantity) * e.dataItem.ProductWeight);
                spanQuantityKg.textContent = quantityKg.format(0);
                e.dataItem.Weight = quantityKg;
                if (e.dataItem.ProductInventory < productQuantity) {
                    alert("Số lượng bạn nhập với các giao dịch trước đó có thể đã quá so với sản phẩm tồn kho\n" +
                        "Kho thiếu " + (productQuantity - e.dataItem.ProductInventory));
                    e.cell.style.background = "red";
                } else {
                    e.cell.style.background = "none";
                }

                if (productQuantity === e.dataItem.AvailableInventory) {
                    spanIsRotateAll.checked = true;
                } else {
                    spanIsRotateAll.checked = false;
                }
                calculateSumKg(0);
                calculateSum(quantity);
            }
        }
        function calculateSumKg(quantityKg) {
            spanReals = $("span[name='Weight']");
            for (i = 0; i < spanReals.length; i++) {
                innerText = spanReals[i].innerText;
                innerText = innerText.replace(/,/g, '');
                sumRealKg = sumRealKg + parseInt(innerText);
            }
            sumRealKg = sumRealKg + parseInt(quantityKg);
            $("#TotalWeight").text(sumRealKg.format(0));
        }

        function calculateSum(quantity) {
            spanReals = $("span[name='RealNumber']");
            for (i = 0; i < spanReals.length; i++) {
                innerText = spanReals[i].innerText;
                innerText = innerText.replace(/,/g, '');
                sumReal = sumReal + parseInt(innerText);
            }
            sumReal = sumReal + parseInt(quantity);
            $("#TotalReal").text(sumReal.format(0));
        }

        function grid_onSubmitChanges(e) {
            var eDate = $("#ExportDate").data("tDatePicker").value();
            if (eDate === null)
                eDate = "";
            else
                eDate = $.telerik.formatString('{0:dd/MM/yyyy}', eDate);

            var formId = $("#PlatingForm").data("tComboBox").value();
            if (formId === "")
                formId = 0;

            e.values = $.extend(e.values,
                {
                    exportDate: eDate,
                    formId: formId
                }
            );

        }

        function PlatingFormNumber_OnChange() {
            RefreshGrid("gridExportPartial");
        }

        function grid_OnDataBinding(e) {
            var formId = $("#PlatingForm").data("tComboBox").value();
            if (formId === "")
                formId = 0;
            e.data = $.extend(e.data, {
                platingFormId: formId
            });
            if (formId !== 0) {
                $.ajax({
                    type: 'post',
                    data: { formId: formId },
                    dataType: 'json',
                    url: '@Url.Action("SelectPlatingFormInfo", "PurchaseOrder", new {area = "Purchasing"})',
                    timeout: 20000,
                    success: function(data) {
                        $('#VendorCodeName').val(data.VendorCodeName);
                    }
                });
            }
        }


        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (dataItem.ProductWeight === 0)
                e.row.childNodes[2].style.backgroundColor = "#F4FA58";
            if (dataItem.AvailableInventory === 0)
                e.row.childNodes[1].style.backgroundColor = "#F4FA58";
        }

    </script>
    
}

    <div class="title">Xuất kho gia công ngoài</div>
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

        <fieldset>
            <legend>Thông tin phiếu nhập</legend> 
             <div class="grid_2">Mã lệnh:</div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("PlatingForm")
                    .DataBinding(binding => binding.Ajax().Select("SelectPlatingFormForExport", "PurchaseOrder", new { area = "Purchasing" }))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .ClientEvents(events => events.OnChange("PlatingFormNumber_OnChange"))
                    .AutoFill(true)
                    .Filterable(f=>f.FilterMode(AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
           
            <div class="grid_3">Ngày xuất kho</div>
            <div class="grid_4">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ExportDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="clear" style ="margin-bottom: 10px"></div>
            <div class="grid_3">Nhà cung ứng</div>
            <div class="grid_4">
                @Html.TextBox("VendorCodeName","",new{style="width:100%",@readonly="true"})
            </div>
            <div class="clear" style ="margin-bottom: 10px"></div>
           @* <div class="grid_3">Số thùng</div>
            <div class="grid_4">
                @Html.TextBoxFor(f => f.BoxNumber, new {style = "color: maroon;"})
            </div>
            <div class="grid_3">Số lốc</div>
            <div class="grid_4">
                @Html.TextBoxFor(f => f.BlockNumber, new {style = "color: maroon;"})
            </div>*@
        </fieldset>
    </div>
    <div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ExportGCN_NCUDetailModel>()
            .Name("gridExportPartial")
            .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
            .ToolBar(bar => bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu tất cả").CancelText("Hủy"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectExportPlating", "Transaction", new { platingFormId = 0 })
                                                     .Update("UpdateExportPlatingDetail", "Transaction")
            )
            .Columns(columns =>
            {

                columns.Bound(f => f.ProductImg).Width(50).Title("").ReadOnly(true)
                       .ClientTemplate("<a id='<#=DetailId#>' href='" + Url.Content("~/Content/FileUpload/Drawing/") + "<#=ProductImg#>?<#=UploadDate#>' class='highslide' onclick='return hs.expand(this)'>" +
                                       "<img src='" + Url.Content("~/Content/FileUpload/Drawing/") + "<#=ProductImg#>?<#=UploadDate#>' height='40' width='40' title='Mở lớn'/>" +
                                       "</a><div class='highslide-caption'><#= ProductCode #></div>");
                columns.Bound(f => f.ProductCode).Width(100).Title("Sản Phẩm").ReadOnly(true);
                columns.Bound(f => f.LotNumber).Width(100).Title("Lô").ReadOnly(true);

                columns.Bound(f => f.ProductWeight).Width(50).ReadOnly(true)
                       .HeaderTemplate("Trọng lượng</br>(g/pc)")
                       .HtmlAttributes(new { style = "text-align: right;" })
                       .Format("{0:n3}");
                columns.Bound(f => f.ProductInventory).Width(70).ReadOnly(true)
                       .HeaderTemplate("Tồn kho</br>(pcs)")
                       .HtmlAttributes(new { style = "text-align: right;" })
                       .Format("{0:n0}");
                columns.Bound(f => f.ProductInventoryG).Width(70).ReadOnly(true)
                       .HeaderTemplate("Tồn kho</br>(g)")
                       .HtmlAttributes(new { style = "text-align: right;border-left:1px black solid;" })
                       .Format("{0:n0}");
                columns.Bound(f => f.AvailableInventoryG).Width(70).ReadOnly(true)
                       .HeaderTemplate("Có thể</br>xuất (g)")
                       .HtmlAttributes(new { style = "text-align: right;" })
                       .Format("{0:n0}");
                columns.Bound(f => f.AvailableInventory).Width(70).ReadOnly(true)
                       .HeaderTemplate("Có thể</br>xuất (pcs)")
                       .HtmlAttributes(new { style = "text-align: right;border-left:1px black solid;" })
                       .Format("{0:n0}");
                columns.Bound(f => f.RequestNumberString).Width(50).ReadOnly(true).Title("SL Yêu cầu")
                       .HtmlAttributes(new { style = "text-align: center;background-color: yellow;" });
                columns.Bound(f => f.IsRotateAll).Width(50).Title("All")
                        .HeaderHtmlAttributes(new { @class = "edit-column" })
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsRotateAll_<#= ProductInvId #>' class='IsRotateAll_<#= ProductInvId #>' <#=IsRotateAll? checked='checked' : '' #> />")
                        .HtmlAttributes(new { style = "text-align: center;border-left:1px black solid;" });
                columns.Bound(f => f.Weight).Width(70)
                       .HeaderTemplate("TL xuất</br>(g)")
                               .HeaderHtmlAttributes(new { @class = "edit-column" })
                       .HtmlAttributes(new { style = "text-align: right;" })
                       .ClientTemplate("<span name='Weight' class='Weight'><#= Weight == null ? 0 : $.telerik.formatString('{0:n0}', Weight) #></span>")
                       .FooterTemplate("<span id='TotalWeight'></span>")
                       .FooterHtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.RealNumber).Width(70)
                       .HeaderTemplate("SL xuất</br>(pcs)")
                               .HeaderHtmlAttributes(new { @class = "edit-column" })
                       .HtmlAttributes(new { style = "text-align: right;" })
                       .ClientTemplate("<span name='RealNumber' class='RealNumber'><#= RealNumber == null ? 0 : $.telerik.formatString('{0:n0}', RealNumber) #></span>")
                       .FooterTemplate("<span id='TotalReal'></span>")
                       .FooterHtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.Package).Width(120).Title("Đóng gói")
                               .HeaderHtmlAttributes(new { @class = "edit-column" })
                       .HtmlAttributes(new { style = "text-align: center;border-left:1px black solid;" });
                columns.Bound(f => f.Note).Title("Ghi chú");
                //columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(50).Title("");
            })
            .ClientEvents(events => events
                                        .OnSave("grid_onSave")
                                        .OnSubmitChanges("grid_onSubmitChanges")
                                        .OnError("grid_OnError")
                                        .OnDataBinding("grid_OnDataBinding")
                                        .OnRowDataBound("grid_OnRowDataBound")
            )
            .Editable(editing => editing.Mode(GridEditMode.InCell))
            .KeyboardNavigation()
            //.Footer(false)
            .Render();
    }
</div>