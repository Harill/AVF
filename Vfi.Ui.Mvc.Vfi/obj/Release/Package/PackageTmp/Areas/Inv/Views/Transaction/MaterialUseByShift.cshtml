
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model MaterialUseInShiftModel
@{
    ViewBag.Title = "Material-Using Forms";
    //Phiếu sử dụng nguyên liệu
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">

        function grid_onEdit(e) {

            var dataItem = e.dataItem;
            var mode = e.mode;
            var form = e.form;
            //var cell = e.cell;

            //var orderQty = $(form).find("#OrderQty").data("tTextBox");
            //var unitPrice = $(form).find("#UnitPrice").data("tTextBox");
            if (mode == 'insert') {

            }
            if (mode == 'edit') {

            }

            var lastQuantity = $(form).find("#LastQuantity").data("tTextBox");
            // var data = dataItem.AssignQuantity + dataItem.EarlyQuantity - dataItem.Quantity;
            var data = dataItem.EarlyQuantity - dataItem.Quantity - dataItem.Quantity2;
            dataItem.LastQuantity = data;
            if (lastQuantity != null) {
                lastQuantity.value(data);
            }
        }

        function grid_onDataBinding(args) {
            var importDate = $("#ImportDate").data("tDatePicker").value();
            if (importDate === null)
                importDate = "";
            else
                importDate = $.telerik.formatString('{0:dd/MM/yyyy}', importDate);
            var ca1 = $("#Ca1Name").data("tDropDownList").value();
            if (ca1 === null)
                ca1 = "";
            var ca2 = $("#Ca2Name").data("tDropDownList").value();
            if (ca2 === null)
                ca2 = "";
            var factory = $("#Factory").data('tComboBox').value();
            args.data = $.extend(args.data, {
                onDate: importDate,
                ca1Name: ca1,
                ca2Name: ca2,
                factory: factory,
            });
        }

        function grid_onSave(e) {
            var maxUse = e.dataItem.EditQuantity;
            var lastQuantity = 0;
            var lastQuatityCell = e.cell.parentNode.getElementsByClassName("LastQuantity")[0];
            var quantity = $(e.cell).find('#Quantity').val();
            if (!isNaN(parseFloat(quantity))) {
                var sum = 0;
                var span = $("span[name='Quantity']");
                for (var i = 0; i < span.length; i++) {
                    var innerText = span[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sum = sum + parseFloat(innerText);
                }
                sum = sum + parseFloat(quantity);
                $("#TotalQuantity").text(sum);
                lastQuantity = e.dataItem.EarlyQuantity - e.dataItem.Quantity2 - quantity;
                lastQuatityCell.textContent = lastQuantity.format(2);
                if (quantity > maxUse) {
                    if (quantity >= maxUse * 2)
                        e.cell.style.backgroundColor = "red";
                   else  e.cell.style.backgroundColor = "yellow";
                } else {
                    e.cell.style.backgroundColor = "";
                }
                if (lastQuantity < 0) {
                    lastQuatityCell.style.backgroundColor = "red";
                } else {
                    lastQuatityCell.style.backgroundColor = "";
                }
            }

            quantity = $(e.cell).find('#Quantity2').val();
            if (!isNaN(parseFloat(quantity))) {
                sum = 0;
                span = $("span[name='Quantity2']");
                for (i = 0; i < span.length; i++) {
                    innerText = span[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sum = sum + parseFloat(innerText);
                }
                sum = sum + parseFloat(quantity);
                $("#TotalQuantity2").text(sum);
                lastQuantity = e.dataItem.EarlyQuantity - e.dataItem.Quantity - quantity;
                lastQuatityCell.textContent = lastQuantity.format(2);
                if (quantity > maxUse) {
                    if (quantity >= maxUse*2)
                        e.cell.style.backgroundColor = "red";
                    else e.cell.style.backgroundColor = "yellow";
                } else {
                    e.cell.style.backgroundColor = "";
                }
                if (lastQuantity < 0) {
                    lastQuatityCell.style.backgroundColor = "red";
                } else {
                    lastQuatityCell.style.backgroundColor = "";
                }
            }
        }

        function grid_onSubmitChanges(e) {
            var flag = InputValidation();
            if (flag == false)
                e.preventDefault();
            else {
                var importDate = $("#ImportDate").data("tDatePicker").value();
                if (importDate === null)
                    importDate = "";
                else
                    importDate = $.telerik.formatString('{0:dd/MM/yyyy}', importDate);
                var ca1Name = $("#Ca1Name").data("tDropDownList").value();
                var ca2Name = $("#Ca2Name").data("tDropDownList").value();
                e.values = $.extend(e.values,
                    {
                        importDate: importDate,
                        ca1Name: ca1Name,
                        ca2Name: ca2Name,
                    }
                );
            }
        }

        function InputValidation() {
            var strMsgAlert = "";

            var ca1Name = $("#Ca1Name").data("tDropDownList").value();
            var ca2Name = $("#Ca2Name").data("tDropDownList").value();
            if (ca1Name === "") {
                strMsgAlert += "Vui lòng chọn ca 1.\t\r\n";
            }
            if (ca2Name === "") {
                strMsgAlert += "Vui lòng chọn ca 2.\t\r\n";
            }

            if (strMsgAlert === "")
                return true;

            alert(strMsgAlert);
            return false;
        }

        //function CaNumber_onload() {
        //    var combobox1 = $('#CaNumber').data('tDropDownList');
        //    var dataSource =
        //    [
        //        { Text: "1", Value: "1" },
        //        { Text: "2", Value: "2" }
        //    ];

        //    combobox1.dataBind(dataSource);
        //}

        function Ca1Name_onload() {
            var combobox2 = $('#Ca1Name').data('tDropDownList');
            var dataSource =
            [
                { Text: "A", Value: "A" },
                { Text: "B", Value: "B" },
                { Text: "C", Value: "C" },
                { Text: "D", Value: "D" }
            ];

            combobox2.dataBind(dataSource);
        }
        function Ca2Name_onload() {
            var combobox2 = $('#Ca2Name').data('tDropDownList');
            var dataSource =
            [
                { Text: "A", Value: "A" },
                { Text: "B", Value: "B" },
                { Text: "C", Value: "C" },
                { Text: "D", Value: "D" }
            ];

            combobox2.dataBind(dataSource);
        }
        function getMaterialUseList() {
            RefreshGrid("gridMaterialUse");
        }

        function Factory_Onload() {
            var combobox = $('#Factory').data('tComboBox');
            var dataSource =
            [
                { Text: "VF1", Value: "VF1" },
                { Text: "VF2", Value: "VF2" }
            ];

            combobox.dataBind(dataSource);
        }
    </script>
}

<div class="title">Create Material-Using Forms
    @*Tạo phiếu sử dụng nguyên liệu*@</div>
<div class="t-info-sha" style="padding-left: 15px;padding-right: 15px; width:920px;">

    <fieldset>
        <legend>Material-Using Forms Information</legend> 
            <div class="grid_7">
               
            </div>
        @* <div class="grid_2">Mã phiếu</div>
        <div class="grid_1"><div id="lookupTransactionCodeExisted">&nbsp;</div></div>
        <div class="grid_4">
            @Html.TextBoxFor(f=>f.TransactionCode, new {style ="color: maroon;"})
            @Html.Hidden("txtTransactionCodeHidden")
        </div>*@
         <div class="grid_2">Using Date</div>
            <div class="grid_4">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ImportDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
        @*<div class="clear" style ="margin-bottom: 10px"></div>*@
        
        <div class="grid_1">Shift</div>
        <div class="grid_2">
            @{
                Html.Telerik().DropDownList()
                    .Name("Ca1Name")
                    .HtmlAttributes(new {style = "width: 40px"})
                    .DropDownHtmlAttributes(new {style = "width: 40px"})
                    .ClientEvents(events => events.OnLoad("Ca1Name_onload"))
                    .Render();
            }
        </div>
        <div class="grid_2">
            @{
                Html.Telerik().DropDownList()
                    .Name("Ca2Name")
                    .HtmlAttributes(new {style = "width: 40px"})
                    .DropDownHtmlAttributes(new {style = "width: 40px"})
                    .ClientEvents(events => events.OnLoad("Ca2Name_onload"))
                    .Render();
            }
        </div>
            <div class="grid_1_5">Factory </div>
            <div class="grid_2">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Factory")
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "width: 100%" })
                        .ClientEvents(events => events.OnLoad("Factory_Onload"))
                        .Render();
                }
            </div>
        @*<div class="grid_4 prefix_15">*@
            <button id="btnGetMaterialUseList" class="t-button" onclick=" return getMaterialUseList(); ">
                <span class='t-icon t-insert'></span>
                List Of Materials
       @*         Lấy danh sách nguyên liệu*@
            </button>
        @*</div>*@
    </fieldset>
</div>
<div class="clear"></div>
<div class="cover-div">
        @{
            Html.Telerik().Grid<MaterialUseInShiftDetailModel>()
                .Name("gridMaterialUse")
                .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
                .ToolBar(bar =>
                    {
                        //bar.Insert().ButtonType(GridButtonType.ImageAndText).Text("Thêm dòng mới");
                        bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).SaveText("Save").CancelText("Cancel");

                    })
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectMaterialInvOnMachineToUse", "Transaction", new { onDate = "", ca1Name = "", ca2Name = "" })
                                                         .Update("UpdateMaterialUse", "Transaction")
                )
                .Columns(columns =>
                    {
                        columns.Bound(f => f.MachineName).Width(100).Title("Machine").ReadOnly(true);
                        columns.Bound(f => f.ProductCode).Width(150).Title("Product").ReadOnly(true);          //SP đang chạy
                        columns.Bound(f => f.MaterialCode).Width(200).Title("Material</br>Code").ReadOnly(true);
                        columns.Bound(f => f.EditQuantity).Width(65).Title("Max</br>Material").ReadOnly(true)                  //NL tối đa
                               .HtmlAttributes(new { style = "text-align:center;border-left: 1px black solid;" });
                        //columns.Bound(f => f.Length).Width(40).Title("Dài").ReadOnly(true);
                        //columns.Bound(f => f.LotNumber).Width(40).Title("Lô").ReadOnly(true); 
                        columns.Bound(f => f.AssignQuantity).Width(65).Title("Assign").ReadOnly(true)
                               .Format("{0:n2}")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .Aggregate(agg => agg.Sum())
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.EditQuantity2).Width(65).Title("Material</br>Inv").ReadOnly(true)                //Tồn NL
                               .Format("{0:n2}")
                               .HtmlAttributes(new { style = "text-align: right;border-left: 1px black solid;" });
                        columns.Bound(f => f.WaitingNumber).Width(65).Title("Approved</br>Pending").ReadOnly(true)                     //Chờ duyệt
                               .Format("{0:n2}")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.EarlyQuantity).Width(65).Title("Actual</br>Inv").ReadOnly(true)                //Tồn TT
                               .Format("{0:n2}")
                               .HtmlAttributes(new { style = "text-align: right;border-left: 1px black solid;" });
                        columns.Bound(f => f.Quantity).Width(65).Title("Shift1")
                               .HeaderHtmlAttributes(new { @class = "edit-column" })
                               .HtmlAttributes(new { style = "text-align: right;border-left: 1px black solid;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" })
                               .ClientTemplate("<span name='Quantity'><#= Quantity == null ? 0.0 : $.telerik.formatString('{0:n2}', Quantity) #></span>")
                               .FooterTemplate("<span id='TotalQuantity'></span>");
                        columns.Bound(f => f.Quantity2).Width(65).Title("Shift2")
                               .HeaderHtmlAttributes(new { @class = "edit-column" })
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" })
                               .ClientTemplate("<span name='Quantity2'><#= Quantity2 == null ? 0.0 : $.telerik.formatString('{0:n2}', Quantity2) #></span>")
                               .FooterTemplate("<span id='TotalQuantity2'></span>");
                        columns.Bound(f => f.LastQuantity).Width(65).Title("Last</br>Inv").ReadOnly(true)
                               .HtmlAttributes(new { style = "text-align: right;border-left: 1px black solid;" })
                               .ClientTemplate("<span class='LastQuantity'></span>");
                       columns.Bound(f => f.Note).Title("Note");
                        //columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(30);
                    })
                .ClientEvents(events => events
                                            .OnDataBinding("grid_onDataBinding")
                                            .OnEdit("grid_onEdit")
                                            .OnSave("grid_onSave")
                                            .OnSubmitChanges("grid_onSubmitChanges")
                                            .OnError("grid_OnError")
                )
                .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
                .KeyboardNavigation(keys => keys.EditOnTab(true))
                .Resizable(resizing => resizing.Columns(true))
                .Scrollable(f => f.Height(510))
                // .Footer(false)
                .Render();
        }
    </div>
<div class="clear"></div><br/>