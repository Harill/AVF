@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "NG SX";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">

        function gridProductionSX1Report_onDataBinding(args) {

            var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();
            var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
            if (monthlyDate === null)
                monthlyDate = "";
            else {
                monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);
            }
            args.data = $.extend(args.data, {
                productName: productCodeNameForMonthly,
                monthlyDate: monthlyDate//$.telerik.formatString('{0:dd/MM/yyyy}', toDate )
            });

        }
        var index = 0;

        function gridProductionSX1Report_onDataBound() {
            //var sum = 0;
            //$("span[name='sumMonthly']").each(function () {
            //    sum = sum + parseInt($(this).text());
            //});
            //$("#sumMonthly").text(sum);

            //for (var i = 7; i <= 18; i++) {
            //    var total = 0;
            //    $("span[name='cot" + i + "']").each(function () {
            //        total = total + parseInt($(this).text());
            //    });
            //    $("#tongcot" + i).text(total);
            //}
        }
    </script>
    <!-- report -->
    <script type="text/javascript">
        function printProductionDefect() {

            var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
            if (monthlyDate === null)
                monthlyDate = "";
            else
                monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);


            $('#result').load('@Url.Action("PrintProductionDefectDailyReport", "Reporting")',
                {
                    monthlyDate: monthlyDate
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

    </script>
}

<div class="title">Báo cáo sản xuất hàng ngày</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">


        <div class="clear"></div>  
        
            <div class="grid_4 prefix_15">
                <button id="btnProductInvTotal" class="t-button" onclick=" return printProductionDefect(); ">
                    <span class='t-icon t-insert'></span>
                    Xuất báo cáo
                </button>
            </div>
        <br />

        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
            <div class="grid_2">
                @Html.LabelFor(f => f.ProductCodeName)
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeNameForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("MonthlyDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="grid_4 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridProductionSX1Report'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
            </div>
           

        </fieldset>
    </div>
    <div class="clear">
        
    </div>

