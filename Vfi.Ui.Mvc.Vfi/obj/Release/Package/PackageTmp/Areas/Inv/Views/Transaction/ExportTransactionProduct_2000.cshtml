<!-- check code-->
<script type="text/javascript">
    function GenCode() {
        $.ajax({
            type: 'post',
            data: {},
            dataType: 'json',
            url: '@Url.Action("GenTransactionParam", "Transaction")',
            timeout: 20000,
            success: function (data) {
                $("#TransactionCode").val(data);
                CheckTransactionCode(data);
            }
        });
    }

    function CheckTransactionCode(value) {
        if (value.length === 0) {
            $('#lookupTransactionCodeExisted').attr('class', 'imgUnAvailable');
            $('#txtTransactionCodeHidden').val(0);
            return false;
        }
        $('#lookupTransactionCodeExisted').attr('class', 't-loading');

        $.ajax({
            type: 'post',
            data: { transactionCode: value },
            dataType: 'json',
            url: '@Url.Action("CheckTransactionCode", "Transaction")',
            timeout: 20000,
            success: function (data) {
                if (data == 1) {
                    $('#lookupTransactionCodeExisted').attr('class', 'imgUnAvailable');
                    $('#txtTransactionCodeHidden').val(0);
                }
                else if (data == 0) {
                    $('#lookupTransactionCodeExisted').attr('class', 'imgAvailable');
                    $('#txtTransactionCodeHidden').val(1);
                }
                else if (data == 2) {
                    $('#lookupTransactionCodeExisted').attr('class', 'imgUnAvailable');
                    $('#txtTransactionCodeHidden').val(0);
                }
            }
        });

        return false;
    }
</script>
