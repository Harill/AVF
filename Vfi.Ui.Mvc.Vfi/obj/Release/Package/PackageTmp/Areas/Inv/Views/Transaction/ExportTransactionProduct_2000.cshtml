@{
    Html.Telerik().Grid<ProductInventoryModel>()
        .Name("gridProductInventory")
        .ToolBar(bar=>bar.Template(
            @<text>
            <div class="grid_7">
                <button class="t-button" id="btnPickupProductId" name="btnPickupProductId" onclick="PickupProductId()">
                    <span class='t-icon t-insert'></span>
                    Chọn các thành phẩm vào lưới
                </button>
            </div>
            <div class="clear"></div>
            </text>
            ))
        .DataKeys(keys => keys.Add(f => f.ProductInventoryId).RouteKey("productInventoryId"))
        .DataBinding(dataBindings=>dataBindings.Ajax()
            .Select("SelectProductInventoryByCustomerAndWarehouse", "Inv",
            new { customerId = 0, warehouseIssue = 0, warehouseReceipt = 0, eoi = MyUtilities.Transaction.EoIEnum.Export }))
        .Columns(columns=>
                     {
                         columns.Bound(f => f.ProductId).Title("Chọn").Width(75)
                             .ClientTemplate("<input type='checkbox' name='chkProductIds' value='<#= ProductId #>' />")
                             .HtmlAttributes(new { style = "text-align:center" });
                         columns.Bound(f => f.ProductCode).Width(250);
                         columns.Bound(f => f.TotalQty);
                         //columns.Bound(f => f.AvailableQty);
                         //columns.Bound(f => f.UnavailableQty);
                         //columns.Bound(f => f.Active).Width(75)
                         //   .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                         //   .HtmlAttributes(new { style = "text-align:center" });
                     })
        .Scrollable(f=>f.Height("auto"))
        .Scrollable(f => f.Height(200))
        .Resizable(f => f.Columns(true))
        .Pageable(f => f.Style(GridPagerStyles.Status))
        .ClientEvents(events => events.OnDataBinding("gridProductInventory_onDataBinding"))
        .Render();
}
