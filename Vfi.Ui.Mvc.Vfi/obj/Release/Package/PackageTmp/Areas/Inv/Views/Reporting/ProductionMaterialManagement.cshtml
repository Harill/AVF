@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "Nguyên liệu sản xuất";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">
        function grid_OnRowDataBound(e) {
            if (e.dataItem.MoreDay === 0)
                e.row.style.backgroundColor = "#F4FA58";
        }

        var startGrid = false;

        function grid_OnDataBinding(args) {
            if (startGrid) {
                index = 1;
                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }
                var materialCode = $("#MaterialCodeName").data("tAutoComplete").value();
                args.data = $.extend(args.data,
                    {
                        materialCode: materialCode,
                        fromDate: fromDate,
                        toDate: toDate
                    }
                );
            }
        }

        var index = 1;
        //function gridDetail_OnDataBinding(args) {
        //    var month = $("#Month").val();
        //    if (month === null)
        //        month = new Date().getMonth() + 1;
        //    var year = $("#Year").val();
        //    if (year === null || year == "")
        //        year = new Date().getYear() + 1;
        //    var monthCount = $("#MonthCount").val();
        //    if (monthCount === null || monthCount == "")
        //        monthCount = 3;
        //    args.data = $.extend(args.data, {
        //        month: month,
        //        year: year,
        //        monthCount: monthCount,
        //    });

        //}
        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("gridPlan");
        }

    </script>
}

<div class="title">Dự kiến đặt hàng nguyên liệu</div>
<div class="clear"></div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1000px;">
    <fieldset>
        <legend>Tiêu chí trích lọc</legend>

        <div class="grid_2">
            Nguyên liệu
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("MaterialCodeName")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedMaterialInventory", "Inv", new { materialTypeId = 0 }))
                    //.HtmlAttributes(new { style = "width: 185px; " })
                    .DropDownHtmlAttributes(new { style = "width: 250px; " })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("FromDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("ToDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
        <div class="grid_3 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2(); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
        </div>
    </fieldset>
</div>
<div class="clear">
</div>

