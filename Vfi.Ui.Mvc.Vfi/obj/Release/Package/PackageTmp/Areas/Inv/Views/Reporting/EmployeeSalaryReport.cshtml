@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Employee Salary Report";
        //All Products Report"
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">

        var fileName = "";
        function upload_OnUpload(e) {
            var files = e.files;
            $.each(files, function () {
                fileName = this.name;
                if (this.extension != ".xls" && this.extension != ".xlsx") {
                    alert("Only excel files can be uploaded");
                    e.preventDefault();
                    return false;
                }
                return false;
            });
            $.extend(e.data);
        }

        function upload_OnSuccess(e) {
            alert(e.response);
        }

        var isParse = false;
        function grid_OnDataBinding(args) {

            var sheetName = $("#SheetName").data("tAutoComplete").value();
            //var upload = $("#attachments");
            //var upload2 = $("#attachments").data("tUpload");
            if (sheetName != "") {
                args.data = $.extend(args.data, {
                    fileName: fileName,
                    sheetName: sheetName,
                });
                isParse = true;
            }

        }
        function grid_onSubmitChanges(args) {
            if (isParse) {
                $.ajax({
                    type: 'post',
                    data: { list: args.data },
                    dataType: 'json',
                    url: '@Url.Action("PrintForecastOrder", "Reporting")',
                timeout: 20000,
                success: function () {
                }
            });
        }

    }
    function grid_OnComplete(args) {
        if (isParse) {
            $.ajax({
                type: 'post',
                data: {},
                dataType: 'json',
                url: '@Url.Action("GetExcelParseStatus", "Reporting")',
                timeout: 20000,
                success: function (data) {
                    var message = "Tổng dòng: " + data[0];
                    message += "\nĐạt: " + data[1];
                    message += "\nLỗi: " + data[2];
                    message += "\nTrùng: " + data[3];
                    message += "\nMô tả: " + data[4];
                    alert(message);
                    isParse = false;
                }
            });
        }
    }
    </script>
}

<div class="title">Employee Salary Report
    @*Báo cáo xuất nhập tồn thành phẩm*@</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
        <fieldset>
        <legend>Test upload</legend>
            <div class="grid_4">
                @{
                    Html.Telerik().Upload().Name("attachments")
                        .Async(async => async
                                            .Save("Save", "Reporting")
                                            .AutoUpload(false))
                        .ClientEvents(events => events
                                                    .OnUpload("upload_OnUpload")
                                                    .OnSuccess("upload_OnSuccess")
                                                    .OnError("grid_OnError"))
                        .Multiple(false)
                        .Render();
                }
            </div>
            <div class="grid_2_5"> Sheet's Name </div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("SheetName")
                    .HtmlAttributes(new {style = "width: 100px"})
                    .Render();
            }
            <br />(Ex: Sheet1 or Sheet2)
        </div>
            <div class="grid_8">
             <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridTaxInvoiceDetail'); ">
                <span class='t-icon t-insert'></span>
                Print Data
            </button>
        </div>
    <div class="clear"></div>

    </fieldset>
    </div>
    <div class="clear">
    </div>

