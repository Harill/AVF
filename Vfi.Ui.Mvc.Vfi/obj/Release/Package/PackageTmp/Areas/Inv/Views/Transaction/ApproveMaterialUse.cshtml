@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "Material-Using Forms Approve";
    //Duyệt sử dụng nguyên liệu
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
<!-- approve stockorder -->
<script type="text/javascript">
    function Approve() {
        $("#btnApprove").attr('disabled', 'disabled');
       
        var $checkedRecords = $("input[name='chkIds']:checked");

        if ($checkedRecords.length < 1) {
            alert("Vui lọn chọn ít nhất 1 phiếu lệnh");
            return;
        }
        $.post('@Url.Action("ApproveMaterialUseById", "Transaction")',
            {
                //checkedRecords: $checkedRecords.map(function () { return value; })
                checkedRecords: $checkedRecords.eq(0).val()
            },
            function (data) {
                if (data === "okie") {
                    RefreshGrid("gridMaterialUse");
                }
                else
                    alert(data);
            });
        $("#btnApprove").removeAttr('disabled');
    }
</script>
}

<div class="title">Material-Using Forms Approve
    @*Duyệt phiếu sử dụng nguyên liệu*@</div>

<div class="t-info-sha" style="padding-left: 15px; width:250px; color: Maroon;">Material-Using Forms Sheet</div>
<div class="cover-div">
@{
    Html.Telerik().Grid<MaterialUseInShiftModel>()
        .Name("gridMaterialUse")
        .DataKeys(keys => keys.Add(f => f.UseId).RouteKey("useId"))
        .ToolBar(bar => bar.Template(
            @<text>
                 <div class="grid_7">
                     <button class="t-button" id="btnApprove" name="btnApprove" onclick=" Approve() ">
                         <span class='t-icon t-insert'></span>
                        Approved
                     </button>
                 </div>
                 <div class="clear"></div>
             </text>
                            ))
        .DataBinding(dataBindings => dataBindings.Ajax()
                                                 .Select("SelectMaterialUseForm", "Transaction",
                                                         new{
                                                                 status = (byte)MyUtilities.Transaction.Status.Open,
                                                                 formCode = "",
                                                                 type = 0,
                                                                 fromDate = "",
                                                                 toDate = ""
                                                             })
                                                 .Delete("CancelMaterialUseForm", "Transaction")
        )
        .Columns(columns =>
            {
                columns.Bound(f => f.UseId).Title("Select").Width(75)
                       .ClientTemplate("<input type='radio' name='chkIds' value='<#= UseId #>' />")
                       .HtmlAttributes(new {style = "text-align:center"});
                columns.Bound(f => f.UsedCode).Title("Code");
                columns.Bound(f => f.UsedDate).Title("Date")
                       .ClientTemplate("<strong><#= UsedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', UsedDate) #></strong>");
                columns.Bound(f => f.TypeName).Title("Type");
                columns.Bound(f => f.StatusName).Title("Status");
                columns.Bound(f => f.ModifiedUser).Title("M-User");
                columns.Bound(f => f.ModifiedDate).Title("M-Date")
                       .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ModifiedDate) #>");
                columns.Bound(f => f.UseId).Title("Print").Width(75)
                       .ClientTemplate("<input type='button' id='<#= UseId #>' value='In' class='t-button' />")
                       .HtmlAttributes(new {style = "text-align:center"});
                columns.Command(c => c.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(50);
            })
        .DetailView(details => details.ClientTemplate(
            Html.Telerik().TabStrip()
                .Name("TabStrip_<#= UseId #>")
                .SelectedIndex(0)
                .Items(items =>
                       items.Add().Text("Detail Information").Content(
                           Html.Telerik().Grid<MaterialUseInShiftDetailModel>()
                               .Name("gridMaterialUseDetail_<#= UseId #>")
                               .DataKeys(key => key.Add(f => f.DetailId).RouteKey("detailId"))
                               .DataBinding(dataDindings => dataDindings.Ajax()
                                                                        .Select("SelectMaterialUseDetailByFormId", "Transaction", new {formId = "<#= UseId #>"})
                                                                        .Update("UpdateMaterialUseDetail", "Transaction", new {formId = "<#= UseId #>"})
                               )

                               .Columns(columns =>
                                   {
                                       columns.Command(command =>
                                                       command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)
                                                              .UpdateText("Edit").CancelText("Cancel").Text("Update")
                                           ).Width(30).Title("").HtmlAttributes(new {style = "text-align:center"});
                                       columns.Bound(f => f.MachineName).Width(40).Title("Machine").ReadOnly(true);
                                       columns.Bound(f => f.ProductCode).Width(80).Title("Product</br>Production").ReadOnly(true);         // Sp Dang chay.
                                       columns.Bound(f => f.MaterialCode).Width(250).Title("Material Code").ReadOnly(true);
                                       columns.Bound(f => f.LotNumber).Width(30).Title("Lot").ReadOnly(true);
                                       columns.Bound(f => f.EarlyQuantity).Width(75).Title("Material</br>Inv").ReadOnly(true)
                                              .HtmlAttributes(new {style = "text-align: right;"})
                                              .ClientTemplate("<#= EarlyQuantity == null ? 0 :$.telerik.formatString('{0:n2}', EarlyQuantity) #>");
                                       columns.Bound(f => f.AssignQuantity).Width(50).Title("Assign</br>Date").ReadOnly(true)
                                              .HtmlAttributes(new {style = "text-align: right;"})
                                              .ClientTemplate("<#= AssignQuantity == null ? 0 :$.telerik.formatString('{0:n2}', AssignQuantity) #>")
                                              .Aggregate(agg => agg.Sum())
                                              .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>")
                                              .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>");
                                       columns.Bound(f => f.EditQuantity).Width(50).Title("Shift1")
                                              .HtmlAttributes(new {style = "text-align: right;"})
                                              .FooterHtmlAttributes(new {style = "text-align: right;"})
                                              .ClientTemplate("<span name='EditQuantity'><#= EditQuantity == null ? 0.0 : $.telerik.formatString('{0:n2}', EditQuantity) #></span>")
                                              .Aggregate(agg => agg.Sum())
                                              .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>")
                                              .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>");
                                       columns.Bound(f => f.EditQuantity2).Width(50).Title("Shift2")
                                              .HtmlAttributes(new {style = "text-align: right;"})
                                              .FooterHtmlAttributes(new {style = "text-align: right;"})
                                              .ClientTemplate("<span name='EditQuantity2'><#= EditQuantity2 == null ? 0.0 : $.telerik.formatString('{0:n2}', EditQuantity2) #></span>")
                                              .Aggregate(agg => agg.Sum())
                                              .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>")
                                              .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>");
                                       columns.Bound(f => f.LastQuantity).Width(50).Title("Last</br>Inv").ReadOnly(true)
                                              .HtmlAttributes(new {style = "text-align: right;"})
                                              .ClientTemplate("<span name='LastQuantity'><#= LastQuantity == null ? 0.0 : $.telerik.formatString('{0:n2}', LastQuantity) #></span>")
                                              .FooterTemplate("<span id='TotalLastQuantity'></span>");
                                       columns.Bound(f => f.IsDestroy).Width(50).Title("Inv</br>Cancel")            // Huy ton
                                              .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsDestroy' <#=IsDestroy? checked='checked' : '' #> />")
                                              .HtmlAttributes(new { style = "text-align:center" });
                                       //columns.Bound(f => f.BoxNumber).Width(50).Title("Số hộp").ReadOnly(true)
                                       //       .HtmlAttributes(new {style = "text-align: right;"})
                                       //       .ClientTemplate("<span name='BoxNumber'><#= BoxNumber == null ? 0 : $.telerik.formatString('{0:n0}', BoxNumber) #></span>")
                                       //       .FooterTemplate("<span id='TotalBoxNumber'></span>");
                                       columns.Bound(f => f.Note).Title("Note");
                                   })
                               .ClientEvents(events => events.OnError("grid_OnError"))
                               .ToHtmlString()
                           )
                )
                .ToHtmlString()
                                   ))
        .Selectable()
        .ClientEvents(events => events.OnRowSelect("grid_OnRowSelect")
                                      .OnError("grid_OnError"))
        //.Pageable(f=>f.PageSize(5))
        .Render();
}
</div>