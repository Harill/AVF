@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Models.Production
@model ProductInventoryModel
@{
    ViewBag.Title = "Workshop1 Production1";             
    //Xưởng 1 SX 1
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{

    <!-- grid Monthly -->
    <script type="text/javascript">
        var startGrid = false;
        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("grid");
        }

        var index = 0;

        function grid_OnDataBinding(args) {
            index = 0;
            if (startGrid) {

                var productCodeNameForMonthly = $("#ProductCode").data("tAutoComplete").value();

                var customerId = $("#Customer").data('tComboBox').value();
                if (customerId == 0)
                    customerId = 0;
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                //var endYearForeacast = $("#endYearForeacast").data("tDatePicker").value();
                //if (endYearForeacast === null)
                //    endYearForeacast = "";
                //else
                //    endYearForeacast = $.telerik.formatString('{0:dd/MM/yyyy}', endYearForeacast);
                var invDate = $("#invDate").data("tDatePicker").value();
                if (invDate === null)
                    invDate = "";
                else
                    invDate = $.telerik.formatString('{0:dd/MM/yyyy}', invDate);
                var fromProductionDate = $("#fromProductionDate").data("tDatePicker").value();
                if (fromProductionDate === null)
                    fromProductionDate = "";
                else
                    fromProductionDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromProductionDate);
                //var toProductionDate = $("#toProductionDate").data("tDatePicker").value();
                //if (toProductionDate === null)
                //    toProductionDate = "";
                //else
                //    toProductionDate = $.telerik.formatString('{0:dd/MM/yyyy}', toProductionDate);

                var isGetAll = $("input[name='chGetAll']").attr('checked');
                args.data = $.extend(args.data, {
                    customerId: customerId,
                    productCode: productCodeNameForMonthly,
                    fromPoDate: fromDate,
                    toPoDate: toDate,
                    endYearForeacast: "",
                    invDate: invDate,
                    fromProductionDate: fromProductionDate,
                    toProductionDate: "",
                    isGetAll: isGetAll,
                });
            }
        }

        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            var realProductions = e.dataItem.RealProductions;
            $("#Day1")[0].parentNode.innerHTML = ("<span id='Day1'>Ngày 1 (KH)</br>"
                                                        + realProductions[0].DayOfWeek + "</br>"
                                                        + realProductions[0].ProductionDate.format("dd/MM") + "</span>");
            $("#Day2")[0].parentNode.innerHTML = ("<span id='Day2'>Ngày 2 (KH)</br>"
                                                        + realProductions[1].DayOfWeek + "</br>"
                                                        + realProductions[1].ProductionDate.format("dd/MM") + "</span>");
            $("#Day3")[0].parentNode.innerHTML = ("<span id='Day3'>Ngày 3 (KH)</br>"
                                                        + realProductions[2].DayOfWeek + "</br>"
                                                        + realProductions[2].ProductionDate.format("dd/MM") + "</span>");
            $("#Day4")[0].parentNode.innerHTML = ("<span id='Day4'>Ngày 4 (KH)</br>"
                                                        + realProductions[3].DayOfWeek + "</br>"
                                                        + realProductions[3].ProductionDate.format("dd/MM") + "</span>");
            $("#Day5")[0].parentNode.innerHTML = ("<span id='Day5'>Ngày 5 (KH)</br>"
                                                        + realProductions[4].DayOfWeek + "</br>"
                                                        + realProductions[4].ProductionDate.format("dd/MM") + "</span>");
            $("#Day6")[0].parentNode.innerHTML = ("<span id='Day6'>Ngày 6 (KH)</br>"
                                                        + realProductions[5].DayOfWeek + "</br>"
                                                        + realProductions[5].ProductionDate.format("dd/MM") + "</span>");
            $("#Day7")[0].parentNode.innerHTML = ("<span id='Day7'>Ngày 7 (KH)</br>"
                                                        + realProductions[6].DayOfWeek + "</br>"
                                                        + realProductions[6].ProductionDate.format("dd/MM") + "</span>");
        }
    </script>
}

