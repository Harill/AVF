@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "Transaction Product ByStockOrder";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
<script type="text/javascript">
    $(function () {
        $("#pnlStockOrderInfo").hide();
    });
</script>

<!-- grid stockorder -->
<script type="text/javascript">

    function gridStockOrder_onDataBinding(args) {
        var txtStockOrderCodeSearch = $("#txtStockOrderCodeSearch").val();

        //        if(txtStockOrderCodeSearch === "")
        //            args.preventDefault();

        args.data = $.extend(args.data, {
            status: Number("@((byte)StockOrderStatusEnumModel.Approved)"),
            stockOrderCode: txtStockOrderCodeSearch,
            mop: false
        });
    }
</script>

<!-- Choice TransactionMaterial By StockOrder -->
<script type="text/javascript">
    function ChoiceTransactionProductByStockOrder() {
        var $checkedRecords = $("input[name='chkStockOrderIds']:checked");

        if ($checkedRecords.length < 1) {
            alert("Vui lọn chọn ít nhất 1 nguyên liệu");
            return;
        }

        //$.post('@Url.Action("ApproveStockOrderMaterial", "StockOrder")', $.param($checkedRecords, true));
        $.post('@Url.Action("ChoiceTransactionByStockOrder", "Transaction")',
            {
                checkedRecords: $checkedRecords.map(function () { return value; })
            },
            function (data) {
                if (data === "okie") {
                }
                else
                    alert(data);
            });
    }
</script>

<!-- PickupStockOrderInfo -->
<script type="text/javascript">
    function PickupStockOrderInfo() {
        //var gridStockOrder = $("#gridStockOrder").data("tGrid");

    }
</script>

}

<div class="title">Phiếu lệnh</div>

<div class="t-info-sha" style="padding-left: 15px; width:250px; color: Maroon;">Phiếu lệnh</div>
<div class="cover-div">
@{
    Html.Telerik().Grid<StockOrderModel>()
        .Name("gridStockOrder")
        .DataKeys(keys => keys.Add(f => f.StockOrderId).RouteKey("stockOrderId"))
        .ToolBar(bar => bar.Template(
            @<text>
            <div class="grid_7">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("txtStockOrderCodeSearch")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedStockOrderCode", "StockOrder", 
                            new { mop = false, status = (byte)StockOrderStatusEnumModel.Approved }))// mop = material or product; 
                        .HtmlAttributes(new { style = "width: 185px; " })
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .ClientEvents(events => events.OnChange("txtStockOrderCodeSearch_onChange"))
                        .Render();
                }
            </div>
            <div class="grid_7">
                <button class="t-button" id="btnChoiceTransactionProductByStockOrder" name="btnChoiceTransactionProductByStockOrder" onclick="ChoiceTransactionProductByStockOrder()">
                    <span class='t-icon t-insert'></span>
                    Chọn các lệnh
                </button>
            </div>
            <div class="clear"></div>
            </text>
            ))
        .DataBinding(dataBindings=>dataBindings.Ajax()
            .Select("SelectStockOrderByStatus", "StockOrder",
            new { status = (byte)StockOrderStatusEnumModel.Approved, stockOrderCode = "", mop = false })
        )
        .Columns(columns=>
                     {
                         columns.Bound(f => f.StockOrderId).Title("Chọn").Width(75)
                             .ClientTemplate("<input type='checkbox' name='chkStockOrderIds' value='<#= StockOrderId #>' />")
                             .HtmlAttributes(new { style = "text-align:center" });
                         columns.Bound(f => f.StockOrderCode);
                         columns.Bound(f => f.WarehouseIssueName);
                         columns.Bound(f => f.WarehouseReceiptName);
                         //columns.Bound(f => f.EoI).ClientTemplate("<#= EoI ? 'Nhập' : 'Xuất' #>");
                         columns.Bound(f => f.EoIName);
                         columns.Bound(f => f.StatusName);
                         columns.Bound(f => f.CreatedUser);
                         columns.Bound(f => f.CreatedDate)
                             .ClientTemplate("<#= CreatedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', CreatedDate) #>");
                         columns.Bound(f => f.Active).Width(75)
                            .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                            .HtmlAttributes(new { style = "text-align:center" });

                         columns.Bound(f => f.StockOrderId).Title("In").Width(75)
                             .ClientTemplate("<input type='button' id='<#= StockOrderId #>' value='<#= StockOrderId #>' />")
                             .HtmlAttributes(new { style = "text-align:center" });
                     })
        .DetailView(details => details.ClientTemplate(

            Html.Telerik().TabStrip()
            .Name("TabStrip_<#= StockOrderId #>")
            .SelectedIndex(0)
            .Items(items =>

                           items.Add().Text("Thông tin chi tiết").Content(

                               Html.Telerik().Grid<StockOrderDetailModel>()
                                    .Name("gridStockOrderDetail_<#= StockOrderId #>")
                                    .DataBinding(dataDindings => dataDindings.Ajax()
                                                    .Select("SelectStockOrderDetailByStockOrderId", "StockOrder",
                                                    new { stockOrderId = "<#= StockOrderId #>" }))
                                    .Columns(columns =>
                                    {
                                        columns.Bound(f => f.ProductCodeName);
                                        columns.Bound(f => f.Quantity).Width(98)
                                            .HtmlAttributes(new { style = "text-align: right;" })
                                            .ClientTemplate("<#= Quantity == null ? 0 : $.telerik.formatString('{0:n}', Quantity) #>");
                                        columns.Bound(f => f.UnitMeasure);
                                        //columns.Bound(f => f.UnitPrice).Width(125)
                                        //    .HtmlAttributes(new { style = "text-align: right;" })
                                        //    .ClientTemplate("<#= UnitPrice == null ? 0 : $.telerik.formatString('{0:n}', UnitPrice) #>");
                                        //columns.Bound(f => f.LineTotal).Width(175)
                                        //    .HtmlAttributes(new { style = "text-align: right;" })
                                        //    .FooterHtmlAttributes(new { style = "text-align: right;" })
                                        //    .Aggregate(f => f.Sum())
                                        //    .ClientFooterTemplate("<strong>Tổng tiền: </strong><label style='color:maroon'><#= Sum == null ? 0 : $.telerik.formatString('{0:n}', Sum) #></label>")
                                        //    .ClientTemplate("<#= LineTotal == null ? 0 : $.telerik.formatString('{0:n}', LineTotal) #>");
                                    })
                                    .ToHtmlString()

                                )
                       )
            .ToHtmlString()
        ))
        .Selectable()
        .ClientEvents(events => events
            .OnRowSelect("grid_OnRowSelect")
            .OnDataBinding("gridStockOrder_onDataBinding")
        )
        .Pageable(f=>f.PageSize(5))
        .Render();
}
</div>
<div class="clear"></div>
<div class="grid_7">
    
</div>
<br />

