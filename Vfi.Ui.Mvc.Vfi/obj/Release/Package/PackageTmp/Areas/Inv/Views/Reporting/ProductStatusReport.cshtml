@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Product Status";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {
            if (startGrid) {
                var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;

                args.data = $.extend(args.data, {
                    customerId: customerId,
                    productCode: productCodeNameForMonthly
                });
                index = 0;
            }
        }

        var index = 0;

        var startGrid = false;
        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("grid");
        }
    </script>
}

<div class="title">Product Status Report </div>
<div class="clear"></div>
<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1000px;">
        <fieldset>
            <legend> Filters</legend>
            <div class="grid_2">
                @Html.Label("Customer")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("CustomerForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 275px" })
                        //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_2_5">
                @Html.Label("Product Code")
@*                @Html.LabelFor(f => f.ProductCodeName)*@
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeNameForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                        .DropDownHtmlAttributes(new { style = "width: 200px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_3 prefix_1">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2(); ">
                    <span class='t-icon t-insert'></span>
                    Find
                </button>
            </div>
        </fieldset>
    </div>
    <div class="clear">
    </div>

    <div class="cover-div">
        @{
            Html.Telerik().Grid<ProductStatusModel>()
                .Name("grid")
                .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectProductStatusReport", "Reporting",
                                                                 new {
                                                                     customerId = -1,
                                                                     productCode = ""
                                                                 })
                )
                .Columns(columns => {
                        columns.Bound(f => f.ProductId).Width(40)
                               .ClientTemplate("<#= ++index #>")
                               .HeaderTemplate("<strong>No.</strong>");
                        columns.Bound(f => f.CustomerCode).Width(80)
                               .HeaderTemplate("<strong>Customer</br>Code</strong>")
                               .HtmlAttributes(new { style = "text-align: center;" });
                        columns.Bound(f => f.ProductCode).Width(140)
                               .HeaderTemplate("<strong>Product</br>Code</strong>")
                               .HtmlAttributes(new { style = "text-align: center;" })
                               .Aggregate(agg => agg.Count())
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                               .FooterHtmlAttributes(new { style = "text-align: center;" });
                        columns.Bound(f => f.UnitPrice).Width(120)
                               .HeaderTemplate("<strong>Product</br>Price</strong>")
                               .Format("{0:n0}")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.MaterialPrice).Width(120)
                               .HeaderTemplate("<strong>Material</br>Price</strong>")
                               .Format("{0:n0}")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.MaterialUnitWeight).Width(120)
                               .HeaderTemplate("<strong>Workpiece</br>Weight</strong>")
                               .Format("{0:n3}")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.MaterialCode).Width(120)
                               .HeaderTemplate("<strong>Material</strong>")
                               .HtmlAttributes(new { style = "text-align: center;" });
                        // so lieu
                        columns.Bound(f => f.TotalInv).Title("Total</br>Inv").Width(80)
                               .Aggregate(agg => agg.Sum())
                              .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.FinishInv).Title("Finished</br>Inv").Width(80)
                               .Aggregate(agg => agg.Sum())
                              .Format("{0:n0}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });

                        columns.Bound(f => f.LastProductionDate)
                            .HeaderTemplate("Last-Production</br>Date ").Width(130)
                               .ClientTemplate("<#= LastProductionDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', LastProductionDate) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.LastExportDate)
                            .HeaderTemplate("Last Delivery</br>Date").Width(100)
                               .ClientTemplate("<#= LastExportDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', LastExportDate) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.LastFinishInvDate)
                            .HeaderTemplate("Last-Finished<br/>Rotate Date").Width(100)
                               .ClientTemplate("<#= LastFinishInvDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', LastFinishInvDate) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.LastRotateDate)
                            .HeaderTemplate("Last-Warehouse</br>Rotate Date").Width(130)
                               .ClientTemplate("<#= LastRotateDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', LastRotateDate) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.ModifiedDate)
                            .HeaderTemplate("Last</br>M-Date").Width(100)
                               .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ModifiedDate) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });

                    })
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnError("grid_OnError"))
                .Scrollable(f => f.Height(510))
                //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .Groupable()
                .Render();
        }
        @*@{ Html.Telerik().ScriptRegistrar().OnDocumentReady("applyFrozenColumns();"); }*@
    </div>
</div>

<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
)
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

<style type="text/css">
    #windowReport {
        /*
            float: right;
            Position: relative;
            */
        min-height: 580px;
        top: 15%;
    }

    #result {
        height: 520px;
        overflow: hidden;
    }

    #ReportBody {
        padding-bottom: 25px;
        margin-bottom: 25px;
    }

    .tb-witdh td {
        width: 55px;
    }
</style>
