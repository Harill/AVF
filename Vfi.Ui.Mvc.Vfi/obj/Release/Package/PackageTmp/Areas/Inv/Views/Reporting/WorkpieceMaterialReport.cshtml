@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Báo cáo sản xuất hàng ngày";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {

            if (startGrid && !onLoading) {
                var materialType = $("#MaterialType").data('tComboBox').value();
                if (materialType === "")
                    materialType = 0;
                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);

                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                args.data = $.extend(args.data, {
                    materialType: materialType,
                    fromDate: fromDate,
                    toDate: toDate,
                });
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }
        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
    </script>
    <!-- report -->
    <script type="text/javascript">
        function printWorkpieceMaterial() {
            
            if (!onLoading) {
                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);

                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                $('#result').load('@Url.Action("PrintWorkpieceMaterial", "Reporting")',
                    {
                        fromDate: fromDate,
                        toDate: toDate,
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

    </script>
}

    <div class="title">Báo cáo phôi</div>
    <div class="clear"></div>
    <br />

    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">


        <div class="clear"></div>

        <div class="grid_4 prefix_15">
            <button id="btnProductInvTotal" class="t-button" onclick=" return printWorkpieceMaterial(); ">
                <span class='t-icon t-insert'></span>
                Xuất báo cáo
            </button>
        </div>
        <br />
    <div class="clear"></div>

        <fieldset>
            <legend>Tiêu chí trích lọc</legend>

            <div class="grid_3">Loại nguyên liệu</div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("MaterialType")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxAllMaterialType", "Material", new { area = "" }))
                        .HtmlAttributes(new { style = "width: 100%" })
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("FromDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddDays(-1))
                        .Render();
                }
            </div> 
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ToDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('gridWorkpieceMaterialModel'); ">
                    <span class='t-icon t-insert'></span>
                    Làm mới
                </button>
            </div>

        </fieldset>
    </div>
    <div class="clear">
    </div>

    <div class="cover-div">
        @{
            Html.Telerik().Grid<WorkpieceMaterialPeriodModel>()
                .Name("gridWorkpieceMaterialModel")
                .DataKeys(keys => keys.Add(f => f.MaterialTypeName).RouteKey("materialTypeName"))
                .DataBinding(dataBindings => dataBindings.Ajax()
