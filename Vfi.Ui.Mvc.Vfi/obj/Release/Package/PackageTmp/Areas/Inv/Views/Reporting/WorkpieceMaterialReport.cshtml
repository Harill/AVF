                        columns.Bound(f => f.MaterialTypeName).Width(100).Title("Nguyên liệu");
                        columns.Bound(f => f.TypeName).Width(100).Title("Loại")
                               .HtmlAttributes(new { style = "border-right:solid 1px black;" });
                        columns.Bound(f => f.AvgMaterialUnitPrice).Width(100).Title("Giá")
                               .HtmlAttributes(new { style = "border-right:solid 1px black;" });
                        columns.Bound(f => f.EarlyQuantity).Width(100)
                                .HeaderTemplate("Tồn đầu</br>(KG)")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n2}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        //columns.Bound(f => f.EarlyPrice).Width(100)
                        //        .HeaderTemplate("Giá trị")
                        //       .Aggregate(agg => agg.Sum())
                        //       .Format("{0:n0}")
                        //       .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        //       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        //       .HtmlAttributes(new { style = "text-align: right;border-right:solid 1px black;" })
                        //       .FooterHtmlAttributes(new { style = "text-align: right;" });

                        columns.Bound(f => f.Import).Width(100).Title("Nhập SX")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n2}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.ImportVirtual).Width(100).Title("Nhập thêm")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n2}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.TotalImport).Width(100).Title("Tổng nhập")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n2}")
                               .ClientGroupFooterTemplate("<strong><#= $.telerik.formatString('{0:n2}', Sum) #></strong>")
                               .ClientFooterTemplate("<strong><#= $.telerik.formatString('{0:n2}', Sum) #></strong>")
                               .HtmlAttributes(new { style = "text-align: right;border-right:solid 1px black;font-weight:bold;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;font-weight:bold;" });
                        columns.Bound(f => f.Export).Width(100).Title("Xuất")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n2}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.Destroy).Width(100).Title("Xuất hủy")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n2}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.Process).Width(100).Title("Xuất GC")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n2}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.TotalExport).Width(100).Title("Xuất hủy")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n2}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;border-right:solid 1px black;font-weight:bold;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;font-weight:bold;" });
                        columns.Bound(f => f.LastQuantity).Width(100).Title("Tồn cuối")
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n2}")
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.LastQuantityCheck).Width(100).Title("Tồn cuối")
                               .Format("{0:n2}")
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                    })
                .DetailView(details => details.ClientTemplate(
                    Html.Telerik().TabStrip()
                        .Name("TabStrip_<#= IdentityCode #>_<#= Type #>")
                        .SelectedIndex(0)
                        .Items(items =>
                               items.Add().Text("Chi tiết nhập SX").Content(
                                   Html.Telerik().Grid<WorkpieceImportExportModel>()
                                       .Name("gridProductionWorkpieceDetail_<#= IdentityCode #>_<#= Type #>")
                                       .DataBinding(dataDindings => dataDindings.Ajax()
                                                                                .Select("SelectProductionImportWorkpiece", "Reporting",
                                                                                        new { identityCode = "<#= IdentityCode #>", type = "<#= Type #>", fromDate = "<#= FromDate #>", toDate = "<#= ToDate #>" }))
                                       .Columns(columns => {
                                           columns.Bound(f => f.ImportExport).Width(200).Title("Loại");
                                           columns.Bound(f => f.Date).Width(50).Title("Ngày")
                                               .Format("{0:dd/MM/yyyy}");
                                           columns.Bound(f => f.Weight).Width(50).Title("TL (Kg)")
                                                  .Format("{0:n2}")
                                                  .HtmlAttributes(new { style = "text-align: right;" });
                                           columns.Bound(f => f.TransactionCode).Width(50).Title("Mã giao dịch");
                                           columns.Bound(f => f.WarehouseName).Width(50).Title("Nhận từ kho");
                                       })
                .ClientEvents(events => events
                                            .OnError("grid_OnError"))
                                       .ToHtmlString()
                                   )
                        )
                        .ToHtmlString()
                                           ))
                .Scrollable(f => f.Height("Auto"))
                //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Groupable(group => group.Groups(g => g.Add(model => model.MaterialTypeName)))
                .Filterable()
                .Sortable()
                .Selectable()
                .ClientEvents(events => events
                                            .OnDataBound("grid_OnDataBound")
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnRowSelect("grid_OnRowSelect")
                                            .OnError("grid_OnError"))
                .Groupable()
                .Render();
        }
        @*@{ Html.Telerik().ScriptRegistrar().OnDocumentReady("applyFrozenColumns();"); }*@
    </div>

    <!-- windown -->
    @{
        Html.Telerik().Window()
            .Name("windowReport")
            .Modal(true)
