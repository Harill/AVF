@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "Quản lý kho";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title">Quản lý thông tin các kho</div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<WarehouseModel>()
            .Name("gridWarehouse")
            .DataKeys(key => key.Add(f => f.WarehouseId).RouteKey("warehouseId"))
            .ToolBar(
                toolbar =>
                toolbar.Insert().ButtonType(GridButtonType.ImageAndText).Text("Thêm kho mới").ImageHtmlAttributes(new { style = "margin-left:0" }))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectWarehouse", "Warehouse")
                                          .Insert("InsertWarehouse", "Warehouse")
                                          .Update("UpdateWarehouse", "Warehouse"))
            .Columns(columns => {
                columns.Command(command =>
                                command.Edit().ButtonType(GridButtonType.Image)
                    ).Width(98).Title("").HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.WarehouseName);
                columns.Bound(f => f.ShortName).Title("Tên ngắn");
                columns.Bound(f => f.Idx);
                columns.Bound(f => f.Active).Width(45)
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.IsMainProcess).Width(45).Title("Công đoạn</br>chính")
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsMainProcess' <#=IsMainProcess? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.IsProduction2).Width(45).Title("Công đoạn</br>SX2")
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsProduction2' <#=IsProduction2? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.IsProduction2Process).Width(45).Title("Công đoạn</br>SX2 (xử lý)")
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsProduction2Process' <#=IsProduction2Process? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.IsHeatTreatment).Width(45).Title("Công đoạn</br>nhiệt luyện")
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsHeatTreatment' <#=IsHeatTreatment? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.IsPolish).Width(45).Title("Công đoạn</br>rung bóng")
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsPolish' <#=IsPolish? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.IsQC).Width(45).Title("Công đoạn</br>QC")
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsQC' <#=IsQC? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.IsReprocessing).Width(45).Title("Công đoạn</br>xử lý lại")
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsReprocessing' <#=IsReprocessing? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.CanInternal).Width(45).Title("Xuất nhập</br>nội bộ")
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='CanInternal' <#=CanInternal? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.CanPurchase).Width(45).Title("Nhập</br>mua hàng")
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='CanPurchase' <#=CanPurchase? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.ModifiedDate).Width(45).ReadOnly(true)
                    .Format("{0:dd/MM/yyyy HH:mm}");
                columns.Bound(f => f.ModifiedUser).Width(45).ReadOnly(true);
            })
            .ClientEvents(e => e.OnError("grid_OnError"))
            .Editable(editing => editing.Mode(GridEditMode.InLine))
            //.Pageable(page => page.PageSize(10))
            .Sortable()
            .Render();
    }
</div>
