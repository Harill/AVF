<div class="title">Nhập sản phẩm</div>

<div class="t-info-sha" style="padding-left: 15px;padding-right: 15px; width:920px;">
    
    <div class="grid_3">Khách hàng:</div>
    <div class="grid_7">
        @{
            Html.Telerik().ComboBox()
                .Name("Customer")
                .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                .HtmlAttributes(new { style = "width: 250px" })
                .DropDownHtmlAttributes(new { style = "width: 325px;" })
                .ClientEvents(events => events.OnChange("customer_onChange"))
                .AutoFill(true)
                .Filterable(f=>f.FilterMode(AutoCompleteFilterMode.Contains))
                .Render();
        }
    </div>
    <div class="grid_2">Sản phẩm:</div>
    <div class="grid_4">
        @{
            Html.Telerik().AutoComplete()
                .Name("ProductCode")
                .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                .HtmlAttributes(new { style = "width: 200px; " })
                .DropDownHtmlAttributes(new { style = "width: 250px; " })
                .Encode(false)
                .AutoFill(true)
                .HighlightFirstMatch(true)
                .ClientEvents(events=>events
                    .OnChange("autoComplete_onChange")
                )
                .Render();
        }
    </div>
    <div class="clear"></div><br/>

    <fieldset>
        <legend>Thông tin phiếu nhập</legend>
        <div class="grid_3">@Html.LabelFor(f=>f.WarehouseReceiptName)</div>
        <div class="grid_4">
            @{
                Html.Telerik().DropDownList()
                    .Name("WarehouseReceiptName")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxImportWarehouse", "Warehouse"))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px; height: 250px;" })
                    .ClientEvents(events => events
                        //.OnChange("warehouseReceiptName_onChange")
                       // .OnLoad("warehouseReceiptName_onLoad")
                       // .OnDataBound("warehouseReceiptName_onDataBound")
                        .OnClose("warehouseReceiptName_OnClose")
                        )
                    //.Enable(false)
                    .Render();
            }
        </div>
         <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("MonthlyDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
    </fieldset>
</div>
<div class="clear"></div>
<div class="cover-div">
@{
    Html.Telerik().Grid<ProductInventoryModel>()
        .Name("gridProductInventory")
        .ToolBar(bar=>bar.Template(
            @<text>
            <div class="grid_7">
                <button class="t-button" id="btnPickupProductId" name="btnPickupProductId" onclick="PickupProductId()">
                    <span class='t-icon t-insert'></span>
                    Chọn các sản phẩm vào lưới
                </button>
            </div>
            <div class="clear"></div>
            </text>
            ))
        .DataKeys(keys => keys.Add(f => f.ProductInventoryId).RouteKey("productInventoryId"))
        .DataBinding(dataBindings=>dataBindings.Ajax()
            .Select("SelectProductInventoryByCustomerAndWarehouse", "Inv",
            new { customerId = 0, warehouseId = 0, eoi = MyUtilities.Transaction.EoIEnum.Import, productName = "" }))
        .Columns(columns=>
                     {
                         columns.Bound(f => f.ProductId).Title("Chọn").Width(75)
                             .ClientTemplate("<input type='checkbox' name='chkProductIds' value='<#= ProductId #>' />")
                             .HtmlAttributes(new { style = "text-align:center" });
                         columns.Bound(f => f.ProductCode).Width(250);
                         columns.Bound(f => f.TotalQty).Format("{0:n0}");
                         //columns.Bound(f => f.AvailableQty);
                         //columns.Bound(f => f.UnavailableQty);
                         //columns.Bound(f => f.Active).Width(75)
                         //   .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                         //   .HtmlAttributes(new { style = "text-align:center" });
                     })
        .Scrollable(f=>f.Height("auto"))
        .ClientEvents(events => events.OnDataBinding("gridProductInventory_onDataBinding").OnError("grid_OnError"))
        .Scrollable(f=>f.Height(200))
        .Resizable(f => f.Columns(true))
        //.Pageable(f=>f.Style(GridPagerStyles.Status))
        .Render();
}
</div>
<div class="clear"></div><br/>
<div class="t-info-sha" style="padding-left: 15px; width:250px; color: Maroon;">Chi tiết lệnh nhập sản phẩm</div>
<div class="cover-div">
@{
    Html.Telerik().Grid<ProductInventoryRotateModel>()
        .Name("gridProductInventoryDetail")
        .ToolBar(bar=>bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu tất cả").CancelText("Hủy bỏ"))
        .DataKeys(keys => keys.Add(f => f.ProductInventoryId).RouteKey("productInventoryId"))
        .DataBinding(dataBindings => dataBindings.Ajax()
            .Select("SelectProductInventory", "Inv", new { productIds = "", warehouseId = 0 })
            .Update("UpdateTransactionProductInventory", "Transaction"))
        .Columns(columns =>
        {
            columns.Bound(f => f.CustomerCode).Title("Mã KH").Width(100).ReadOnly(true);
            columns.Bound(f => f.ProductCode).Width(200).ReadOnly(true);
            columns.Bound(f => f.TotalQty).Format("{0:n0}")
                //.ClientTemplate("<span name='TotalQty'><#= TotalQty == null ? 0 : $.telerik.formatString('{0:n0}', TotalQty) #></span>")
                //   .FooterTemplate("<span id='TotalTotalQty'></span>")
                   .ReadOnly(true);
            //columns.Bound(f => f.AvailableQty).Width(125).ReadOnly(true);
            //columns.Bound(f => f.UnavailableQty).Width(125).ReadOnly(true);
            columns.Bound(f => f.Quantity).Format("{0:n0}")
                   //.ClientTemplate("<span name='Quantity'><#= Quantity == null ? 0 : $.telerik.formatString('{0:n0}', Quantity) #></span>")
                   //.FooterTemplate("<span id='TotalQuantity'></span>")
                   ;
            //columns.Bound(f => f.UnitMeasure).Width(150);
            columns.Bound(f => f.Note).Title("Ghi chú").Width(250);
            
            columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(98).Title("");
        })
        .ClientEvents(events => events
            .OnSave("gridProductInventoryDetail_onSave")
            .OnSubmitChanges("gridProductInventoryDetail_onSubmitChanges")
            .OnError("grid_OnError")
            .OnDataBound("gridProductInventoryDetail_onDataBound")
            .OnEdit("grid_OnEdit")
            
        )
        .Editable(f=>f.Mode(GridEditMode.InCell))
        //.Footer(false)
        .Resizable(f => f.Columns(true))
        .Render();   
}
</div>