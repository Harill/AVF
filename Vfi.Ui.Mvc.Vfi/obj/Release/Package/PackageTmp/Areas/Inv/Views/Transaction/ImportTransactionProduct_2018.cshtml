@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@model TransactionModel
@{
    ViewBag.Title = "Nhập SP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function customer_onChange() {
            RefreshGrid("gridProductInventory");
        }

        function warehouseIssueName_onChange() {
            RefreshGrid("gridProductInventory");
        }

        function warehouseReceiptName_onChange() {
        }

        //function warehouseReceiptName_onLoad() {
        //    $(this).data('tDropDownList').reload();

        //}

        //function warehouseReceiptName_onDataBound() {
        //    $(this).data('tDropDownList').value('1');
        //}

        function gridProductInventory_onDataBinding(args) {

            var customerId = $("#Customer").data('tComboBox').value();
            var warehouseReceipt = $("#WarehouseReceiptName").data('tDropDownList').value();
            var productCodeName = $("#ProductCode").data("tAutoComplete").value();

            if (warehouseReceipt == 0) {
                args.preventDefault();
            }
            if (customerId == 0) {
                customerId = 0;
            }

            args.data = $.extend(args.data, {
                customerId: customerId,
                warehouseId: warehouseReceipt,
                eoi: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Import)",
                productName: productCodeName
            });

        }

        function autoComplete_onChange() {
            RefreshGrid("gridProductInventory");
        }
    </script>

    <script type="text/javascript">
        function PickupProductId() {

            var $checkedRecords = $(':checked');
            //var $checkedRecords = $("input[name='chkMaterialIds']:checked");

            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 nguyên liệu");
                return;
            }

            //$.ajaxSettings.traditional = false;
            var a = {};
            var ids = "";

            for (var i = 0; i < $checkedRecords.length; i++) {
                a[i] = $checkedRecords[i].value;

                ids += $checkedRecords[i].value;
                if (i < ($checkedRecords.length - 1))
                    ids += ":";
            }

            var warehouseReceipt = $("#WarehouseReceiptName").data('tDropDownList').value();
            $("#gridProductInventoryDetail").data("tGrid").rebind({
                //checkedRecords: $checkedRecords.map(function () { return value; }) 
            //checkedRecords: a
                productIds: ids,
                warehouseId: warehouseReceipt
            });

        }
    </script>

