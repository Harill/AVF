@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "Packing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .fieldheader {
        height: 150px;
        padding-left: 15px;
        padding-right: 15px;
        float: left;
    }
    .fieldheader1 {
        width: 35%;
        min-width: 420px;
        margin-right: 10px;
    }
    .fieldheader2 {
        width: 30%;
        margin-right: 10px;
    }
    .fieldheader3 {
        width: 25%;
    }
</style>
@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">
        $(document).ready(function () {
            auto_OnChange();
        });
        function auto_OnChange() {
            if ($("input[name='chkAuto']").attr('checked')) {
                $("#btnAddData").fadeTo('slow', 0.4);
            } else {
                $("#btnAddData")[0].removeAttribute("style");
            }
        }

        function packingNumber_OnChange() {
            var number = $("#PackingNumber").data("tTextBox").value();
            if (number > 0) {
                $("#chkFixNumber")[0].setAttribute('checked', true)
            } else {
                $("#chkFixNumber")[0].removeAttribute("checked");
            }
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span>";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }
    </script>
    <script>
        function product_OnChange() {
            RefreshCombobox("Package");
            var warehouse = $("#Warehouse").data('tComboBox').value();
            if (warehouse === "") warehouse = 0;
            var product = $("#Product").data('tComboBox').value();
            if (product === "") product = 0;
            OnLoadingData();
            $.ajax({
                type: 'post',
                data: { productId: product, warehouseId: warehouse },
                dataType: 'json',
                url: '@Url.Action("CheckProductInventoryInfo", "Inv", new { area = "Inv" })',
                timeout: 20000,
                success: function (data) {
                    OnLoadedData();
                    if (!data || data[0] != 1) { }
                    else if (data[0] === 1) {
                        $("#UnitWeight").val(data[1]);
                        $("#UnitWeight").data("tTextBox").$text[0].innerHTML = data[1].format(4);
                        $("#InventoryQuantity")[0].innerText = data[2].format(0);
                        $("#InventoryWeight")[0].innerText = data[3].format(0);
                    }
                }
            });
        }
        function package_OnDataBinding(e) {
            var productId = $("#Product").data('tComboBox').value();
            if (productId == "") return false;

            e.data = $.extend(e.data, {
                productId: productId
            });
        }
        function package_OnChange(e) {
            var productPackage = $("#Package").data('tComboBox').value();
            if (productPackage !== "") {
                var values = productPackage.split(":");
                if (values.length < 4) { return false; }
                $("#PackingNumber").val(values[1]);
                $("#PackingNumber").data("tTextBox").$text[0].innerHTML = parseInt(values[1]).format(0);
                $("#CrossWeight").val(values[2]);
                $("#CrossWeight").data("tTextBox").$text[0].innerHTML = parseInt(values[2]).format(0);
                $("#PackageWeight")[0].innerText = parseFloat(values[3]).format(3);
                var tolerance = $("#Tolerance").data("tTextBox").value();
                if (!isNaN(tolerance)) {
                    var unitWeight = $("#UnitWeight").data('tTextBox').value();
                    var quantity = parseInt(values[1]) * parseInt(unitWeight);
                    $("#MinWeight")[0].innerText = (quantity - quantity * tolerance / 100).format(0);
                    $("#MaxWeight")[0].innerText = (quantity + quantity * tolerance / 100).format(0);
                    $("#NetWeight").val(quantity);
                    $("#NetWeight").data("tTextBox").$text[0].innerHTML = quantity.format(0);
                }
            }
        }

        function weight_OnChange() {
            var weight = $("#Weight").data("tTextBox").value(),
                second = $("#AutoDataSecond").data("tTextBox").value(),
             auto = $("input[name='chkAuto']").attr('checked');
            var msg = "";
            msg += auto ? "Tự động: sau " + second + " giây\n" : "";
            msg += "Trọng lượng: " + weight;
            alert(msg);
        }

        function AddData() {
            RefreshGrid("gridProductInventoryDetail");
        }
        var ids = "";
        function grid_OnDataBinding(e) {
            var warehouse = $("#Warehouse").data('tComboBox').value();
            if (warehouse === "") warehouse = 0;
            var product = $("#Product").data('tComboBox').value();
            if (product === "") product = 0;
            e.data = $.extend(e.data, {
                productIds: ids,
                warehouseId: warehouse
            });
        }
    </script>
}

<div class="title" style="float:left;">
    <div class="grid_2_5">Weighing</div>
    @*Can^ hang`*@
    <div class="grid_3">
        @{
            Html.Telerik().NumericTextBox()
                .Name("Weight")
                .MinValue(0)
                .MaxValue(1000000)
                .DecimalDigits(0)
                .Value(0)
                .Spinners(false)
                .InputHtmlAttributes(new { style = "text-align:right;width:100%;width:100%;" })
                .ClientEvents(events => { events.OnChange("weight_OnChange"); })
                .Render();
        }
    </div>
    <div class="grid_0_5">
        (g)
    </div>
</div>
<div class="clear"></div>
<br />

<div class="t-info-sha fieldheader fieldheader1">
    <fieldset>
        <legend>Product Information</legend>
        <div class="grid_6">
            <div class="grid_3">
               Warehouse
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Warehouse")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxImportWarehouse", "Warehouse", new { area = "Inv" }).Delay(350))
                        .HtmlAttributes(new { style = "width: 100%" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        //.ClientEvents(events => events.OnChange("warehouse_OnChange"))
                        .Render();
                }
            </div>
            <div class="clear"></div>
            <br />

            <div class="grid_1_5">
                Product
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Product")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProductFullCodeName", "Product", new { area = "" }))
                        .HtmlAttributes(new { style = "width: 100%" })
                        .DropDownHtmlAttributes(new { style = "width: 275px" })
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .ClientEvents(events => { events.OnChange("product_OnChange"); })
                        .Render();
                }
            </div>
            
            <div class="clear"></div>
            <br />
            <div class="grid_1_5">
               Product Weight
            </div>
            <div class="grid_2">
                @{
                    Html.Telerik().NumericTextBox()
                        .Name("UnitWeight")
                        .MinValue(0)
                        .MaxValue(1000)
                        .DecimalDigits(4)
                        .Value(0.000)
                        .Spinners(false)
                        .InputHtmlAttributes(new { style = "text-align:right; width:100%;" })
                        //.ClientEvents(events => { events.OnChange("unitWeight_OnChange"); })
                        .Render();
                }
            </div>
            <div class="grid_2">(g/pc)</div>
        </div>
        <div class="grid_4">
            <button class="t-button" id="btnAddData" name="btnAddData" onclick=" AddData() ">
                <span class='t-icon t-insert'></span>
                Ok
            @*    Nạp liệu*@
            </button>
            <span class="twoToneButton"></span>
            <div class="clear"></div>
            <br />
            
            <div class="grid_3_5">
                TK (pcs): <span id="InventoryQuantity">1.100.000</span>
            </div>
            <div class="clear"></div>
            <br />
            
            <div class="grid_3_5">
                TK (g): <span id="InventoryWeight">1.212.345</span>
            </div>
        </div>
        <div class="clear"></div>
        <div class="clear"></div>

    </fieldset>
</div>

