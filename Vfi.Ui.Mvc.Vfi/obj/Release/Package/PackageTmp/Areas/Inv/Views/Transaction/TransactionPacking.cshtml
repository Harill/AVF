<div class="clear"></div>

<div class="cover-div">
@{
    Html.Telerik().Grid<ProductInventoryRotateModel>()
        .Name("gridTransactionDetail")
        .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
        .DataBinding(dataBindings => dataBindings.Ajax()
            .Select("AddTransactionWeighingProduct", "Transaction", new { productId = 0, warehouseId = 0, productWeight = 0, quantity = 0 })
        //.Update("PrintForecastOrder", "Reporting")
            )
        .Columns(columns => {
            columns.Bound(f => f.ProductId).Width(30)
                .ClientTemplate("<#= ++index #>")
                .HeaderTemplate("<strong>No.</strong>");
            columns.Bound(f => f.CustomerCode).Width(70).HeaderTemplate("Customer");
            columns.Bound(f => f.ProductCode).Width(120)
                .Aggregate(agg => agg.Count())
                .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                ;
            columns.Bound(f => f.LotNumber).Width(100).Title("Lot");
            columns.Bound(f => f.ProductWeight).Width(70)
                .HeaderTemplate("Product</br>Weight(g/pc)")
                .Format("{0:n3}")
                .HtmlAttributes(new { style = "text-align: right;" });
            columns.Bound(f => f.TotalQtyExport).Width(70)
                .HeaderTemplate("Inv</br>(pcs)")
                .Format("{0:n0}")
                .HtmlAttributes(new { style = "text-align: right;" });
            columns.Bound(f => f.TotalQtyExportKg).Width(70)
                .HeaderTemplate("Inv</br>(g)")
                .Format("{0:n0}")
                .HtmlAttributes(new { style = "text-align: right;" });
            columns.Bound(f => f.QuantityKg).Width(100).HeaderTemplate("Release</br>Weight(g)")
                .Format("{0:n2}")
                .HtmlAttributes(new { style = "text-align: right;" })
                .Aggregate(agg => agg.Sum())
                .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                .FooterHtmlAttributes(new { style = "text-align: right;" });
            columns.Bound(f => f.Quantity).Width(100).HeaderTemplate("Release</br>Quantity(pcs)")
                .Format("{0:n0}")
                .HtmlAttributes(new { style = "text-align: right;" })
                .Aggregate(agg => agg.Sum())
                .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                .FooterHtmlAttributes(new { style = "text-align: right;" });
            columns.Bound(f => f.ModifiedDate).Width(100).HeaderTemplate("Time")
                .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ModifiedDate) #>")
                .HtmlAttributes(new { style = "text-align: right;" });

            //columns.Bound(f => f.Note).Title("Ghi Chú");
        })
        .ClientEvents(events => events
            .OnDataBinding("grid_OnDataBinding")
            .OnError("grid_OnError")
        )
        .Scrollable(f => f.Height(510))
        .Editable(f => f.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
        // .Footer(false)
        .Groupable()
        .Resizable(f => f.Columns(true))
        .Render();
}
</div>

