        </div>
        <div class="grid_1">
            (g)
        </div>
        <div class="grid_2_5">
            Cross Weight
        </div>
        <div class="grid_1_5">
            @{
                Html.Telerik().NumericTextBox()
                    .Name("CrossWeight")
                    .MinValue(0)
                    .MaxValue(1000000)
                    .DecimalDigits(0)
                    .Value(0)
                    .Spinners(false)
                    .InputHtmlAttributes(new { style = "text-align:right;width:100%;width:100%;" })
                    //.ClientEvents(events => { events.OnChange("crossWeight_OnChange"); })
                    .Render();
