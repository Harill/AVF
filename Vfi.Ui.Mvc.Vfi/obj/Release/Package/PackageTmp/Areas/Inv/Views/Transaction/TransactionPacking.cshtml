@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "Đóng gói";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    div .fieldheader {
        height:150px;padding-left: 15px; padding-right: 15px; width: 30%; float:left;
        margin-right: 10px; min-width:350px;
    }
</style>
@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">
        $(document).ready(function () {
            auto_OnChange();
            //packingNumber_OnChange();
        });
        function product_OnChange() {

        }
        function auto_OnChange() {
            //$("#btnAddData").fadeTo('slow', 0.4);
            //$("#btnAddData").fadeTo(100);
            if ($("input[name='chkAuto']").attr('checked')) {
                $("#btnAddData").fadeTo('slow', 0.4);
            } else {
                $("#btnAddData")[0].removeAttribute("style");
            }
        }

        function packingNumber_OnChange() {
            var number = $("#PackingNumber").data("tTextBox").value();
            if (number > 0) {
                $("#chkFixNumber")[0].setAttribute('checked', true)
            } else {
                $("#chkFixNumber")[0].removeAttribute("checked");
            }
        }
        function package_OnDataBinding(e) {
            var productId = $("#Product").data('tComboBox').value();
            if (productId == "") return false;

            e.data = $.extend(e.data, {
                productId: productId
            });
        }
    </script>
    <script>

        function weight_OnChange() {
            var weight = $("#Weight").data("tTextBox").value(),
                second = $("#AutoDataSecond").data("tTextBox").value(),
             auto = $("input[name='chkAuto']").attr('checked');
            var msg = "";
            msg += auto ? "Tự động: sau " + second + " giây\n" : "";
            msg += "Trọng lượng: " + weight;
            alert(msg);
        }

        function AddData() {

        }
    </script>
}

<div class="title">Cân hàng</div>
<div class="clear"></div>
<br />

<div class="t-info-sha fieldheader">
    <fieldset>
        <legend>Thông tin sản phẩm</legend>
        <div class="grid_6">
            <div class="grid_1_5">
                Sản phẩm
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("ProductCode")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProductFullCodeName", "Product", new { area = "" }))
                        .HtmlAttributes(new { style = "width: 100%" })
                        .DropDownHtmlAttributes(new { style = "width: 275px" })
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        .ClientEvents(events => { events.OnChange("product_OnChange"); })
                        .Render();
                }
            </div>
            <div class="clear"></div>
            <br />

            <div class="grid_1_5">
                TL SP
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().NumericTextBox()
                        .Name("UnitWeight")
                        .MinValue(0)
                        .MaxValue(1000)
                        .DecimalDigits(4)
                        .Value(0.000)
                        .Spinners(false)
                        .InputHtmlAttributes(new { style = "text-align:right; width:100%;" })
                        //.ClientEvents(events => { events.OnChange("unitWeight_OnChange"); })
                        .Render();
                }
            </div>
            <div class="clear"></div>
            <br />

            <div class="grid_1_5">
                TL cân
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().NumericTextBox()
                        .Name("Weight")
                        .MinValue(0)
                        .MaxValue(1000000)
                        .DecimalDigits(0)
                        .Value(0)
                        .Spinners(false)
                        .InputHtmlAttributes(new { style = "text-align:right;width:100%;width:100%;" })
                        .ClientEvents(events => { events.OnChange("weight_OnChange"); })
                        .Render();
                }
            </div>
        </div>
        @*<div class="clear"></div>*@
        <div class="grid_2_5">
            <button class="t-button" id="btnAddData" name="btnAddData" onclick=" AddData() ">
                <span class='t-icon t-insert'></span>
                Nạp liệu
                <span id="twoToneButton"></span>
            </button>
        </div>
        <div class="clear"></div>
        <div class="clear"></div>

    </fieldset>
</div>

<div class="t-info-sha fieldheader">
    <fieldset>
        <legend>Thông tin đóng gói</legend>
        <div class="grid_2">
            Kho
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("Warehouse")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxImportWarehouse", "Warehouse", new { area = "Inv" }).Delay(350))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    //.ClientEvents(events => events.OnChange("warehouse_OnChange"))
                    .Render();
            }
        </div>
        <div class="clear"></div>
        <br />

        <div class="grid_2">
            Loại gói
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("Package")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboboxProductionFuel", "Production", new { area = "Factory", productId = 0 }).Delay(350))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .ClientEvents(events => events.OnDataBinding("package_OnDataBinding"))
                    .Render();
            }

        </div>
        <div class="clear"></div>
        <br />

        <div class="grid_2">
            SL trong gói
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().NumericTextBox()
                    .Name("PackingNumber")
                    .MinValue(0)
                    .MaxValue(1000000)
                    .DecimalDigits(0)
                    .Value(0)
                    .Spinners(false)
                    .InputHtmlAttributes(new { style = "text-align:right;width:100%;" })
                    .ClientEvents(events => events.OnChange("packingNumber_OnChange"))
                    .Render();
            }
        </div>
            <label>
                <input type="checkbox" id="chkFixNumber" name="chkFixNumber" />
                cố định số lượng
            </label>
        <div class="clear"></div>
        <br />

    </fieldset>
</div>

<div class="t-info-sha fieldheader">
    <fieldset>
        <legend>Cấu hình đóng gói</legend>
        <div class="grid_2_5">
            Tự động nạp
        </div>
        <div class="grid_1">
            <label>
                <input type="checkbox" id="chkAuto" name="chkAuto" checked onchange="auto_OnChange()" />
            </label>
        </div>
        <div class="grid_1">
            @{
                Html.Telerik().NumericTextBox()
                    .Name("AutoDataSecond")
                    .MinValue(1)
                    .MaxValue(10)
                    .DecimalDigits(0)
                    .Value(5)
                    .Spinners(false)
                    .InputHtmlAttributes(new { style = "text-align:right; width:100%;" })
                    //.ClientEvents(events => { events.OnChange("weight_OnChange"); })
                    .Render();
            } 
        </div>
        giây
        <div class="clear"></div>
    </fieldset>
</div>
