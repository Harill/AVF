@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "Material Use Form Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function PrintForm(val) {
            alert(val);
            $('#result').load('@Url.Action("PrintTransactionForm", "Inv")',
                {
                    transactionId: val
                }, function(data) {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

    </script>

    <!-- click node grid expand.colapse -->
    <script type="text/javascript">
        function Status_onChange() {
            RefreshGrid("gridMaterialUse");
        }
        function grid_onDataBinding(args) {
            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;
            
            var typeValue = $("#Type").data("tDropDownList").value();
            if (typeValue === "")
                typeValue = 1;

            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }
            args.data = $.extend({}, args.data, {
                status: statusValue,
                formCode: "",
                type: typeValue,
                fromDate: fromDate,
                toDate: toDate
            });


            //$('#gridTransaction').data('t-grid').ajaxRequest();
            // $("#gridTransaction").page(1);


        }
        function Type_OnLoad() {
            var combobox = $('#Type').data('tDropDownList');
            var dataSource =
            [
                { Text: "Phát NL", Value: "1" },
                { Text: "Trả NL", Value: "2" }
            ];

            combobox.dataBind(dataSource);
            combobox.text("Sử dụng");
        }

        function gridDetail_OnRowDataBound(e) {
            if (!e.dataItem.CanReUpdate)
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
        }

    </script>
}
<div class="title">Hồ sơ thông tin lệnh giao dịch nguyên liệu trên máy</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
            <div class="grid_2">
               Tình trạng giao dịch
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Status")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxTransactionStatus", "Transaction"))
                        .HtmlAttributes(new {style = "width: 150px"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .ClientEvents(events => events.OnChange("Status_onChange"))
                        .Render();
                }
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().DropDownList()
                        .Name("Type")
                        //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxTransactionStatus", "Transaction"))
                        .HtmlAttributes(new {style = "width: 150px"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        //.Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        //.HighlightFirstMatch(true)
                        //.AutoFill(true)
                        .ClientEvents(events => events.OnLoad("Type_OnLoad").OnChange("Status_onChange"))
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                        .Render();
                }
            </div>
            <div class="grid_2">
                @{
                    Html.Telerik().DatePicker()
                        .Name("toDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
              <div class="grid_4 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridMaterialUse'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
            </div>
        </fieldset>
    </div>
<div class="cover-div">
@{
    Html.Telerik().Grid<MaterialUseInShiftModel>()
        .Name("gridMaterialUse")
        .DataKeys(keys => keys.Add(f => f.UseId).RouteKey("useId"))
        .DataBinding(dataBindings => dataBindings.Ajax()
                                                 .Select("SelectMaterialUseForm", "Transaction",
                                                         new
                                                         {
                                                             status = (byte)MyUtilities.Transaction.Status.Open,
                                                             formCode = "",
                                                             type = 1,
                                                             fromDate = "",
                                                             toDate = ""
                                                         })
        )
        .Columns(columns =>
            {
                columns.Bound(f => f.UsedCode).Title("Mã sử dụng");
                columns.Bound(f => f.UsedDate).Title("Ngày sử dụng")
                       .ClientTemplate("<strong><#= UsedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', UsedDate) #></strong>");
                columns.Bound(f => f.TypeName).Title("Loại");
                columns.Bound(f => f.StatusName).Title("Tình trạng");
                columns.Bound(f => f.ModifiedUser).Title("Người làm");
                columns.Bound(f => f.ModifiedDate).Title("Ngày làm")
                       .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ModifiedDate) #>");
                columns.Bound(f => f.UseId).Title("In").Width(75)
                       .ClientTemplate("<input type='button' id='<#= UseId #>' value='In' class='t-button' />")
                       .HtmlAttributes(new { style = "text-align:center" });
            })
        .DetailView(details => details.ClientTemplate(
            Html.Telerik().TabStrip()
                .Name("TabStrip_<#= UseId #>")
                .SelectedIndex(0)
                .Items(items =>
                       items.Add().Text("Thông tin chi tiết").Content(
                           Html.Telerik().Grid<MaterialUseInShiftDetailModel>()
                               .Name("gridMaterialUseDetail_<#= UseId #>")
                               .DataKeys(key => key.Add(f => f.DetailId).RouteKey("detailId"))
                               .DataBinding(dataDindings => dataDindings.Ajax()
                                                                        .Select("SelectMaterialUseDetailByFormId", "Transaction", new { formId = "<#= UseId #>" })
                                                                        .Update("UpdateMaterialUseDetail", "Transaction", new { formId = "<#= UseId #>" })
                                                                        
                               )
                               .Columns(columns => {
                                       columns.Command(c => c.Edit().ButtonType(GridButtonType.Image)).Width(50).Title("")
                                           .HtmlAttributes(new { style = "text-align:center" });
                                       columns.Bound(f => f.MachineName).Width(60).Title("Máy").ReadOnly(true);
                                       columns.Bound(f => f.ProductCode).Width(100).Title("SP đang chạy").ReadOnly(true);
                                       columns.Bound(f => f.MaterialCode).Width(250).Title("Mã NL").ReadOnly(true);
                                       columns.Bound(f => f.WaitingNumber).Width(60).Title("SD tối đa").ReadOnly(true);
                                       //columns.Bound(f => f.LotNumber).Width(40).Title("Lô").ReadOnly(true);
                                       columns.Bound(f => f.AssignQuantity).Width(80).Title("Phát theo ngày").ReadOnly(true)
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .ClientTemplate("<#= AssignQuantity == null ? 0 :$.telerik.formatString('{0:n2}', AssignQuantity) #>")
                                              .Aggregate(agg => agg.Sum())
                                              .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>")
                                              .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>");
                                       columns.Bound(f => f.EditQuantity).Width(60).Title("Ca 1")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .FooterHtmlAttributes(new { style = "text-align: right;" })
                                              .ClientTemplate("<span name='EditQuantity'><#= EditQuantity == null ? 0.0 : $.telerik.formatString('{0:n2}', EditQuantity) #></span>")
                                              .Aggregate(agg => agg.Sum())
                                              .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>")
                                              .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>");
                                       columns.Bound(f => f.EditQuantity2).Width(60).Title("Ca 2")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .FooterHtmlAttributes(new { style = "text-align: right;" })
                                              .ClientTemplate("<span name='EditQuantity2'><#= EditQuantity2 == null ? 0.0 : $.telerik.formatString('{0:n2}', EditQuantity2) #></span>")
                                              .Aggregate(agg => agg.Sum())
                                              .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>")
                                              .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n2}', Sum) #></div>");
                                       //columns.Bound(f => f.BoxNumber).Width(50).Title("Số hộp").ReadOnly(true)
                                       //       .HtmlAttributes(new { style = "text-align: right;" })
                                       //       .ClientTemplate("<span name='BoxNumber'><#= BoxNumber == null ? 0 : $.telerik.formatString('{0:n0}', BoxNumber) #></span>")
                                       //       .FooterTemplate("<span id='TotalBoxNumber'></span>");
                                       columns.Bound(f => f.Note).Title("Ghi chú");
                                   })
        .ClientEvents(events => events.OnError("grid_OnError")
                .OnRowDataBound("gridDetail_OnRowDataBound"))
                               .ToHtmlString()
                           )
                )
                .ToHtmlString()
                                   ))
        .Selectable()
        .ClientEvents(events => events
                                    .OnRowSelect("grid_OnRowSelect")
                                    .OnDataBinding("grid_onDataBinding")
                                    .OnError("grid_OnError")
        )
        .Filterable()
        .Groupable()
                .Scrollable(f => f.Height(510))
        .Render();
}
</div>

@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
        )
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

