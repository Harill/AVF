
@if (Request.IsAuthenticated) {
    
    <text>
        Welcome: <span id="displayname" style="font-weight:bold"> @ViewBag.UserLoginFullName</span>!
        @*<span id ="HelloString"></span>*@
        [ @Html.ActionLink("Log Out", "WindowLogOff", "Home", new { area = ""  }, new { @style = "color:"+ViewBag.PageTitleColor+";"  }) ]
    </text>
}
else
{

        @:[ @Html.ActionLink("Log On", "Index", "Home") ]
}
