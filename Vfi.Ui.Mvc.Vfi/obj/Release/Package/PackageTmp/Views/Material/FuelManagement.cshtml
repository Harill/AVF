@using Vfi.Ui.Mvc.Vfi.Models
@{
    ViewBag.Title = "Fuel Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="title">Fuel Management</div>                               @* Quản lý thông tin nhiên liệu *@

<div class="cover-div">
@{
    Html.Telerik().Grid<FuelModel>()
        .Name("gridFuel")
        .DataKeys(key => key.Add(f => f.FuelId).RouteKey("FuelId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).Text("Add New").ImageHtmlAttributes(new {style = "margin-left:0px;"}))
        .DataBinding(
            dataBinding => dataBinding.Ajax()
                                      .Select("SelectAllFuel", "Material")
                                      .Insert("InsertFuel", "Material")
                                      .Update("UpdateFuel", "Material"))
        .Columns(columns =>
            {
                columns.Command(command =>
                                command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image).UpdateText("Update").InsertText("Add").CancelText("Cancel").Text("Edit")
                    ).Width(60).Title("").HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.FuelFullCode).Width(155).Title("Fuel Full Code").ReadOnly(true)                                        //Mã
                       .ClientTemplate("<strong><#= FuelFullCode #></strong>");
                columns.Bound(f => f.FuelName).Width(95).Title("Fuel Name");                                                        // Ten nguyen lieu
                columns.Bound(f => f.FuelCode).Width(105).Title("Fuel Code")                                                              //Mã tên
                       .ClientTemplate("<strong><#= FuelCode #></strong>");
                columns.Bound(f => f.FuelDesignNo).Width(180).Title("Specification")                                                   // Quy cách
                       .ClientTemplate("<strong><#= FuelDesignNo #></strong>");
                columns.Bound(f => f.FuelDesctiption).Width(195).Title("Describe");                                                     //Mô tả
                columns.Bound(f => f.UnitWeight).Width(50).Title("Weight");                                                             //Trọng lượng
                columns.Bound(f => f.ModifiedDate).Width(80).Title("M-Date").ReadOnly(true)                                     //Ngày chỉnh
                       .Format("{0:dd/MM/yyyy HH:mm}");
                columns.Bound(f => f.ModifiedUser).Width(75).Title("M-User").ReadOnly(true);                                    //Người chỉnh
                columns.Bound(f => f.Active).Width(50)
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
            })
        .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
        .Scrollable(f => f.Height(500))
        .Sortable()
        .Filterable()
        .Resizable(f => f.Columns(true))
        .Reorderable(f => f.Columns(true))
        .ClientEvents(events => events.OnError("grid_OnError"))
        .Render();
}
</div>

