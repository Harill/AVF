@using Vfi.Ui.Mvc.Vfi.Models
@{
    ViewBag.Title = "Fuel Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="title">Quản lý thông tin nhiên liệu</div>

<div class="cover-div">
@{
    Html.Telerik().Grid<FuelModel>()
        .Name("gridFuel")
        .DataKeys(key => key.Add(f => f.FuelId).RouteKey("FuelId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert().ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new {style = "margin-left:0px;"}))
        .DataBinding(
            dataBinding => dataBinding.Ajax()
                                      .Select("SelectAllFuel", "Material")
                                      .Insert("InsertFuel", "Material")
                                      .Update("UpdateFuel", "Material"))
        .Columns(columns =>
            {
                columns.Command(command =>
                                command.Edit().ButtonType(GridButtonType.Image).UpdateText("Cập nhập").InsertText("Thêm").CancelText("Hủy").Text("Sửa")
                    ).Width(90).Title("").HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.FuelFullCode).Width(150).Title("Mã").ReadOnly(true)
                       .ClientTemplate("<strong><#= FuelFullCode #></strong>");
                columns.Bound(f => f.FuelName).Width(75).Title("Tên nhiên liệu");
                columns.Bound(f => f.FuelCode).Width(75).Title("Mã tên")
                       .ClientTemplate("<strong><#= FuelCode #></strong>");
                columns.Bound(f => f.FuelDesignNo).Width(150).Title("Quy cách")
                       .ClientTemplate("<strong><#= FuelDesignNo #></strong>");
                columns.Bound(f => f.FuelDesctiption).Width(150).Title("Mô tả");
                columns.Bound(f => f.UnitWeight).Width(75).Title("Trọng lượng");
                columns.Bound(f => f.ModifiedDate).Width(100).Title("Ngày chỉnh").ReadOnly(true)
                       .Format("{0:dd/MM/yyyy HH:mm}");
                columns.Bound(f => f.ModifiedUser).Width(100).Title("Người chỉnh").ReadOnly(true);
                columns.Bound(f => f.Active).Width(50)
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
            })
        .Editable(editing => editing.Mode(GridEditMode.InLine))
        .Scrollable(f => f.Height(500))
        .Sortable()
        .Filterable()
        .Resizable(f => f.Columns(true))
        .Reorderable(f => f.Columns(true))
        .ClientEvents(events => events.OnError("grid_OnError"))
        .Render();
}
</div>

