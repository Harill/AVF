@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "Material Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        function gridTabProduct_OnEdit(e) {
            var mode = e.mode;
            var form = e.form;

            var productCodeName = $(form).find('#ProductCode');
            var productCodeNameData = $(form).find('#ProductCode').data('tComboBox');

            if (mode == 'insert') {

            }
            else if (mode == 'edit') {
                productCodeNameData.reload();
                productCodeName.bind('dataBound', function () { // your code 
                    productCodeNameData.select(function (item) {
                        return item.Value == e.dataItem['ProductId'];
                    });
                });
            }
        }

        function gridMaterial_onEdit(e) {
            var mode = e.mode;
            var form = e.form;

            var materialTypeName = $(form).find('#MaterialTypeName');
            var materialTypeNameData = $(form).find('#MaterialTypeName').data('tDropDownList');
            //var vendorCodeName = $(form).find('#VendorCodeName');
            //var vendorCodeNameData = $(form).find('#VendorCodeName').data('tComboBox');

            if (mode == 'insert') {

            }
            else if (mode == 'edit') {

                materialTypeNameData.reload();
                materialTypeName.bind('dataBound', function () { // your code 
                    materialTypeNameData.select(function (item) {
                        return item.Text == e.dataItem['MaterialTypeName'];
                    });
                });
                //vendorCodeNameData.reload();
                //vendorCodeName.bind('dataBound', function () { // your code 
                //    vendorCodeNameData.select(function (item) {
                //        return item.Value == e.dataItem['VendorId'];
                //    });
                //});
            }
        }
        
        function gridMaterial_OnDataBinding(args) {
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            args.data = $.extend(args.data, {
                productCode: productCodeName
            });
        }

    </script>
}

<div class="title">Quản lý thông tin nguyên liệu</div>
<div id="pnlInvPeriod">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
    
        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
                <div class="grid_1">Sản phẩm</div>
            <div class="grid_5">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new {area = "Inv"}))
                        .HtmlAttributes(new {style = "width: 150px; "})
                        .DropDownHtmlAttributes(new {style = "width: 250px; "})
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Value("")
                        //.ClientEvents(events => events.OnClose("ProductCodeName_OnClose"))
                        .Render();
                }
            </div>
              <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid('gridMaterial'); ">
                    <span class='t-icon t-insert'></span>
                   Làm mới
                </button>
        </fieldset>
    </div>
</div>
<div class="cover-div">
@{
    Html.Telerik().Grid<MaterialModel>()
        .Name("gridMaterial")
        .DataKeys(key => key.Add(f => f.MaterialId).RouteKey("materialId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert().ButtonType(GridButtonType.ImageAndText).Text("Nhập mới").ImageHtmlAttributes(new {style = "margin-left:0px;"}))
        .DataBinding(
            dataBinding => dataBinding.Ajax()
                                      .Select("SelectMaterial", "Material", new {area="",productCode = ""})
                                      .Insert("InsertMaterial", "Material")
                                      .Update("UpdateMaterial", "Material"))
        .Columns(columns =>
            {
                columns.Command(command =>
                                command.Edit().ButtonType(GridButtonType.ImageAndText).UpdateText("Cập nhập").InsertText("Thêm").CancelText("Hủy").Text("Sửa")
                    ).Width(90).Title("Lệnh").HtmlAttributes(new {style = "text-align:center"});
                //columns.Bound(f => f.VendorCodeName).Width(150)
                //       .ClientTemplate("<strong><#= VendorCodeName #></strong>");
                columns.Bound(f => f.MaterialTypeName).Width(100)
                       .HeaderTemplate("Loại</br>nguyên liệu")
                       .ClientTemplate("<strong><#= MaterialTypeName #></strong>");
                columns.Bound(f => f.MaterialName).Width(100)
                       .HeaderTemplate("Tên</br>nguyên liệu");
                columns.Bound(f => f.MaterialCode)
                    //.Width(225)
                       .ReadOnly(true)
                       .ClientTemplate("<strong><#= MaterialCode #></strong>");
                columns.Bound(f => f.OutDiameter).Width(50)
                       .HeaderTemplate("OD</br>(mm)");
                columns.Bound(f => f.InDiameter).Width(50)
                       .HeaderTemplate("ID</br>(mm)");
                columns.Bound(f => f.Shape).Width(50)
                       .HtmlAttributes(new {style = "text-align:center;"})
                       .HeaderTemplate("Hình</br>dạng");
                columns.Bound(f => f.DiameterType).Width(50)
                       .HtmlAttributes(new {style = "text-align:center;"})
                       .HeaderTemplate("Dung</br>sai");
                //columns.Bound(f => f.Length).Width(70)
                //       .HtmlAttributes(new {style = "text-align:right;"})
                //       .HeaderTemplate("Chiều dài</br>(mm)")
                //       .ClientTemplate("<#= Length == null ? 0 :$.telerik.formatString('{0:n0}', Length) #>");
                columns.Bound(f => f.Weight).Width(80)
                       .HeaderTemplate("Trọng lượng</br>(kg/cây)");
                columns.Bound(f => f.UnitPrice).Width(80)
                       .HeaderTemplate("Đơn giá")
                       .HtmlAttributes(new {style = "text-align:right;"})
                       .ClientTemplate("<#= UnitPrice == null ? 0 :$.telerik.formatString('{0:n0}', UnitPrice) #>");
                columns.Bound(f => f.IsExpensive).Width(55)
                       .HeaderTemplate("Mắc</br>tiền")
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsExpensive' <#=IsExpensive? checked='checked' : '' #> />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.Active).Width(55)
                       .HeaderTemplate("Kích</br>hoạt")
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                       .HtmlAttributes(new {style = "text-align:center"});
            })
            
        .DetailView(details => details.ClientTemplate(

            Html.Telerik().TabStrip()
                .Name("TabStrip_<#= MaterialId #>")
                .SelectedIndex(0)
                .Items(items =>

                       items.Add().Text("Sản phẩm sử dụng").Content(

                           Html.Telerik().Grid<ProductionMaterialModel>()
                               .Name("gridProductionMaterial_<#= MaterialId #>")
                               .DataKeys(key => key.Add(f => f.RealMaterialId).RouteKey("realMaterialId"))
                               .ToolBar(
                                   toolbar =>
                                   toolbar.Insert().Text("Thêm mới").ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new {style = "margin-left:0px;"}))
                               .DataBinding(
                                   dataBinding => dataBinding.Ajax()
                                                             .Select("SelectProductionMaterialById", "Material", new {area = "", materialId = "<#= MaterialId #>"})
                                                             .Insert("InsertProductionMaterial", "Material", new {area = "", materialId = "<#= MaterialId #>"})
                                                             .Update("UpdateProductionMaterial", "Material", new {area = "", materialId = "<#= MaterialId #>"})
                               )
                               .Columns(columns =>
                                   {
                                       columns.Command(command =>
                                                       command.Edit().ButtonType(GridButtonType.Image).UpdateText("Cập nhật").CancelText("Hủy").Text("Sửa").InsertText("Thêm mới")
                                           ).Width(40).Title("").HtmlAttributes(new { style = "text-align:center" });
                                       columns.Bound(f => f.CustomerCode).Width(50).Title("Mã KH").ReadOnly(true);
                                       columns.Bound(f => f.ProductCode).Width(120).Title("Mã sản phẩm");
                                       columns.Bound(f => f.ForecastInYear).Width(85)
                                              .HeaderTemplate("Dự báo</br>SX 1 năm(pcs)")
                                              .Format("{0:n0}");
                                       columns.Bound(f => f.ForecastIn3Month).Width(85).ReadOnly(true)
                                              .HeaderTemplate("Dự báo</br>SX 1 quý(pcs)")
                                              .Format("{0:n0}");
                                       columns.Bound(f => f.UnitWeightByMaterial).Width(85).ReadOnly(true)
                                              .HeaderTemplate("Trọng lượng</br>theo NL (g)")
                                              .ClientTemplate("<#= UnitWeightByMaterial == null ? 0 : $.telerik.formatString('{0:n3}', UnitWeightByMaterial) #>");
                                       //columns.Bound(f => f.ProductWeight).Width(85)
                                       //       .HeaderTemplate("Trọng lượng</br>thiết kế (g)").ReadOnly(true)
                                       //       .ClientTemplate("<#= ProductWeight == null ? 0 : $.telerik.formatString('{0:n3}', ProductWeight) #>");
                                       //columns.Bound(f => f.Priority).Width(50).Title("Độ ưu tiên");
                                       columns.Bound(f => f.Note).Title("Ghi chú");
                                       columns.Bound(f => f.Active).Width(55)
                                              .HeaderTemplate("Kích</br>hoạt")
                                              .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                                              .HtmlAttributes(new {style = "text-align:center"});
                                       columns.Bound(f => f.ModifiedUser)
                                              .Title("Người tạo").ReadOnly(true)
                                              .Width(70);
                                       columns.Bound(f => f.ModifiedDate)
                                              .Title("Ngày tạo").ReadOnly(true)
                                              .Width(80)
                                              .Format("{0:dd/MM/yyyy HH:mm:ss}");
                                       //columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(30).Title("");
                                   })
                               .Editable(editing => editing.Mode(GridEditMode.InLine))
                               .ClientEvents(e => e.OnEdit("gridTabProduct_OnEdit")
                                                   .OnError("grid_OnError"))
                               .ToHtmlString()
                           ))

                .ToHtmlString()
                                   ))
        .Selectable()
        .Editable(editing => editing.Mode(GridEditMode.InLine))
        .ClientEvents(events => events.OnEdit("gridMaterial_onEdit")
                                      .OnRowSelect("grid_OnRowSelect")
                                      .OnDataBinding("gridMaterial_OnDataBinding")
                                      .OnError("grid_OnError"))
        //.Pageable(page => page.PageSize(10).Style(GridPagerStyles.NextPreviousAndNumeric))
        .Scrollable(f => f.Height(500))
        .Sortable()
        .Filterable()
        .Resizable(f => f.Columns(true))
        .Reorderable(f => f.Columns(true))
        .Render();
}
</div>

