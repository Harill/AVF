@using Vfi.Server.Core.DataModel.Models.System
@model ChangePasswordModel
@*@inherits WebViewPage<ChangePasswordModel>*@
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    $(function () {
        $("#lblMsg").val("");
    });

    function ChangePassword() {
        try {
            $("#lblMsg").val("");
            var changePassword = {};
            changePassword.OldPassword = $("#OldPassword").val();
            changePassword.NewPassword = $("#NewPassword").val();
            changePassword.ConfirmPassword = $("#ConfirmPassword").val();

            var changePassworkDto = { 'ChangePasswordModel': changePassword };
            
            $.ajax({
                type: 'post',
                data: JSON.stringify(changePassworkDto),
                dataType: 'json',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("ChangePassword", "User")',
                timeout: 20000,
                success: function (data) {
                    //$("#lblMsg").html(data);
                    alert(data);
                }
            });
        }
        catch (e) { if (e === "") { alert("Bad Value Sent - or XSS"); $('.t-overlay').hide(); } else { alert(e); } }
        
        return false;
    }

</script>

<div class="title">ChangePassword</div>

<div class="t-info-sha" style="padding-left: 15px; width:750px; color: Maroon;">
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm())
    {
         @Html.ValidationSummary(true)

         <div class="grid_4">@Html.LabelFor(f => f.OldPassword)</div>
         <div class="grid_5">
             @Html.EditorFor(f => f.OldPassword)
             @Html.ValidationMessageFor(f => f.OldPassword)
         </div>
         <div class="clear"></div>

         <div class="grid_4">@Html.LabelFor(f => f.NewPassword)</div>
         <div class="grid_5">
             @Html.EditorFor(f => f.NewPassword)
             @Html.ValidationMessageFor(f => f.NewPassword)
         </div>
         <div class="clear"></div>

         <div class="grid_4">@Html.LabelFor(f => f.ConfirmPassword)</div>
         <div class="grid_5">
             @Html.EditorFor(f => f.ConfirmPassword)
             @Html.ValidationMessageFor(f => f.ConfirmPassword)
         </div>
         <div class="clear"></div>
    
        <div class="grid_9">@Html.Label("lblMsg", "")</div>
        <div class="clear"></div>

         <div class="grid_5 push_4">
             <button class="t-button" id="btnChangePassword" name="btnChangePassword" onclick="return ChangePassword();">
                 <span class='t-icon t-insert'></span>
                 Đổi mật khẩu
             </button>
         </div>
        <div class="clear"></div>
    
    }
}
</div>